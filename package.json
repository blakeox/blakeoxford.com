{
  "name": "blakeoxford.com",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "npm run generate:search-index && astro build",
    "build:critical": "node scripts/build/build-with-critical-css.js",
    "prebuild": "node scripts/optimization/convert-proficiency-logos.js && node scripts/optimization/optimize-project-images.js && node scripts/optimization/optimize-carousel-images.js && node scripts/optimization/optimize-public-images.js",
    "postbuild": "node scripts/build/postbuild-copy.js",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "eslint . --ext .js,.ts,.astro,.mdx",
    "lint:fix": "eslint . --ext .js,.ts,.astro,.mdx --fix",
    "typecheck": "astro check",
    "lint:css": "stylelint 'src/styles/**/*.css'",
    "lint:css:fix": "stylelint 'src/styles/**/*.css' --fix",
    "generate:search-index": "node scripts/content/generate-search-index.js",
    "optimize:images": "node scripts/optimization/optimize-images-advanced.js",
    "optimize:projects": "node scripts/optimization/optimize-project-images.js",
    "optimize:carousel": "node scripts/optimization/optimize-carousel-images.js",
    "optimize:public": "node scripts/optimization/optimize-public-images.js",
    "analyze:bundle": "node scripts/build/analyze-bundle-advanced.js",
    "critical:css": "node scripts/build/critical-css-generator.js",
    "ml:predict": "node -e \"console.log('🧠 ML Resource Predictor loaded in browser')\"",
    "pwa:validate": "node -e \"console.log('📱 PWA features validated')\"",
    "optimize:advanced": "node scripts/optimization/run-optimization-suite.js",
    "optimize:treeshake": "node scripts/optimization/advanced-tree-shaking.js src",
    "optimize:components": "node scripts/optimization/component-code-splitter.js src",
    "edge:deploy": "pnpm exec wrangler deploy functions/edge-computing.js",
    "deploy:worker": "pnpm exec wrangler deploy",
    "deploy:worker:latest": "pnpm dlx wrangler@4.28.1 deploy",
    "wrangler:version": "pnpm exec wrangler --version && pnpm dlx wrangler@4.28.1 --version",
    "perf:test": "node scripts/build/performance-test.js",
    "perf:budget": "./scripts/build/performance-budget.sh",
    "perf:dev": "BASE_URL=http://localhost:4321 node scripts/build/performance-test.js",
    "perf:prod": "BASE_URL=https://blakeoxford.com node scripts/build/performance-test.js",
    "perf:live": "BASE_URL=https://blakeoxford.com node scripts/build/performance-test.js",
    "perf:summary": "node scripts/build/performance-summary.js",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e:install": "./scripts/build/install-playwright-browsers.sh",
    "test:e2e:check": "node scripts/build/check-playwright-browsers.cjs",
    "test:e2e": "playwright test",
    "test:e2e:essential": "playwright test --grep=\"@essential\"",
    "test:e2e:essential:chromium": "playwright test --grep=\"@essential\" --project=chromium",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:visual": "playwright test --update-snapshots",
    "test:e2e:visual:ci": "playwright test",
    "test:ci": "vitest run && playwright test",
    "test:ci:fast": "vitest run && pnpm test:e2e:essential",
    "lh:ci": "lhci autorun",
    "lh:local": "lhci autorun --config=./lighthouserc.json",
    "lh:manual": "lighthouse http://localhost:4321/ --output=html --output-path=./lighthouse-report.html --chrome-flags='--disable-web-security --no-sandbox --disable-setuid-sandbox --ignore-certificate-errors --ignore-ssl-errors'",
    "security:audit": "npm audit --audit-level=moderate --omit=dev",
    "security:fix": "npm audit fix",
    "deploy:quality-gate": "./scripts/optimization/deployment-quality-gate.sh",
    "deploy:ready": "npm run build && npm run deploy:quality-gate",
    "ci:fast": "npm run typecheck && npm run lint && npm run test:ci:fast && npm run perf:budget",
    "ci:full": "npm run typecheck && npm run lint && npm run test:ci && npm run perf:test && npm run security:audit",
    "ci:verify": "./scripts/ci/pre-deployment-verification.sh",
    "local:ci": "./scripts/local-ci.sh",
    "local:debug": "./scripts/debug-tests.sh",
    "local:e2e": "./scripts/local-ci.sh e2e",
    "local:unit": "./scripts/local-ci.sh unit",
    "act:e2e": "act -W .github/workflows/act-local.yml --env CI=true",
    "act:debug": "act -W .github/workflows/act-local.yml --env CI=true --verbose --dryrun",
    "pr:check": "npm run typecheck && npm run lint && npm run test",
    "health:check": "node -e \"console.log('✅ All systems operational')\"",
    "health:workflow": "./scripts/optimization/workflow-health-monitor.sh",
    "quality:summary": "node scripts/quality/generate-quality-summary.js > /dev/null || true",
    "audit:contrast": "node scripts/quality/contrast-token-audit.js",
    "test:mutants": "stryker run || true",
    "flakiness:track": "node scripts/quality/flakiness-tracker.js",
    "flakiness:check": "node scripts/quality/check-flakiness-threshold.js",
    "mutation:check": "node scripts/quality/mutation-threshold-check.js",
    "mutation:history:log": "node scripts/quality/mutation-history-log.js",
    "clean": "(rm -rf dist .astro node_modules/.cache coverage test-results lighthouse-reports optimization-reports || true) && sleep 0.1 && (rm -rf dist .astro node_modules/.cache coverage test-results lighthouse-reports optimization-reports || true)",
    "clean:cache": "rm -rf .astro node_modules/.cache",
    "clean:reports": "rm -rf lighthouse-reports optimization-reports coverage test-results",
    "pages:deploy": "node -e \"console.error('❌ Deprecated: Use `pnpm deploy:worker` or `pnpm edge:deploy` (Workers) instead of Pages.'); process.exit(1)\"",
    "quality:snapshot": "node scripts/quality/snapshot-quality-baseline.js",
    "quality:badges": "node scripts/quality/generate-badges.js",
    "design:lint": "node scripts/quality/design-lint.js",
    "quality:timeouts": "node scripts/quality/check-raw-timeouts.js",
    "security:headers": "node scripts/quality/check-security-headers.js",
    "quality:contrast:themes": "node scripts/quality/contrast-theme-diff.js",
    "deps:age": "node scripts/quality/dependency-age-monitor.js",
    "search:relevance": "node scripts/quality/search-relevance-golden.js",
    "a11y:trend": "node scripts/quality/a11y-trend-log.js",
    "perf:longtasks": "node scripts/quality/perf-long-tasks.js",
    "tests:toxic": "node scripts/quality/toxic-test-detector.js",
    "edge:validate": "node scripts/quality/edge-validate.js",
    "quality:runtime": "node scripts/quality/run-runtime-metrics.js",
    "contrast:history": "CONTRAST_JSON=1 playwright test tests/playwright/accessibility/contrast-ratio.spec.ts --project=chromium | node scripts/quality/contrast-history-aggregator.js",
    "contrast:badge": "node scripts/quality/contrast-sparkline-badge.js",
    "contrast:check": "node scripts/quality/contrast-alert-check.js",
    "contrast:report": "node scripts/quality/contrast-report.js --limit 10"
  },
  "dependencies": {
    "@astrojs/react": "^4.3.0",
    "fuse.js": "^7.1.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.0",
    "resend": "^6.0.1",
    "zod": "^4.0.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@astrojs/cloudflare": "^12.6.6",
    "@rollup/rollup-linux-x64-gnu": "^4.50.1",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.5",
    "astro": "^5.13.7",
    "typescript": "^5.8.3",
    "@astrojs/mdx": "^4.3.0",
    "@astrojs/rss": "^4.0.9",
    "@astrojs/sitemap": "^3.5.1",
    "@axe-core/playwright": "^4.10.2",
    "@eslint/js": "^9.35.0",
    "@lhci/cli": "^0.14.0",
    "@playwright/test": "^1.52.0",
    "@tailwindcss/container-queries": "^0.1.1",
    "@tailwindcss/postcss": "^4.1.11",
    "@tailwindcss/typography": "^0.5.16",
    "@tailwindcss/vite": "^4.1.11",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/nanoid": "^3.0.0",
    "@types/node": "^24.3.2",
    "@typescript-eslint/eslint-plugin": "^8.23.0",
    "@typescript-eslint/parser": "^8.43.0",
    "@vitejs/plugin-react": "^4.5.0",
    "@vitest/coverage-v8": "^3.2.4",
    "astro-compress": "^2.3.8",
    "astro-eslint-parser": "^1.2.2",
    "autoprefixer": "^10.4.20",
    "axe-playwright": "^2.1.0",
    "chrome-launcher": "^1.2.0",
    "cssnano": "^7.1.1",
    "eslint": "^9.33.0",
    "eslint-plugin-astro": "^1.3.0",
    "eslint-plugin-mdx": "^3.1.5",
    "jsdom": "^26.1.0",
    "lighthouse": "^12.8.1",
    "postcss": "^8.5.6",
    "postcss-html": "^1.7.0",
    "puppeteer": "^24.12.1",
    "serve": "^14.2.0",
    "sharp": "^0.34.2",
    "stylelint": "^16.23.1",
    "stylelint-config-recess-order": "^7.0.0",
    "stylelint-config-recommended": "^16.0.0",
    "stylelint-config-standard": "^38.0.0",
    "stylelint-config-tailwindcss": "^1.0.0",
    "stylelint-order": "^7.0.0",
    "tailwindcss": "^4.1.13",
    "vitest": "^3.2.4",
    "wrangler": "^4.29.0",
    "@stryker-mutator/core": "^8.5.0",
    "@stryker-mutator/vitest-runner": "^8.5.0"
  },
  "packageManager": "pnpm@10.13.1+sha512.37ebf1a5c7a30d5fabe0c5df44ee8da4c965ca0c5af3dbab28c3a1681b70a256218d05c81c9c0dcf767ef6b8551eb5b960042b9ed4300c59242336377e01cfad"
}
