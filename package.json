    "@types/react-dom": "^19.1.5",
    "astro": "latest",
    "gray-matter": "^4.0.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "resend": "^4.5.1",
    "sharp": "^0.34.2",
    "zod": "^4.0.5"
  },
