{
  "name": "blakeoxford.com",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "npm run generate:search-index && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "eslint . --ext .js,.ts,.astro,.mdx",
    "lint:fix": "eslint . --ext .js,.ts,.astro,.mdx --fix",
    "lint:css": "stylelint 'src/styles/**/*.css'",
    "lint:css:fix": "stylelint 'src/styles/**/*.css' --fix",
    "generate:search-index": "node scripts/generate-search-index.js",
    "optimize:images": "node scripts/optimize-images-advanced.js",
    "analyze:bundle": "node scripts/analyze-bundle-advanced.js",
    "critical:css": "node scripts/critical-css-generator.js",
    "ml:predict": "node -e \"console.log('🧠 ML Resource Predictor loaded in browser')\"",
    "pwa:validate": "node -e \"console.log('📱 PWA features validated')\"",
    "optimize:advanced": "node scripts/run-optimization-suite.js",
    "optimize:treeshake": "node scripts/advanced-tree-shaking.js src",
    "optimize:components": "node scripts/component-code-splitter.js src",
    "edge:deploy": "wrangler deploy functions/edge-computing.js",
    "perf:test": "node scripts/performance-test.js",
    "perf:dev": "BASE_URL=http://localhost:4321 node scripts/performance-test.js",
    "perf:prod": "BASE_URL=https://blakeoxford.com node scripts/performance-test.js",
    "perf:summary": "node scripts/performance-summary.js",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:ci": "vitest run && playwright test",
    "lh:ci": "lhci autorun",
    "lh:local": "lhci autorun --config=./lighthouserc.json",
    "lh:manual": "lighthouse http://localhost:4321/ --output=html --output-path=./lighthouse-report.html --chrome-flags='--disable-web-security --no-sandbox --disable-setuid-sandbox --ignore-certificate-errors --ignore-ssl-errors'"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.4",
    "@astrojs/react": "^4.3.0",
    "@types/react": "^19.1.5",
    "@types/react-dom": "^19.1.5",
    "astro": "^5.12.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "resend": "^4.5.1",
    "typescript": "^5.8.3",
    "zod": "^4.0.5"
  },
  "devDependencies": {
    "@astrojs/mdx": "^4.3.0",
    "@astrojs/rss": "^4.0.9",
    "@astrojs/sitemap": "^3.3.0",
    "@axe-core/playwright": "^4.10.2",
    "@eslint/js": "^9.31.0",
    "@lhci/cli": "^0.14.0",
    "@playwright/test": "^1.52.0",
    "@tailwindcss/container-queries": "^0.1.1",
    "@tailwindcss/postcss": "^4.1.11",
    "@tailwindcss/typography": "^0.5.17",
    "@tailwindcss/vite": "^4.1.11",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/nanoid": "^3.0.0",
    "@types/node": "^24.0.3",
    "@typescript-eslint/eslint-plugin": "^8.23.0",
    "@typescript-eslint/parser": "^8.23.0",
    "@vitejs/plugin-react": "^4.5.0",
    "@vitest/coverage-v8": "^3.2.4",
    "astro-compress": "^2.3.8",
    "astro-eslint-parser": "^1.3.0",
    "autoprefixer": "^10.4.20",
    "axe-playwright": "^2.1.0",
    "chrome-launcher": "^1.2.0",
    "cssnano": "^7.0.7",
    "eslint": "^9.31.0",
    "eslint-plugin-astro": "^1.3.0",
    "eslint-plugin-mdx": "^3.1.5",

    "jsdom": "^26.1.0",
    "lighthouse": "^12.8.0",
    "postcss": "^8.5.6",
    "postcss-html": "^1.7.0",

    "puppeteer": "^24.12.1",
    "serve": "^14.2.0",
    "sharp": "^0.34.2",
    "stylelint": "^16.22.0",
    "stylelint-config-recess-order": "^7.0.0",
    "stylelint-config-recommended": "^16.0.0",
    "stylelint-config-standard": "^38.0.0",

    "stylelint-config-tailwindcss": "^0.0.7",
    "stylelint-order": "^7.0.0",
    "tailwindcss": "^4.1.11",
    "vitest": "^3.2.4",
    "wrangler": "^4.24.3"
  },
  "packageManager": "pnpm@10.11.0+sha512.6540583f41cc5f628eb3d9773ecee802f4f9ef9923cc45b69890fb47991d4b092964694ec3a4f738a420c918a333062c8b925d312f42e4f0c263eb603551f977"
}
