{
  "name": "blakeoxford.com",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "prepare": "husky",
    "build": "astro build",
    "build:prod": "GIT_COMMIT=$(git rev-parse HEAD) PUBLIC_GIT_COMMIT=$(git rev-parse HEAD) NODE_ENV=production npm run build",
    "preview:prod": "npm run build:prod && npm run preview",
    "prebuild": "node scripts/optimization/convert-proficiency-logos.js && node scripts/optimization/optimize-project-images.js && node scripts/optimization/optimize-carousel-images.js && node scripts/optimization/optimize-public-images.js && node scripts/content/generate-search-index.js",
    "postbuild": "node scripts/build/postbuild-copy.js",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "eslint . --ext .js,.ts,.astro,.mdx",
    "lint:fix": "eslint . --ext .js,.ts,.astro,.mdx --fix",
    "typecheck": "astro check",
    "lint:css": "stylelint 'src/styles/**/*.css'",
    "lint:css:fix": "stylelint 'src/styles/**/*.css' --fix",
    "generate:search-index": "node scripts/content/generate-search-index.js",
    "vectorize:index": "node scripts/vectorize-content.mjs",
    "optimize:images": "node scripts/optimization/optimize-images-advanced.js",
    "optimize:advanced": "node scripts/optimization/optimize-images-advanced.js",
    "deploy:zaraz": "node scripts/setup/deploy-zaraz.mjs",
    "deploy:zaraz:dry-run": "node scripts/setup/deploy-zaraz.mjs --dry-run",
    "validate:zaraz": "node scripts/setup/validate-zaraz.mjs",
    "edge:deploy": "corepack pnpm exec wrangler deploy functions/edge-computing.js",
    "deploy:worker": "corepack pnpm exec wrangler deploy",
    "deploy:worker:latest": "corepack pnpm dlx wrangler@latest deploy",
    "wrangler:version": "corepack pnpm exec wrangler --version && corepack pnpm dlx wrangler@latest --version",
    "sentry:sourcemaps": "sentry-cli sourcemaps upload --org ${SENTRY_ORG} --project ${SENTRY_PROJECT} ./dist",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e:install": "./scripts/build/install-playwright-browsers.sh",
    "test:e2e:check": "node scripts/build/check-playwright-browsers.cjs",
    "test:e2e": "playwright test",
    "test:e2e:essential": "playwright test --grep=\"@essential\"",
    "test:e2e:essential:chromium": "playwright test --grep=\"@essential\" --project=chromium",
    "test:e2e:extended": "PLAYWRIGHT_EXTENDED=true playwright test --grep=\"@extended\"",
    "test:e2e:extended:chromium": "PLAYWRIGHT_EXTENDED=true playwright test --grep=\"@extended\" --project=chromium",
    "test:e2e:device-matrix": "PLAYWRIGHT_EXTENDED=true playwright test tests/playwright/mobile-navigation.spec.ts --project=chromium",
    "test:e2e:visual:chromium": "playwright test tests/playwright/visual-smoke.spec.ts tests/playwright/component-visual-baselines.spec.ts --project=chromium",
    "test:e2e:visual:update": "playwright test tests/playwright/visual-smoke.spec.ts tests/playwright/component-visual-baselines.spec.ts --project=chromium --update-snapshots",
    "test:e2e:ui": "playwright test --ui",
    "test:ci": "vitest run && playwright test",
    "test:ci:fast": "vitest run && corepack pnpm test:e2e:essential",
    "lh:ci": "lhci autorun",
    "lh:local": "lhci autorun --config=./lighthouserc.json",
    "lh:manual": "lighthouse http://localhost:4321/ --output=html --output-path=./lighthouse-report.html --chrome-flags='--disable-web-security --no-sandbox --disable-setuid-sandbox --ignore-certificate-errors --ignore-ssl-errors'",
    "perf:test": "node scripts/build/performance-test.js",
    "perf:budget": "node scripts/build/performance-test.js",
    "perf:summary": "node scripts/build/performance-summary.js",
    "perf:long-tasks": "node scripts/quality/perf-long-tasks.js",
    "security:audit": "node scripts/quality/run-dependency-audit.js",
    "security:fix": "corepack pnpm audit fix",
    "deploy:quality-gate": "./scripts/optimization/deployment-quality-gate.sh",
    "deploy:ready": "npm run build && npm run deploy:quality-gate",
    "ci:fast": "npm run typecheck && npm run design:lint && npm run lint && npm run test:ci:fast && npm run perf:budget",
    "ci:full": "npm run typecheck && npm run design:lint && npm run lint && npm run test:ci && npm run perf:test && npm run security:audit",
    "ci:verify": "./scripts/ci/pre-deployment-verification.sh",
    "local:ci": "./scripts/local-ci.sh",
    "local:debug": "./scripts/debug-tests.sh",
    "local:e2e": "./scripts/local-ci.sh e2e",
    "local:unit": "./scripts/local-ci.sh unit",
    "act:e2e": "act -W .github/workflows/act-local.yml --env CI=true",
    "act:debug": "act -W .github/workflows/act-local.yml --env CI=true --verbose --dryrun",
    "pr:check": "npm run typecheck && npm run design:lint && npm run lint && npm run test",
    "health:check": "node -e \"console.log('✅ All systems operational')\"",
    "health:workflow": "./scripts/optimization/workflow-health-monitor.sh",
    "quality:summary": "node scripts/quality/generate-quality-summary.js > /dev/null || true",
    "audit:contrast": "playwright test tests/playwright/accessibility/contrast-ratio.spec.ts --project=chromium",
    "test:mutants": "stryker run || true",
    "flakiness:track": "node scripts/quality/flakiness-tracker.js",
    "flakiness:check": "node scripts/quality/check-flakiness-threshold.js",
    "mutation:check": "node scripts/quality/mutation-threshold-check.js",
    "mutation:history:log": "node scripts/quality/mutation-history-log.js",
    "clean": "(rm -rf dist 'dist 2' .astro node_modules/.cache coverage test-results lighthouse-reports optimization-reports || true) && sleep 0.1 && (rm -rf dist 'dist 2' .astro node_modules/.cache coverage test-results lighthouse-reports optimization-reports || true)",
    "clean:cache": "rm -rf .astro node_modules/.cache",
    "clean:reports": "rm -rf lighthouse-reports optimization-reports coverage test-results",
    "pages:deploy": "node -e \"console.error('❌ Deprecated: Use `pnpm deploy:worker` or `pnpm edge:deploy` (Workers) instead of Pages.'); process.exit(1)\"",
    "quality:snapshot": "node scripts/quality/snapshot-quality-baseline.js",
    "quality:badges": "node scripts/quality/generate-badges.js",
    "design:lint": "node scripts/quality/design-lint.js && node scripts/quality/check-blog-mdx-dark-baseline.js",
    "design:theme-docs-sync": "node scripts/quality/check-theme-docs-sync.js",
    "design:blog-mdx-dark": "node scripts/quality/blog-mdx-dark-codemod.js --write",
    "quality:timeouts": "node scripts/quality/check-raw-timeouts.js",
    "security:headers": "node scripts/quality/check-security-headers.js",
    "quality:contrast:themes": "node scripts/quality/contrast-theme-diff.js",
    "deps:age": "node scripts/quality/dependency-age-monitor.js",
    "search:relevance": "node scripts/quality/search-relevance-golden.js",
    "a11y:trend": "node scripts/quality/a11y-trend-log.js",
    "tests:toxic": "node scripts/quality/toxic-test-detector.js",
    "edge:validate": "node scripts/quality/edge-validate.js",
    "quality:runtime": "node scripts/quality/run-runtime-metrics.js",
    "contrast:history": "CONTRAST_JSON=1 playwright test tests/playwright/accessibility/contrast-ratio.spec.ts --project=chromium | node scripts/quality/contrast-history-aggregator.js",
    "contrast:badge": "node scripts/quality/contrast-sparkline-badge.js",
    "contrast:check": "node scripts/quality/contrast-alert-check.js",
    "contrast:report": "node scripts/quality/contrast-report.js --limit 10",
    "contrast:sitemap": "playwright test tests/playwright/accessibility/contrast-sitemap.spec.ts --project=chromium",
    "upgrade:vite": "corepack pnpm up vite @vitejs/plugin-react --latest -L",
    "upgrade:lodash": "corepack pnpm up lodash@latest --latest -L"
  },
  "dependencies": {
    "@astrojs/react": "^6.0.0",
    "@sentry/astro": "^10.62.0",
    "@sentry/cloudflare": "^10.62.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/cloudflare": "^14.0.1",
    "@astrojs/mdx": "^7.0.0",
    "@astrojs/rss": "^4.0.18",
    "@astrojs/sitemap": "^3.7.3",
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^10.0.1",
    "@fontsource/inter": "^5.2.8",
    "@fontsource/montserrat": "^5.2.8",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.61.1",
    "@rollup/rollup-linux-x64-gnu": "^4.62.2",
    "@sentry/cli": "^3.6.0",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@tailwindcss/cli": "^4.3.1",
    "@tailwindcss/container-queries": "^0.1.1",
    "@tailwindcss/postcss": "^4.3.1",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.62.0",
    "@typescript-eslint/parser": "^8.62.0",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.9",
    "astro": "^7.0.3",
    "astro-compress": "^2.4.1",
    "astro-eslint-parser": "^2.1.0",
    "autoprefixer": "^10.5.2",
    "chrome-launcher": "^1.2.1",
    "cssnano": "^8.0.2",
    "eslint": "^10.6.0",
    "eslint-plugin-astro": "^2.1.1",
    "eslint-plugin-better-tailwindcss": "^4.6.0",
    "eslint-plugin-mdx": "^3.8.1",
    "fuse.js": "^7.4.2",
    "happy-dom": "^20.10.6",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lighthouse": "^13.4.0",
    "postcss": "^8.5.15",
    "postcss-html": "^1.8.1",
    "puppeteer": "^25.2.1",
    "serve": "^14.2.6",
    "sharp": "^0.35.2",
    "stylelint": "^17.14.0",
    "stylelint-config-recess-order": "^7.7.0",
    "stylelint-config-recommended": "^18.0.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-config-tailwindcss": "^1.0.1",
    "stylelint-order": "^8.1.1",
    "tailwindcss": "^4.3.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9",
    "wrangler": "^4.107.0"
  },
  "packageManager": "pnpm@10.13.1+sha512.37ebf1a5c7a30d5fabe0c5df44ee8da4c965ca0c5af3dbab28c3a1681b70a256218d05c81c9c0dcf767ef6b8551eb5b960042b9ed4300c59242336377e01cfad"
}
