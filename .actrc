# Act configuration for local GitHub Actions testing
# Use Ubuntu 24.04 for better compatibility with our Node.js 22 requirement
-P ubuntu-latest=catthehacker/ubuntu:act-24.04

# Platform-specific configurations
-P ubuntu-22.04=catthehacker/ubuntu:act-22.04
-P ubuntu-20.04=catthehacker/ubuntu:act-20.04

# Set container architecture (useful for M1/M2 Macs)
--container-architecture linux/amd64

# Use Docker's buildkit for better performance
--use-gitignore=false

# Container options for better debugging
-v
