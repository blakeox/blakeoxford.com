---
/**
 * JSON-LD for WebSite + Person.
 */
import { AUTHOR_IDENTITY, SITE_BRAND_NAME } from '@/config/constants';

interface Props {
  siteHref: string;
  description: string;
  ogImage: string;
  structuredData?: Array<Record<string, unknown>>;
}

const { siteHref, description, ogImage, structuredData = [] } = Astro.props;

const websitePersonJsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      url: siteHref,
      name: SITE_BRAND_NAME,
      description,
      inLanguage: 'en-US',
      publisher: {
        '@type': 'Person',
        ...AUTHOR_IDENTITY,
      },
    },
    {
      '@type': 'Person',
      ...AUTHOR_IDENTITY,
      image: ogImage,
      description,
    },
    ...structuredData,
  ],
});
---

<script is:inline type="application/ld+json" set:html={websitePersonJsonLd} />
