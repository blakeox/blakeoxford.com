---
export interface Props {
  title: string;
  achievements: string[];
}

const { title, achievements } = Astro.props;
---

<div class="bg-gray-50 dark:bg-gray-800 rounded-xl p-8">
  <h3 class="text-2xl font-semibold mb-6 text-gray-800 dark:text-gray-100">{title}</h3>
  <ul class="space-y-4">
    {achievements.map((achievement) => (
      <li class="flex items-start gap-3">
        <span class="text-accent dark:text-accent-light font-bold">•</span>
        <span class="text-lg text-gray-700 dark:text-gray-300" set:html={achievement} />
      </li>
    ))}
  </ul>
</div> 