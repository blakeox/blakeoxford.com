---
export interface Props {
  title: string;
  achievements: string[];
}

const { title, achievements } = Astro.props;
---

<div class="bg-surface-alt dark:bg-surface-alt-dark rounded-xl p-8">
  <h3 class="text-2xl font-semibold mb-6 text-foreground">{title}</h3>
  <ul class="space-y-4">
    {achievements.map((achievement) => (
      <li class="flex items-start gap-3">
        <span class="text-accent dark:text-accent-light font-bold">•</span>
  <span class="text-lg text-foreground/80" set:html={achievement} />
      </li>
    ))}
  </ul>
</div> 