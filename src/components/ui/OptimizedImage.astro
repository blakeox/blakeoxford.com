---
import { Image } from 'astro:assets';

type StaticImage = {
  src: ImageMetadata;
  alt: string;
  class?: string;
  loading?: 'lazy' | 'eager';
  priority?: boolean;
};

type ExternalImage = {
  src: string;
  alt: string;
  width?: number;
  height?: number;
  class?: string;
  loading?: 'lazy' | 'eager';
  priority?: boolean;
  quality?: number;
};

type Props = StaticImage | ExternalImage;

const props = Astro.props as Props;
const {
  alt,
  class: className = '',
  loading = 'lazy',
  priority = false,
} = props;

const width = 'width' in props ? props.width : undefined;
const height = 'height' in props ? props.height : undefined;
const quality = 'quality' in props ? props.quality ?? 80 : 80;

// Set loading to eager for priority images
const imageLoading = priority ? 'eager' : loading;
---

{typeof props.src === 'object' ? (
  <Image
    src={props.src}
    alt={alt}
    class={className}
    loading={imageLoading}
  />
) : (
  <Image
    src={props.src}
    alt={alt}
    width={width}
    height={height}
    format="avif"
    quality={quality}
    loading={imageLoading}
    class={className}
    inferSize={true}
  />
)}

{priority && (
  <link
    rel="preload"
    as="image"
    href={src}
    type="image/avif"
  />
)}
