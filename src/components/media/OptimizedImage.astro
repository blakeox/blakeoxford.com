---
interface Props {
  name: string; // path relative to /assets/images without extension (e.g. 'proficiencies/python_logo')
  alt: string;
  class?: string;
  sizes?: string; // sizes attribute for responsive loading
  loading?: 'lazy' | 'eager';
  decoding?: 'auto' | 'async' | 'sync';
  width?: number;
  height?: number;
  ext?: string; // original source extension used as fallback if no optimized manifest (default: webp)
}

const {
  name,
  alt,
  class: className = '',
  sizes = '(max-width: 768px) 100vw, 33vw',
  loading = 'lazy',
  decoding = 'async',
  width,
  height,
  ext = 'webp'
} = Astro.props as Props;

// Generated manifests live in /public/assets/images/optimized/*.json (written by optimize-images script)
// Because Astro builds statically, we attempt a dynamic import with a relative path known at build time.
let manifest: any = null;
try {
  manifest = await import(`../../../public/assets/images/optimized/${name}.json`).then(m => m.default || m);
} catch {
  // Fallback: leave manifest null so we gracefully use original image path.
}

// Helper to build a srcset for a format
function buildSrcSet(format: string) {
  if (!manifest || !manifest.sizes) return '';
  return manifest.sizes.map((w: number) => `/assets/images/optimized/${format}/${name}@${w}w.${format} ${w}w`).join(', ');
}

const avifSet = buildSrcSet('avif');
const webpSet = buildSrcSet('webp');
// Primary fallback source (non-optimized) uses provided extension (default webp)
const fallbackSrc = `/assets/images/${name}.${ext}`;
// If optimization manifest exists, prefer optimized JPEG baseline (AVIF/WebP sources already defined above)
const jpegPath = manifest ? `/assets/images/optimized/jpeg/${name}.jpeg` : fallbackSrc;
---
<picture>
  {avifSet && (
    <source srcset={avifSet} sizes={sizes} type="image/avif" />
  )}
  {webpSet && (
    <source srcset={webpSet} sizes={sizes} type="image/webp" />
  )}
  <img src={jpegPath} alt={alt} loading={loading} decoding={decoding} class={className} width={width} height={height} />
</picture>
