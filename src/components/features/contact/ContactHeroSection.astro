---
import PageHero from '@/components/composites/PageHero.astro';
import IntroCopy from '@/components/composites/IntroCopy.astro';
import DotMetaList from '@/components/composites/DotMetaList.astro';
import Button from '@/components/primitives/Button.astro';
import ButtonGroup from '@/components/composites/ButtonGroup.astro';

export interface ContactHeroContent {
  kicker: string;
  title: string;
  description: string;
  scenarios: string[];
  primaryCta: { href: string; label: string };
  secondaryCta: { href: string; label: string };
  sidebar: {
    heading: string;
    items: string[];
    note: string;
  };
}

interface Props {
  content: ContactHeroContent;
}

const { content } = Astro.props;
---

<PageHero
  fullScreen={false}
  includeBlurOrbs={false}
  align="center"
  id="contact-hero"
  class="min-h-0!"
  shell="contact-hero-inner"
>
  <div class="flex w-full flex-col items-center gap-7">
    <IntroCopy
      kicker={content.kicker}
      title={content.title}
      description={content.description}
      align="center"
      size="hero"
    />
    <ButtonGroup align="center" responsive>
      <Button variant="primary" size="lg" href={content.primaryCta.href}>
        {content.primaryCta.label}
      </Button>
      <Button variant="outline" size="lg" href={content.secondaryCta.href}>
        {content.secondaryCta.label}
      </Button>
    </ButtonGroup>
    <DotMetaList
      items={content.scenarios}
      label="Best-fit scenarios"
      align="center"
      class="max-w-3xl"
    />
  </div>
</PageHero>
