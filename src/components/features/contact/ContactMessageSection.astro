---
/**
 * Contact brief — the page is the form.
 * Claim, sequencing, and Turnstile wiring live in one section.
 */
import Section from '@/components/primitives/Section.astro';
import FormField from '@/components/primitives/FormField.astro';
import Button from '@/components/primitives/Button.astro';
import IntroCopy from '@/components/composites/IntroCopy.astro';
import DotMetaList from '@/components/composites/DotMetaList.astro';

interface Sidebar {
  heading: string;
  items: string[];
  note: string;
}

interface ContactBrief {
  kicker: string;
  title: string;
  description: string;
  scenarios: string[];
  sidebar: Sidebar;
}

interface Props {
  content: ContactBrief;
}

const { content } = Astro.props as Props;
const { sidebar } = content;
---

<Section
  id="contact-message-section"
  padding="xl"
  container="xl"
  background="surface"
  aria-labelledby="contact-title"
  data-chat-avoid-launcher
>
  <div class="grid gap-10 lg:grid-cols-[minmax(0,0.85fr)_minmax(0,1.15fr)] lg:items-start lg:gap-12">
    <div class="flex flex-col gap-8 lg:sticky lg:top-28">
      <IntroCopy
        kicker={content.kicker}
        title={content.title}
        titleId="contact-title"
        description={content.description}
        size="hero"
        descriptionSize="md"
      />
      <DotMetaList items={content.scenarios} label="Best-fit scenarios" />

      <div class="border-t border-border/50 pt-5">
        <p class="text-sm font-semibold tracking-tight text-foreground">{sidebar.heading}</p>
        <ol class="mt-3 space-y-2.5" role="list">
          {sidebar.items.map((item, index) => (
            <li class="flex gap-3 text-sm leading-relaxed text-muted-foreground">
              <span
                class="font-heading text-sm font-semibold text-accent-emphasis tabular-nums"
                aria-hidden="true"
              >
                {String(index + 1).padStart(2, '0')}
              </span>
              <span>{item}</span>
            </li>
          ))}
        </ol>
        <p class="mt-5 text-sm leading-relaxed text-muted-foreground">{sidebar.note}</p>
        <p class="mt-3 text-xs leading-relaxed text-subtle-foreground">
          Protected by Cloudflare Turnstile; delivered through Cloudflare Email Service.
        </p>
      </div>
    </div>

    <div class="border border-border/50 bg-background p-5 sm:p-7 lg:p-8">
      <p class="mb-6 text-sm text-muted-foreground">All fields are required.</p>

      <div
        id="form-status"
        role="status"
        aria-live="polite"
        aria-atomic="true"
        tabindex="-1"
        class="mb-5 hidden text-sm font-semibold"
      ></div>

      <form
        id="contact-form"
        method="POST"
        action="/send-email"
        class="space-y-5"
        aria-describedby="contact-form-help"
      >
        <FormField id="form-name" type="hidden" label="form-name-hidden" value="contact" />
        <p hidden>
          <input id="bot-field" name="bot-field" type="text" tabindex="-1" autocomplete="off" />
        </p>
        <p id="contact-form-help" class="sr-only">
          All fields are required. Your message is protected by Cloudflare Turnstile and delivered
          through Cloudflare Email Service. Contact submissions are retained for up to 90 days for
          follow-up and abuse review, then automatically expire.
        </p>

        <div class="grid gap-5 sm:grid-cols-2">
          <FormField
            id="name"
            label="Name"
            type="text"
            required
            autocomplete="name"
            minlength={2}
            maxlength={100}
            placeholder="Your name"
          />

          <FormField
            id="email"
            label="Work email"
            type="email"
            required
            autocomplete="email"
            maxlength={254}
            placeholder="you@company.com"
          />
        </div>

        <FormField
          id="message"
          label="What bottleneck should we attack first?"
          type="textarea"
          required
          rows={6}
          minlength={10}
          maxlength={2000}
          placeholder="Describe the problem, the systems or teams involved, and the outcome you need."
          helpText="10 character minimum · 2,000 character maximum"
        />

        <div class="-mt-4 flex justify-end text-xs text-subtle-foreground" aria-live="polite">
          <span id="message-count">0</span>
          <span aria-hidden="true"> / 2,000</span>
          <span class="sr-only">characters used</span>
        </div>

        <div
          id="turnstile-shell"
          class="min-h-0 data-[turnstile-state=error]:min-h-10 data-[turnstile-state=interactive]:min-h-[65px]"
          data-turnstile-state="idle"
        >
          <p id="turnstile-status" class="sr-only" aria-live="polite"></p>
          <div
            id="turnstile-container"
            class="flex w-full min-w-0 items-start justify-start [&>iframe]:max-w-full"
            role="group"
            aria-label="Human verification challenge"
          ></div>
        </div>

        <Button type="submit" variant="primary" size="lg" fullWidth>
          <span id="btn-label">Send project brief</span>
          <svg
            id="spinner"
            class="hidden size-5 animate-spin"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <circle
              cx="12"
              cy="12"
              r="10"
              stroke="currentColor"
              stroke-width="3"
              fill="none"
              opacity=".3"
            ></circle>
            <path
              d="M22 12a10 10 0 0 0-10-10"
              stroke="currentColor"
              stroke-width="3"
              stroke-linecap="round"
            ></path>
          </svg>
        </Button>
        <p class="text-center text-sm leading-relaxed text-muted-foreground">
          I’ll review your brief and follow up by email about next steps.
        </p>
        <p class="text-center text-xs leading-relaxed text-subtle-foreground">
          Your details are used to respond to your inquiry and protect this form from abuse.
        </p>
      </form>
    </div>
  </div>
</Section>
