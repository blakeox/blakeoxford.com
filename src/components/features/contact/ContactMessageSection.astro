---
import Section from '../../primitives/Section.astro';
import FormField from '../../primitives/FormField.astro';
import Button from '../../primitives/Button.astro';
---

<Section padding="xl" container="xl" background="surface" class="border-y border-border/50" aria-labelledby="message-form">
  <div class="grid gap-12 lg:grid-cols-[minmax(0,0.78fr)_minmax(34rem,1.22fr)] lg:items-start lg:gap-20">
    <div class="section-intro-left lg:sticky lg:top-28">
      <span class="section-kicker">Primary path</span>
      <h2 id="message-form" class="font-heading text-3xl font-semibold tracking-tight text-foreground sm:text-4xl">Send the project brief</h2>
      <p class="text-base leading-relaxed text-muted-foreground sm:text-lg">
        Share the friction, the systems involved, and the outcome you need. I’ll use that context to determine whether a focused working session is the right next move.
      </p>

      <div class="mt-8 border-t border-border/60 pt-7">
        <p class="text-sm font-semibold text-foreground">A useful note includes</p>
        <ul class="mt-4 space-y-3 text-sm leading-relaxed text-muted-foreground" role="list">
          <li class="flex gap-3"><span class="text-accent" aria-hidden="true">01</span><span>The business problem creating drag, risk, or avoidable manual work.</span></li>
          <li class="flex gap-3"><span class="text-accent" aria-hidden="true">02</span><span>The systems, teams, and approvals that shape the work.</span></li>
          <li class="flex gap-3"><span class="text-accent" aria-hidden="true">03</span><span>The outcome you need and the constraint that matters most.</span></li>
        </ul>
      </div>

      <div class="mt-8 flex items-start gap-3 rounded-2xl border border-border/60 bg-background/70 p-4 text-sm leading-relaxed text-muted-foreground">
        <svg class="mt-0.5 size-5 shrink-0 text-accent" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M12 3 5 6v5c0 4.6 2.9 8.2 7 10 4.1-1.8 7-5.4 7-10V6l-7-3Z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round" />
          <path d="m9 12 2 2 4-4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        <p><strong class="font-semibold text-foreground">Protected delivery.</strong> Cloudflare Turnstile screens automated submissions, then Cloudflare Email Service delivers your note directly to my inbox.</p>
      </div>
    </div>

    <div class="rounded-3xl border border-border/70 bg-background p-6 shadow-lg sm:p-8 lg:p-10">
      <div class="mb-8 flex flex-col gap-3 border-b border-border/60 pb-6 sm:flex-row sm:items-start sm:justify-between">
        <div>
          <p class="font-heading text-xl font-semibold text-foreground">Project inquiry</p>
          <p class="mt-1 text-sm text-muted-foreground">All fields are required.</p>
        </div>
        <span class="inline-flex w-fit items-center gap-2 rounded-full border border-success/30 bg-success/8 px-3 py-1.5 text-xs font-semibold text-success-dark">
          <span class="size-1.5 rounded-full bg-success" aria-hidden="true"></span>
          Cloudflare delivery
        </span>
      </div>

      <div id="form-status" role="status" aria-live="polite" aria-atomic="true" tabindex="-1" class="mb-6 hidden text-sm font-semibold"></div>

      <form id="contact-form" method="POST" action="/send-email" class="space-y-6" aria-describedby="contact-form-help">
          <FormField id="form-name" type="hidden" label="form-name-hidden" value="contact" />
          <p class="sr-only" aria-hidden="true">
            <label for="bot-field" class="sr-only">Don&apos;t fill this out</label>
            <input id="bot-field" name="bot-field" type="hidden" aria-hidden="true" tabindex="-1" aria-label="bot-field-hidden" />
          </p>
          <p id="contact-form-help" class="sr-only">All fields are required. Your message is protected by Cloudflare Turnstile and delivered through Cloudflare Email Service.</p>

          <div class="grid gap-6 sm:grid-cols-2">
            <FormField
              id="name"
              label="Name"
              type="text"
              required
              autocomplete="name"
              minlength={2}
              maxlength={100}
              placeholder="Your name"
            />

            <FormField
              id="email"
              label="Work email"
              type="email"
              required
              autocomplete="email"
              maxlength={254}
              placeholder="you@company.com"
            />
          </div>

          <FormField
            id="message"
            label="What can I help you solve?"
            type="textarea"
            required
            rows={6}
            minlength={10}
            maxlength={2000}
            placeholder="Describe the problem, the systems or teams involved, and the outcome you need."
            helpText="10 character minimum · 2,000 character maximum"
          />

          <div class="-mt-4 flex justify-end text-xs text-subtle-foreground" aria-live="polite">
            <span id="message-count">0</span><span aria-hidden="true"> / 2,000</span><span class="sr-only"> characters used</span>
          </div>

          <div class="flex min-h-[72px] w-full items-center justify-start border-t border-border/60 pt-5">
            <div id="turnstile-container" class="w-full" role="group" aria-label="Human verification challenge">
              <div class="text-sm text-muted-foreground">Human verification will appear when needed.</div>
            </div>
          </div>

          <Button type="submit" variant="primary" size="lg" fullWidth>
            <span id="btn-label">Send project brief</span>
            <svg id="spinner" class="hidden size-5 animate-spin" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="3" fill="none" opacity=".3"/><path d="M22 12a10 10 0 0 0-10-10" stroke="currentColor" stroke-width="3" stroke-linecap="round" /></svg>
          </Button>
          <p class="text-center text-xs leading-relaxed text-subtle-foreground">Your details are used to respond to your inquiry and protect this form from abuse.</p>
      </form>
    </div>
  </div>
</Section>
