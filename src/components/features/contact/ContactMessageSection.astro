---
import Section from '../../primitives/Section.astro';
import FormField from '../../primitives/FormField.astro';
import FloatingBlur from '../../primitives/FloatingBlur.astro';
---

<Section padding="lg" container="lg" background="gradient" class="relative overflow-hidden" aria-labelledby="message-form">
  <div class="absolute inset-0 z-0 opacity-20 pointer-events-none">
    <svg class="absolute inset-0 h-full w-full" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <pattern id="contact-grid" width="40" height="40" patternUnits="userSpaceOnUse">
          <path d="M0 40L40 0M20 40L40 20M0 20L20 0" fill="none" stroke="currentColor" stroke-width="1" stroke-opacity="0.12" />
        </pattern>
      </defs>
      <rect width="100%" height="100%" fill="url(#contact-grid)" />
    </svg>
  </div>
  <div class="fixed inset-0 -z-10 pointer-events-none">
    <FloatingBlur size="md" color="accent-light" position="top-right" translate="translate-x-1/2 -translate-y-1/2" />
    <FloatingBlur size="sm" color="accent-light" position="bottom-left" translate="-translate-x-1/2 translate-y-1/2" />
  </div>

  <div class="relative z-10">
    <div class="mx-auto w-full max-w-3xl">
      <div class="section-intro mb-8">
        <span class="section-kicker">Primary path</span>
        <h2 id="message-form" class="font-heading text-2xl font-semibold text-foreground sm:text-3xl md:text-4xl">Send the project brief</h2>
        <p class="text-lg text-muted-foreground">
          The more concrete the friction, systems, and desired outcome, the faster I can tell you whether a working session makes sense.
        </p>
      </div>
      <div id="form-status" aria-live="polite" class="mb-4 hidden min-h-[56px] text-center font-semibold"></div>

      <div class="mx-auto mt-4 max-w-xl rounded-3xl border border-accent/25 bg-surface p-8 shadow-xl transition-colors hover:border-accent/40 dark:bg-surface-dark">
        <div class="mb-6 rounded-2xl border border-border/45 bg-surface-subtle/65 px-4 py-4 text-sm leading-relaxed text-muted-foreground dark:bg-surface-dark-subtle/55">
          Useful inputs: the business problem, systems involved, current bottleneck, and any timing or governance constraint that shapes the decision.
        </div>
        <form id="contact-form" method="POST" action="/send-email" class="space-y-6" aria-describedby="contact-form-help">
          <FormField id="form-name" type="hidden" label="form-name-hidden" value="contact" />
          <p class="sr-only" aria-hidden="true">
            <label for="bot-field" class="sr-only">Don&apos;t fill this out</label>
            <input id="bot-field" name="bot-field" type="hidden" aria-hidden="true" tabindex="-1" aria-label="bot-field-hidden" />
          </p>
          <p id="contact-form-help" class="sr-only">All fields marked with an asterisk are required.</p>

          <FormField
            id="name"
            label="Name"
            type="text"
            required
            autocomplete="name"
            minlength={2}
            maxlength={100}
            placeholder="Your Name"
          />

          <FormField
            id="email"
            label="Email"
            type="email"
            required
            autocomplete="email"
            maxlength={254}
            placeholder="you@email.com"
            helpText="I'll never share your email."
          />

          <FormField
            id="message"
            label="Project brief"
            type="textarea"
            required
            rows={6}
            minlength={10}
            maxlength={2000}
            placeholder="What problem are you solving, which systems or teams are involved, and what outcome do you need?"
            helpText="Please provide at least 10 characters. Include the constraint that matters most."
          />

          <div class="flex min-h-[72px] w-full items-center justify-center">
            <div id="turnstile-container" class="w-full" role="group" aria-label="Human verification challenge">
              <div class="text-center text-sm text-muted-foreground">Human verification will appear when needed.</div>
            </div>
          </div>

          <button type="submit" class="mx-auto flex w-full items-center justify-center gap-2 rounded-full border border-accent bg-accent px-6 py-3 text-sm font-semibold text-on-accent shadow-lg shadow-accent/20 transition-[background-color,border-color,transform] duration-200 hover:-translate-y-0.5 hover:border-accent-dark hover:bg-accent-dark focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent/65 focus-visible:ring-offset-2 dark:hover:border-accent dark:hover:bg-accent md:w-auto">
            <span id="btn-label">Send project brief</span>
            <svg id="spinner" class="hidden h-5 w-5 animate-spin" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" fill="none"/></svg>
          </button>
        </form>
      </div>
    </div>
  </div>
</Section>
