---
/**
 * Contact brief — same editorial calm as Selected work / About.
 * Form behavior and Turnstile wiring preserved.
 */
import Section from '@/components/primitives/Section.astro';
import FormField from '@/components/primitives/FormField.astro';
import Button from '@/components/primitives/Button.astro';
import SectionHeader from '@/components/composites/SectionHeader.astro';

interface Sidebar {
  heading: string;
  items: string[];
  note: string;
}

interface Props {
  sidebar: Sidebar;
}

const { sidebar } = Astro.props as Props;
---

<Section
  id="message"
  padding="xl"
  container="xl"
  background="surface"
  aria-labelledby="message-form"
>
  <div
    class="grid gap-10 lg:grid-cols-[minmax(0,0.85fr)_minmax(0,1.15fr)] lg:items-start lg:gap-12"
  >
    <div class="lg:sticky lg:top-28">
      <SectionHeader
        kicker="Primary path"
        title="Send the project brief"
        titleId="message-form"
        description="Share the friction, the systems involved, and the outcome you need. I’ll use that to decide whether a focused working session is the right next move."
      />

      <div class="border-t border-border/50 pt-5">
        <p class="text-sm font-semibold tracking-tight text-foreground">{sidebar.heading}</p>
        <ol class="mt-3 space-y-2.5" role="list">
          {
            sidebar.items.map((item, index) => (
              <li class="flex gap-3 text-sm leading-relaxed text-muted-foreground">
                <span
                  class="font-heading text-sm font-semibold text-accent tabular-nums"
                  aria-hidden="true"
                >
                  {String(index + 1).padStart(2, '0')}
                </span>
                <span>{item}</span>
              </li>
            ))
          }
        </ol>
        <p class="mt-5 text-sm leading-relaxed text-foreground/85">{sidebar.note}</p>
        <p class="mt-3 text-xs leading-relaxed text-subtle-foreground">
          Protected by Cloudflare Turnstile; delivered through Cloudflare Email Service.
        </p>
      </div>
    </div>

    <div class="border border-border/50 bg-background p-5 sm:p-7 lg:p-8">
      <div
        class="mb-6 flex flex-col gap-1.5 border-b border-border/50 pb-5 sm:flex-row sm:items-end sm:justify-between"
      >
        <div>
          <p class="font-heading text-xl font-semibold tracking-tight text-foreground">
            Project inquiry
          </p>
          <p class="mt-1 text-sm text-muted-foreground">All fields are required.</p>
        </div>
        <p class="text-xs font-semibold tracking-tight text-success-emphasis">
          Cloudflare delivery
        </p>
      </div>

      <div
        id="form-status"
        role="status"
        aria-live="polite"
        aria-atomic="true"
        tabindex="-1"
        class="mb-5 hidden text-sm font-semibold"
      >
      </div>

      <form
        id="contact-form"
        method="POST"
        action="/send-email"
        class="space-y-5"
        aria-describedby="contact-form-help"
      >
        <FormField id="form-name" type="hidden" label="form-name-hidden" value="contact" />
        <p class="sr-only" aria-hidden="true">
          <label for="bot-field" class="sr-only">Don&apos;t fill this out</label>
          <input
            id="bot-field"
            name="bot-field"
            type="hidden"
            aria-hidden="true"
            tabindex="-1"
            aria-label="bot-field-hidden"
          />
        </p>
        <p id="contact-form-help" class="sr-only">
          All fields are required. Your message is protected by Cloudflare Turnstile and delivered
          through Cloudflare Email Service.
        </p>

        <div class="grid gap-5 sm:grid-cols-2">
          <FormField
            id="name"
            label="Name"
            type="text"
            required
            autocomplete="name"
            minlength={2}
            maxlength={100}
            placeholder="Your name"
          />

          <FormField
            id="email"
            label="Work email"
            type="email"
            required
            autocomplete="email"
            maxlength={254}
            placeholder="you@company.com"
          />
        </div>

        <FormField
          id="message"
          label="What bottleneck should we attack first?"
          type="textarea"
          required
          rows={6}
          minlength={10}
          maxlength={2000}
          placeholder="Describe the problem, the systems or teams involved, and the outcome you need."
          helpText="10 character minimum · 2,000 character maximum"
        />

        <div class="-mt-4 flex justify-end text-xs text-subtle-foreground" aria-live="polite">
          <span id="message-count">0</span><span aria-hidden="true"> / 2,000</span><span
            class="sr-only"
          >
            characters used</span
          >
        </div>

        <div class="border-t border-border/50 pt-5">
          <div
            id="turnstile-shell"
            class="relative grid min-h-[65px] w-full overflow-hidden border border-border/50 bg-surface-subtle/40 transition-[min-height,border-color,background-color] duration-normal data-[turnstile-state=error]:border-error/40 data-[turnstile-state=interactive]:bg-background data-[turnstile-state=verified]:border-success/30"
            data-turnstile-state="idle"
          >
            <div
              id="turnstile-placeholder"
              class="col-start-1 row-start-1 flex h-[65px] items-center gap-3 px-4 transition-opacity"
            >
              <span
                class="flex size-9 shrink-0 items-center justify-center border border-accent/25 bg-accent-subtle text-accent"
                aria-hidden="true"
              >
                <svg class="size-4" viewBox="0 0 24 24" fill="none">
                  <path
                    d="M12 3 5 6v5c0 4.6 2.9 8.2 7 10 4.1-1.8 7-5.4 7-10V6l-7-3Z"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linejoin="round"></path>
                  <path
                    d="m9 12 2 2 4-4"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linecap="round"
                    stroke-linejoin="round"></path>
                </svg>
              </span>
              <span class="min-w-0">
                <span
                  id="turnstile-status"
                  class="block text-sm font-semibold text-foreground"
                  aria-live="polite">Secure verification ready</span
                >
                <span class="mt-0.5 block text-xs text-muted-foreground"
                  >Protected by Cloudflare</span
                >
              </span>
            </div>
            <div
              id="turnstile-container"
              class="z-10 col-start-1 row-start-1 flex w-full min-w-0 items-start justify-start [&>iframe]:max-w-full"
              role="group"
              aria-label="Human verification challenge"
            >
            </div>
          </div>
        </div>

        <Button type="submit" variant="primary" size="lg" fullWidth>
          <span id="btn-label">Send brief · book a review</span>
          <svg
            id="spinner"
            class="hidden size-5 animate-spin"
            viewBox="0 0 24 24"
            aria-hidden="true"
            ><circle
              cx="12"
              cy="12"
              r="10"
              stroke="currentColor"
              stroke-width="3"
              fill="none"
              opacity=".3"></circle><path
              d="M22 12a10 10 0 0 0-10-10"
              stroke="currentColor"
              stroke-width="3"
              stroke-linecap="round"></path></svg
          >
        </Button>
        <p class="text-center text-xs leading-relaxed text-subtle-foreground">
          Your details are used to respond to your inquiry and protect this form from abuse.
        </p>
      </form>
    </div>
  </div>
</Section>
