---
/**
 * Contact brief — title, one next step, and the form.
 * A successful send replaces the form. A document POST error stays on this page.
 */
import Section from '@/components/primitives/Section.astro';
import FormField from '@/components/primitives/FormField.astro';
import Button from '@/components/primitives/Button.astro';
import IntroCopy from '@/components/composites/IntroCopy.astro';

interface Sidebar {
  heading: string;
  items: string[];
  note: string;
}

interface ContactBrief {
  kicker: string;
  title: string;
  description: string;
  scenarios: string[];
  sidebar: Sidebar;
}

interface Props {
  content: ContactBrief;
  sent?: boolean;
  errorMessage?: string;
}

const { content, sent = false, errorMessage } = Astro.props as Props;
const SUCCESS_MESSAGE = 'Your project brief was sent. I’ll review it and follow up by email.';
---

<Section
  id="contact-message-section"
  padding="lg"
  container="lg"
  background="surface"
  aria-labelledby="contact-title"
  data-chat-avoid-launcher
>
  <div class="mx-auto flex max-w-xl flex-col gap-8">
    <IntroCopy
      kicker={content.kicker}
      title={content.title}
      titleId="contact-title"
      description={content.description}
      size="section"
      descriptionSize="md"
    />

    {sent ? (
      <p
        id="form-status"
        role="status"
        tabindex="-1"
        class="border border-border/50 bg-background px-5 py-6 text-base leading-relaxed text-foreground"
      >
        {SUCCESS_MESSAGE}
      </p>
    ) : (
      <div class="border border-border/50 bg-background p-5 sm:p-7">
        {errorMessage ? (
          <p
            id="form-status"
            role="alert"
            tabindex="-1"
            class="mb-5 text-sm font-semibold text-error"
          >
            {errorMessage}
          </p>
        ) : (
          <div
            id="form-status"
            role="status"
            aria-live="polite"
            aria-atomic="true"
            tabindex="-1"
            class="mb-5 hidden text-sm font-semibold"
          />
        )}

        <form id="contact-form" method="POST" action="/send-email" class="space-y-5" novalidate>
          <FormField id="form-name" type="hidden" label="form-name-hidden" value="contact" />
          <p hidden>
            <input id="bot-field" name="bot-field" type="text" tabindex="-1" autocomplete="off" />
          </p>

          <div class="grid gap-5 sm:grid-cols-2">
            <FormField
              id="name"
              label="Name"
              type="text"
              required
              autocomplete="name"
              minlength={2}
              maxlength={100}
              placeholder="Your name"
            />

            <FormField
              id="email"
              label="Work email"
              type="email"
              required
              autocomplete="email"
              maxlength={254}
              placeholder="you@company.com"
            />
          </div>

          <FormField
            id="message"
            label="What bottleneck should we attack first?"
            type="textarea"
            required
            rows={6}
            minlength={10}
            maxlength={2000}
            placeholder="Describe the problem, the systems or teams involved, and the outcome you need."
          />

          <div
            id="turnstile-shell"
            class="min-h-0 data-[turnstile-state=error]:min-h-10 data-[turnstile-state=interactive]:min-h-[65px]"
            data-turnstile-state="idle"
          >
            <p
              id="turnstile-status"
              class="sr-only text-sm font-semibold text-error"
              aria-live="polite"
            ></p>
            <div
              id="turnstile-container"
              class="flex w-full min-w-0 items-start justify-start [&>iframe]:max-w-full"
              role="group"
              aria-label="Human verification challenge"
            />
          </div>

          <Button type="submit" variant="primary" size="lg" fullWidth>
            <span id="btn-label">Send project brief</span>
            <svg
              id="spinner"
              class="hidden size-5 animate-spin"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <circle
                cx="12"
                cy="12"
                r="10"
                stroke="currentColor"
                stroke-width="3"
                fill="none"
                opacity=".3"
              />
              <path
                d="M22 12a10 10 0 0 0-10-10"
                stroke="currentColor"
                stroke-width="3"
                stroke-linecap="round"
              />
            </svg>
          </Button>
          <p class="text-center text-sm leading-relaxed text-muted-foreground">
            I’ll review your brief and follow up by email about next steps.
          </p>
        </form>
      </div>
    )}
  </div>
</Section>

<style>
  #turnstile-shell[data-turnstile-state='error'] #turnstile-status {
    position: static;
    width: auto;
    height: auto;
    margin: 0 0 0.75rem;
    padding: 0;
    overflow: visible;
    clip: auto;
    clip-path: none;
    white-space: normal;
  }
</style>
