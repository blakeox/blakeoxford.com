---
import type { ContactChannels } from './types';

const { channels } = Astro.props as { channels: ContactChannels };

interface IconProps {
  name: string;
}

function Icon({ name }: IconProps) {
  switch (name) {
    case 'email':
      return '✉️';
    case 'phone':
      return '📞';
    case 'linkedin':
      return '💼';
    default:
      return '✨';
  }
}
---

<section class="w-full py-20 relative overflow-hidden bg-gradient-to-br from-background via-accent/5 to-background" aria-labelledby="contact-channels-heading">
  <div class="absolute inset-0 z-0 opacity-20 pointer-events-none" aria-hidden="true">
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_top,_rgba(13,148,136,0.15),_transparent_60%)]" />
  </div>

  <div class="relative z-10 container mx-auto px-6 sm:px-8 lg:px-12">
    <header class="flex flex-col items-center gap-3 text-center mb-12">
      <h2 id="contact-channels-heading" class="font-heading text-2xl sm:text-3xl md:text-4xl font-bold text-foreground dark:text-foreground-light">
        {channels.title}
      </h2>
    </header>

    <ul class="flex flex-col md:flex-row items-center justify-center gap-6" role="list">
      {channels.items.map((channel) => (
        <li>
          <a
            href={channel.href}
            target={channel.icon === 'linkedin' ? '_blank' : undefined}
            rel={channel.icon === 'linkedin' ? 'noopener noreferrer' : undefined}
            class="flex flex-col items-center gap-3 group focus:outline-none focus-visible:ring-2 focus-visible:ring-accent/60 focus-visible:ring-offset-2 p-4 rounded-xl hover:bg-accent/5 transition-colors"
            aria-label={channel.label}
            title={channel.label}
          >
            <span class="text-3xl text-accent group-hover:scale-110 transition-transform duration-200" aria-hidden="true">
              <Icon name={channel.icon} />
            </span>
            <span class="font-medium text-primary group-hover:text-accent transition-colors">
              {channel.label}
            </span>
            {channel.description && (
              <span class="text-sm text-foreground/70 dark:text-foreground-light/70 text-center max-w-sm">
                {channel.description}
              </span>
            )}
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>
