---
import navLinks from '../../../config/navLinks';

interface ProjectCard {
  title: string;
  [key: string]: unknown;
}

const projects: ProjectCard[] = [];
---

<form class="rounded-2xl border border-border/50 bg-background/95 px-4 py-3 text-sm shadow focus-within:ring-2 focus-within:ring-accent/40" role="search" action="/projects/" method="get">
  <label for="site-search" class="sr-only">Search site</label>
  <input
    id="site-search"
    name="q"
    type="search"
    class="w-full bg-transparent text-foreground placeholder:text-subtle-foreground/70 focus:outline-none"
    placeholder="Search pages or featured projects"
    list="search-suggestions"
  />
  <datalist id="search-suggestions">
    {navLinks.map((page) => <option value={page.label} />)}
    {projects?.map((card) => <option value={card.title} />)}
  </datalist>
</form>
