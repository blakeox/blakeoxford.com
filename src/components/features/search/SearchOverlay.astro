---
import SearchOverlayClient from '../../islands/SearchOverlayClient';
---

<div
  id="search-overlay"
  class="group fixed inset-0 z-[1200] flex opacity-0 transition duration-300 ease-out data-[state=closed]:pointer-events-none data-[state=open]:opacity-100"
  role="dialog"
  aria-modal="true"
  aria-labelledby="search-title"
  inert
  data-state="closed"
  data-a11y-allow-color-contrast
>
  <div class="absolute inset-0 cursor-pointer bg-background-dark/55 backdrop-blur-sm" data-overlay-backdrop></div>

  <div class="relative flex min-h-full w-full items-start justify-center px-4 pb-8 pt-16 sm:pt-20 lg:pt-24" data-overlay-container>
    <div class="overlay-panel w-full max-w-3xl translate-y-6 rounded-3xl border border-border/60 bg-surface/95 shadow-2xl backdrop-blur-xl transition-transform duration-300 ease-out group-data-[state=open]:translate-y-0 dark:bg-surface-dark/95" data-panel>
      <div class="flex items-center justify-between gap-3 border-b border-border/60 px-5 py-4">
        <div id="search-title" class="text-lg font-semibold text-foreground dark:text-foreground-light">Search</div>
        <button
          id="close-search"
          class="inline-flex size-10 items-center justify-center rounded-xl border border-border/80 bg-surface text-foreground transition hover:border-border focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-surface dark:border-border-dark/70 dark:bg-surface-dark"
          aria-label="Close search"
        >
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

      <div class="px-6 py-6">
        <form class="flex flex-col gap-6" autocomplete="off" data-search-form>
          <div class="flex flex-col gap-3">
            <label class="text-sm font-medium text-foreground/80 dark:text-foreground-light/70">Search in</label>
            <div class="flex flex-wrap gap-2" data-search-category-group>
              <button type="button" class="search-pill" data-category="all" data-active>All</button>
              <button type="button" class="search-pill" data-category="projects">Projects</button>
              <button type="button" class="search-pill" data-category="pages">Pages</button>
            </div>
          </div>

          <div class="flex flex-col gap-2" data-search-input-group>
            <label for="search-input" class="flex items-center justify-between text-sm font-medium text-foreground/80 dark:text-foreground-light/70">
              <span>What are you looking for?</span>
              <kbd class="hidden rounded-full border border-border px-2 py-1 text-xs font-sans text-foreground/60 sm:inline-flex">/ or Cmd+K</kbd>
            </label>

            <div class="group relative flex w-full items-center gap-3 rounded-xl border border-border/60 bg-background px-4 py-3 shadow-sm focus-within:border-accent/60 focus-within:ring-2 focus-within:ring-accent/40 dark:border-border-dark/60 dark:bg-surface-dark">
              <svg class="size-5 text-foreground/50" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.8-4.8M10.5 18a7.5 7.5 0 1 1 0-15 7.5 7.5 0 0 1 0 15Z" />
              </svg>
              <input
                id="search-input"
                type="text"
                class="peer flex-1 bg-transparent text-base text-foreground placeholder:text-foreground/40 focus:outline-none dark:text-foreground-light"
                placeholder="Type to search..."
                aria-label="Search input"
                autocomplete="off"
                spellcheck="false"
                aria-expanded="false"
                aria-controls="search-results"
                role="combobox"
              />
              <button type="button" id="voice-search" class="hidden items-center gap-2 rounded-lg border border-border/60 px-3 py-2 text-sm text-foreground/70 transition hover:border-accent hover:text-accent focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent/60 sm:inline-flex">
                <svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 19a7 7 0 0 0 7-7V9a7 7 0 1 0-14 0v3a7 7 0 0 0 7 7Zm0 0v3m-4 0h8" />
                </svg>
                <span class="hidden text-xs uppercase tracking-wide text-foreground/60 lg:block">Voice</span>
              </button>
            </div>
            <p class="text-xs text-foreground/60 dark:text-foreground-light/60">Quick ideas: “Microsoft Fabric”, “Power BI dashboards”, “Contact”</p>
          </div>

          <div id="search-results" class="hidden flex-col gap-3" role="listbox" aria-label="Search results" data-results>
            <div class="max-h-[26rem] overflow-y-auto rounded-2xl border border-border/60 bg-surface/95 p-2 shadow-inner dark:border-border-dark/70 dark:bg-surface-dark/90" data-results-container></div>
          </div>

          <div class="flex flex-col gap-2 rounded-2xl border border-dashed border-border/60 bg-surface/60 p-4 text-sm text-foreground/70 dark:border-border-dark/60 dark:bg-surface-dark/40 dark:text-foreground-light/70">
            <p class="flex items-center gap-2"><span aria-hidden="true">💡</span><span>Use keywords like “automation”, “AI coaching”, or “cloud rollout”.</span></p>
            <p class="flex items-center gap-2"><span aria-hidden="true">🧭</span><span>Press <kbd class="rounded border border-border px-2 py-1 text-xs">Esc</kbd> to close.</span></p>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>

<SearchOverlayClient client:load />
