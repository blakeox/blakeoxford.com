---
import type { CollectionEntry } from 'astro:content';
import Section from '../../primitives/Section.astro';
import Stack from '../../primitives/Stack.astro';
import Flex from '../../primitives/Flex.astro';
import Button from '../../primitives/Button.astro';
import Badge from '../../primitives/Badge.astro';
import BaseCard from '../../primitives/BaseCard.astro';
import { BlogPostRow } from './index';

interface Props {
  posts: CollectionEntry<'blog'>[];
}

const { posts } = Astro.props as Props;
---

{
  posts.length > 0 && (
    <Section padding="md" container="lg" class="border-t border-border/20 bg-surface-subtle/40">
      <Flex responsive="sm" gap="md" justify="between" align="center">
        <Flex wrap gap="sm" align="center">
          <Badge variant="pill" size="xs" class="w-fit">
            {posts.length} {posts.length === 1 ? 'Article' : 'Articles'}
          </Badge>
          <p class="text-sm leading-relaxed text-muted-foreground">
            Field notes and implementation breakdowns
          </p>
        </Flex>
        <Flex gap="sm" align="center">
          <Button variant="ghost" as="button" data-ai-launcher data-ai-action="open">
            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M21 21l-4.8-4.8M10.5 18a7.5 7.5 0 1 1 0-15 7.5 7.5 0 0 1 0 15Z"
              />
            </svg>
            Search articles
          </Button>
        </Flex>
      </Flex>
    </Section>
  )
}

<Section
  padding="lg"
  container="lg"
  class="border-t border-border/20 bg-background"
  role="region"
  aria-labelledby="blog-posts-heading"
>
  <Stack space="xl" class="text-pretty">
    {
      posts.length > 0 && (
        <Stack space="md" class="max-w-3xl">
          <span class="section-kicker w-fit">Archive</span>
          <h2
            id="blog-posts-heading"
            class="font-heading text-2xl font-semibold text-foreground sm:text-3xl md:text-4xl"
          >
            Latest insights
          </h2>
          <p class="text-sm leading-relaxed text-muted-foreground sm:text-base">
            Practical takeaways from real implementations, strategic initiatives, and operational
            cleanup work.
          </p>
        </Stack>
      )
    }
    <Stack space="xl">
      {
        posts.length > 0 ? (
          posts.map((post, index) => (
            <BlogPostRow post={post} align={index % 2 === 0 ? 'left' : 'right'} />
          ))
        ) : (
          <BaseCard variant="elevated" hover="none" rounded="3xl" padding="lg" class="text-center">
            <h2 class="mb-4 font-heading text-2xl font-semibold text-foreground sm:text-3xl">
              Articles are on the way
            </h2>
            <p class="text-sm leading-relaxed text-muted-foreground">
              Check back soon for breakdowns of recent programs, playbooks, and technical deep
              dives.
            </p>
          </BaseCard>
        )
      }
    </Stack>
  </Stack>
</Section>
