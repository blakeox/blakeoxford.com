---
import type { CollectionEntry } from 'astro:content';
import Section from '@/components/primitives/Section.astro';
import Stack from '@/components/primitives/Stack.astro';
import BaseCard from '@/components/primitives/BaseCard.astro';
import { BlogPostRow } from './index';
import { headingSizeClass } from '@/lib/typeScale';

interface Props {
  posts: CollectionEntry<'blog'>[];
}

const { posts } = Astro.props as Props;
---

<Section
  padding="lg"
  container="lg"
  class="border-t border-border/20 bg-background"
  role="region"
  aria-labelledby="blog-posts-heading"
>
  <Stack space="xl" class="text-pretty">
    {posts.length > 0 && (
      <h2 id="blog-posts-heading" class="section-kicker w-fit">
        Archive
      </h2>
    )}
    <Stack space="xl">
      {posts.length > 0 ? (
        posts.map((post, index) => (
          <BlogPostRow post={post} align={index % 2 === 0 ? 'left' : 'right'} />
        ))
      ) : (
        <BaseCard variant="elevated" hover="none" rounded="2xl" padding="lg" class="text-center">
          <h2
            class:list={[
              'mb-4 font-heading font-semibold text-foreground',
              headingSizeClass('title'),
            ]}
          >
            Articles are on the way
          </h2>
          <p class="text-sm leading-relaxed text-muted-foreground">
            Check back soon for breakdowns of recent programs, playbooks, and technical deep dives.
          </p>
        </BaseCard>
      )}
    </Stack>
  </Stack>
</Section>
