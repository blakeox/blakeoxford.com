---
import type { CollectionEntry } from 'astro:content';
import Section from '../../primitives/Section.astro';
import Stack from '../../primitives/Stack.astro';
import Flex from '../../primitives/Flex.astro';
import Button from '../../primitives/Button.astro';
import BadgePill from '../../primitives/BadgePill.astro';
import { BlogPostRow } from './index';

interface Props {
  posts: CollectionEntry<'blog'>[];
}

const { posts } = Astro.props as Props;
---

{posts.length > 0 && (
  <Section padding="md" container="lg" class="border-t border-border/20 bg-surface-subtle/40">
    <Flex responsive="sm" gap="md" justify="between" align="center">
      <Flex wrap gap="sm" align="center">
        <BadgePill size="xs" class="w-fit">
          {posts.length} {posts.length === 1 ? 'Article' : 'Articles'}
        </BadgePill>
        <p class="text-sm leading-relaxed text-muted-foreground">
          Latest insights and deep dives
        </p>
      </Flex>
      <Flex gap="sm" align="center">
        <Button variant="ghost" as="button" data-ai-launcher data-ai-action="open">
          <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-4.8-4.8M10.5 18a7.5 7.5 0 1 1 0-15 7.5 7.5 0 0 1 0 15Z" />
          </svg>
          Search articles
        </Button>
      </Flex>
    </Flex>
  </Section>
)}

<Section padding="lg" container="lg" class="border-t border-border/20 bg-background" role="region" aria-labelledby="blog-posts-heading">
  <Stack space="xl" class="text-pretty">
    {posts.length > 0 && (
      <Stack space="md" class="max-w-3xl">
        <h2 id="blog-posts-heading" class="font-heading text-2xl font-semibold text-foreground sm:text-3xl md:text-4xl">
          Latest Insights
        </h2>
        <p class="text-sm leading-relaxed text-muted-foreground sm:text-base">
          Practical takeaways from real-world implementations and strategic initiatives.
        </p>
      </Stack>
    )}
    <Stack space="xl">
      {posts.length > 0 ? (
        posts.map((post, index) => (
          <BlogPostRow post={post} align={index % 2 === 0 ? 'left' : 'right'} />
        ))
      ) : (
        <div class="rounded-3xl bg-surface/95 p-12 text-center shadow-lg ring-1 ring-border/30">
          <h2 class="mb-4 font-heading text-2xl font-semibold text-foreground sm:text-3xl">Articles are on the way</h2>
          <p class="text-sm leading-relaxed text-muted-foreground">
            Check back soon for breakdowns of recent programs, playbooks, and technical deep dives.
          </p>
        </div>
      )}
    </Stack>
  </Stack>
</Section>
