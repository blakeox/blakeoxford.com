---
// BlogCard.astro - Compact card for grid layouts
import OptimizedImage from '../../ui/OptimizedImage.astro';
import { formatDateISO, formatDateBlog, truncate } from '../../../utils/index.js';

interface BlogCardProps {
  post: any;
}

const { post } = Astro.props as BlogCardProps;
const { slug, data } = post;
---
<article class="group flex flex-col h-full rounded-2xl border border-border/30 bg-background/95 shadow-lg transition-all duration-200 hover:-translate-y-1 hover:shadow-xl dark:border-border-dark/30 dark:bg-surface/80">
  <!-- Hero Image -->
  {data.heroImage && (
    <div class="aspect-[16/10] overflow-hidden rounded-t-2xl">
      <OptimizedImage 
        src={data.heroImage} 
        alt={`Hero image for ${data.title}`}
        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
        loading="lazy"
      />
    </div>
  )}
  
  <!-- Content -->
  <div class="flex flex-1 flex-col p-6">
    <header class="mb-4">
      <!-- Tags -->
      {data.tags && Array.isArray(data.tags) && data.tags.length > 0 && (
        <div class="flex flex-wrap gap-2 mb-3">
          {data.tags.slice(0, 2).map((tag: string) => (
            <span class="inline-flex items-center px-2 py-1 text-xs font-medium rounded-full border bg-surface text-foreground dark:bg-surface-dark dark:text-foreground-light border-border/40 dark:border-border-dark/40">
              {tag}
            </span>
          ))}
        </div>
      )}
      
      <!-- Title -->
      <h3 class="text-xl sm:text-2xl font-bold text-foreground dark:text-foreground-light leading-tight mb-3 group-hover:text-accent dark:group-hover:text-accent-light transition-colors duration-300">
        <a href={`/blog/${slug}/`} class="hover:underline focus:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-background">
          {data.title}
        </a>
      </h3>

      <!-- Date -->
      {data.pubDate && (
                <time class="inline-flex items-center text-sm text-foreground/70 dark:text-foreground-light/70 font-medium" datetime={formatDateISO(data.pubDate)}>
          <svg class="mr-1.5" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
            <line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line>
          </svg>
          {formatDateBlog(data.pubDate)}
        </time>
      )}
    </header>

    <!-- Description -->
    {data.description && (
      <p class="text-foreground/80 dark:text-foreground-light/80 leading-relaxed flex-1 mb-4 line-clamp-3">
              <p class="text-base text-foreground/80 dark:text-foreground-light/80 leading-relaxed">
        {truncate(data.description, 120)}
      </p>
      </p>
    )}

    <!-- Footer -->
    <footer class="flex items-center justify-between pt-4 border-t border-border/20 dark:border-border-dark/20">
      <a
        href={`/blog/${slug}/`}
        class="inline-flex items-center text-sm font-semibold text-accent hover:text-accent-dark transition-colors duration-200"
      >
        Read more
        <svg class="w-4 h-4 ml-1 group-hover:translate-x-1 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
      </a>

      <span class="text-xs text-foreground/60 dark:text-foreground-light/60">
        5 min read
      </span>
    </footer>
  </div>
</article>