---
// BlogCard.astro - Compact card for grid layouts using primitives
import type { BlogCardProps } from '../../../types/components';
import OptimizedImage from '../../primitives/OptimizedImage.astro';
import Badge from '../../primitives/Badge.astro';
import DateDisplay from '../../primitives/DateDisplay.astro';
import Flex from '../../primitives/Flex.astro';
import { truncate, take } from '../../../utils/index.js';

const { post } = Astro.props as BlogCardProps;
const { slug, data } = post;
const visibleTags = data.tags && Array.isArray(data.tags) ? take(data.tags as string[], 2) : [];
---

<article class="hover-lift group flex flex-col h-full rounded-2xl border border-border/30 bg-background/95 shadow-lg hover:shadow-primary/5 dark:border-border-dark/30 dark:bg-surface/80">
  <!-- Hero Image -->
  {data.heroImage && (
    <div class="aspect-[16/10] overflow-hidden rounded-t-2xl">
      <OptimizedImage 
        src={data.heroImage} 
        alt={`Hero image for ${data.title}`}
        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
        loading="lazy"
      />
    </div>
  )}
  
  <!-- Content -->
  <div class="flex flex-1 flex-col p-6">
    <header class="mb-4">
      <!-- Tags -->
      {visibleTags.length > 0 && (
        <Flex wrap gap="xs" class="mb-3">
          {visibleTags.map((tag: string) => (
            <Badge variant="secondary">{tag}</Badge>
          ))}
        </Flex>
      )}
      
      <!-- Title -->
      <h3 class="text-xl sm:text-2xl font-bold text-foreground dark:text-foreground-light leading-tight mb-3 group-hover:text-accent dark:group-hover:text-accent-light transition-colors duration-300">
        <a href={`/blog/${slug}/`} class="hover:underline focus:outline-none focus-visible:ring-2 focus-visible:ring-accent/60 focus-visible:ring-offset-2 focus-visible:ring-offset-background">
          {data.title}
        </a>
      </h3>

      <!-- Date -->
      {data.pubDate && <DateDisplay date={data.pubDate} format="blog" />}
    </header>

    <!-- Description -->
    {data.description && (
      <p class="text-base text-foreground/80 dark:text-foreground-light/80 leading-relaxed flex-1 mb-4 line-clamp-3">
        {truncate(data.description, 120)}
      </p>
    )}

    <!-- Footer -->
    <footer class="flex items-center justify-between pt-4 border-t border-border/20 dark:border-border-dark/20">
      <a
        href={`/blog/${slug}/`}
        class="inline-flex items-center text-sm font-semibold text-accent hover:text-accent-dark transition-colors duration-200"
      >
        Read more
        <svg class="w-4 h-4 ml-1 group-hover:translate-x-1 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
      </a>

      <span class="text-xs text-foreground/60 dark:text-foreground-light/60">
        5 min read
      </span>
    </footer>
  </div>
</article>
