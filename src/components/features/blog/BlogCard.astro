---
// BlogCard.astro - Compact card for grid layouts using Card → BaseCard
import type { BlogCardProps } from '../../../types/components';
import OptimizedImage from '../../primitives/OptimizedImage.astro';
import Badge from '../../primitives/Badge.astro';
import DateDisplay from '../../primitives/DateDisplay.astro';
import Flex from '../../primitives/Flex.astro';
import Card from '../../composites/Card.astro';
import { truncate, take } from '../../../utils/index.js';

const { post } = Astro.props as BlogCardProps;
const { id: slug, data } = post;
const visibleTags = data.tags && Array.isArray(data.tags) ? take(data.tags as string[], 2) : [];
---

<Card as="article" variant="default" hover="lift" padding="none" class="group h-full">
 {data.heroImage && (
 <div slot="image" class="aspect-[16/10] overflow-hidden rounded-t-2xl">
 <OptimizedImage 
 src={data.heroImage} 
 alt={`Hero image for ${data.title}`}
 class="h-full w-full object-cover group-hover:scale-105 transition-transform duration-500"
 loading="lazy"
 />
 </div>
 )}
 
 <div class="flex flex-1 flex-col p-6">
 <header class="mb-4">
 {visibleTags.length > 0 && (
 <Flex wrap gap="xs" class="mb-3">
 {visibleTags.map((tag: string) => (
 <Badge variant="secondary">{tag}</Badge>
 ))}
 </Flex>
 )}
 
 <h3 class="mb-3 text-xl font-bold leading-tight text-foreground transition-colors duration-300 group-hover:text-accent sm:text-2xl">
 <a href={`/blog/${slug}/`} class="hover:underline focus:outline-none focus-visible:ring-2 focus-visible:ring-accent/60 focus-visible:ring-offset-2 focus-visible:ring-offset-background">
 {data.title}
 </a>
 </h3>

 {data.pubDate && <DateDisplay date={data.pubDate} format="blog" />}
 </header>

 {data.description && (
 <p class="mb-4 line-clamp-3 flex-1 text-base leading-relaxed text-muted-foreground">
 {truncate(data.description, 120)}
 </p>
 )}

 <footer class="flex items-center justify-between border-t border-border/20 pt-4">
 <a
 href={`/blog/${slug}/`}
 class="inline-flex items-center text-sm font-semibold text-accent transition-colors duration-200 hover:text-accent-dark"
 >
 Read more
 <svg class="ml-1 h-4 w-4 transition-transform duration-200 group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
 <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
 </svg>
 </a>

 <span class="text-xs text-subtle-foreground">
 5 min read
 </span>
 </footer>
 </div>
</Card>
