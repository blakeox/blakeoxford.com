---
import PageHero from '../../composites/PageHero.astro';
---

<PageHero fullScreen={false} includeBlurOrbs={false} id="blog-hero">
  <div class="section-intro-left mx-auto max-w-3xl space-y-6">
    <span class="section-kicker">Writing</span>
    <h1
      class="font-heading text-4xl font-semibold tracking-tight text-foreground sm:text-5xl md:text-6xl lg:text-7xl"
    >
      Notes grounded in shipped work
    </h1>
    <p class="max-w-2xl text-lg leading-relaxed text-muted-foreground sm:text-xl">
      Automation, analytics, governance, and change programs translated into practical takeaways.
    </p>
  </div>
</PageHero>
