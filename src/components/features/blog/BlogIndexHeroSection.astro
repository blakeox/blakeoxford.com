---
import PageHero from '@/components/composites/PageHero.astro';
import IntroCopy from '@/components/composites/IntroCopy.astro';

interface Props {
  visual?: {
    src: string;
    caption: string;
    href: string;
  };
}

const { visual } = Astro.props as Props;
---

{visual ? (
  <section
    id="blog-hero"
    data-layout-section="blog-hero"
    class="relative flex min-h-[calc(100svh-var(--nav-height))] flex-col overflow-hidden md:grid md:grid-cols-2"
  >
    <div class="layout-gutter flex flex-col justify-center py-section-lg sm:py-section-xl lg:py-section-2xl">
      <IntroCopy
        kicker="Writing"
        title="Notes grounded in shipped work"
        description="Automation, analytics, governance, and change programs translated into practical takeaways."
        size="hero"
        class="max-w-xl"
      />
    </div>
    <a
      href={visual.href}
      class="relative min-h-72 overflow-hidden md:h-full"
      aria-label={visual.caption}
    >
      <img
        src={visual.src}
        alt=""
        width="960"
        height="1200"
        class="absolute inset-0 size-full object-cover"
      />
      <div
        class="pointer-events-none absolute inset-0 bg-gradient-to-t from-background/80 via-background/15 to-transparent md:bg-gradient-to-r md:from-background md:via-background/25 md:to-transparent"
        aria-hidden="true"
      ></div>
      <p class="absolute bottom-5 left-5 z-10 max-w-sm text-sm font-semibold text-foreground">
        {visual.caption}
      </p>
    </a>
  </section>
) : (
  <PageHero fullScreen={false} includeBlurOrbs={false} id="blog-hero">
    <IntroCopy
      kicker="Writing"
      title="Notes grounded in shipped work"
      description="Automation, analytics, governance, and change programs translated into practical takeaways."
      size="hero"
      class="mx-auto max-w-3xl"
    />
  </PageHero>
)}
