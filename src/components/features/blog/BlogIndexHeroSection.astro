---
import PageHero from '../../composites/PageHero.astro';
---

<PageHero fullScreen={false} includeBlurOrbs={true} id="blog-hero">
  <div class="section-intro mx-auto max-w-4xl space-y-6">
    <span class="section-kicker">Writing</span>
    <h1 class="font-heading text-4xl font-semibold tracking-tight text-foreground sm:text-5xl md:text-6xl lg:text-7xl">
      Practical writing grounded in shipped work
    </h1>
    <p class="text-lg leading-relaxed text-muted-foreground sm:text-xl md:text-2xl">
      Notes on automation, analytics, governance, and change programs translated into practical takeaways rather than abstract commentary.
    </p>
  </div>
</PageHero>
