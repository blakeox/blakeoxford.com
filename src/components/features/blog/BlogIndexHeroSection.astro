---
import PageHero from '../../composites/PageHero.astro';
---

<PageHero fullScreen={false} includeBlurOrbs={true} id="blog-hero">
  <div class="mx-auto max-w-4xl space-y-6 text-center">
    <h1 class="font-heading text-4xl font-bold tracking-tight text-foreground sm:text-5xl md:text-6xl lg:text-7xl">
      Fresh thinking, built on shipped work
    </h1>
    <p class="text-lg leading-relaxed text-muted-foreground sm:text-xl md:text-2xl">
      Every article explores real-world systems leadership, translating complex automation, data, and change programs into momentum you can measure.
    </p>
  </div>
</PageHero>
