---
import PageHero from '@/components/composites/PageHero.astro';
import IntroCopy from '@/components/composites/IntroCopy.astro';
import type { CollectionEntry } from 'astro:content';
import { formatDateISO, formatDateShort } from '@/utils/date';
import ArrowRightIcon from '@/components/primitives/icons/ArrowRightIcon.astro';
import { headingSizeClass } from '@/lib/typeScale';

interface Props {
  post?: CollectionEntry<'blog'>;
  imageSrc?: string;
}

const { post, imageSrc } = Astro.props as Props;
---

<PageHero fullScreen={false} includeBlurOrbs={false} id="blog-hero">
  <div class:list={['grid items-center gap-10 lg:gap-16', post && 'lg:grid-cols-2']}>
    <IntroCopy
      kicker="Writing"
      title="Notes on navigating AI"
      description="Practical perspectives on AI choices, trust, and adoption—and the systems work it takes to scale across the enterprise."
      size="hero"
    />
    {post && (
      <article aria-labelledby="latest-article-title">
        <a
          href={`/blog/${post.id}/`}
          class="group focus-ring-interactive flex flex-col gap-5 rounded-xl border border-border bg-surface p-4 transition-colors hover:border-accent/50"
          data-featured-article
        >
          {imageSrc && (
            <img
              src={imageSrc}
              alt=""
              width="960"
              height="600"
              loading="eager"
              decoding="async"
              fetchpriority="high"
              class="aspect-[16/10] w-full rounded-lg object-cover"
            />
          )}
          <div class="space-y-3 px-1 pb-1">
            <div class="flex flex-wrap items-center gap-x-4 gap-y-1 text-xs font-semibold tracking-label text-subtle-foreground uppercase">
              <p>Latest article</p>
              <time datetime={formatDateISO(post.data.pubDate)}>
                {formatDateShort(post.data.pubDate)}
              </time>
            </div>
            <h2
              id="latest-article-title"
              class:list={[
                'font-heading font-semibold tracking-tight text-foreground group-hover:text-accent-emphasis',
                headingSizeClass('title'),
              ]}
            >
              {post.data.title}
            </h2>
            <p class="text-sm leading-relaxed text-muted-foreground">{post.data.description}</p>
            <span class="inline-flex min-h-11 items-center text-sm font-semibold text-accent-emphasis">
              Read article <ArrowRightIcon class="ml-2" />
            </span>
          </div>
        </a>
      </article>
    )}
  </div>
</PageHero>
