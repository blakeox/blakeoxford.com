---
import PageHero from '@/components/composites/PageHero.astro';
import IntroCopy from '@/components/composites/IntroCopy.astro';

interface Props {
  visual?: {
    src: string;
    caption: string;
    href: string;
  };
}

const { visual } = Astro.props as Props;
---

<PageHero fullScreen={false} includeBlurOrbs={false} id="blog-hero">
  <div class="grid items-center gap-10 lg:grid-cols-2 lg:gap-16">
    <IntroCopy
      kicker="Writing"
      title="Notes on navigating AI"
      description="Practical perspectives on AI choices, trust, and adoption—and the systems work it takes to scale across the enterprise."
      size="hero"
    />
    {visual && (
      <a
        href={visual.href}
        class="group focus-ring-interactive flex flex-col gap-4 rounded-xl border border-border bg-surface p-4 transition-colors hover:border-accent/50"
      >
        <img
          src={visual.src}
          alt=""
          width="960"
          height="600"
          loading="eager"
          decoding="async"
          fetchpriority="high"
          class="aspect-[16/10] w-full rounded-lg object-cover"
        />
        <div class="space-y-2 px-1 pb-1">
          <p class="text-xs font-semibold tracking-smallcaps text-subtle-foreground uppercase">
            Latest article
          </p>
          <p class="font-heading text-lg font-semibold text-foreground group-hover:text-accent-emphasis">
            {visual.caption}
          </p>
          <span class="inline-flex min-h-11 items-center text-sm font-semibold text-accent-emphasis">
            Read article →
          </span>
        </div>
      </a>
    )}
  </div>
</PageHero>
