---
// BlogPostRow.astro
import OptimizedImage from '../../ui/OptimizedImage.astro';

interface BlogPostRowProps {
  post: any;
  align?: 'left' | 'right';
}

const { post, align = 'left' } = Astro.props as BlogPostRowProps;
const { slug, data } = post;
---
<article class={`group relative flex flex-col lg:flex-row items-start w-full gap-6 md:gap-8 lg:gap-12 xl:gap-16 overflow-hidden rounded-3xl bg-surface/95 ring-1 ring-border/30 shadow-lg transition-all duration-300 hover:-translate-y-1 hover:shadow-xl ${align === 'right' ? 'lg:flex-row-reverse' : ''}`}>
  <div class="pointer-events-none absolute inset-0 bg-gradient-to-br from-background/70 via-surface/85 to-background/65 opacity-0 transition-opacity duration-300 group-hover:opacity-100"></div>

  <!-- Hero Image Section -->
  {data.heroImage && (
    <div class="w-full lg:w-2/5 xl:w-1/2 flex-shrink-0">
      <div class="relative aspect-[16/10] lg:aspect-[4/3] xl:aspect-[16/10] overflow-hidden">
        <OptimizedImage
          src={data.heroImage}
          alt={`Hero image for ${data.title}`}
          class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.04]"
          loading="lazy"
        />
        <div class="absolute inset-x-0 bottom-0 h-24 bg-gradient-to-t from-background/95 via-background/75 to-transparent lg:hidden"></div>
      </div>
    </div>
  )}

  <!-- Content Section -->
  <div class={`relative z-[1] flex flex-1 flex-col gap-6 px-7 pb-8 pt-7 sm:px-8 ${!data.heroImage ? 'w-full' : ''}`}>
    <div class="space-y-4">
      <div class="flex flex-wrap items-center gap-3 text-xs font-semibold uppercase tracking-label text-foreground/55 dark:text-foreground-light/65">
        {data.pubDate && (
          <time class="inline-flex items-center" datetime={new Date(data.pubDate).toISOString()}>
            {new Date(data.pubDate).toLocaleDateString(undefined, { month: 'short', year: 'numeric' })}
          </time>
        )}
      </div>

      <h2 class="text-pretty font-heading text-2xl sm:text-3xl lg:text-4xl font-semibold text-foreground dark:text-foreground-light leading-tight group-hover:text-accent dark:group-hover:text-accent-light transition-colors duration-300">
        <a href={`/blog/${slug}/`} class="hover:underline focus:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-background">
          {data.title}
        </a>
      </h2>

      {data.description && (
        <p class="text-sm leading-relaxed text-foreground/80 dark:text-foreground-light/80 [display:-webkit-box] [-webkit-line-clamp:4] [-webkit-box-orient:vertical] overflow-hidden">
          {data.description}
        </p>
      )}
    </div>

    {data.tags && Array.isArray(data.tags) && data.tags.length > 0 && (
      <ul class="flex flex-wrap items-center gap-2 text-xxs font-semibold uppercase tracking-wide text-foreground/60 dark:text-foreground-light/65" aria-label="Post tags">
        {data.tags.slice(0, 3).map((tag: string) => (
          <li class="rounded-full bg-surface-subtle px-3 py-1 ring-1 ring-border/30 dark:bg-surface-dark-subtle">
            <span>{tag}</span>
          </li>
        ))}
        {data.tags.length > 3 && (
          <li class="rounded-full bg-surface-subtle px-3 py-1 ring-1 ring-border/25 text-foreground/55 dark:bg-surface-dark-subtle dark:text-foreground-light/60">
            +{data.tags.length - 3}
          </li>
        )}
      </ul>
    )}

    <div class="mt-auto flex items-center justify-between gap-4">
      <span class="text-xs font-semibold uppercase tracking-label text-foreground/55 dark:text-foreground-light/65">
        Read article
      </span>
      <a
        href={`/blog/${slug}/`}
  class="inline-flex items-center gap-2 rounded-full bg-accent px-6 py-3 text-sm font-semibold text-on-accent transition-colors duration-200 group-hover:bg-accent-light dark:group-hover:bg-accent-dark focus:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2"
      >
        Explore
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          width="18"
          height="18"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="opacity-90"
          aria-hidden="true"
        >
          <path d="M5 12h14m-6-6 6 6-6 6" />
        </svg>
      </a>
    </div>
  </div>
</article>
