---
// BlogPostRow.astro
import type { BlogPostRowProps } from '@/types/components';
import OptimizedImage from '@/components/primitives/OptimizedImage.astro';
import Flex from '@/components/primitives/Flex.astro';
import Button from '@/components/primitives/Button.astro';
import Badge from '@/components/primitives/Badge.astro';
import BaseCard from '@/components/primitives/BaseCard.astro';
import GradientOverlay from '@/components/primitives/GradientOverlay.astro';
import ArrowRightIcon from '@/components/primitives/icons/ArrowRightIcon.astro';
import { formatDateISO, formatDateShort } from '@/utils/index.js';
import { cn } from '@/utils/cn';
import { headingSizeClass } from '@/lib/typeScale';

const { post, align = 'left' } = Astro.props as BlogPostRowProps;
const { id: slug, data } = post;
---

<BaseCard
  as="article"
  variant="elevated"
  hover="lift"
  rounded="3xl"
  padding="none"
  class="w-full overflow-hidden"
>
  <GradientOverlay variant="hover-card" direction="br" />

  <div
    class={cn(
      'relative z-[1] flex w-full flex-col items-start gap-6 md:gap-8 lg:flex-row lg:gap-12 xl:gap-16',
      align === 'right' && 'lg:flex-row-reverse'
    )}
  >
    {
      data.heroImage && (
        <div class="w-full flex-shrink-0 lg:w-2/5 xl:w-1/2">
          <div class="relative aspect-[16/10] overflow-hidden lg:aspect-[4/3] xl:aspect-[16/10]">
            <OptimizedImage
              src={data.heroImage}
              alt={`Hero image for ${data.title}`}
              class="h-full w-full object-cover transition-transform duration-slow group-hover:scale-[1.04]"
              loading="lazy"
            />
            <GradientOverlay variant="image-fade" direction="t" class="lg:hidden" />
          </div>
        </div>
      )
    }

    <div
      class={cn(
        'relative z-[1] flex flex-1 flex-col gap-6 px-7 pt-7 pb-8 sm:px-8',
        !data.heroImage && 'w-full'
      )}
    >
      <div class="space-y-4">
        <Flex
          wrap
          align="center"
          gap="sm"
          class="text-xs font-semibold tracking-label text-subtle-foreground uppercase"
        >
          {
            data.pubDate && (
              <time class="inline-flex items-center" datetime={formatDateISO(data.pubDate)}>
                {formatDateShort(data.pubDate)}
              </time>
            )
          }
        </Flex>

        <h2
          class:list={[
            'font-heading font-semibold text-pretty text-foreground transition-colors duration-moderate group-hover:text-accent-emphasis',
            headingSizeClass('section'),
          ]}
        >
          <a
            href={`/blog/${slug}/`}
            class="hover:underline focus:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-background"
          >
            {data.title}
          </a>
        </h2>

        {
          data.description && (
            <p class="[display:-webkit-box] overflow-hidden text-sm leading-relaxed text-muted-foreground [-webkit-box-orient:vertical] [-webkit-line-clamp:4]">
              {data.description}
            </p>
          )
        }
      </div>

      {
        data.tags && Array.isArray(data.tags) && data.tags.length > 0 && (
          <Flex
            as="ul"
            wrap
            align="center"
            gap="xs"
            class="text-xxs font-semibold tracking-wide text-subtle-foreground uppercase"
            aria-label="Post tags"
          >
            {data.tags.slice(0, 3).map((tag: string) => (
              <li>
                <Badge variant="pill" size="xs">
                  {tag}
                </Badge>
              </li>
            ))}
            {data.tags.length > 3 && (
              <li>
                <Badge variant="pill" size="xs" class="text-subtle-foreground">
                  +{data.tags.length - 3}
                </Badge>
              </li>
            )}
          </Flex>
        )
      }

      <div class="mt-auto flex items-center justify-between gap-4">
        <span class="text-xs font-semibold tracking-label text-subtle-foreground uppercase">
          Read article
        </span>
        <Button variant="outline" href={`/blog/${slug}/`}>
          Explore
          <ArrowRightIcon class="opacity-90" />
        </Button>
      </div>
    </div>
  </div>
</BaseCard>
