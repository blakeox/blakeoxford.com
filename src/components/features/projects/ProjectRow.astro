---
// ProjectRow.astro - Modern Tailwind v4 + Astro 5 implementation
// import type { CollectionEntry } from 'astro:content';
// TODO: Use correct type from astro:content when available

interface Props {
  project: any; // fallback to any due to type issues
  featured?: boolean;
  align?: 'left' | 'right';
}

const { project, featured = false, align = 'left' } = Astro.props as Props;
const { slug, data } = project;

// Generate semantic alt text for project images
const imageAlt = data.image 
  ? `Screenshot of ${data.title} project interface` 
  : `Blake Oxford logo representing ${data.title} project`;
---

<article 
  class={`project-row group relative w-full min-h-[340px] @container ${featured ? 'featured' : ''}`}
  data-align={align}
>
  <div class="project-layout grid grid-cols-1 @lg:grid-cols-12 gap-8 @lg:gap-12 @xl:gap-16 items-center">
    
    <!-- Project Media Section -->
    <div class={`project-media @lg:col-span-5 ${align === 'right' ? '@lg:order-2' : '@lg:order-1'}`}>
      <a 
        href={`/projects/${slug}/`} 
        class="project-image-link block group-focus-within:ring-2 group-focus-within:ring-accent group-focus-within:ring-offset-2 rounded-2xl overflow-hidden transition-all duration-300 hover:scale-105 focus-visible:outline-none focus-visible:scale-105"
        aria-label={`View detailed case study: ${data.title}`}
      >
        <div class="relative aspect-[16/9] overflow-hidden bg-surface dark:bg-surface-dark">
          {featured && (
            <div class="featured-badge absolute top-4 left-4 z-10 bg-accent text-accent-light text-xs font-bold px-3 py-1.5 rounded-full shadow-lg backdrop-blur-sm border border-accent-light/20">
              Featured
            </div>
          )}
          
          <img
            src={data.image || '/assets/images/blake-logo-fallback.png'}
            alt={imageAlt}
            width="640"
            height="360"
            class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110"
            loading="lazy"
            decoding="async"
          />
          
          <!-- Hover overlay -->
          <div class="project-overlay absolute inset-0 bg-gradient-to-t from-foreground/80 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-end p-6">
            <span class="text-white text-sm font-medium">View case study →</span>
          </div>
        </div>
      </a>
    </div>

    <!-- Project Content Section -->
    <div class={`project-content @lg:col-span-7 ${align === 'right' ? '@lg:order-1' : '@lg:order-2'} space-y-4 @lg:space-y-6`}>
      
      <!-- Header with title and date -->
      <header class="project-header space-y-3">
        <h2 class="project-title text-2xl @md:text-3xl @lg:text-4xl font-heading font-bold text-foreground dark:text-foreground-light leading-tight">
          <a 
            href={`/projects/${slug}/`} 
            class="hover:text-accent dark:hover:text-accent-light transition-colors duration-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 rounded-sm"
          >
            {data.title}
          </a>
        </h2>
        
        {data.date && (
          <time 
            class="project-date block text-sm @md:text-base text-foreground/70 dark:text-foreground-light/70 font-medium" 
            datetime={data.date.toISOString()}
          >
            {data.date.toLocaleDateString(undefined, { 
              year: 'numeric', 
              month: 'long', 
              day: 'numeric' 
            })}
          </time>
        )}
      </header>
      
      <!-- Tags section -->
      {data.tags && Array.isArray(data.tags) && data.tags.length > 0 && (
        <div class="project-tags" role="group" aria-label="Project technologies">
          <div class="flex flex-wrap gap-2 max-w-full overflow-hidden">
            {data.tags.slice(0, 5).map((tag: string) => (
              <span class="tag inline-flex items-center bg-accent/10 dark:bg-accent/15 text-foreground dark:text-foreground-light border border-accent/20 dark:border-accent/25 text-xs @md:text-sm font-medium px-3 py-1.5 rounded-full transition-colors duration-200 hover:bg-accent/20 dark:hover:bg-accent/25">
                {tag}
              </span>
            ))}
            {data.tags.length > 5 && (
              <span class="tag-more inline-flex items-center text-foreground/60 dark:text-foreground-light/60 text-xs @md:text-sm font-medium px-2 py-1.5 rounded-full">
                +{data.tags.length - 5} more
              </span>
            )}
          </div>
        </div>
      )}
      
      <!-- Description -->
      {data.description && (
        <div class="project-description">
          <p class="text-foreground dark:text-foreground-light text-base @md:text-lg leading-relaxed line-clamp-3 @lg:line-clamp-4">
            {data.description.length > 180 
              ? `${data.description.slice(0, 177)}...` 
              : data.description
            }
          </p>
          {data.description.length > 180 && (
            <a 
              href={`/projects/${slug}/`} 
              class="read-more inline-flex items-center mt-2 text-accent dark:text-accent-light text-sm font-medium hover:text-accent-dark dark:hover:text-accent transition-colors duration-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-1 rounded-sm"
              aria-label={`Read full description of ${data.title}`}
            >
              Read more about this project
              <svg class="ml-1 w-4 h-4 transition-transform duration-200 group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
              </svg>
            </a>
          )}
        </div>
      )}
      
      <!-- Call to Action -->
      <div class="project-cta mt-auto pt-4">
        <a
          href={`/projects/${slug}/`}
          class="btn-primary inline-flex items-center justify-center gap-2 bg-accent hover:bg-accent-dark dark:hover:bg-accent-light text-white dark:text-foreground font-semibold px-6 py-3 @md:px-8 @md:py-4 rounded-xl shadow-md hover:shadow-lg transform hover:scale-105 transition-all duration-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 min-h-[44px]"
          aria-label={`View detailed case study for ${data.title}`}
        >
          <span>View Case Study</span>
          <svg class="w-5 h-5 transition-transform duration-200 group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
      </div>
      
    </div>
  </div>
</article>

<style>
  /* Modern Tailwind v4 + Container Queries Implementation */
  .project-row {
    /* Enhanced card styling with modern shadow layers */
    background: rgb(var(--color-surface) / 1);
    border-radius: 1.5rem;
    box-shadow: 
      0 1px 3px 0 rgb(0 0 0 / 0.1),
      0 1px 2px -1px rgb(0 0 0 / 0.1);
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    overflow: hidden;
  }
  
  .project-row:hover {
    box-shadow: 
      0 10px 15px -3px rgb(0 0 0 / 0.1),
      0 4px 6px -4px rgb(0 0 0 / 0.1);
    transform: translateY(-2px);
  }
  
  /* Featured project special styling */
  .project-row.featured {
    background: linear-gradient(135deg, 
      rgb(var(--color-surface) / 1) 0%,
      rgb(var(--color-accent) / 0.02) 100%
    );
    border: 1px solid rgb(var(--color-accent) / 0.15);
  }
  
  .project-row.featured::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: linear-gradient(90deg, 
      var(--color-accent-light), 
      var(--color-accent), 
      var(--color-accent-dark)
    );
    border-radius: 1.5rem 1.5rem 0 0;
  }
  
  /* Container query responsive layouts */
  @container (min-width: 768px) {
    .project-layout {
      padding: 2rem;
    }
  }
  
  @container (min-width: 1024px) {
    .project-layout {
      padding: 3rem;
    }
    
    .project-content {
      padding-left: 2rem;
    }
    
    /* Reverse layout for right-aligned projects */
    .project-row[data-align="right"] .project-content {
      padding-left: 0;
      padding-right: 2rem;
    }
  }
  
  /* Enhanced image hover effects */
  .project-image-link {
    transform-origin: center;
  }
  
  .project-image-link::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 1rem;
    box-shadow: inset 0 0 0 1px rgb(var(--color-accent) / 0.1);
    transition: all 0.3s ease;
    pointer-events: none;
  }
  
  .project-image-link:hover::after {
    box-shadow: inset 0 0 0 1px rgb(var(--color-accent) / 0.3);
  }
  
  /* Modern focus states */
  .project-image-link:focus-visible {
    transform: scale(1.02);
    outline: none;
  }
  
  /* Tag hover animations */
  .tag {
    cursor: default;
    -webkit-tap-highlight-color: transparent;
  }
  
  .tag:hover {
    transform: translateY(-1px);
  }
  
  /* Button modern styling */
  .btn-primary {
    background: linear-gradient(135deg, 
      var(--color-accent) 0%,
      var(--color-accent-dark) 100%
    );
    box-shadow: 
      0 4px 8px -2px rgb(var(--color-accent) / 0.3),
      0 2px 4px -2px rgb(var(--color-accent) / 0.2);
  }
  
  .btn-primary:hover {
    background: linear-gradient(135deg, 
      var(--color-accent-dark) 0%,
      var(--color-accent) 100%
    );
    box-shadow: 
      0 8px 16px -4px rgb(var(--color-accent) / 0.4),
      0 4px 8px -4px rgb(var(--color-accent) / 0.3);
  }
  
  /* Dark mode enhancements */
  .dark .project-row {
    background: rgb(var(--color-surface-dark) / 1);
    box-shadow: 
      0 1px 3px 0 rgb(0 0 0 / 0.3),
      0 1px 2px -1px rgb(0 0 0 / 0.2);
  }
  
  .dark .project-row:hover {
    box-shadow: 
      0 10px 15px -3px rgb(0 0 0 / 0.3),
      0 4px 6px -4px rgb(0 0 0 / 0.2);
  }
  
  .dark .project-row.featured {
    background: linear-gradient(135deg, 
      rgb(var(--color-surface-dark) / 1) 0%,
      rgb(var(--color-accent) / 0.05) 100%
    );
    border-color: rgb(var(--color-accent) / 0.25);
  }
  
  /* Reduced motion support */
  @media (prefers-reduced-motion: reduce) {
    .project-row,
    .project-image-link,
    .tag,
    .btn-primary {
      transition: none;
    }
    
    .project-row:hover {
      transform: none;
    }
  }
  
  /* High contrast mode support */
  @media (prefers-contrast: high) {
    .project-row {
      border: 2px solid currentColor;
    }
    
    .featured-badge {
      border: 1px solid currentColor;
    }
    
    .tag {
      border-width: 2px;
    }
  }
</style>
