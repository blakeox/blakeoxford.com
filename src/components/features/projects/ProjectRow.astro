---
// ProjectRow: minimal, performant card. Tailwind-only. No client JS.
const { project, featured = false } = Astro.props as {
  project: any;
  featured?: boolean;
};

const { slug, data } = project;
const description: string = data?.description ?? '';
const truncatedDescription = description.length > 180 ? `${description.slice(0, 177)}…` : description;
const tags: string[] = Array.isArray(data?.tags) ? data.tags.slice(0, 4) : [];
const primaryTag = tags[0] ?? 'Case study';
---
<article class="group relative flex h-full flex-col overflow-hidden rounded-[2rem] bg-gradient-to-b from-background/95 via-surface/90 to-background/80 ring-1 ring-border/40 shadow-soft-glow transition-all duration-300 hover:-translate-y-1.5 hover:shadow-accent-glow focus-within:outline-none focus-within:ring-2 focus-within:ring-accent/60">
  <div class="pointer-events-none absolute inset-0 opacity-60 mix-blend-screen">
    <div class="h-full w-full bg-grid-overlay [background-size:160px_160px]"></div>
  </div>
  <div class="absolute inset-x-0 top-0 h-1.5 bg-gradient-to-r from-transparent via-accent/55 to-transparent" aria-hidden="true"></div>
  <a
    href={`/projects/${slug}/`}
    aria-label={`View project ${data?.title ?? 'case study'}`}
    class="relative z-[1] block overflow-hidden"
  >
    <div class="relative aspect-[3/2] overflow-hidden rounded-[1.75rem] border border-border/30 bg-background/80">
      <img
        src={data?.image || '/assets/images/blake-logo-fallback.png'}
        alt=""
        aria-hidden="true"
        width="640"
        height="360"
        class="absolute inset-0 h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.05]"
        loading="lazy"
        fetchpriority="low"
        decoding="async"
      />
      <div class="absolute inset-x-0 bottom-0 h-24 bg-gradient-to-t from-background/95 via-background/80 to-transparent"></div>
      {featured && (
        <span class="absolute left-4 top-4 inline-flex items-center gap-2 rounded-full bg-background/95 px-3 py-1 text-[0.7rem] font-semibold uppercase tracking-wide text-accent ring-1 ring-accent/40">
          <span class="h-2 w-2 rounded-full bg-accent"></span>
          Featured
        </span>
      )}
    </div>
  </a>

  <div class="relative z-[1] flex flex-1 flex-col gap-6 px-7 pb-7 pt-8">
    <div class="space-y-5">
      <div class="flex flex-wrap items-start justify-between gap-3">
        <a
          href={`/projects/${slug}/`}
          class="max-w-[18rem] text-left text-xl font-semibold leading-tight text-foreground transition-colors duration-200 hover:text-accent focus-visible:ring-2 focus-visible:ring-accent/70 dark:text-foreground-light"
        >
          {data?.title}
        </a>
        {data?.date && (
          <time class="inline-flex items-center gap-2 rounded-full bg-background/90 px-3 py-1 text-[0.65rem] font-semibold uppercase tracking-wide text-foreground/60 ring-1 ring-border/40 dark:text-foreground-light/65" datetime={data.date.toISOString()}>
            <span class="h-1.5 w-1.5 rounded-full bg-accent/70"></span>
            {data.date.toLocaleDateString(undefined, { year: 'numeric', month: 'short' })}
          </time>
        )}
      </div>

      {tags.length > 0 && (
        <ul class="flex flex-wrap gap-2" aria-label="Project tags">
          {tags.map((tag: string) => (
            <li class="text-xs">
              <span class="inline-flex items-center gap-2 rounded-full bg-surface/90 px-2.5 py-1 text-xs font-medium text-foreground/70 ring-1 ring-border/40 transition-colors duration-200 group-hover:text-foreground dark:text-foreground-light/70">
                <span class="h-1.5 w-1.5 rounded-full bg-accent/70"></span>
                {tag}
              </span>
            </li>
          ))}
        </ul>
      )}

      {description && (
        <p class="text-sm leading-relaxed text-foreground/75 dark:text-foreground-light/75">{truncatedDescription}</p>
      )}
    </div>

    <div class="mt-auto flex items-center justify-between gap-4 pt-4">
      <span class="inline-flex items-center gap-2 rounded-full bg-surface/85 px-3 py-1 text-xs font-semibold uppercase tracking-wide text-foreground/65 ring-1 ring-border/35 dark:text-foreground-light/65">
        <span class="h-1.5 w-1.5 rounded-full bg-accent/70"></span>
        {primaryTag}
      </span>
      <a
        href={`/projects/${slug}/`}
        aria-label={`View case study: ${data?.title ?? 'case study'}`}
        class="inline-flex min-h-[44px] items-center gap-2 rounded-full bg-accent px-4 text-sm font-semibold text-white transition-colors duration-200 hover:bg-accent-dark focus-visible:ring-2 focus-visible:ring-accent/70"
      >
        <span>View case study</span>
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" class="opacity-90">
          <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14m-6-6 6 6-6 6" />
        </svg>
      </a>
    </div>
  </div>
</article>


