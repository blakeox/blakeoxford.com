---
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
  featured?: boolean;
  align?: 'left' | 'right';
}

const { project, featured = false, align = 'left' } = Astro.props as Props;
const { id: slug, data } = project;
---

<section
  class={`flex flex-col md:flex-row items-center w-full gap-8 md:gap-16 min-h-[340px] ${align === 'right' ? 'md:flex-row-reverse' : ''}`}
>
  <a
    href={`/projects/${slug}/`}
    class="flex-basis-0 group block w-full flex-shrink-0 flex-grow-0 transform overflow-hidden rounded-2xl shadow-lg transition-all duration-moderate hover:shadow-lg focus:outline-none focus-visible:ring-2 focus-visible:ring-accent motion-safe:hover:-translate-y-1 md:w-2/5 md:basis-2/5"
  >
    <img
      src={data.heroImage || '/assets/images/blake-logo-fallback.png'}
      alt={`${data.title} project screenshot`}
      width="640"
      height="360"
      class="aspect-[16/9] h-auto w-full object-cover motion-safe:transition-transform motion-safe:duration-normal motion-safe:group-hover:scale-105"
      loading="lazy"
      fetchpriority="low"
      decoding="async"
    />
  </a>
  <div class="layout-gutter flex w-full min-w-0 flex-1 flex-col gap-4 py-4">
    <h2 class="mb-2 font-heading text-2xl leading-tight font-bold text-accent-emphasis md:text-3xl">
      <a
        href={`/projects/${slug}/`}
        class="project-title-link text-accent-emphasis hover:underline focus:outline-none focus-visible:ring-2 focus-visible:ring-accent"
        >{data.title}</a
      >
      {
        featured && (
          <span class="ml-3 rounded-full border border-accent/30 bg-button-primary-bg px-3 py-1 align-middle text-xs font-bold text-button-primary-fg shadow-md">
            Featured
          </span>
        )
      }
    </h2>
    {
      data.date && (
        <time class="mb-1 text-xs text-muted-foreground" datetime={data.date.toISOString()}>
          {data.date.toLocaleDateString(undefined, {
            year: 'numeric',
            month: 'short',
            day: 'numeric',
          })}
        </time>
      )
    }
    {
      data.tags && Array.isArray(data.tags) && data.tags.length > 0 && (
        <ul class="mb-1 flex flex-wrap gap-2" aria-label="Project tags">
          {data.tags.map((tag: string) => (
            <li>
              <span class="rounded-full border border-accent/20 bg-accent-subtle px-2 py-0.5 text-xs font-medium text-foreground">
                {tag}
              </span>
            </li>
          ))}
        </ul>
      )
    }
    {
      data.description && (
        <p class="mb-4 line-clamp-4 text-muted-foreground">
          {data.description.length > 220
            ? `${data.description.slice(0, 217)}...`
            : data.description}
          {data.description.length > 220 && (
            <a
              href={`/projects/${slug}/`}
              class="ml-1 text-accent-emphasis underline focus:outline-none focus-visible:ring-2 focus-visible:ring-accent"
            >
              Read more about {data.title}
            </a>
          )}
        </p>
      )
    }
    <div class="mt-auto flex justify-start">
      <a
        href={`/projects/${slug}/`}
        class="inline-flex min-h-11 min-w-11 items-center justify-center rounded-lg bg-button-primary-bg px-5 py-2 text-base font-semibold text-button-primary-fg shadow transition-all duration-normal hover:bg-button-primary-bg-hover focus:outline-none focus-visible:ring-2 focus-visible:ring-accent"
      >
        View Project: {data.title}
      </a>
    </div>
  </div>
</section>

<!-- No custom style needed; Tailwind classes handle color and hover states for accessibility and visibility. -->
