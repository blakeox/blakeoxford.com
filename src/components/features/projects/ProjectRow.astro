---
// ProjectRow: minimal, performant card. Tailwind-only. No client JS.
const { project, featured = false } = Astro.props as {
  project: any;
  featured?: boolean;
};

const { slug, data } = project;

const title = data?.title ?? 'Case study';
const description = typeof data?.description === 'string' ? data.description.trim() : '';
const hasDescription = description.length > 0;

const image = data?.image ?? '/assets/images/blake-logo-fallback.png';

const allTags: string[] = Array.isArray(data?.tags)
  ? data.tags.filter((tag: string) => typeof tag === 'string' && tag.trim().length > 0)
  : [];

const headlineTag = allTags[0] ?? 'Case study';
const supportingTags = allTags.slice(1, 4);

const dateISO = data?.date ? data.date.toISOString() : undefined;
const dateLabel = data?.date
  ? data.date.toLocaleDateString(undefined, { month: 'short', year: 'numeric' })
  : undefined;
---
<article class="group relative isolate flex overflow-hidden rounded-[2.25rem] bg-surface/95 ring-1 ring-border/35 shadow-lg transition-all duration-300 hover:-translate-y-1 hover:shadow-xl focus-within:outline-none focus-within:ring-2 focus-within:ring-accent/55">
  <div class="pointer-events-none absolute inset-0 bg-gradient-to-br from-background/40 via-surface/50 to-background/30 opacity-0 transition-opacity duration-300 group-hover:opacity-100" aria-hidden="true"></div>
  <div class="grid w-full gap-0 lg:grid-cols-[min(22rem,45%),1fr]">
    <a
      href={`/projects/${slug}/`}
      aria-label={`View project ${title}`}
      class="relative block overflow-hidden"
    >
      <figure class="relative aspect-[16/13] h-full overflow-hidden bg-surface-subtle">
        <img
          src={image}
          alt={`${title} preview`}
          width="640"
          height="520"
          loading="lazy"
          decoding="async"
          class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.05]"
        />
        <div class="absolute inset-x-0 bottom-0 h-24 bg-gradient-to-t from-background/95 via-background/75 to-transparent"></div>
        {featured && (
          <span class="absolute left-5 top-5 inline-flex items-center gap-2 rounded-full bg-background/95 px-3 py-1 text-[0.65rem] font-semibold uppercase tracking-[0.25em] text-accent ring-1 ring-accent/35">
            <span class="h-1.5 w-1.5 rounded-full bg-accent"></span>
            Featured
          </span>
        )}
      </figure>
    </a>

    <div class="relative flex flex-col gap-8 px-7 py-8 sm:px-9 lg:px-10">
      <div class="space-y-5">
        <div class="flex flex-wrap items-center gap-3 text-xs font-semibold uppercase tracking-[0.25em] text-foreground/55 dark:text-foreground-light/65">
          {dateISO && dateLabel && (
            <time datetime={dateISO} class="inline-flex items-center gap-2 rounded-full bg-surface-subtle px-3 py-1 ring-1 ring-border/25 dark:bg-surface-dark-subtle">
              <span class="h-1.5 w-1.5 rounded-full bg-accent"></span>
              {dateLabel}
            </time>
          )}
          <span class="inline-flex items-center gap-2 rounded-full bg-surface-subtle px-3 py-1 ring-1 ring-border/25 text-foreground/65 dark:bg-surface-dark-subtle dark:text-foreground-light/70">
            <span class="h-1.5 w-1.5 rounded-full bg-accent/80"></span>
            {headlineTag}
          </span>
        </div>

        <div class="space-y-3">
          <h3 class="text-pretty font-heading text-2xl font-semibold text-foreground transition-colors duration-200 group-hover:text-accent dark:text-foreground-light">
            <a
              href={`/projects/${slug}/`}
              class="focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent/60"
            >
              {title}
            </a>
          </h3>
          {hasDescription && (
            <p class="text-sm leading-relaxed text-foreground/75 dark:text-foreground-light/75 [display:-webkit-box] [-webkit-line-clamp:4] [-webkit-box-orient:vertical] overflow-hidden">
              {description}
            </p>
          )}
        </div>
      </div>

      {supportingTags.length > 0 && (
        <ul class="flex flex-wrap items-center gap-2 text-[0.7rem] font-semibold uppercase tracking-wide text-foreground/60 dark:text-foreground-light/65" aria-label="Project capabilities">
          {supportingTags.map((tag) => (
            <li class="rounded-full bg-surface-subtle px-3 py-1 ring-1 ring-border/25 transition-colors duration-200 group-hover:ring-border/40 dark:bg-surface-dark-subtle">
              <span>{tag}</span>
            </li>
          ))}
        </ul>
      )}

      <div class="mt-auto flex flex-wrap items-center justify-between gap-4 pt-2">
        <span class="text-xs font-semibold uppercase tracking-[0.3em] text-foreground/55 dark:text-foreground-light/65">
          View deep dive
        </span>
        <a
          href={`/projects/${slug}/`}
          class="inline-flex min-h-[44px] items-center gap-2 rounded-full bg-accent px-5 text-sm font-semibold text-on-accent transition-colors duration-200 hover:bg-accent-dark focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent/60"
        >
          <span>Explore case study</span>
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            width="18"
            height="18"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="opacity-90"
          >
            <path d="M5 12h14m-6-6 6 6-6 6" />
          </svg>
        </a>
      </div>
    </div>
  </div>
</article>


