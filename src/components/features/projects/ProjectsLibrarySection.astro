---
import type { CollectionEntry } from 'astro:content';
import Section from '@/components/primitives/Section.astro';
import Grid from '@/components/primitives/Grid.astro';
import SectionHeader from '@/components/composites/SectionHeader.astro';
import ProjectCard from './ProjectCard.astro';

interface Props {
  projects: CollectionEntry<'projects'>[];
  kicker?: string;
  title: string;
  description: string;
  id?: string;
  /** Featured slug to de-emphasize or skip if already shown above. */
  excludeSlug?: string;
}

const { projects, kicker, title, description, id = 'library', excludeSlug } = Astro.props as Props;
const headingId = `${id}-heading`;
const libraryProjects = excludeSlug
  ? projects.filter((project) => project.id !== excludeSlug)
  : projects;
---

<Section
  id={id}
  padding="md"
  container="xl"
  aria-labelledby={headingId}
  data-layout-section="projects-grid"
>
  <div data-layout-shell="projects-grid-inner">
    <SectionHeader
      kicker={kicker}
      title={title}
      titleId={headingId}
      description={description}
      size="section"
    />

    <Grid
      cols={libraryProjects.length >= 3 ? '3' : libraryProjects.length === 2 ? '2' : '1'}
      gap="lg"
    >
      {libraryProjects.map((project) => (
        <ProjectCard project={project} />
      ))}
    </Grid>
  </div>
</Section>
