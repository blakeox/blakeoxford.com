---
import type { CollectionEntry } from 'astro:content';
import Button from '@/components/primitives/Button.astro';
import DotMetaList from '@/components/composites/DotMetaList.astro';
import ProofPlaque from '@/components/composites/ProofPlaque.astro';
import { headingSizeClass } from '@/lib/typeScale';
import type { ProjectDeepCut } from '@/content/projects/getProjectInsights';
import { WORK_PROOF_LABELS } from '@/content/projects/hirePath';

interface Props {
  project: CollectionEntry<'projects'>;
  deepCut: ProjectDeepCut;
  kicker: string;
  ctaLabel: string;
}

const { project, deepCut, kicker, ctaLabel } = Astro.props as Props;
const categories: string[] = project.data.categories ?? [];
const caseHref = `/projects/${deepCut.projectSlug}/`;
const hireLabel = WORK_PROOF_LABELS[deepCut.projectSlug];
---

<section
  id="featured"
  class="work-featured overflow-hidden border-y border-border/40"
  aria-labelledby="featured-heading"
  data-layout-section="projects-featured"
  data-chat-avoid-launcher
>
  <div class="flex flex-col xl:grid xl:min-h-[min(32rem,calc(100svh-var(--nav-height)))] xl:grid-cols-2">
    <div class="max-xl:contents xl:flex xl:flex-col xl:justify-start xl:gap-5 xl:py-8">
      <div class="layout-gutter order-1 flex flex-col gap-5 py-2 xl:order-none xl:max-w-xl xl:py-0">
        <div class="flex max-w-xl flex-col gap-2.5">
          <span class="section-kicker">{kicker}</span>
          <h2
            id="featured-heading"
            class:list={[
              'font-heading font-semibold tracking-tight text-balance text-foreground',
              headingSizeClass('section'),
            ]}
          >
            {hireLabel ?? deepCut.projectTitle}
          </h2>
          {hireLabel ? (
            <p class="text-sm font-semibold text-muted-foreground sm:text-base">
              {deepCut.projectTitle}
            </p>
          ) : null}
          <p class="featured-thesis pt-0.5 text-base leading-relaxed text-pretty text-muted-foreground sm:text-lg">
            {deepCut.thesis}
          </p>
        </div>
      </div>
      <div class="layout-gutter order-2 pb-2 xl:order-none xl:pb-0">
        <Button variant="primary" href={caseHref} data-test="projects-featured-cta">
          {ctaLabel}
        </Button>
      </div>
      <div class="layout-gutter order-4 xl:order-none">
        <DotMetaList items={categories} label="Focus areas" />
      </div>
    </div>

    <div class="featured-proof order-3 xl:order-none xl:h-full">
      <ProofPlaque
        figure={deepCut.proofFigure}
        caption={deepCut.proofCaption}
        href={caseHref}
        label={`${deepCut.projectTitle} case study`}
        size="hero"
        flush
      />
    </div>
  </div>
</section>

<style>
  @keyframes work-featured-rise {
    from {
      opacity: 0;
      transform: translateY(0.85rem);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .work-featured :global(.layout-gutter.order-1),
    .work-featured :global(.layout-gutter.order-2),
    .featured-proof {
      animation: work-featured-rise 750ms var(--ease-decelerate) both;
    }

    .work-featured :global(.layout-gutter.order-2) {
      animation-delay: 80ms;
    }

    .featured-proof {
      animation-delay: 120ms;
    }
  }

  @media (width < 1280px) {
    .featured-proof :global(.proof-plaque) {
      border-top-width: 1px;
      border-left-width: 0;
      gap: 0.25rem;
      padding: 0.25rem 1.5rem 1rem;
    }

    .featured-proof :global(.proof-plaque > p:first-child) {
      font-size: 3rem;
      line-height: 1;
    }

    .featured-proof :global(.proof-plaque > p:last-child) {
      font-size: 1rem;
      line-height: 1.35;
    }
  }

  /* Short phones: keep the hire title; drop the thesis so the proof fits. */
  @media (width < 768px) and (height <= 700px) {
    #featured :global(.featured-thesis) {
      display: none;
    }

    .layout-gutter.order-1 {
      padding-top: 0;
      padding-bottom: 0;
    }

    .featured-proof :global(.proof-plaque) {
      padding-bottom: 0.25rem;
    }
  }
</style>
