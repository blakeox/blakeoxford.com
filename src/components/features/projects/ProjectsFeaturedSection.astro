---
import type { CollectionEntry } from 'astro:content';
import Container from '../../primitives/Container.astro';
import OptimizedImage from '../../primitives/OptimizedImage.astro';
import Button from '../../primitives/Button.astro';
import IntroCopy from '../../composites/IntroCopy.astro';
import DotMetaList from '../../composites/DotMetaList.astro';
import type { ProjectDeepCut } from '../../../content/projects/getProjectInsights';

interface Props {
  project: CollectionEntry<'projects'>;
  deepCut: ProjectDeepCut;
  kicker: string;
  ctaLabel: string;
}

const { project, deepCut, kicker, ctaLabel } = Astro.props as Props;
const image = project.data.heroImage ?? '/assets/images/blake-logo-fallback.png';
const categories: string[] = project.data.categories ?? [];
---

<section
  id="featured"
  class="border-y border-border/40 bg-surface/50 py-14 sm:py-16 lg:py-20"
  aria-labelledby="featured-heading"
  data-layout-section="projects-featured"
>
  <Container size="xl">
    <div class="grid items-center gap-8 lg:grid-cols-[minmax(0,1.05fr)_minmax(0,0.95fr)] lg:gap-12">
      <div class="flex flex-col gap-5">
        <IntroCopy
          kicker={kicker}
          title={deepCut.projectTitle}
          titleId="featured-heading"
          description={deepCut.thesis}
          emphasis={deepCut.proof}
          as="h2"
          size="display"
          descriptionSize="md"
        />
        <DotMetaList items={categories} label="Focus areas" />
        <div>
          <Button variant="primary" href={`/projects/${deepCut.projectSlug}/`}>
            {ctaLabel}
          </Button>
        </div>
      </div>

      <a
        href={`/projects/${deepCut.projectSlug}/`}
        class="group relative block overflow-hidden ring-1 ring-border/40 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent/60"
      >
        <OptimizedImage
          src={image}
          alt={`${deepCut.projectTitle} preview`}
          width={960}
          height={720}
          class="aspect-[4/3] h-full w-full object-cover transition-transform duration-slow group-hover:scale-[1.03]"
          loading="lazy"
        />
      </a>
    </div>
  </Container>
</section>
