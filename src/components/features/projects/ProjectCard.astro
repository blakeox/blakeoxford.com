---
/**
 * ProjectCard - Interactive project card for project listings
 *
 * Displays a project with hero image, title, description, date, tags, and link.
 * Uses semantic tokens for surface, focus, and interactive states.
 * Uses container queries for responsive layout adapting to container width.
 *
 * @component
 * @category Features
 * @subcategory Projects
 *
 * @example Basic usage
 * ```astro
 * <ProjectCard project={projectEntry} />
 * ```
 *
 * @example With container query wrapper
 * ```astro
 * <div class="@container">
 * <ProjectCard project={projectEntry} />
 * </div>
 * ```
 *
 * @prop {CollectionEntry<'projects'>} project - Project content collection entry
 *
 * @accessibility
 * - Semantic article element
 * - aria-labelledby linking to project title
 * - Proper heading hierarchy (h3)
 * - Focus-visible styles for keyboard navigation
 * - Alt text required for images
 *
 * @containerQueries
 * - @sm (384px): Increased spacing, larger badges
 * - @md (448px): Enhanced typography, larger gaps
 * - @lg (512px): Maximum content width, optimal reading layout
 */
import Card from '../../composites/Card.astro';
import OptimizedImage from '../../primitives/OptimizedImage.astro';
import Flex from '../../primitives/Flex.astro';
import BadgePill from '../../primitives/BadgePill.astro';
import ArrowRightIcon from '../../primitives/icons/ArrowRightIcon.astro';
import GradientOverlay from '../../primitives/GradientOverlay.astro';
import { formatDateISO, formatDateShort, take } from '../../../utils/index.js';

const { project } = Astro.props as import('../../../types/components').ProjectCardProps;
const { id: slug, data } = project;

const title = data.title ?? 'Case study';
const image = data?.heroImage ?? '/assets/images/blake-logo-fallback.png';
const description = data.description ?? '';
const categories = Array.isArray(data.categories) ? data.categories.filter(Boolean) : [];
const highlights = Array.isArray(data.highlights) ? data.highlights.filter(Boolean) : [];
const impact = Array.isArray(data.impact) ? data.impact.filter(Boolean) : [];
const tags = Array.isArray(data.tags) ? data.tags.filter(Boolean) : [];
const visibleTags = take(tags, 3);
const extraTagCount = Math.max(tags.length - visibleTags.length, 0);
const hasDescription = Boolean(description.trim());
const primaryCategory = categories[0] ?? 'Case study';
const supportingCategory = categories[1];
const valueSummary =
  description.trim() ||
  highlights[0] ||
  impact[0] ||
  'Operational change delivered through systems, automation, and enablement.';
const proofLine = impact[0] || highlights[1] || highlights[0];

const dateISO = project.data.date ? formatDateISO(project.data.date) : undefined;
const dateLabel = project.data.date ? formatDateShort(project.data.date) : undefined;
---

<article class="group @container relative flex h-full flex-col">
  <Card variant="elevated" hover="lift" padding="none" rounded="xl" class="h-full">
    <a
      href={`/projects/${slug}/`}
      class="relative flex h-full flex-col overflow-hidden focus-visible:ring-2 focus-visible:ring-accent/60 focus-visible:outline-none"
      aria-labelledby={`project-card-${slug}`}
    >
      <GradientOverlay variant="hover-card" direction="br" />

      <figure class="relative aspect-[16/10] overflow-hidden">
        <OptimizedImage
          src={image}
          alt={`${title} preview`}
          width={960}
          height={540}
          class="h-full w-full object-cover transition-transform duration-slow group-hover:scale-[1.04]"
          loading="lazy"
          quality={80}
        />
        <GradientOverlay variant="image-fade" direction="t" />
      </figure>

      <div
        class="relative z-[1] flex flex-1 flex-col gap-4 px-6 pt-6 pb-7 @sm:gap-5 @sm:px-7 @sm:pt-7 @sm:pb-8 @md:gap-6 @md:px-8"
      >
        <div class="space-y-3 @sm:space-y-4">
          <Flex
            wrap
            align="center"
            gap="sm"
            class="text-xs font-semibold tracking-label text-subtle-foreground uppercase"
          >
            {
              primaryCategory && (
                <BadgePill size="xs" class="bg-accent-subtle text-accent ring-accent/20">
                  {primaryCategory}
                </BadgePill>
              )
            }
            {supportingCategory && <BadgePill size="xs">{supportingCategory}</BadgePill>}
            {dateISO && dateLabel && <time datetime={dateISO}>{dateLabel}</time>}
            {
              categories.length === 0 && tags.length === 0 && (
                <BadgePill size="xs">Case Study</BadgePill>
              )
            }
          </Flex>

          <h3
            id={`project-card-${slug}`}
            class="font-heading text-lg font-semibold text-pretty text-foreground @sm:text-xl @md:text-2xl"
          >
            {title}
          </h3>

          {
            (hasDescription || valueSummary) && (
              <p class="[display:-webkit-box] overflow-hidden text-sm leading-relaxed text-muted-foreground [-webkit-box-orient:vertical] [-webkit-line-clamp:4] @md:text-base">
                {valueSummary}
              </p>
            )
          }

          {
            proofLine && (
              <p class="border-l-2 border-accent/50 pl-4 text-sm leading-relaxed text-foreground/82">
                {proofLine}
              </p>
            )
          }
        </div>

        {
          (visibleTags.length > 0 || extraTagCount > 0) && (
            <Flex
              as="ul"
              wrap
              align="center"
              gap="xs"
              class="text-xxs font-semibold tracking-wide text-subtle-foreground uppercase"
              aria-label="Project focus areas"
            >
              {visibleTags.map((tag) => (
                <li>
                  <BadgePill size="xs">{tag}</BadgePill>
                </li>
              ))}
              {extraTagCount > 0 && (
                <li>
                  <BadgePill size="xs" class="text-subtle-foreground">
                    +{extraTagCount}
                  </BadgePill>
                </li>
              )}
            </Flex>
          )
        }

        <div class="mt-auto flex items-center justify-end gap-4">
          <span
            class="inline-flex items-center gap-2 text-sm font-semibold text-accent-emphasis transition-all duration-normal group-hover:gap-3"
          >
            View case study
            <ArrowRightIcon
              class="opacity-90 transition-transform duration-normal group-hover:translate-x-0.5"
            />
          </span>
        </div>
      </div>
    </a>
  </Card>
</article>
