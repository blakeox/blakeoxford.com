---
// ProjectCard.astro - A modern, accessible project showcase component
import type { ProjectCardProps } from '../../../types/index';

const { project, featured = false } = Astro.props as ProjectCardProps;
const { slug, data } = project;

// Use featured prop for conditional styling
const cardClasses = featured
  ? 'bg-surface dark:bg-surface p-0 rounded-2xl shadow-xl flex flex-col group hover:scale-[1.03] hover:shadow-2xl transition-all duration-200 animate-slide-up featured-card'
  : 'bg-surface dark:bg-surface p-0 rounded-2xl shadow-xl flex flex-col group hover:scale-[1.03] hover:shadow-2xl transition-all duration-200 animate-slide-up';
---
<article class={cardClasses}>
  <div class="relative">
  <a href={`/projects/${slug}/`} class="block rounded-t-2xl overflow-hidden aspect-[16/9] bg-surface dark:bg-surface-dark focus:outline-none focus-visible:ring-2 focus-visible:ring-accent">
      <img
        src={data.image || '/assets/images/default-project.png'}
        alt={`${data.title} project screenshot`}
        width="640"
        height="360"
        class="w-full h-full object-cover transition-transform duration-200 group-hover:scale-105"
        loading="lazy"
      />
    </a>
  </div>
  <div class="flex flex-col flex-1 p-6 gap-2">
    <h3 class="text-2xl font-bold mb-1 text-foreground leading-tight">
  <a href={`/projects/${slug}/`} class="text-foreground hover:text-accent dark:hover:text-accent-light hover:underline flex items-center gap-2 focus:outline-none focus-visible:ring-2 focus-visible:ring-accent">
        {data.title}
      </a>
    </h3>
    {data.tags && Array.isArray(data.tags) && data.tags.length > 0 && (
      <ul class="flex flex-wrap gap-2 mb-1" aria-label="Project tags">
        {data.tags.map((tag: string) => (
          <li>
            <span class="bg-accent/10 dark:bg-accent/20 text-accent dark:text-accent-light text-xs font-medium px-2 py-0.5 rounded-full">{tag}</span>
          </li>
        ))}
      </ul>
    )}
    {data.description && (
  <p class="text-foreground/80 mb-4 line-clamp-3">
        {data.description.length > 160 ? `${data.description.slice(0, 157)}...` : data.description}
        {data.description.length > 160 && (
          <a
            href={`/projects/${slug}/`}
            class="ml-1 text-accent dark:text-accent-light underline focus:outline-none focus-visible:ring-2 focus-visible:ring-accent"
          >
            Read more about {data.title}
          </a>
        )}
      </p>
    )}
    <div class="mt-auto flex justify-end">
      <a
        href={`/projects/${slug}/`}
        class="inline-flex items-center gap-1 text-accent dark:text-accent-light font-semibold hover:underline focus:outline-none focus-visible:ring-2 focus-visible:ring-accent transition-colors duration-200 text-base"
      >
        View Project: {data.title}
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 ml-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M5 12h14M13 6l6 6-6 6" />
        </svg>
      </a>
    </div>
  </div>
</article>
