---
/**
 * ProjectCard — portfolio showcase.
 * Compact: cardless media teaser for home.
 * Full: Selected work library, still cardless — plaque or photo, then proof copy.
 */
import OptimizedImage from '@/components/primitives/OptimizedImage.astro';
import Flex from '@/components/primitives/Flex.astro';
import ArrowRightIcon from '@/components/primitives/icons/ArrowRightIcon.astro';
import { headingSizeClass } from '@/lib/typeScale';
import { take } from '@/utils/array';
import { formatDateISO, formatDateShort } from '@/utils/date';
import ProofPlaque from '@/components/composites/ProofPlaque.astro';
import { resolvePublicImage } from '@/lib/media/publicAssetExists';
import { splitProofFigure } from '@/lib/content/splitProofFigure';

const {
  project,
  compact = false,
  featured = false,
} = Astro.props as import('@/types/components').ProjectCardProps;
const { id: slug, data } = project;

const title = data.title ?? 'Case study';
const image = resolvePublicImage(data?.heroImage);
const description = data.description ?? '';
const categories = Array.isArray(data.categories) ? data.categories.filter(Boolean) : [];
const highlights = Array.isArray(data.highlights) ? data.highlights.filter(Boolean) : [];
const impact = Array.isArray(data.impact) ? data.impact.filter(Boolean) : [];
const tags = Array.isArray(data.tags) ? data.tags.filter(Boolean) : [];
const visibleTags = take(tags, 3);
const extraTagCount = Math.max(tags.length - visibleTags.length, 0);
const hasDescription = Boolean(description.trim());
const primaryCategory = categories[0] ?? 'Case study';
const proofLine = impact[0] || highlights[1] || highlights[0];
const metrics = Array.isArray(data.metrics) ? data.metrics : [];
const metricLine = metrics[0] ? `${metrics[0].result} ${metrics[0].metric}` : '';
const fromImpact = proofLine ? splitProofFigure(proofLine) : { figure: '', caption: '' };
const fromMetric = metricLine ? splitProofFigure(metricLine) : { figure: '', caption: '' };
const proofPlaque = fromImpact.figure
  ? fromImpact
  : fromMetric.figure
    ? fromMetric
    : fromImpact.caption
      ? fromImpact
      : null;

const dateISO = project.data.date ? formatDateISO(project.data.date) : undefined;
const dateLabel = project.data.date ? formatDateShort(project.data.date) : undefined;
const valueSummary =
  description.trim() ||
  highlights[0] ||
  impact[0] ||
  'Operational change delivered through systems, automation, and enablement.';
---

<article
  class:list={[
    'group @container relative flex h-full flex-col',
    featured && 'project-card-featured',
  ]}
>
  <a
    href={`/projects/${slug}/`}
    class="relative flex h-full flex-col gap-4 focus-visible:ring-2 focus-visible:ring-accent/60 focus-visible:outline-none"
    aria-labelledby={`project-card-${slug}`}
  >
    {image ? (
      <figure
        class:list={[
          'relative overflow-hidden bg-surface-subtle',
          compact
            ? featured
              ? 'aspect-[16/9] sm:aspect-[16/10] lg:aspect-[16/9]'
              : 'aspect-[16/10]'
            : 'aspect-[16/11] @md:aspect-[16/10]',
        ]}
      >
        <OptimizedImage
          src={image}
          alt={`${title} preview`}
          width={featured ? 1400 : 960}
          height={featured ? 788 : 540}
          class="h-full w-full object-cover transition-transform duration-slow motion-safe:group-hover:scale-[1.03]"
          loading="lazy"
          quality={80}
        />
      </figure>
    ) : proofPlaque ? (
      <ProofPlaque figure={proofPlaque.figure} caption={proofPlaque.caption} size="card" />
    ) : null}

    <div
      class:list={['flex flex-1 flex-col', compact ? (featured ? 'gap-3' : 'gap-2.5') : 'gap-3']}
    >
      <p class="project-card-meta text-xs font-semibold tracking-label text-subtle-foreground uppercase">
        {primaryCategory}
        {dateISO && dateLabel ? (
          <>
            <span aria-hidden="true"> · </span>
            <time datetime={dateISO}>{dateLabel}</time>
          </>
        ) : null}
      </p>

      <h3
        id={`project-card-${slug}`}
        class:list={[
          'font-heading font-semibold tracking-tight text-pretty text-foreground',
          headingSizeClass(compact && !featured ? 'subtitle' : 'title'),
        ]}
      >
        {title}
      </h3>

      {proofLine && image ? (
        <p
          class:list={[
            'leading-snug text-muted-foreground',
            compact && featured ? 'max-w-2xl text-base sm:text-lg' : 'text-sm @md:text-base',
          ]}
        >
          {proofLine}
        </p>
      ) : null}

      {!compact && hasDescription && valueSummary !== proofLine ? (
        <p class="[display:-webkit-box] overflow-hidden text-sm leading-relaxed text-muted-foreground [-webkit-box-orient:vertical] [-webkit-line-clamp:3] @md:text-base">
          {valueSummary}
        </p>
      ) : null}

      {!compact && (visibleTags.length > 0 || extraTagCount > 0) ? (
        <Flex
          as="ul"
          wrap
          align="center"
          gap="xs"
          class="text-xxs font-semibold tracking-wide text-subtle-foreground uppercase"
          aria-label="Project focus areas"
        >
          {visibleTags.map((tag) => (
            <li>{tag}</li>
          ))}
          {extraTagCount > 0 && <li>+{extraTagCount}</li>}
        </Flex>
      ) : null}

      <span class="mt-auto inline-flex items-center gap-2 pt-1 text-sm font-semibold text-accent-emphasis transition-all duration-normal motion-safe:group-hover:gap-3">
        View case study
        <ArrowRightIcon class="opacity-90 transition-transform duration-normal motion-safe:group-hover:translate-x-0.5" />
      </span>
    </div>
  </a>
</article>
