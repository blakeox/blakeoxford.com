---
export interface Props {
  title: string;
  description: string;
  date: Date;
  image: string;
  link?: string;
}

const { title, description, date, image, link } = Astro.props;

const formattedDate = date.toLocaleDateString('en-US', {
  month: 'long',
  year: 'numeric',
});
---

<section class="bg-gradient-to-br from-background to-surface dark:from-background-dark dark:to-surface-dark py-16">
  <div class="container mx-auto px-6 max-w-7xl">
    <!-- Back to Projects link -->
    <div class="mb-8">
      <a
        href="/projects/"
        class="inline-flex items-center gap-2 text-accent dark:text-accent-light hover:text-accent-dark dark:hover:text-accent transition-colors duration-200 font-medium text-lg"
        aria-label="Back to Projects"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
        </svg>
        Back to Projects
      </a>
    </div>

    <div class="grid lg:grid-cols-2 gap-8 items-center">
      <div>
        <h1 class="text-4xl lg:text-5xl font-extrabold mb-4 text-foreground dark:text-white leading-tight">
          {title}
        </h1>
  <p class="text-lg text-foreground dark:text-foreground-light mb-6 leading-relaxed">
          {description}
        </p>
        <div class="flex items-center gap-4">
          <p class="text-sm text-foreground/80 dark:text-foreground-light/80">{formattedDate}</p>
          {link && (
            <a href={link} target="_blank" rel="noopener noreferrer" class="c-btn c-btn--primary">
              Visit Project
            </a>
          )}
        </div>
      </div>
      <div class="relative">
        <img
          src={image}
          alt={title}
          class="w-full h-80 lg:h-96 object-cover rounded-xl shadow-lg"
        />
      </div>
    </div>
  </div>
</section>
