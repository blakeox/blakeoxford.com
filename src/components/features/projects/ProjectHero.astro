---
export interface Props {
  title: string;
  description: string;
  date: Date;
  image: string;
  link?: string;
}

const { title, description, date, image, link } = Astro.props;

const formattedDate = date.toLocaleDateString(undefined, {
  month: 'long',
  year: 'numeric',
});
const dateISO = date.toISOString();
---
<section class="relative isolate overflow-hidden bg-gradient-to-br from-background via-surface-subtle to-background-dark/80 py-20">
  <div class="pointer-events-none absolute inset-0 bg-grid-overlay/40 [background-size:180px_180px]" aria-hidden="true"></div>
  <div class="container relative z-[1] mx-auto flex max-w-6xl flex-col gap-12 px-6 lg:flex-row lg:items-center lg:gap-16">
    <div class="flex flex-1 flex-col gap-8">
      <div class="flex items-center gap-3 text-xs font-semibold uppercase tracking-[0.3em] text-foreground/60 dark:text-foreground-light/60">
        <a
          href="/projects/"
          class="inline-flex items-center gap-2 rounded-full bg-surface-subtle px-4 py-2 text-foreground/70 ring-1 ring-border/35 transition-colors duration-200 hover:text-accent focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent/50 dark:bg-surface-dark-subtle dark:text-foreground-light/70"
          aria-label="Back to all projects"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            width="18"
            height="18"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="m15 19-7-7 7-7" />
          </svg>
          Back to projects
        </a>
  <time datetime={dateISO}>{formattedDate}</time>
      </div>

      <div class="space-y-6">
        <h1 class="text-pretty font-heading text-4xl font-semibold text-foreground sm:text-5xl lg:text-6xl dark:text-foreground-light">
          {title}
        </h1>
        <p class="text-lg leading-relaxed text-foreground/80 dark:text-foreground-light/80">
          {description}
        </p>
      </div>

      <div class="flex flex-wrap items-center gap-4">
        <span class="inline-flex items-center gap-2 rounded-full bg-surface-subtle px-4 py-2 text-xs font-semibold uppercase tracking-[0.35em] text-foreground/60 ring-1 ring-border/35 dark:bg-surface-dark-subtle dark:text-foreground-light/65">
          Case study
        </span>
        {link && (
          <a
            href={link}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex min-h-[44px] items-center gap-2 rounded-full bg-accent px-5 text-sm font-semibold text-on-accent transition-colors duration-200 hover:bg-accent-dark focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent/55"
          >
            Visit project
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              width="18"
              height="18"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M7 17 17 7m0 0h-7m7 0v7" />
            </svg>
          </a>
        )}
      </div>
    </div>

    <figure class="relative flex flex-1 justify-center">
      <div class="relative w-full max-w-[28rem] overflow-hidden rounded-[2.5rem] bg-surface/90 ring-1 ring-border/30 shadow-card">
        <img
          src={image}
          alt={title}
          width="960"
          height="960"
          loading="lazy"
          decoding="async"
          class="h-full w-full object-cover"
        />
        <div class="pointer-events-none absolute inset-0 bg-gradient-to-tr from-background/70 via-transparent to-background/40"></div>
      </div>
      <div class="pointer-events-none absolute -left-10 top-12 h-24 w-24 rounded-full bg-accent/20 blur-3xl" aria-hidden="true"></div>
      <div class="pointer-events-none absolute -right-12 bottom-8 h-28 w-28 rounded-full bg-sky-500/25 blur-[120px]" aria-hidden="true"></div>
    </figure>
  </div>
</section>
