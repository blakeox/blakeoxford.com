---
import OptimizedImage, {
  type Props as OptimizedImageProps,
} from '@/components/primitives/OptimizedImage.astro';
import Button from '@/components/primitives/Button.astro';
import DotMetaList from '@/components/composites/DotMetaList.astro';
import ProofPlaque from '@/components/composites/ProofPlaque.astro';
import ArrowLeftIcon from '@/components/primitives/icons/ArrowLeftIcon.astro';
import ExternalLinkIcon from '@/components/primitives/icons/ExternalLinkIcon.astro';
import { headingSizeClass } from '@/lib/typeScale';
import { splitProofFigure } from '@/lib/content/splitProofFigure';

export interface Props {
  title: string;
  description: string;
  date: Date;
  image?: OptimizedImageProps['src'];
  link?: string;
  categories?: string[];
  /** Lead result — what this engagement proved. */
  outcome?: string;
}

const { title, description, date, image, link, categories = [], outcome } = Astro.props;
const proofPlaque = !image && outcome ? splitProofFigure(outcome) : null;
const hasVisual = Boolean(image || proofPlaque);

const formattedDate = date.toLocaleDateString('en-US', {
  timeZone: 'UTC',
  month: 'long',
  year: 'numeric',
});
const dateISO = date.toISOString();
---

<section class="relative isolate overflow-hidden border-b border-border/40">
  <div
    class:list={[
      'flex flex-col',
      hasVisual && 'lg:grid lg:min-h-[calc(100svh-var(--nav-height))] lg:grid-cols-2',
    ]}
  >
    <div class="layout-gutter flex flex-col justify-center py-section-lg sm:py-section-xl lg:py-section-2xl">
      <div class="flex max-w-xl flex-col gap-5">
        <div class="flex flex-wrap items-center gap-x-4 gap-y-1.5 text-xs font-semibold tracking-smallcaps text-subtle-foreground uppercase">
          <a
            href="/projects/"
            class="inline-flex items-center gap-2 text-accent-emphasis transition-colors hover:text-accent"
            aria-label="Back to selected work"
          >
            <ArrowLeftIcon />
            Selected work
          </a>
          <span aria-hidden="true" class="text-border">
            ·
          </span>
          <time datetime={dateISO}>{formattedDate}</time>
        </div>

        <div class="space-y-2.5">
          <p class="section-kicker">Case study</p>
          <h1
            class:list={[
              'font-heading font-semibold tracking-tight text-pretty text-foreground',
              headingSizeClass('hero'),
            ]}
          >
            {title}
          </h1>
          {outcome && image ? (
            <p class="font-heading text-lg font-semibold tracking-tight text-accent-emphasis sm:text-xl">
              {outcome}
            </p>
          ) : null}
          {description && (
            <p class="pt-0.5 text-lg leading-relaxed text-pretty text-muted-foreground sm:text-xl">
              {description}
            </p>
          )}
        </div>

        <DotMetaList items={categories} label="Focus areas" />

        {link && (
          <div>
            <Button variant="outline" href={link} target="_blank" rel="noopener noreferrer">
              Visit project
              <ExternalLinkIcon />
            </Button>
          </div>
        )}
      </div>
    </div>

    {image ? (
      <figure class="relative min-h-72 overflow-hidden lg:h-full">
        <OptimizedImage
          src={image}
          alt={title}
          width={960}
          height={1200}
          class="size-full min-h-72 object-cover lg:absolute lg:inset-0 lg:h-full lg:min-h-full"
          priority={true}
        />
        <div
          class="pointer-events-none absolute inset-0 hidden bg-gradient-to-r from-background via-background/20 to-transparent lg:block"
          aria-hidden="true"
        ></div>
      </figure>
    ) : proofPlaque ? (
      <ProofPlaque figure={proofPlaque.figure} caption={proofPlaque.caption} size="hero" flush />
    ) : null}
  </div>
</section>
