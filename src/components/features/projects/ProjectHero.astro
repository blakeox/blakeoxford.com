---
import OptimizedImage, {
  type Props as OptimizedImageProps,
} from '../../primitives/OptimizedImage.astro';
import Container from '../../primitives/Container.astro';
import Button from '../../primitives/Button.astro';
import DotMetaList from '../../composites/DotMetaList.astro';
import ArrowLeftIcon from '../../primitives/icons/ArrowLeftIcon.astro';
import ExternalLinkIcon from '../../primitives/icons/ExternalLinkIcon.astro';

export interface Props {
  title: string;
  description: string;
  date: Date;
  image: OptimizedImageProps['src'];
  link?: string;
  categories?: string[];
  /** Lead result — what this engagement proved. */
  outcome?: string;
}

const { title, description, date, image, link, categories = [], outcome } = Astro.props;

const formattedDate = date.toLocaleDateString(undefined, {
  month: 'long',
  year: 'numeric',
});
const dateISO = date.toISOString();
---

<section class="relative isolate overflow-hidden border-b border-border/40 py-14 sm:py-16 md:py-20">
  <div
    class="pointer-events-none absolute top-0 right-0 size-96 rounded-full bg-accent-subtle blur-3xl"
    aria-hidden="true"
  >
  </div>

  <Container size="xl" class="relative z-10">
    <div class="grid items-center gap-8 lg:grid-cols-[minmax(0,1.05fr)_minmax(0,0.95fr)] lg:gap-12">
      <div class="flex flex-col gap-5">
        <div
          class="flex flex-wrap items-center gap-x-4 gap-y-1.5 text-xs font-semibold tracking-smallcaps text-subtle-foreground uppercase"
        >
          <a
            href="/projects/"
            class="inline-flex items-center gap-2 text-accent-emphasis transition-colors hover:text-accent"
            aria-label="Back to selected work"
          >
            <ArrowLeftIcon />
            Selected work
          </a>
          <span aria-hidden="true" class="text-border">·</span>
          <time datetime={dateISO}>{formattedDate}</time>
        </div>

        <div class="space-y-2.5">
          <p class="section-kicker">Case study</p>
          <h1
            class="font-heading text-4xl leading-[1.1] font-semibold tracking-tight text-pretty text-foreground sm:text-5xl lg:text-6xl"
          >
            {title}
          </h1>
          {
            outcome && (
              <p class="font-heading text-lg font-semibold tracking-tight text-accent-emphasis sm:text-xl">
                {outcome}
              </p>
            )
          }
          {
            description && (
              <p class="max-w-xl pt-0.5 text-lg leading-relaxed text-pretty text-muted-foreground sm:text-xl">
                {description}
              </p>
            )
          }
        </div>

        <DotMetaList items={categories} label="Focus areas" />

        {
          link && (
            <div>
              <Button variant="outline" href={link} target="_blank" rel="noopener noreferrer">
                Visit project
                <ExternalLinkIcon />
              </Button>
            </div>
          )
        }
      </div>

      <figure class="relative">
        <div class="overflow-hidden ring-1 ring-border/40">
          <OptimizedImage
            src={image}
            alt={title}
            width={960}
            height={720}
            class="aspect-[4/3] h-full w-full object-cover"
            priority={true}
          />
        </div>
      </figure>
    </div>
  </Container>
</section>
