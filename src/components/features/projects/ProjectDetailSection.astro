---
import BadgePill from '../../primitives/BadgePill.astro';

export interface Props {
  title: string;
  eyebrow?: string;
  id?: string;
  description?: string;
  subtitle?: string;
  layout?: 'default' | 'surface';
}

const { title, eyebrow, id, description, subtitle, layout = 'default' } = Astro.props;

const containerClasses =
  layout === 'surface'
    ? 'rounded-[2.5rem] bg-surface/95 p-6 sm:p-8 lg:p-10 ring-1 ring-border/30 shadow-lg backdrop-blur-sm'
    : 'rounded-[2.75rem] bg-background/96 p-6 sm:p-9 lg:p-10 ring-1 ring-border/30 shadow-lg backdrop-blur-sm';
---
<section class={`relative flex flex-col gap-6 ${containerClasses}`}>
  <div class="space-y-3 w-full">
    {eyebrow && (
      <BadgePill size="xs" showDot>
        {eyebrow}
      </BadgePill>
    )}
    <h2 id={id} class="font-heading text-2xl sm:text-3xl md:text-4xl font-semibold text-foreground dark:text-foreground-light">
      {title}
    </h2>
    {subtitle && (
      <p class="max-w-3xl text-sm font-semibold uppercase tracking-label text-foreground/65 dark:text-foreground-light/65">
        {subtitle}
      </p>
    )}
    {description && (
      <p class="max-w-3xl text-base leading-relaxed text-foreground/80 dark:text-foreground-light/80">
        {description}
      </p>
    )}
  </div>
  <div class="flex flex-col gap-5 sm:gap-6 text-pretty w-full">
    <slot />
  </div>
</section>
