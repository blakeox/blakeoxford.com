---
export interface Props {
  title: string;
  eyebrow?: string;
  id?: string;
  description?: string;
  layout?: 'default' | 'surface';
}

const { title, eyebrow, id, description, layout = 'default' } = Astro.props;

const containerClasses =
  layout === 'surface'
    ? 'rounded-[2.5rem] bg-surface/95 p-10 ring-1 ring-border/30 shadow-card backdrop-blur-sm'
    : 'rounded-[2.75rem] bg-background/96 p-10 ring-1 ring-border/30 shadow-card backdrop-blur-sm';
---
<section id={id} class={`relative flex flex-col gap-6 ${containerClasses}`}>
  <div class="space-y-3">
    {eyebrow && (
      <span class="inline-flex items-center gap-2 rounded-full bg-surface-subtle px-4 py-1 text-[0.65rem] font-semibold uppercase tracking-[0.28em] text-foreground/65 ring-1 ring-border/30 dark:bg-surface-dark-subtle dark:text-foreground-light/70">
        <span class="h-1.5 w-1.5 rounded-full bg-accent"></span>
        {eyebrow}
      </span>
    )}
    <h2 class="font-heading text-3xl font-semibold text-foreground dark:text-foreground-light">
      {title}
    </h2>
    {description && (
      <p class="max-w-3xl text-base leading-relaxed text-foreground/75 dark:text-foreground-light/75">
        {description}
      </p>
    )}
  </div>
  <div class="flex flex-col gap-6 text-pretty">
    <slot />
  </div>
</section>
