---
export interface Props {
  title: string;
  eyebrow?: string;
  id?: string;
  description?: string;
  subtitle?: string;
  layout?: 'default' | 'surface';
}

const { title, eyebrow, id, description, subtitle, layout = 'default' } = Astro.props;

const containerClasses =
  layout === 'surface'
    ? 'rounded-[2.5rem] bg-surface/95 p-6 sm:p-8 lg:p-10 ring-1 ring-border/30 shadow-lg backdrop-blur-sm'
    : 'rounded-[2.75rem] bg-background/96 p-6 sm:p-9 lg:p-10 ring-1 ring-border/30 shadow-lg backdrop-blur-sm';
---
<section class={`relative flex flex-col gap-6 ${containerClasses}`}>
  <div class="space-y-3 max-w-6xl w-full mx-auto">
    {eyebrow && (
      <span class="inline-flex items-center gap-2 rounded-full bg-surface-subtle px-4 py-1 text-xxs font-semibold uppercase tracking-label text-foreground/65 ring-1 ring-border/30 dark:bg-surface-dark-subtle dark:text-foreground-light/70">
        <span class="h-1.5 w-1.5 rounded-full bg-accent"></span>
        {eyebrow}
      </span>
    )}
    <h2 id={id} class="font-heading text-3xl font-semibold text-foreground dark:text-foreground-light">
      {title}
    </h2>
    {subtitle && (
      <p class="max-w-3xl text-sm font-semibold uppercase tracking-label text-foreground/65 dark:text-foreground-light/65">
        {subtitle}
      </p>
    )}
    {description && (
      <p class="max-w-3xl text-base leading-relaxed text-foreground/80 dark:text-foreground-light/80">
        {description}
      </p>
    )}
  </div>
  <div class="flex flex-col gap-5 sm:gap-6 text-pretty max-w-6xl w-full mx-auto">
    <slot />
  </div>
</section>
