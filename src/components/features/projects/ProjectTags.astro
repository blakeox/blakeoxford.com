---
export interface Props {
  tags: string[];
}

const { tags } = Astro.props;
---

<aside class="bg-surface dark:bg-surface-dark py-16">
  <div class="w-full px-6 lg:px-12 xl:px-16">
    <h2 class="font-heading font-bold text-3xl mb-8 text-foreground dark:text-white">Related Technologies</h2>
    <div class="flex flex-wrap gap-4">
      {tags.map((tag: string) => (
        <a
          href={`/projects/?filter=${tag.toLowerCase().replace(/ /g, '-')}`}
          class="inline-flex items-center px-6 py-3 bg-surface dark:bg-surface-dark text-foreground/85 dark:text-foreground-light border border-neutral-light dark:border-neutral-dark rounded-lg hover:bg-accent hover:text-white hover:border-accent transition-all duration-200 font-medium text-base"
          aria-label={`Filter projects by ${tag}`}
        >
          {tag}
        </a>
      ))}
    </div>
  </div>
</aside> 