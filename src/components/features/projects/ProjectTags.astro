---
import Flex from '../../primitives/Flex.astro';
import BadgePill from '../../primitives/BadgePill.astro';
import GradientOverlay from '../../primitives/GradientOverlay.astro';

export interface Props {
  tags: string[];
}

const { tags } = Astro.props;

const normalizedTags = Array.isArray(tags)
  ? tags
      .map((tag) => (typeof tag === 'string' ? tag.trim() : ''))
      .filter((tag) => tag.length > 0)
  : [];
---
{normalizedTags.length > 0 && (
  <aside class="relative overflow-hidden rounded-[2.25rem] bg-surface/95 py-16 ring-1 ring-border/35 shadow-lg">
    <GradientOverlay variant='background' direction='br' opacity='light' />
    <div class="relative flex w-full flex-col gap-8 px-6 sm:px-8 lg:px-10">
      <div class="max-w-2xl space-y-3">
        <h2 class="font-heading text-2xl sm:text-3xl md:text-4xl font-semibold text-foreground dark:text-foreground-light">
          Related technologies
        </h2>
        <p class="text-sm text-foreground/70 dark:text-foreground-light/70">
          Explore additional case studies anchored in the same stack. Each tag filters the projects feed.
        </p>
      </div>

      <Flex wrap gap="sm" role="list">
        {normalizedTags.map((tag) => {
          const filterParam = tag.toLowerCase().replace(/\s+/g, '-');

          return (
            <a
              href={`/projects/?filter=${filterParam}`}
              aria-label={`Filter projects by ${tag}`}
              role="listitem"
              class="group"
            >
              <BadgePill size="sm" showDot class="transition-colors duration-200 hover:text-accent focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent/50">
                {tag}
              </BadgePill>
            </a>
          );
        })}
      </Flex>
    </div>
  </aside>
)}
