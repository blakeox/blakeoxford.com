---
/**
 * Related stack labels — display only (no broken ?filter= links).
 */
import DotMetaList from '../../composites/DotMetaList.astro';

export interface Props {
  tags: string[];
}

const { tags } = Astro.props;

const normalizedTags = Array.isArray(tags)
  ? tags.map((tag) => (typeof tag === 'string' ? tag.trim() : '')).filter((tag) => tag.length > 0)
  : [];
---

{
  normalizedTags.length > 0 && (
    <aside class="border-t border-border/50 pt-10" aria-labelledby="case-stack-heading">
      <div class="max-w-2xl space-y-2">
        <h2
          id="case-stack-heading"
          class="font-heading text-xl leading-snug font-semibold tracking-tight text-foreground sm:text-2xl"
        >
          Stack & focus
        </h2>
        <p class="text-sm leading-relaxed text-muted-foreground">
          Tools and domains this engagement relied on.
        </p>
      </div>
      <DotMetaList items={normalizedTags} label="Stack and focus areas" class="mt-5" />
    </aside>
  )
}
