---
export interface Props {
  tags: string[];
}

const { tags } = Astro.props;

const normalizedTags = Array.isArray(tags)
  ? tags
      .map((tag) => (typeof tag === 'string' ? tag.trim() : ''))
      .filter((tag) => tag.length > 0)
  : [];
---
{normalizedTags.length > 0 && (
  <aside class="relative overflow-hidden rounded-[2.25rem] bg-surface/95 py-16 ring-1 ring-border/35 shadow-card">
    <div class="pointer-events-none absolute inset-0 bg-gradient-to-br from-background/45 via-transparent to-background/60" aria-hidden="true"></div>
    <div class="relative mx-auto flex w-full max-w-5xl flex-col gap-8 px-6 sm:px-10">
      <div class="max-w-2xl space-y-3">
        <h2 class="font-heading text-3xl font-semibold text-foreground dark:text-foreground-light">
          Related technologies
        </h2>
        <p class="text-sm text-foreground/70 dark:text-foreground-light/70">
          Explore additional case studies anchored in the same stack. Each tag filters the projects feed.
        </p>
      </div>

      <div class="flex flex-wrap gap-3" role="list">
        {normalizedTags.map((tag) => {
          const filterParam = tag.toLowerCase().replace(/\s+/g, '-');

          return (
            <a
              href={`/projects/?filter=${filterParam}`}
              class="group inline-flex items-center gap-2 rounded-full bg-surface-subtle px-5 py-2 text-sm font-semibold text-foreground/70 ring-1 ring-border/30 transition-colors duration-200 hover:text-accent focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent/50 dark:bg-surface-dark-subtle dark:text-foreground-light/75"
              aria-label={`Filter projects by ${tag}`}
              role="listitem"
            >
              <span class="h-1.5 w-1.5 rounded-full bg-accent transition-transform duration-200 group-hover:scale-125"></span>
              {tag}
            </a>
          );
        })}
      </div>
    </div>
  </aside>
)}
