---
import type { CollectionEntry } from 'astro:content';
import type { AstroComponentFactory } from 'astro/runtime/server/index.js';
import ProjectDetailSection from './ProjectDetailSection.astro';
import ProjectTags from './ProjectTags.astro';
import MetricsTable from '@/components/composites/MetricsTable.astro';
import EditorialList from '@/components/composites/EditorialList.astro';
import Container from '@/components/primitives/Container.astro';

interface Props {
  data: CollectionEntry<'projects'>['data'];
  Content: AstroComponentFactory;
  metrics: Array<{ metric: string; result: string; timeline: string }>;
  journey: Array<{ title: string; body: string }>;
  lessons: Array<{ title: string; description: string }>;
  reflection?: string;
  hasMetrics: boolean;
  hasJourney: boolean;
  hasLessons: boolean;
}

const { data, Content, metrics, journey, lessons, reflection, hasMetrics, hasJourney, hasLessons } =
  Astro.props as Props;

const hasHighlights = Boolean(data.highlights?.length);
const hasCtaSlot = Astro.slots.has('cta');

/** When metrics already carry the proof, skip impact rows that restate those figures. */
const impactRows = (data.impact ?? [])
  .filter((item: string) => {
    if (!hasMetrics) return true;
    const normalized = item.toLowerCase();
    return !metrics.some((row) => {
      const result = row.result.toLowerCase();
      const metric = row.metric.toLowerCase();
      return normalized.includes(result) || normalized.includes(metric);
    });
  })
  .map((item: string) => ({ body: item }));

const showImpactList = impactRows.length > 0;
const showProof = hasMetrics || showImpactList;

const journeyRows = journey.map((item) => ({ title: item.title, body: item.body }));
const lessonRows = lessons.map((lesson: { title: string; description: string }) => ({
  title: lesson.title,
  body: lesson.description,
}));
const highlightRows = (data.highlights ?? []).map((item: string) => ({ body: item }));
---

<article class="relative isolate py-section-md sm:py-section-lg lg:py-section-xl">
  <Container size="xl" class="relative flex flex-col gap-12 sm:gap-14 lg:gap-16">
    <ProjectDetailSection title="Overview" eyebrow="Context">
      <div class="prose-case max-w-none space-y-4 text-base leading-relaxed text-muted-foreground sm:text-lg">
        <Content />
      </div>
    </ProjectDetailSection>

    {showProof ? (
      <ProjectDetailSection title="Impact" eyebrow="Proof">
        <div class="flex flex-col gap-8">
          {hasMetrics ? <MetricsTable metrics={metrics} /> : null}
          {showImpactList ? <EditorialList rows={impactRows} numbered={false} /> : null}
        </div>
      </ProjectDetailSection>
    ) : null}

    {hasCtaSlot ? (
      <ProjectDetailSection
        id="case-next-steps"
        title="Next steps"
        eyebrow="Continue the conversation"
      >
        <slot name="cta" />
      </ProjectDetailSection>
    ) : null}

    {hasHighlights ? (
      <ProjectDetailSection title="What shipped" eyebrow="Highlights">
        <EditorialList rows={highlightRows} numbered={false} />
      </ProjectDetailSection>
    ) : null}

    {hasJourney ? (
      <ProjectDetailSection title="Journey" eyebrow="How it unfolded">
        <EditorialList rows={journeyRows} />
      </ProjectDetailSection>
    ) : null}

    {hasLessons ? (
      <ProjectDetailSection title="Lessons" eyebrow="What stuck">
        <EditorialList rows={lessonRows} numbered={false} />
      </ProjectDetailSection>
    ) : null}

    {reflection ? (
      <ProjectDetailSection title="Reflection" eyebrow="Personal note">
        <blockquote class="max-w-2xl border-l-2 border-accent/60 pl-5 text-lg leading-relaxed text-foreground italic sm:pl-6 sm:text-xl">
          {reflection}
        </blockquote>
      </ProjectDetailSection>
    ) : null}

    <ProjectTags tags={data.tags ?? []} />
  </Container>
</article>
