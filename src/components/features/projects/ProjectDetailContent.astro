---
import type { CollectionEntry } from 'astro:content';
import type { AstroComponentFactory } from 'astro/runtime/server/index.js';
import ProjectDetailSection from './ProjectDetailSection.astro';
import OutcomeCard from '../../composites/OutcomeCard.astro';
import BulletListItem from '../../primitives/BulletListItem.astro';
import BackgroundGrid from '../../primitives/BackgroundGrid.astro';
import ProjectTags from './ProjectTags.astro';
import Grid from '../../primitives/Grid.astro';
import MetricsTable from '../../composites/MetricsTable.astro';
import Flex from '../../primitives/Flex.astro';

interface Props {
  data: CollectionEntry<'projects'>['data'];
  Content: AstroComponentFactory;
  metrics: Array<{ metric: string; result: string; timeline: string }>;
  journey: string[];
  lessons: Array<{ title: string; description: string }>;
  categories: string[];
  reflection?: string;
  hasMetrics: boolean;
  hasJourney: boolean;
  hasLessons: boolean;
  hasCategories: boolean;
}

const {
  data,
  Content,
  metrics,
  journey,
  lessons,
  categories,
  reflection,
  hasMetrics,
  hasJourney,
  hasLessons,
  hasCategories,
} = Astro.props as Props;
---

<article class="relative isolate overflow-hidden bg-gradient-to-b from-surface-subtle via-background to-background py-24">
  <BackgroundGrid opacity={35} size="200px" />
  <div class="relative mx-auto flex w-full max-w-7xl flex-col gap-14 px-4 sm:px-6 lg:px-8">
    <ProjectDetailSection title="Program overview" eyebrow="Context" description={data.description}>
      <div class="max-w-none space-y-6 text-base leading-relaxed text-muted-foreground">
        <Content />
      </div>
    </ProjectDetailSection>

    {data.highlights?.length ? (
      <ProjectDetailSection title="Highlights" eyebrow="What resonated" layout="surface">
        <OutcomeCard title="Program outcomes" achievements={data.highlights} />
      </ProjectDetailSection>
    ) : null}

    {(hasMetrics || data.impact?.length) ? (
      <ProjectDetailSection title="Impact signals" eyebrow="Proof of traction" layout={hasMetrics ? 'surface' : undefined}>
        <div class="flex flex-col gap-6">
          {hasMetrics ? <MetricsTable metrics={metrics} /> : null}
          {data.impact?.length ? (
            <ul class="flex flex-col gap-3 text-sm leading-relaxed text-muted-foreground" role="list">
              {(data.impact ?? []).map((item: string) => (
                <BulletListItem text={item} />
              ))}
            </ul>
          ) : null}
        </div>
      </ProjectDetailSection>
    ) : null}

    {hasJourney ? (
      <ProjectDetailSection title="Journey" eyebrow="How it unfolded">
        <ul class="space-y-3 text-sm leading-relaxed text-muted-foreground" role="list">
          {journey.map((item: string) => (
            <BulletListItem><span set:html={item} /></BulletListItem>
          ))}
        </ul>
      </ProjectDetailSection>
    ) : null}

    {hasCategories ? (
      <ProjectDetailSection title="Program pillars" eyebrow="Where it delivered" layout="surface">
        <Flex wrap gap="xs" class="text-xs font-semibold uppercase tracking-label text-subtle-foreground">
          {categories.map((category: string) => (
            <span class="rounded-full bg-surface-subtle px-3 py-1 ring-1 ring-border/25 dark:bg-surface-dark-subtle">{category}</span>
          ))}
        </Flex>
      </ProjectDetailSection>
    ) : null}

    {hasLessons ? (
      <ProjectDetailSection title="Lessons" eyebrow="What stuck" layout="surface">
        <Grid cols="2" gap="md">
          {lessons.map((lesson) => (
            <article class="flex flex-col gap-2 rounded-2xl border border-border/25 bg-background/95 p-4 shadow-sm">
              <h3 class="text-lg font-semibold text-foreground">{lesson.title}</h3>
              <p class="text-sm leading-relaxed text-muted-foreground">{lesson.description}</p>
            </article>
          ))}
        </Grid>
      </ProjectDetailSection>
    ) : null}

    {reflection ? (
      <ProjectDetailSection title="Reflection" eyebrow="Personal note">
        <blockquote class="border-l-4 border-accent/80 bg-surface-subtle/80 p-6 text-base italic leading-relaxed text-muted-foreground dark:bg-surface-dark-subtle">
          {reflection}
        </blockquote>
      </ProjectDetailSection>
    ) : null}

    <ProjectDetailSection title="Next steps" eyebrow="Ready to explore?" layout="surface">
      <slot name="cta" />
    </ProjectDetailSection>

    <ProjectTags tags={data.tags ?? []} />
  </div>
</article>
