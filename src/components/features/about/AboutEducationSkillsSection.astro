---
import Section from '../../primitives/Section.astro';
import Grid from '../../primitives/Grid.astro';
import Flex from '../../primitives/Flex.astro';
import FloatingBlur from '../../primitives/FloatingBlur.astro';
import SkillBadge from '../../primitives/SkillBadge.astro';
import EducationCard from './EducationCard.astro';

export interface AboutEducationContent {
  kicker: string;
  title: string;
  description: string;
  institution: string;
  degree: string;
  educationDescription: string;
  skillsIntro: string;
  skills: string[];
}

interface Props {
  content: AboutEducationContent;
}

const { content } = Astro.props;
---

<Section padding="lg" container="lg" class="relative overflow-hidden bg-gradient-to-b from-background to-surface">
  <div class="absolute inset-0 z-0 overflow-hidden opacity-20">
    <div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
      <FloatingBlur size="lg" color="accent" position="custom" class="top-1/4 left-1/4" />
      <FloatingBlur size="lg" color="primary" position="custom" class="bottom-1/4 right-1/4" />
    </div>
  </div>
  <div class="relative z-10">
    <div class="section-intro mb-12">
      <span class="section-kicker">{content.kicker}</span>
      <h2 class="font-heading text-3xl font-semibold text-foreground sm:text-4xl md:text-5xl">{content.title}</h2>
      <p class="text-lg text-muted-foreground">
        {content.description}
      </p>
    </div>
    <Grid cols="2" gap="xl" class="items-stretch">
      <div class="flex h-full flex-col">
        <h2 class="mb-6 border-l-4 border-accent pl-4 text-2xl font-semibold sm:text-3xl">Education</h2>
        <EducationCard
          institution={content.institution}
          degree={content.degree}
          description={content.educationDescription}
        />
      </div>

      <div class="flex h-full flex-col">
        <h2 class="mb-6 border-l-4 border-accent pl-4 text-2xl font-semibold sm:text-3xl">Skills</h2>
        <div class="flex flex-1 flex-col rounded-xl border border-border bg-surface p-6 shadow-lg">
          <p class="mb-4 text-muted-foreground">{content.skillsIntro}</p>
          <Flex as="ul" wrap gap="sm" role="list" class="flex-1">
            {content.skills.map((skill) => (
              <SkillBadge skill={skill} />
            ))}
          </Flex>
        </div>
      </div>
    </Grid>
  </div>
</Section>
