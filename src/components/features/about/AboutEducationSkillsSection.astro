---
/**
 * Background — quiet education + toolkit, not elevated skill cards.
 */
import Section from '@/components/primitives/Section.astro';
import SectionHeader from '@/components/composites/SectionHeader.astro';
import { headingSizeClass } from '@/lib/typeScale';

export interface AboutEducationContent {
  kicker: string;
  title: string;
  description: string;
  institution: string;
  degree: string;
  educationDescription: string;
  skillsIntro: string;
  skills: string[];
}

interface Props {
  content: AboutEducationContent;
}

const { content } = Astro.props;
---

<Section
  id="about-background"
  padding="lg"
  container="lg"
  aria-labelledby="about-background-heading"
>
  <SectionHeader
    kicker={content.kicker}
    title={content.title}
    titleId="about-background-heading"
    description={content.description}
  />

  <div class="grid gap-10 border-y border-border/50 py-8 sm:py-10 md:grid-cols-2 md:gap-16">
    <div class="max-w-xl space-y-2">
      <p class="text-xs font-semibold tracking-smallcaps text-subtle-foreground uppercase">
        Education
      </p>
      <h3
        class:list={[
          'font-heading font-semibold tracking-tight text-foreground',
          headingSizeClass('title'),
        ]}
      >
        {content.degree}
      </h3>
      <p class="text-base font-semibold text-foreground">{content.institution}</p>
      <p class="max-w-md pt-0.5 text-base leading-relaxed text-muted-foreground">
        {content.educationDescription}
      </p>
    </div>
    <div class="min-w-0">
      <h3
        class:list={[
          'font-heading font-semibold tracking-tight text-foreground',
          headingSizeClass('title'),
        ]}
      >
        Practical toolkit
      </h3>
      <p class="mt-3 text-base leading-relaxed text-muted-foreground">{content.skillsIntro}</p>
      <ul
        class="mt-6 grid gap-x-6 gap-y-3 sm:grid-cols-2"
        aria-label="Practical capabilities"
        role="list"
      >
        {content.skills.map((skill) => (
          <li class="flex items-start gap-3 text-sm leading-relaxed text-muted-foreground">
            <span class="mt-2 size-1 shrink-0 rounded-full bg-accent" aria-hidden="true" />
            <span>{skill}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</Section>
