---
/**
 * Background — quiet education + toolkit, not elevated skill cards.
 */
import Section from '../../primitives/Section.astro';
import SectionHeader from '../../composites/SectionHeader.astro';

export interface AboutEducationContent {
  kicker: string;
  title: string;
  description: string;
  institution: string;
  degree: string;
  educationDescription: string;
  skillsIntro: string;
  skills: string[];
}

interface Props {
  content: AboutEducationContent;
}

const { content } = Astro.props;
---

<Section
  id="about-background"
  padding="lg"
  container="lg"
  aria-labelledby="about-background-heading"
>
  <SectionHeader
    kicker={content.kicker}
    title={content.title}
    titleId="about-background-heading"
    description={content.description}
  />

  <div class="grid gap-10 border-y border-border/50 py-8 sm:py-10 lg:grid-cols-2 lg:gap-14">
    <div class="space-y-2">
      <p class="text-xs font-semibold tracking-smallcaps text-subtle-foreground uppercase">
        Education
      </p>
      <h3 class="font-heading text-2xl leading-snug font-semibold tracking-tight text-foreground">
        {content.degree}
      </h3>
      <p class="text-base font-semibold text-accent-emphasis">{content.institution}</p>
      <p class="max-w-md pt-0.5 text-base leading-relaxed text-muted-foreground">
        {content.educationDescription}
      </p>
    </div>

    <div class="space-y-2.5">
      <p class="text-xs font-semibold tracking-smallcaps text-subtle-foreground uppercase">
        Working toolkit
      </p>
      <p class="max-w-md text-base leading-relaxed text-muted-foreground">
        {content.skillsIntro}
      </p>
      <ul
        class="flex flex-wrap gap-x-4 gap-y-1.5 pt-0.5 text-sm text-foreground/85"
        role="list"
        aria-label="Skills"
      >
        {
          content.skills.map((skill) => (
            <li class="flex items-center gap-2">
              <span class="size-1 rounded-full bg-accent" aria-hidden="true" />
              <span>{skill}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</Section>
