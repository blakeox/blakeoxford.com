---
/**
 * Editorial timeline — years and outcomes.
 */
import Section from '../../primitives/Section.astro';
import SectionHeader from '../../composites/SectionHeader.astro';
import EditorialList from '../../composites/EditorialList.astro';

interface TimelineItem {
  year: string;
  title: string;
  achievements: string[];
}

interface Props {
  kicker: string;
  title: string;
  description: string;
  items: TimelineItem[];
}

const { kicker, title, description, items } = Astro.props as Props;

const rows = items.map((item) => ({
  kicker: item.year,
  title: item.title,
  bullets: item.achievements,
}));
---

<Section
  id="about-timeline"
  padding="xl"
  container="lg"
  background="surface"
  aria-labelledby="about-timeline-heading"
>
  <SectionHeader
    kicker={kicker}
    title={title}
    titleId="about-timeline-heading"
    description={description}
  />
  <EditorialList rows={rows} numbered={false} />
</Section>
