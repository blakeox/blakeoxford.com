---
import Section from '../../primitives/Section.astro';
import SectionHeading from '../../primitives/SectionHeading.astro';
import TimelineCard from './TimelineCard.astro';
import TimelineCardMobile from './TimelineCardMobile.astro';

interface TimelineItem {
 year: string;
 icon: '🔄' | '☁️' | '💡' | '🤖';
 title: string;
 achievements: string[];
 color: string;
}

export interface AboutTimelineContent {
 kicker: string;
 title: string;
 description: string;
 items: TimelineItem[];
}

interface Props {
 content: AboutTimelineContent;
}

const { content } = Astro.props as Props;
const { items } = content;
---

<Section id="about-timeline" padding="lg" container="lg" class="relative overflow-hidden bg-surface">
 <div class="absolute inset-0 z-0 opacity-10">
 <div class="absolute inset-0" aria-hidden="true">
 <svg xmlns="http://www.w3.org/2000/svg" width="100%" height="100%">
 </svg>
 </div>
 </div>
 <div class="relative z-10">
 <div class="section-intro mx-auto mb-16 max-w-3xl">
 <span class="section-kicker">{content.kicker}</span>
 <SectionHeading size="3xl" class="mb-2">{content.title}</SectionHeading>
 <p class="text-lg text-muted-foreground">
 {content.description}
 </p>
 </div>
 <div class="timeline-desktop relative hidden md:block">
 <div class="absolute left-1/2 h-full w-1 -translate-x-1/2 transform bg-gradient-to-b from-accent via-primary to-accent opacity-80 animate-gradient-shift"></div>
 <div class="space-y-0">
 {items.map((item, index) => (
 <div class={`relative z-10 flex items-center justify-${index % 2 === 0 ? 'start' : 'end'} group`}>
 <div class={`mb-16 flex w-full ${index % 2 === 0 ? '' : 'justify-end'}`}>
 <div class={`${index % 2 === 0 ? 'ml-0 mr-8 text-right' : 'ml-8 mr-0'} w-5/12`}>
 <TimelineCard
 year={item.year}
 icon={item.icon}
 title={item.title}
 achievements={item.achievements}
 color={item.color}
 />
 </div>
 </div>
 <div class="absolute left-1/2 top-1/2 h-5 w-5 -translate-x-1/2 -translate-y-1/2 transform rounded-full border-4 border-background bg-accent transition-transform duration-moderate group-hover:scale-125">
 <div class="absolute inset-0 rounded-full bg-accent opacity-75 animate-ping"></div>
 </div>
 </div>
 ))}
 </div>
 </div>

 <div class="timeline-scroll-container timeline-mobile overflow-x-auto pb-8 focus:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-surface md:hidden" role="region" aria-label="Timeline events" tabindex="0">
 <div class="inline-flex min-w-max space-x-6 px-4 pb-6">
 {items.map((item) => (
 <TimelineCardMobile
 year={item.year}
 icon={item.icon}
 title={item.title}
 achievements={item.achievements}
 color={item.color}
 />
 ))}
 </div>
 </div>

 <style>
 @keyframes gradient-shift {
 0% { background-position: 0% 0%; }
 50% { background-position: 0% 100%; }
 100% { background-position: 0% 0%; }
 }
 .animate-gradient-shift {
 background-size: 100% 200%;
 animation: gradient-shift 8s ease infinite;
 }
 @media (min-width: 768px) {
 #about-timeline .timeline-desktop { display: block !important; }
 #about-timeline .timeline-mobile { display: none !important; }
 }
 @media (max-width: 767.98px) {
 #about-timeline .timeline-desktop { display: none !important; }
 #about-timeline .timeline-mobile { display: block !important; }
 }
 .timeline-scroll-container::-webkit-scrollbar {
 height: 8px;
 }
 .timeline-scroll-container::-webkit-scrollbar-track {
 background: color-mix(in oklch, var(--color-foreground) 20%, transparent);
 border-radius: 4px;
 }
 .timeline-scroll-container::-webkit-scrollbar-thumb {
 background: color-mix(in oklch, var(--color-accent) 50%, transparent);
 border-radius: 4px;
 }
 .timeline-scroll-container::-webkit-scrollbar-thumb:hover {
 background: color-mix(in oklch, var(--color-accent) 70%, transparent);
 }
 </style>
 </div>
</Section>
