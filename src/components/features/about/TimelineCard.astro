---
/**
 * TimelineCard - Reusable timeline event card
 * Used in about.astro for professional journey timeline
 */
import GradientOverlay from '../../primitives/GradientOverlay.astro';
import BaseCard from '../../primitives/BaseCard.astro';

export interface Props {
  year: string;
  icon: '🔄' | '☁️' | '💡' | '🤖';
  title: string;
  achievements: string[];
  color?: string;
}

const { year, icon, title, achievements, color = 'from-accent to-primary' } = Astro.props;

// Icon SVG mapping
const iconSVGs = {
  '🔄': '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />',
  '☁️': '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999 5.002 5.002 0 10-9.78 2.096A4.001 4.001 0 003 15z" />',
  '💡': '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />',
  '🤖': '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 3v2m6-2v2M9 19v2m6-2v2M5 9H3m2 6H3m18-6h-2m2 6h-2M7 19h10a2 2 0 002-2V7a2 2 0 00-2-2H7a2 2 0 00-2 2v10a2 2 0 002 2zM9 9h6v6H9V9z" />',
};
---

<BaseCard
  data-testid="timeline-card"
  hover="lift"
  padding="lg"
  class="group @container relative overflow-hidden backdrop-blur-sm"
>
  <!-- Background gradient effect -->
  <GradientOverlay variant="hover-subtle" direction="r" />

  <div class="relative mb-6 flex items-center gap-4">
    <div
      class={`inline-flex items-center justify-center w-16 h-16 rounded-full bg-gradient-to-br ${color} text-2xl motion-safe:group-hover:scale-110 motion-safe:transition-transform motion-safe:duration-moderate relative`}
    >
      <!-- Multiple gradient layers for depth -->
      <div
        class="absolute inset-0 rounded-full bg-gradient-to-br from-accent/20 to-primary/20 opacity-0 blur-md transition-opacity duration-moderate group-hover:opacity-100"
      >
      </div>
      <div
        class="absolute inset-0 rounded-full bg-gradient-to-br from-accent/30 to-primary/30 opacity-20 transition-opacity duration-moderate group-hover:opacity-30"
      >
      </div>
      <!-- Enhanced icon container -->
      <div class="relative z-10 h-8 w-8">
        <svg
          class="h-full w-full"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          aria-hidden="true"
          focusable="false"
          set:html={iconSVGs[icon]}
        />
      </div>
    </div>
    <div class="flex-1">
      <h3
        class="text-2xl font-bold text-foreground-strong transition-colors duration-moderate group-hover:text-accent-emphasis @sm:text-3xl"
      >
        {year}
      </h3>
      <p
        class="text-accent-emphasis transition-colors duration-moderate group-hover:text-accent/80"
      >
        {title}
      </p>
    </div>
  </div>

  <div
    class="relative space-y-3 border-l-2 border-border pl-4 transition-colors duration-moderate group-hover:border-accent/50"
  >
    {
      achievements.map((achievement, idx) => (
        <p
          class="flex transform items-start rounded-lg p-2 text-foreground/90 transition-all duration-moderate group-hover:text-foreground hover:bg-surface-subtle/50 motion-safe:hover:translate-x-1"
          style={`transition-delay: ${idx * 50}ms`}
        >
          <svg
            class="mt-1 mr-2 h-4 w-4 flex-shrink-0 text-accent opacity-0 transition-opacity duration-moderate group-hover:opacity-100"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            aria-hidden="true"
            focusable="false"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"
            />
          </svg>
          {achievement}
        </p>
      ))
    }
  </div>

  <!-- Bottom gradient line -->
  <div
    class="absolute bottom-0 left-0 h-1 w-full origin-center scale-x-0 bg-gradient-to-r from-accent/0 via-accent/50 to-accent/0 transition-transform duration-slow group-hover:scale-x-100"
  >
  </div>
</BaseCard>
