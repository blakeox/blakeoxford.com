---
import PageHero from '@/components/composites/PageHero.astro';
import PhotoCarousel from '@/components/composites/PhotoCarousel.astro';
import IntroCopy from '@/components/composites/IntroCopy.astro';

export interface AboutHeroContent {
  kicker: string;
  title: string;
  description: string;
  proofPoints: string[];
}

interface Props {
  content: AboutHeroContent;
}

const { content } = Astro.props;
---

<PageHero id="about-me" flush containerSize="full" containerPadding={false} includeBlurOrbs={false}>
  <div class="relative z-10 flex w-full flex-1 flex-col">
    <div class="about-hero-split flex flex-1 flex-col md:grid md:grid-cols-2 md:gap-0">
      <div class="layout-gutter order-1 flex flex-col justify-center pt-24 pb-10 md:py-14 md:pr-6 lg:pr-10 xl:pr-14">
        <div
          class="mx-auto flex w-full max-w-2xl flex-col gap-8 md:mx-0"
          data-layout-shell="about-hero-copy"
        >
          <IntroCopy
            kicker={content.kicker}
            title={content.title}
            titleId="about-me-title"
            description={content.description}
            size="hero"
            descriptionSize="md"
          />
          <ul
            class="flex flex-col gap-3 border-t border-border/40 pt-5"
            role="list"
            aria-label="How I show up in engagements"
          >
            {content.proofPoints.map((point) => (
              <li class="flex items-start gap-3 text-sm leading-snug text-foreground sm:text-base">
                <span class="mt-2 size-1.5 shrink-0 rounded-full bg-accent" aria-hidden="true" />
                <span>{point}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>

      <div
        class="about-hero-media order-2 w-full overflow-hidden md:h-full"
        data-chat-avoid-launcher
      >
        <div class="relative h-full w-full">
          <PhotoCarousel class="h-full w-full" />
          <div
            class="pointer-events-none absolute inset-0 hidden bg-gradient-to-r from-background/55 via-background/15 to-transparent md:block"
            aria-hidden="true"
          ></div>
        </div>
      </div>
    </div>
  </div>
</PageHero>

<style>
  .about-hero-media {
    height: min(48vh, 24rem);
  }

  @media (width < 768px) {
    .about-hero-split > .layout-gutter {
      min-height: calc(100svh - var(--nav-height));
      padding-bottom: 4.5rem;
    }
  }

  @media (width >= 640px) {
    .about-hero-media {
      height: min(50vh, 26rem);
    }
  }

  @media (width >= 768px) {
    .about-hero-split {
      min-height: calc(100svh - var(--nav-height));
    }

    .about-hero-media {
      height: 100%;
      min-height: 0;
    }
  }
</style>
