---
import PageHero from '@/components/composites/PageHero.astro';
import AboutPhotoStory from './AboutPhotoStory.astro';
import IntroCopy from '@/components/composites/IntroCopy.astro';
import Button from '@/components/primitives/Button.astro';
import ButtonGroup from '@/components/composites/ButtonGroup.astro';

export interface AboutHeroContent {
  kicker: string;
  title: string;
  description: string;
  proofPoints: string[];
}

interface Props {
  content: AboutHeroContent;
}

const { content } = Astro.props;
---

<PageHero id="about-me" fullScreen={false} containerSize="xl">
  <div class="grid items-center gap-10 lg:grid-cols-2 lg:gap-16">
    <div class="about-hero-copy flex min-w-0 flex-col gap-6" data-layout-shell="about-hero-copy">
      <IntroCopy
        kicker={content.kicker}
        title={content.title}
        titleId="about-me-title"
        description={content.description}
        size="hero"
        descriptionSize="md"
      />
      <ul
        class="flex flex-col gap-3 border-t border-border pt-5"
        role="list"
        aria-label="How I show up in engagements"
      >
        {content.proofPoints.map((point) => (
          <li class="flex items-start gap-3 text-base leading-relaxed text-muted-foreground">
            <span class="mt-2.5 size-1 shrink-0 rounded-full bg-accent" aria-hidden="true" />
            <span>{point}</span>
          </li>
        ))}
      </ul>
      <ButtonGroup align="start" responsive>
        <Button variant="primary" size="lg" href="/contact/" data-test="about-cta-connect">
          Discuss your bottleneck
        </Button>
        <Button variant="secondary" size="lg" href="/projects/" data-test="about-cta-work">
          See the work
        </Button>
      </ButtonGroup>
    </div>
    <div class="min-w-0" data-chat-avoid-launcher>
      <AboutPhotoStory />
    </div>
  </div>
</PageHero>
