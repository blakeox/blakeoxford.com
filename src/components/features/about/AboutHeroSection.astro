---
import PageHero from '../../composites/PageHero.astro';
import Stack from '../../primitives/Stack.astro';
import PhotoCarousel from '../../composites/PhotoCarousel.astro';

export interface AboutHeroContent {
  kicker: string;
  title: string;
  description: string;
  proofPoints: string[];
}

interface Props {
  content: AboutHeroContent;
}

const { content } = Astro.props;
---

<PageHero id="about-me" class="min-h-screen py-0" includeBlurOrbs={false}>
  <div class="relative z-10 min-h-screen">
    <div class="flex min-h-screen flex-col md:grid md:grid-cols-2 md:gap-0">
      <div
        class="layout-gutter order-1 flex flex-col justify-start pt-28 pb-8 md:order-1 md:justify-center md:py-16"
      >
        <Stack space="lg" class="mx-auto max-w-2xl">
          <span class="section-kicker">{content.kicker}</span>
          <h1
            id="about-me-title"
            class="font-heading text-4xl leading-tight font-semibold tracking-tight text-foreground sm:text-5xl md:text-6xl"
          >
            {content.title}
          </h1>
          <p class="text-base leading-relaxed text-muted-foreground sm:text-lg md:text-xl">
            {content.description}
          </p>
          <ul
            class="space-y-3 border-t border-border/60 pt-6 text-sm text-foreground/85 sm:text-base"
            role="list"
          >
            {
              content.proofPoints.map((point) => (
                <li class="flex items-start gap-3">
                  <span class="mt-2 size-1.5 shrink-0 rounded-full bg-accent" aria-hidden="true" />
                  <span>{point}</span>
                </li>
              ))
            }
          </ul>
        </Stack>
      </div>

      <div
        class="order-2 min-h-[320px] w-full flex-1 overflow-hidden md:order-2 md:h-full"
        role="complementary"
        aria-label="Photo gallery"
      >
        <div class="relative h-full w-full">
          <PhotoCarousel class="h-full w-full" />
          <div
            class="pointer-events-none absolute inset-0 hidden bg-gradient-to-r from-background/30 via-transparent to-transparent md:block"
          >
          </div>
        </div>
      </div>
    </div>
  </div>
</PageHero>
