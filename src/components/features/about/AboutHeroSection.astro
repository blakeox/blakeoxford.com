---
import PageHero from '../../composites/PageHero.astro';
import PhotoCarousel from '../../composites/PhotoCarousel.astro';
import IntroCopy from '../../composites/IntroCopy.astro';
import Button from '../../primitives/Button.astro';
import ButtonGroup from '../../composites/ButtonGroup.astro';

export interface AboutHeroContent {
  kicker: string;
  title: string;
  description: string;
  proofPoints: string[];
}

interface Props {
  content: AboutHeroContent;
}

const { content } = Astro.props;
---

<PageHero id="about-me" flush containerSize="full" containerPadding={false} includeBlurOrbs={false}>
  <div class="relative z-10 flex w-full flex-1 flex-col">
    <div class="about-hero-split flex flex-col md:grid md:grid-cols-2 md:gap-0">
      <div
        class="layout-gutter order-1 flex flex-col justify-center pt-24 pb-10 md:order-1 md:py-14 md:pr-6 lg:pr-10 xl:pr-14"
      >
        <div class="mx-auto flex w-full max-w-2xl flex-col gap-6 md:mx-0">
          <IntroCopy
            kicker={content.kicker}
            title={content.title}
            titleId="about-me-title"
            description={content.description}
            size="hero"
            descriptionSize="md"
          />
          <ButtonGroup align="start" responsive>
            <Button variant="primary" href="/contact/">Start a conversation</Button>
            <Button variant="ghost" href="/projects/">See the work</Button>
          </ButtonGroup>
        </div>
      </div>

      <div class="about-hero-media order-2 w-full overflow-hidden md:order-2 md:h-full">
        <div class="relative h-full w-full">
          <PhotoCarousel class="h-full w-full" />
          <div
            class="pointer-events-none absolute inset-0 hidden bg-gradient-to-r from-background/55 via-background/15 to-transparent md:block"
            aria-hidden="true"
          >
          </div>
        </div>
      </div>
    </div>
  </div>
</PageHero>

<section
  class="border-y border-border/40 bg-surface-subtle/60"
  aria-label="How I show up in engagements"
>
  <div class="layout-gutter mx-auto max-w-container-2xl py-8 sm:py-10">
    <ul class="grid gap-4 sm:grid-cols-3 sm:gap-6" role="list">
      {
        content.proofPoints.map((point) => (
          <li class="flex items-start gap-3 text-sm leading-snug text-foreground/88 sm:text-base">
            <span class="mt-2 size-1.5 shrink-0 rounded-full bg-accent" aria-hidden="true" />
            <span>{point}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .about-hero-media {
    height: min(48vh, 24rem);
  }

  @media (width >= 640px) {
    .about-hero-media {
      height: min(50vh, 26rem);
    }
  }

  @media (width >= 768px) {
    .about-hero-split {
      min-height: min(38rem, calc(100svh - 4.5rem));
    }

    .about-hero-media {
      height: 100%;
      min-height: 30rem;
    }
  }
</style>
