---
/**
 * AboutTimeline - Interactive timeline display
 *
 * Displays a horizontal scrollable timeline with events, achievements,
 * and milestones. Uses semantic structure, keyboard access, and responsive layout.
 *
 * @component
 * @category Features
 * @subcategory About
 *
 * @example Timeline display
 * ```astro
 * <AboutTimeline timeline={timelineData} />
 * ```
 *
 * @prop {TimelineSection} timeline - Timeline data with year, title, icon, achievements
 *
 * @accessibility
 * - role="listitem" for timeline entries
 * - aria-label descriptive labels ("{year} – {title}")
 * - Nested lists with proper roles
 * - aria-hidden for non-content visual accents
 * - role="region" for scrollable container
 * - tabindex="0" for keyboard scrolling
 * - focus-visible styles for keyboard navigation
 */
import type { TimelineSection } from './types';
import GradientOverlay from '../../primitives/GradientOverlay.astro';
import Card from '../../composites/Card.astro';

const { timeline } = Astro.props as { timeline: TimelineSection };

interface IconProps {
  name: string;
}

function Icon({ name }: IconProps) {
  switch (name) {
    case 'cycle':
      return '<svg class="w-8 h-8 text-on-dark" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true" focusable="false"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" /></svg>';
    case 'cloud':
      return '<svg class="w-8 h-8 text-on-dark" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true" focusable="false"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999 5.002 5.002 0 10-9.78 2.096A4.001 4.001 0 003 15z" /></svg>';
    case 'idea':
      return '<svg class="w-8 h-8 text-on-dark" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true" focusable="false"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" /></svg>';
    case 'robot':
      return '<svg class="w-8 h-8 text-on-dark" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true" focusable="false"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 3v2m6-2v2M9 19v2m6-2v2M5 9H3m2 6H3m18-6h-2m2 6h-2M7 19h10a2 2 0 002-2V7a2 2 0 00-2-2H7a2 2 0 00-2 2v10a2 2 0 002 2zM9 9h6v6H9V9z" /></svg>';
    default:
      return '<svg class="w-8 h-8 text-on-dark" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true" focusable="false"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6" /></svg>';
  }
}
---

<section id="about-timeline" class="relative overflow-hidden bg-surface py-16">
  <div class="absolute inset-0 z-0 opacity-10" aria-hidden="true">
    <div class="absolute inset-0"></div>
  </div>

  <div class="layout-gutter relative z-10 mx-auto w-full max-w-5xl">
    <header class="mx-auto mb-16 max-w-3xl text-center">
      <h2 class="mb-6 text-2xl font-bold text-foreground sm:text-3xl md:text-4xl">
        {timeline.title}
      </h2>
    </header>

    <div class="relative hidden md:block">
      <div
        class="animate-gradient-shift absolute left-1/2 h-full w-1 -translate-x-1/2 transform bg-gradient-to-b from-accent via-primary to-accent"
        aria-hidden="true"
      >
      </div>
      <div class="space-y-0">
        {
          timeline.items.map((item, index) => (
            <div
              class={`relative z-10 flex items-center justify-${index % 2 === 0 ? 'start' : 'end'} group`}
              role="listitem"
              aria-label={`${item.year} – ${item.title}`}
            >
              <div class={`flex w-full ${index % 2 === 0 ? '' : 'justify-end'} mb-16`}>
                <div class={`${index % 2 === 0 ? 'mr-8 ml-0 text-right' : 'mr-0 ml-8'} w-5/12`}>
                  <Card
                    as="article"
                    hover="lift"
                    padding="md"
                    rounded="xl"
                    class="relative overflow-hidden bg-surface/90 backdrop-blur-sm"
                  >
                    <GradientOverlay variant="hover-subtle" direction="r" />
                    <header class="relative mb-6 flex items-center gap-4">
                      <div class="relative inline-flex h-16 w-16 items-center justify-center rounded-full bg-gradient-to-br from-accent to-primary text-2xl motion-safe:transition-transform motion-safe:duration-moderate motion-safe:group-hover:scale-110">
                        <span set:html={Icon({ name: item.icon })} />
                      </div>
                      <div class="flex-1">
                        <h3 class="text-2xl font-bold text-foreground transition-colors duration-moderate group-hover:text-accent sm:text-3xl">
                          {item.year}
                        </h3>
                        <p class="text-accent transition-colors duration-moderate group-hover:text-accent/80">
                          {item.title}
                        </p>
                      </div>
                    </header>
                    <ul
                      class="space-y-3 border-l-2 border-border/60 pl-4 transition-colors duration-moderate group-hover:border-accent/50"
                      role="list"
                    >
                      {item.achievements.map((achievement) => (
                        <li class="flex items-start gap-2 text-sm text-muted-foreground">
                          <span class="mt-1 inline-flex h-2 w-2 rounded-full bg-accent/80" />
                          <span>{achievement}</span>
                        </li>
                      ))}
                    </ul>
                  </Card>
                </div>
              </div>
              <div
                class="absolute top-1/2 left-1/2 h-5 w-5 -translate-x-1/2 -translate-y-1/2 transform rounded-full border-4 border-background bg-accent motion-safe:transition-transform motion-safe:duration-moderate motion-safe:group-hover:scale-125"
                aria-hidden="true"
              >
                <span class="absolute inset-0 rounded-full bg-accent/60 opacity-75 motion-safe:animate-ping" />
              </div>
            </div>
          ))
        }
      </div>
    </div>

    <div
      class="timeline-scroll-container overflow-x-auto pb-8 focus:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-background md:hidden"
      role="region"
      aria-label="Timeline events"
      tabindex="0"
    >
      <div class="inline-flex min-w-max space-x-6 px-4 pb-6">
        {
          timeline.items.map((item) => (
            <Card
              as="article"
              hover="none"
              padding="md"
              rounded="xl"
              class="relative w-80 flex-none overflow-hidden bg-surface/50 backdrop-blur-sm"
            >
              <GradientOverlay variant="hover-subtle" direction="r" />
              <header class="relative mb-6 flex items-center">
                <div class="flex h-14 w-14 items-center justify-center rounded-full bg-gradient-to-br from-accent to-primary text-xl">
                  <span set:html={Icon({ name: item.icon })} />
                </div>
                <div class="ml-4 flex-1">
                  <h3 class="text-xl font-bold text-foreground sm:text-2xl">{item.year}</h3>
                  <p class="text-accent">{item.title}</p>
                </div>
              </header>
              <ul class="space-y-2 border-l-2 border-border/60 pl-2" role="list">
                {item.achievements.map((achievement) => (
                  <li class="flex items-start gap-2 text-sm text-muted-foreground">
                    <span
                      class="mt-1 inline-flex h-2 w-2 rounded-full bg-accent/80"
                      aria-hidden="true"
                    />
                    <span>{achievement}</span>
                  </li>
                ))}
              </ul>
            </Card>
          ))
        }
      </div>
    </div>
  </div>
</section>
