---
/**
 * Outcomes — one lead figure, then the other hire studies as linked sentences.
 * Each line is copied from that study's first impact line.
 */
import Section from '@/components/primitives/Section.astro';
import SectionHeader from '@/components/composites/SectionHeader.astro';
import type { HomePageContent } from '@/content/home/pageTypes';
import type { HireStudyLink } from '@/content/projects/hirePath';

interface Props {
  content: HomePageContent['resumeHighlights'];
  studies: HireStudyLink[];
}

const { content, studies } = Astro.props as Props;
const [lead, ...rest] = studies;
---

<Section id="resume-highlights" padding="xl" container="lg" class="home-proof">
  <SectionHeader
    class="home-proof-heading"
    align="start"
    kicker={content.kicker}
    title={content.title}
    description={content.description}
  />

  {lead ? (
    <div class="home-proof-list">
      <a class="home-proof-lead" href={lead.href} data-cta-id="study_cta">
        <p class="home-proof-group">{lead.group}</p>
        <p class="home-proof-metric">{lead.line}</p>
        <p class="home-proof-study">{lead.title}</p>
      </a>
      {rest.map((study) => (
        <a class="home-proof-row" href={study.href} data-cta-id="study_cta">
          <p class="home-proof-group">{study.group}</p>
          <p class="home-proof-line">{study.line}</p>
          <p class="home-proof-study">{study.title}</p>
        </a>
      ))}
    </div>
  ) : null}
</Section>

<style>
  :global(.home-proof-heading) {
    margin-bottom: 2.25rem;
  }

  .home-proof-list {
    border-block: 1px solid color-mix(in oklch, var(--color-border) 70%, transparent);
  }

  .home-proof-lead,
  .home-proof-row {
    display: block;
    padding-block: 1.5rem;
    color: inherit;
    text-decoration: none;
  }

  .home-proof-lead + .home-proof-row,
  .home-proof-row + .home-proof-row {
    border-top: 1px solid color-mix(in oklch, var(--color-border) 70%, transparent);
  }

  .home-proof-lead:focus-visible,
  .home-proof-row:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }

  .home-proof-group,
  .home-proof-study {
    margin: 0;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-muted-foreground);
  }

  .home-proof-metric {
    margin: 0.65rem 0 0.35rem;
    font-family: var(--font-heading);
    font-size: clamp(1.35rem, 1.1rem + 0.85vw, 1.85rem);
    font-weight: 650;
    letter-spacing: -0.03em;
    line-height: 1.15;
    text-wrap: pretty;
    color: var(--color-foreground);
  }

  .home-proof-line {
    margin: 0.4rem 0 0.25rem;
    font-size: 1.05rem;
    line-height: 1.4;
    color: var(--color-foreground);
  }

  .home-proof-study {
    margin-top: 0.35rem;
    letter-spacing: 0.04em;
    text-transform: none;
    font-size: 0.875rem;
  }
</style>
