---
/** Outcome strip — comparable figures with direct access to the supporting studies. */
import Section from '@/components/primitives/Section.astro';
import SectionHeader from '@/components/composites/SectionHeader.astro';
import ArrowRightIcon from '@/components/primitives/icons/ArrowRightIcon.astro';
import { splitProofFigure } from '@/lib/content/splitProofFigure';
import type { HomePageContent } from '@/content/home/pageTypes';
import type { HireStudyLink } from '@/content/projects/hirePath';

interface Props {
  content: HomePageContent['resumeHighlights'];
  studies: HireStudyLink[];
}

const { content, studies } = Astro.props as Props;
const outcomes = studies.map((study) => ({ ...study, ...splitProofFigure(study.line) }));
---

<Section id="resume-highlights" padding="lg" container="xl" aria-labelledby="outcomes-title">
  <SectionHeader
    kicker={content.kicker}
    title={content.title}
    titleId="outcomes-title"
    description={content.description}
    size="section"
  />
  <ul class="outcome-strip" role="list">
    {outcomes.map((study) => (
      <li>
        <a class="outcome-link focus-ring-interactive" href={study.href} data-cta-id="study_cta">
          <p class="text-xs font-semibold tracking-smallcaps text-subtle-foreground uppercase">
            {study.group}
          </p>
          <p class="outcome-figure">{study.figure || study.line}</p>
          {study.figure && <p class="outcome-caption">{study.caption}</p>}
          <p class="outcome-study">{study.title}</p>
          <span class="mt-auto inline-flex items-center gap-2 pt-3 text-sm font-semibold text-accent-emphasis">
            Explore case study <ArrowRightIcon />
          </span>
        </a>
      </li>
    ))}
  </ul>
</Section>

<style>
  .outcome-strip {
    display: grid;
    border-block: 1px solid var(--color-border);
  }

  .outcome-strip > li + li {
    border-top: 1px solid var(--color-border);
  }

  .outcome-link {
    display: flex;
    height: 100%;
    flex-direction: column;
    padding: 1.5rem 0.5rem;
    transition: background-color var(--duration-fast) var(--ease-standard);
  }

  .outcome-link:hover {
    background: var(--color-surface);
  }

  .outcome-figure {
    margin-block: 1.25rem 0.5rem;
    font-family: var(--font-heading);
    font-size: clamp(2.5rem, 4vw, 3.5rem);
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 1.1;
    color: var(--color-foreground);
    overflow-wrap: anywhere;
  }

  .outcome-caption {
    max-width: 26ch;
    font-size: 1.125rem;
    line-height: 1.4;
    color: var(--color-foreground);
  }

  .outcome-study {
    margin-top: 1rem;
    max-width: 36ch;
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--color-muted-foreground);
  }

  @media (width >= 768px) {
    .outcome-strip {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .outcome-strip > li + li {
      border-top: 0;
      border-left: 1px solid var(--color-border);
    }

    .outcome-link {
      padding: 2rem 1.5rem;
    }
  }
</style>
