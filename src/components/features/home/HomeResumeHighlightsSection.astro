---
/**
 * Outcomes — metric-led editorial list.
 */
import Section from '../../primitives/Section.astro';
import SectionHeader from '../../composites/SectionHeader.astro';
import EditorialList from '../../composites/EditorialList.astro';
import type { HomePageContent } from '../../../content/home/pageTypes';

interface Props {
  content: HomePageContent['resumeHighlights'];
}

const { content } = Astro.props as Props;

const rows = content.cards.map((card) => ({
  kicker: card.metric,
  title: card.title,
  bullets: card.items.map((item) => item.text),
}));
---

<Section id="resume-highlights" padding="lg" container="lg">
  <SectionHeader
    align="center"
    kicker={content.kicker}
    title={content.title}
    description={content.description}
  />
  <EditorialList rows={rows} numbered={false} kickerAside={false} class="mx-auto max-w-3xl" />
</Section>
