---
/** Outcome strip — comparable figures with the study title as the link. */
import Section from '@/components/primitives/Section.astro';
import SectionHeader from '@/components/composites/SectionHeader.astro';
import ArrowRightIcon from '@/components/primitives/icons/ArrowRightIcon.astro';
import { splitProofFigure } from '@/lib/content/splitProofFigure';
import type { HomePageContent } from '@/content/home/pageTypes';
import type { HireStudyLink } from '@/content/projects/hirePath';

interface Props {
  content: HomePageContent['resumeHighlights'];
  studies: HireStudyLink[];
}

const { content, studies } = Astro.props as Props;
const outcomes = studies.map((study) => ({ ...study, ...splitProofFigure(study.line) }));
---

<Section id="outcomes" padding="lg" container="xl" aria-labelledby="outcomes-title">
  <SectionHeader
    kicker={content.kicker}
    title={content.title}
    titleId="outcomes-title"
    description={content.description}
    size="section"
  />
  <ul class="outcome-strip" role="list">
    {outcomes.map((study) => (
      <li>
        <a class="outcome-link focus-ring-interactive" href={study.href} data-cta-id="study_cta">
          <p class="text-xs font-semibold tracking-label text-subtle-foreground uppercase">
            {study.group}
          </p>
          <p class="outcome-figure">{study.figure || study.line}</p>
          {study.figure && <p class="outcome-caption">{study.caption}</p>}
          <span class="outcome-study">
            <span class="outcome-study-title">{study.linkLabel}</span>
            <ArrowRightIcon class="outcome-study-arrow" />
          </span>
        </a>
      </li>
    ))}
  </ul>
</Section>

<style>
  .outcome-strip {
    display: grid;
    border-block: 1px solid var(--color-border);
  }

  .outcome-strip > li + li {
    border-top: 1px solid var(--color-border);
  }

  .outcome-link {
    display: flex;
    height: 100%;
    flex-direction: column;
    padding: 1.5rem 0.5rem;
    transition: background-color var(--duration-fast) var(--ease-standard);
  }

  .outcome-link:hover {
    background: var(--color-surface);
  }

  .outcome-link:hover .outcome-study-title,
  .outcome-link:focus-visible .outcome-study-title {
    text-decoration-color: color-mix(in oklch, var(--color-foreground) 40%, transparent);
  }

  .outcome-link:hover .outcome-study-arrow,
  .outcome-link:focus-visible .outcome-study-arrow {
    transform: translateX(0.2rem);
  }

  .outcome-figure {
    margin-block: 1.25rem 0.5rem;
    font-family: var(--font-heading);
    font-size: clamp(2.5rem, 4vw, 3.5rem);
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 1.1;
    color: var(--color-foreground);
    overflow-wrap: anywhere;
  }

  .outcome-caption {
    max-width: 26ch;
    font-size: 1.125rem;
    line-height: 1.4;
    color: var(--color-foreground);
  }

  .outcome-study {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: auto;
    padding-top: 1rem;
    max-width: 36ch;
    font-size: 0.875rem;
    font-weight: 600;
    line-height: 1.5;
    color: var(--color-foreground);
  }

  .outcome-study-title {
    text-decoration: underline;
    text-decoration-color: color-mix(in oklch, var(--color-border) 90%, transparent);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.22em;
    transition: text-decoration-color var(--duration-fast) var(--ease-standard);
  }

  .outcome-study-arrow {
    flex-shrink: 0;
    transition: transform var(--duration-fast) var(--ease-standard);
  }

  @keyframes outcome-rise {
    from {
      opacity: 0;
      transform: translateY(0.75rem);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .outcome-link {
        animation: outcome-rise 700ms var(--ease-decelerate) both;
        animation-timeline: view();
        animation-range: entry 0% cover 40%;
      }

      .outcome-strip > li:nth-child(2) .outcome-link {
        animation-delay: 60ms;
      }

      .outcome-strip > li:nth-child(3) .outcome-link {
        animation-delay: 120ms;
      }
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .outcome-study-arrow {
      transition: none;
    }

    .outcome-link:hover .outcome-study-arrow,
    .outcome-link:focus-visible .outcome-study-arrow {
      transform: none;
    }
  }

  @media (width >= 768px) {
    .outcome-strip {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .outcome-strip > li + li {
      border-top: 0;
      border-left: 1px solid var(--color-border);
    }

    .outcome-link {
      padding: 2rem 1.5rem;
    }
  }
</style>
