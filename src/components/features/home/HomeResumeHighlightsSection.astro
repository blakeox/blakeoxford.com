---
import Section from '../../primitives/Section.astro';
import ResumeHighlightIcon from './ResumeHighlightIcon.astro';
import type { HomePageContent } from '../../../content/home/pageTypes';

interface Props {
  content: HomePageContent['resumeHighlights'];
}

const { content } = Astro.props as Props;
---

<Section id="resume-highlights" padding="lg" container="lg">
  <div class="grid gap-12 lg:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)] lg:gap-16">
    <div class="section-intro-left lg:sticky lg:top-28 lg:self-start">
      <span class="section-kicker">{content.kicker}</span>
      <h2
        class="font-heading text-3xl font-semibold tracking-tight text-foreground sm:text-4xl md:text-5xl"
      >
        {content.title}
      </h2>
      <p class="max-w-md text-lg text-muted-foreground">
        {content.description}
      </p>
    </div>

    <ol class="divide-y divide-border/60 border-y border-border/60" role="list">
      {
        content.cards.map((card, index) => (
          <li class="grid gap-5 py-8 sm:grid-cols-[auto_minmax(0,1fr)] sm:gap-8">
            <div class="flex items-start gap-3 sm:block">
              <span class="font-heading text-sm font-semibold text-accent tabular-nums">
                {String(index + 1).padStart(2, '0')}
              </span>
              <div class="hidden size-10 items-center justify-center rounded-full bg-surface-subtle text-accent sm:mt-6 sm:flex">
                <ResumeHighlightIcon name={card.icon} />
              </div>
            </div>
            <div class="space-y-4">
              <div class="space-y-2">
                <h3 class="font-heading text-xl font-semibold text-foreground sm:text-2xl">
                  {card.title}
                </h3>
                <p class="max-w-2xl text-base leading-relaxed text-muted-foreground">
                  {card.description}
                </p>
              </div>
              <ul
                class="space-y-2.5 text-sm leading-relaxed text-foreground/85 sm:text-base"
                role="list"
              >
                {card.items.map((item) => (
                  <li class="flex gap-3">
                    <span
                      class="mt-2 size-1 shrink-0 rounded-full bg-foreground/30"
                      aria-hidden="true"
                    />
                    <span>{item.text}</span>
                  </li>
                ))}
              </ul>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</Section>
