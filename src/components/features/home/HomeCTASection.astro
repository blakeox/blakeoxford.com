---
import Section from '../../primitives/Section.astro';
import SectionHeading from '../../primitives/SectionHeading.astro';
import Button from '../../primitives/Button.astro';
---

<Section padding="lg" container="xl" class="text-center">
  <SectionHeading size="3xl" class="mb-4 flex items-center justify-center gap-2"><span>🤝</span> Want to Work Together?</SectionHeading>
  <p class="mb-6 text-lg text-muted-foreground">I&apos;m always open to exciting new opportunities and collaborations. Let&apos;s create something amazing together!</p>
  <Button variant="outline" href="/contact/">Contact Me</Button>
</Section>
