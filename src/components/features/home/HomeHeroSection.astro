---
/**
 * Home identity hero — one Work/Daring dissolve, both theses, two actions in one viewport.
 */
import HomeHeroCopy from '@/components/features/home/HomeHeroCopy.astro';
import HomeHeroVisual from '@/components/features/home/HomeHeroVisual.astro';
import type { HomePageContent } from '@/content/home/pageTypes';
import './home-hero-dual.css';

interface Props {
  author: string;
  content: HomePageContent['hero'];
}

const { author, content } = Astro.props as Props;

const workLine = 'Builds systems teams keep running.';
const daringLine = 'Chases the edge cases that make them better.';
---

<section
  id="about-me"
  class="home-dual"
  data-home-dual
  data-side="work"
  aria-label="Blake Oxford — two sides"
>
  <div class="home-dual-stage">
    <div class="home-dual-copy-shell layout-gutter">
      <HomeHeroCopy author={author} content={content} workLine={workLine} daringLine={daringLine} />
    </div>
    <HomeHeroVisual workAlt={content.portrait.alt} daringAlt={content.portrait.altBack} />
  </div>
</section>

<script>
  import { bindHomeHero, teardownHomeDual } from './homeHeroDual';

  bindHomeHero();
  document.addEventListener('astro:page-load', bindHomeHero);
  document.addEventListener('astro:before-swap', teardownHomeDual);
</script>
