---
/**
 * Home identity hero — one full-bleed composition.
 * Brand, one supporting line, one CTA group, one photographic plane.
 */
import PageHero from '../../composites/PageHero.astro';
import IntroCopy from '../../composites/IntroCopy.astro';
import Button from '../../primitives/Button.astro';
import ButtonGroup from '../../composites/ButtonGroup.astro';
import type { HomePageContent } from '../../../content/home/pageTypes';

interface Props {
  author: string;
  /** Single supporting line under the name (promise or role). */
  description?: string;
  content: HomePageContent['hero'];
}

const { author, description, content } = Astro.props as Props;

const portraitSrc = content.portrait.frontSrc;
const portraitAvif = '/assets/images/optimized/avif/Blake-O-scaled@768w.avif';
const portraitWebp = '/assets/images/optimized/webp/Blake-O-scaled@768w.webp';
---

<PageHero
  id="about-me"
  flush
  includeBlurOrbs={false}
  containerSize="full"
  containerPadding={false}
  class="home-hero-bleed"
>
  <div class="home-hero-stage">
    <div class="home-hero-media" aria-hidden="true">
      <picture>
        <source srcset={portraitAvif} type="image/avif" />
        <source srcset={portraitWebp} type="image/webp" />
        <img
          src={portraitSrc}
          alt=""
          width="800"
          height="800"
          class="home-hero-photo"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </picture>
      <div class="home-hero-scrim"></div>
    </div>

    <div class="hero-entrance home-hero-copy layout-gutter">
      <div class="home-hero-copy-inner">
        <IntroCopy
          kicker={content.kicker}
          title={author}
          description={description}
          size="identity"
          descriptionTone="strong"
          class="w-full items-start"
        />
        <ButtonGroup align="start" responsive>
          <Button
            variant="primary"
            size="lg"
            href={content.primaryCta.href}
            data-test="home-cta-connect"
            data-analytics="hero-cta"
            data-prefetch-contact
          >
            {content.primaryCta.label}
          </Button>
          <Button variant="ghost" size="lg" href={content.secondaryCta.href}>
            {content.secondaryCta.label}
          </Button>
        </ButtonGroup>
      </div>
    </div>
  </div>
</PageHero>

<style>
  .home-hero-bleed.page-hero-shell {
    background: var(--color-background);
  }

  .home-hero-stage {
    display: flex;
    flex-direction: column;
    width: 100%;
    min-height: min(36rem, calc(100svh - var(--nav-height)));
  }

  .home-hero-media {
    position: relative;
    order: 1;
    overflow: hidden;
    width: 100%;
    height: min(48vh, 24rem);
    background: var(--color-surface-subtle);
  }

  .home-hero-photo {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 14%;
  }

  .home-hero-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      transparent 45%,
      color-mix(in oklch, var(--color-background) 35%, transparent) 72%,
      var(--color-background) 100%
    );
  }

  .home-hero-copy {
    order: 2;
    display: flex;
    flex: 1;
    flex-direction: column;
    justify-content: flex-end;
    padding-block: 2.5rem 3rem;
    background: var(--color-background);
  }

  .home-hero-copy-inner {
    display: flex;
    width: 100%;
    max-width: 36rem;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.5rem;
  }

  @media (width >= 768px) {
    .home-hero-stage {
      display: grid;
      grid-template-columns: minmax(22rem, 1fr) minmax(22rem, 1.05fr);
      min-height: calc(100svh - var(--nav-height));
    }

    .home-hero-media {
      order: 2;
      height: 100%;
      min-height: 100%;
    }

    .home-hero-photo {
      object-position: 50% 12%;
    }

    .home-hero-scrim {
      background: linear-gradient(
        90deg,
        var(--color-background) 0%,
        color-mix(in oklch, var(--color-background) 55%, transparent) 10%,
        transparent 28%
      );
    }

    .home-hero-copy {
      order: 1;
      justify-content: center;
      padding-block: 4rem;
      background: transparent;
    }

    .home-hero-copy-inner {
      max-width: 28rem;
    }
  }

  @media (width >= 1024px) {
    .home-hero-copy-inner {
      max-width: 32rem;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .home-hero-photo {
      animation: home-hero-photo-settle 1.25s var(--ease-decelerate) both;
    }
  }

  @keyframes home-hero-photo-settle {
    from {
      opacity: 0.7;
      transform: scale(1.04);
    }

    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .home-hero-photo {
      animation: none;
      transform: none;
    }
  }
</style>

<script>
  function bindContactPrefetch() {
    const cta = document.querySelector<HTMLAnchorElement>('[data-prefetch-contact]');
    if (!cta || cta.dataset.prefetchBound === 'true') return;
    cta.dataset.prefetchBound = 'true';

    const href = cta.getAttribute('href');
    if (!href) return;

    const prefetch = () => {
      if (document.querySelector(`link[rel="prefetch"][href="${href}"]`)) return;
      const link = document.createElement('link');
      link.rel = 'prefetch';
      link.href = href;
      document.head.appendChild(link);
    };

    cta.addEventListener('pointerenter', prefetch, { once: true });
    cta.addEventListener('focus', prefetch, { once: true });
  }

  bindContactPrefetch();
  document.addEventListener('astro:page-load', bindContactPrefetch);
</script>
