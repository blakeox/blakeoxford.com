---
import CoinFlipImage from '../../composites/CoinFlipImage.astro';
import PageHero from '../../composites/PageHero.astro';
import IntroCopy from '../../composites/IntroCopy.astro';
import Button from '../../primitives/Button.astro';
import ButtonGroup from '../../composites/ButtonGroup.astro';
import type { HomePageContent } from '../../../content/home/pageTypes';

interface Props {
  author: string;
  /** Single supporting line under the name (promise or role). */
  description?: string;
  content: HomePageContent['hero'];
}

const { author, description, content } = Astro.props as Props;
---

{
  /**
   * Identity lockup: coin + name share one axis.
   * Mobile — stacked, centered. Desktop — coin beside copy, group centered as a unit.
   */
}
<PageHero id="about-me" includeBlurOrbs={false}>
  <div
    class="hero-entrance relative z-10 mx-auto flex w-full max-w-5xl flex-col items-center gap-7 text-center lg:flex-row lg:items-center lg:justify-center lg:gap-12 lg:text-left xl:gap-14"
  >
    <div class="relative shrink-0 pb-4 lg:pb-5">
      <div
        class="relative rounded-full ring-1 ring-accent/30 ring-offset-2 ring-offset-background sm:ring-offset-4"
      >
        <CoinFlipImage
          frontSrc={content.portrait.frontSrc}
          backSrc={content.portrait.backSrc}
          alt={content.portrait.alt}
          altBack={content.portrait.altBack}
          size={300}
          flipMultipleTimes
          loading="eager"
          fetchPriority="high"
          decoding="auto"
          class="home-coin-flip"
        />
      </div>
    </div>

    <div class="flex max-w-xl min-w-0 flex-col items-center gap-5 lg:items-start">
      <IntroCopy
        kicker={content.kicker}
        title={author}
        description={description}
        size="identity"
        descriptionTone="strong"
        class="w-full items-center lg:items-start lg:text-left"
      />
      <ButtonGroup align="center" responsive class="lg:justify-start">
        <Button
          variant="primary"
          size="lg"
          href={content.primaryCta.href}
          data-test="home-cta-connect"
          data-analytics="hero-cta"
          data-prefetch-contact
        >
          {content.primaryCta.label}
        </Button>
        <Button variant="outline" size="lg" href={content.secondaryCta.href}>
          {content.secondaryCta.label}
        </Button>
      </ButtonGroup>
    </div>
  </div>
</PageHero>

<style is:global>
  .home-coin-flip.coin-flip {
    width: 11.5rem !important;
    height: 11.5rem !important;
  }

  @media (width >= 640px) {
    .home-coin-flip.coin-flip {
      width: 14rem !important;
      height: 14rem !important;
    }
  }

  @media (width >= 1024px) {
    .home-coin-flip.coin-flip {
      width: 17.5rem !important;
      height: 17.5rem !important;
    }
  }
</style>

<script>
  function bindContactPrefetch() {
    const cta = document.querySelector<HTMLAnchorElement>('[data-prefetch-contact]');
    if (!cta || cta.dataset.prefetchBound === 'true') return;
    cta.dataset.prefetchBound = 'true';

    const href = cta.getAttribute('href');
    if (!href) return;

    const prefetch = () => {
      if (document.querySelector(`link[rel="prefetch"][href="${href}"]`)) return;
      const link = document.createElement('link');
      link.rel = 'prefetch';
      link.href = href;
      document.head.appendChild(link);
    };

    cta.addEventListener('pointerenter', prefetch, { once: true });
    cta.addEventListener('focus', prefetch, { once: true });
  }

  bindContactPrefetch();
  document.addEventListener('astro:page-load', bindContactPrefetch);
</script>
