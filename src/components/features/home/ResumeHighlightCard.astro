---
import GradientOverlay from '../../primitives/GradientOverlay.astro';

interface Props {
  title: string;
  description: string;
  class?: string;
}

const { title, description, class: className = '' } = Astro.props as Props;
---
<div
  class={`bg-surface dark:bg-surface-dark rounded-xl shadow-xl border border-border/50 dark:border-border-dark/50 p-6 flex flex-col h-full hover-lift-sm transition-all duration-300 hover:shadow-2xl hover:border-accent/50 dark:hover:border-accent/30 relative overflow-hidden group ${className}`.trim()}
>
  <div class="relative bg-surface/80 dark:bg-surface-dark/80 p-8 rounded-xl shadow-lg border border-border dark:border-border-dark hover:shadow-2xl transition-all duration-300 group overflow-hidden">
  <GradientOverlay variant='hover-subtle' direction='br' />
  <div class="flex items-center mb-4 relative z-10">
    <div class="rounded-full bg-gradient-to-r from-accent to-primary p-2.5 mr-4">
      <slot name="icon" />
    </div>
    <h3 class="text-xl sm:text-2xl font-bold text-foreground dark:text-foreground-light">{title}</h3>
  </div>
  <div class="relative z-10">
    <p class="text-foreground dark:text-foreground-light mb-2">{description}</p>
    <ul class="space-y-2 ml-5">
      <slot />
    </ul>
  </div>
</div>
