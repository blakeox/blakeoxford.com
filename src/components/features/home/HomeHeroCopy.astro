---
/**
 * Home hero copy — name, one sentence, primary and proof actions.
 */
import IntroCopy from '@/components/composites/IntroCopy.astro';
import Button from '@/components/primitives/Button.astro';
import ButtonGroup from '@/components/composites/ButtonGroup.astro';
import type { HomePageContent } from '@/content/home/pageTypes';

interface Props {
  author: string;
  content: HomePageContent['hero'];
}

const { author, content } = Astro.props as Props;
---

<div class="hero-entrance home-dual-copy relative z-20">
  <div class="home-dual-lockup">
    <IntroCopy kicker={content.kicker} title={author} size="identity" class="w-full items-start" />
    <p class="max-w-md text-lg leading-snug font-semibold tracking-tight text-foreground sm:text-xl">
      {content.defaultTagline}
    </p>
  </div>

  <ButtonGroup align="start" responsive class="pt-0">
    <Button
      variant="primary"
      size="lg"
      href={content.primaryCta.href}
      data-test="home-cta-connect"
      data-cta-id="hero_primary"
      data-prefetch-contact
    >
      {content.primaryCta.label}
    </Button>
    <Button
      variant="secondary"
      size="lg"
      href={content.secondaryCta.href}
      data-test="home-cta-work"
      data-cta-id="hero_secondary"
    >
      {content.secondaryCta.label}
    </Button>
  </ButtonGroup>
</div>
