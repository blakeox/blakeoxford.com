---
/**
 * Home hero copy column — brand lockup, dual lines, primary + proof CTAs.
 */
import IntroCopy from '@/components/composites/IntroCopy.astro';
import Button from '@/components/primitives/Button.astro';
import ButtonGroup from '@/components/composites/ButtonGroup.astro';
import type { HomePageContent } from '@/content/home/pageTypes';

interface Props {
  author: string;
  content: HomePageContent['hero'];
  workLine: string;
  daringLine: string;
}

const { author, content, workLine, daringLine } = Astro.props as Props;
---

<div class="hero-entrance home-dual-copy relative z-20">
  <div class="home-dual-lockup">
    <IntroCopy
      kicker={content.kicker || 'Two sides'}
      title={author}
      size="identity"
      class="w-full items-start"
    />

    <div class="home-dual-lines">
      <p class="home-dual-line" data-dual-line-work>
        {workLine}
      </p>
      <p class="home-dual-line" data-dual-line-daring>
        {daringLine}
      </p>
    </div>
  </div>

  <ButtonGroup align="start" responsive class="pt-0">
    <Button
      variant="primary"
      size="lg"
      href={content.primaryCta.href}
      data-test="home-cta-connect"
      data-analytics="hero-cta"
      data-prefetch-contact
    >
      {content.primaryCta.label}
    </Button>
    <Button variant="outline" size="lg" href={content.secondaryCta.href} data-test="home-cta-work">
      {content.secondaryCta.label}
    </Button>
  </ButtonGroup>
</div>
