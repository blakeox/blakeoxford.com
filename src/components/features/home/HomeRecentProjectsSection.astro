---
import type { CollectionEntry } from 'astro:content';
import Section from '@/components/primitives/Section.astro';
import SectionHeader from '@/components/composites/SectionHeader.astro';
import ProjectCard from '@/components/features/projects/ProjectCard.astro';
import type { HomePageContent } from '@/content/home/pageTypes';

interface Props {
  projects: CollectionEntry<'projects'>[];
  content: HomePageContent['recentProjects'];
}

const { projects, content } = Astro.props as Props;
---

<Section
  id="recent-projects"
  padding="xl"
  container="xl"
  background="surface"
  aria-labelledby="recent-projects-title"
>
  <SectionHeader
    kicker={content.kicker}
    title={content.title}
    description={content.description}
    titleId="recent-projects-title"
    actionHref={content.cta.href}
    actionLabel={content.cta.label}
  />

  <div class="project-grid">
    {projects.map((project) => <ProjectCard project={project} compact featured />)}
  </div>
</Section>

<style>
  .project-grid {
    display: grid;
    gap: 2.5rem;
  }

  .project-grid :global(.project-card-meta) {
    letter-spacing: 0.06em;
    text-transform: none;
  }

  @media (width >= 768px) {
    .project-grid {
      grid-template-columns: 1fr 1fr;
      align-items: stretch;
    }
  }

  @media (width >= 1024px) {
    .project-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
