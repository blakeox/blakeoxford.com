---
/**
 * Home hero portrait — one photograph. Ask stays off this plane.
 */
import { getHomePortrait, homePortraitSizes } from '@/lib/homePortrait';

const portrait = await getHomePortrait();
---

<div class="home-dual-visual" data-chat-avoid-launcher>
  <div class="home-dual-frame">
    <img
      src={portrait.src}
      srcset={portrait.srcSet.attribute}
      sizes={homePortraitSizes}
      alt=""
      width="853"
      height="853"
      class="home-dual-face home-dual-face-work absolute inset-0 size-full object-cover"
      loading="eager"
      fetchpriority="high"
      decoding="async"
    />
    <div class="home-dual-veil" aria-hidden="true"></div>
  </div>
</div>
