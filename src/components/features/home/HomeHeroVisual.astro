---
/**
 * Home hero portrait — Work face by default; Daring on hover/focus.
 */
interface Props {
  workAlt: string;
  daringAlt: string;
}

const { workAlt, daringAlt } = Astro.props as Props;
---

<div class="home-dual-visual relative z-10" data-chat-avoid-launcher>
  <div class="home-dual-visual-inner">
    <div
      class="home-dual-frame relative w-[min(16.5rem,58vw)] rounded-xl sm:w-[min(18rem,46vw)] md:w-[min(20.5rem,32vw)] lg:w-[min(22rem,28vw)]"
      style="aspect-ratio: 4 / 5"
      tabindex="0"
      role="img"
      aria-label={`${workAlt}. ${daringAlt}. Hover or tap to switch.`}
    >
      <img
        src="/assets/images/optimized/avif/Blake-O-scaled@768w.avif"
        alt=""
        width="768"
        height="768"
        class="home-dual-face home-dual-face-work absolute inset-0 size-full object-cover"
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
      <img
        src="/assets/images/optimized/avif/china-profile-picture.avif"
        alt=""
        width="768"
        height="768"
        class="home-dual-face home-dual-face-daring absolute inset-0 size-full object-cover"
        data-dual-daring
        loading="lazy"
        decoding="async"
      />
    </div>
    <p class="home-dual-frame-caption" data-frame-caption>
      Work
    </p>
  </div>
</div>
