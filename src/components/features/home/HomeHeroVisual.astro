---
/**
 * Home hero portrait — flush photographic plane. Work holds, then one dissolve to Daring.
 * The portrait itself keeps Ask off the face while it occupies the launcher corner.
 */
---

<div class="home-dual-visual" data-chat-avoid-launcher>
  <div class="home-dual-frame">
    <img
      src="/assets/images/optimized/avif/blake_detroit_skyline_bell_isle.avif"
      alt=""
      width="853"
      height="853"
      class="home-dual-face home-dual-face-work absolute inset-0 size-full object-cover"
      data-dual-work
      loading="eager"
      fetchpriority="high"
      decoding="async"
    />
    <img
      src="/assets/images/optimized/avif/china-profile-picture-hero.avif"
      alt=""
      width="900"
      height="1200"
      class="home-dual-face home-dual-face-daring absolute inset-0 size-full object-cover"
      data-dual-daring
      loading="lazy"
      decoding="async"
    />
    <div class="home-dual-veil" aria-hidden="true"></div>
  </div>
</div>
