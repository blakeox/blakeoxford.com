---
import ProficiencyLogo from '../../primitives/ProficiencyLogo.astro';

interface Props {
  tech: {
    name: string;
    img: string | { src: string };
    alt: string;
  };
  data: { name: string } | null;
  srcStr: string | undefined;
}

const { tech, data, srcStr } = Astro.props;
---

<li class="group flex flex-col items-center">
  <div
    class="mb-2 flex h-16 w-16 items-center justify-center rounded-full bg-surface motion-safe:transition-transform motion-safe:group-hover:scale-110"
  >
    {
      data ? (
        <ProficiencyLogo
          base={data.name}
          alt={tech.alt}
          width={64}
          height={64}
          class="h-full w-full object-contain"
          loading="lazy"
        />
      ) : srcStr ? (
        <img
          src={srcStr}
          alt={tech.alt}
          width={64}
          height={64}
          class="h-full w-full object-contain"
          loading="lazy"
        />
      ) : (
        <span class="text-2xl" aria-label={tech.name}>
          ?
        </span>
      )
    }
  </div>
  <span class="transition-colors group-hover:text-accent">{tech.name}</span>
</li>
