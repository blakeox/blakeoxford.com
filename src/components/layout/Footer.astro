---
/**
 * Footer - Site footer with navigation and social links
 *
 * Displays site footer with quick links, social media links,
 * copyright information, and back-to-top button.
 * Quick links and social links are sourced from nav.json via navLinks.ts.
 *
 * @component
 * @category Layout
 *
 * @example Site footer
 * ```astro
 * <Footer />
 * ```
 *
 * @accessibility
 * - role="contentinfo" landmark
 * - aria-label for footer region
 * - role="navigation" for link sections
 * - Proper heading hierarchy with aria-level
 * - Social links with descriptive aria-labels
 */
import Container from '../primitives/Container.astro';
import SocialIcon from '../primitives/SocialIcon.astro';
import { getNavQuickLinks, navConfig, type NavLink } from '../../config/navLinks';

const year = new Date().getFullYear();
const siteTitle = 'Blake Oxford\'s portfolio';
const quickLinks = getNavQuickLinks();
const socialLinks = navConfig.socialLinks ?? [];

type SocialIconName = 'linkedin' | 'github' | 'email' | 'microsoft-learn';

function resolveSocialIcon(icon?: string): SocialIconName {
  if (icon === 'linkedin' || icon === 'github' || icon === 'email' || icon === 'microsoft-learn') {
    return icon;
  }
  return 'github';
}

function socialLinkRel(link: NavLink): string | undefined {
  return link.external ? 'noopener noreferrer' : undefined;
}
---
<footer id="footer" role="contentinfo" aria-label="Site footer" tabindex="-1" class="bg-surface text-foreground border-t border-border py-6 pb-1.5 relative">
 <Container size="xl" padding={true}>
 <!-- Upper footer with main content -->
 <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-4">
 <!-- Quick Links -->
 <div aria-labelledby="footer-links-heading" role="navigation" aria-label="Footer Quick Links" class="flex flex-col items-center md:items-start">
 <div id="footer-links-heading" class="text-base font-semibold mb-2 tracking-wide text-foreground-strong" role="heading" aria-level="2">Quick Links</div>
 <ul class="flex flex-col gap-1.5">
 {quickLinks.map((link) => (
 <li>
 <a
 href={link.href}
 class="text-foreground hover:text-accent transition-colors font-medium text-sm rounded focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent/60 hover:underline underline-offset-2"
 >{link.label}</a>
 </li>
 ))}
 </ul>
 </div>

 <!-- Social Media -->
 <div class="flex flex-col items-center">
 <div class="text-base font-semibold mb-2 tracking-wide text-foreground-strong" role="heading" aria-level="2">Connect with Me</div>
 <ul class="flex flex-row gap-5 list-none p-0 m-0">
 {socialLinks.map((link) => (
 <li>
 <a
 href={link.href}
 target={link.target}
 rel={socialLinkRel(link)}
 aria-label={link.label}
 class="inline-flex items-center justify-center group"
 >
 <SocialIcon
 icon={resolveSocialIcon(link.icon)}
 class="w-7 h-7 text-primary group-hover:text-accent group-focus:text-accent transition-colors duration-normal"
 />
 </a>
 </li>
 ))}
 </ul>
 </div>

 <!-- Info -->
 <div class="flex flex-col items-center md:items-end text-foreground text-xs md:text-sm">
 <p class="mb-0.5">© {year} {siteTitle}. All rights reserved.</p>
 <p>
 Built with
 <a
 href="https://astro.build/"
 target="_blank"
 rel="noopener"
 class="text-foreground hover:text-accent transition-colors underline-offset-2 hover:underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent/60 rounded"
 >Astro</a>
 &
 <a
 href="https://cloudflare.com/pages"
 target="_blank"
 rel="noopener"
 class="text-foreground hover:text-accent transition-colors underline-offset-2 hover:underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent/60 rounded"
 >Cloudflare Workers</a>.
 </p>
 </div>
 </div>

 <!-- Lower footer with divider and back to top button -->
 <div class="relative pt-3 border-t border-border flex items-center justify-between">
 <p class="text-xs text-muted-foreground">Made with ☕ by Blake Oxford</p>
 <a
 href="#top"
 class="group flex items-center gap-0.5 text-muted-foreground hover:text-accent focus:text-accent transition-colors duration-normal focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent/60 rounded-md text-xs"
 aria-label="Back to Top"
 >
 <span>Back to Top</span>
 <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 group-hover:-translate-y-0.5 transition-transform duration-normal" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
 <path d="m18 15-6-6-6 6"/>
 </svg>
 </a>
 </div>
 </Container>
</footer>
