---
// Modern NavBar.astro component inspired by Hiro's clean design
import navLinks from '../../config/navLinks';
---

<nav id="navbar" class="navbar-container" role="navigation" aria-label="Main navigation">
  <div class="navbar-content layout-shell-wide h-16 flex items-center justify-between">
    <!-- Left: Brand/Logo -->
  <div class="brand-section min-w-40 flex-shrink-0">
      <a href="/" class="brand-link">
        <div class="brand-avatar-container">
          <picture>
            <source srcset="/assets/images/optimized/avif/Blake-O-scaled@320w.avif 320w, /assets/images/optimized/avif/Blake-O-scaled@640w.avif 640w, /assets/images/optimized/avif/Blake-O-scaled@768w.avif 768w" sizes="32px" type="image/avif" />
            <source srcset="/assets/images/optimized/webp/Blake-O-scaled@320w.webp 320w, /assets/images/optimized/webp/Blake-O-scaled@640w.webp 640w, /assets/images/optimized/webp/Blake-O-scaled@768w.webp 768w" sizes="32px" type="image/webp" />
            <img
              src="/assets/images/Blake-O-scaled.jpg"
              alt=""
              aria-hidden="true"
              class="brand-avatar"
              width={32}
              height={32}
              loading="eager"
              decoding="async"
              fetchpriority="low"
            />
          </picture>
      </div>
        <span class="brand-text">Blake Oxford</span>
      </a>
    </div>

    <!-- Desktop Navigation -->
  <div class="desktop-nav">
      <ul class="nav-links" role="menubar">
      {navLinks.map((link) => (
          <li class="nav-item" role="none">
          <a
              href={link.href}
            class="nav-link"
            role="menuitem"
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>
    </div>

    <!-- Action Buttons -->
  <div class="action-buttons flex items-center gap-2 min-w-40 h-12 whitespace-nowrap">
      <!-- Search Toggle -->
      <button
        id="search-toggle"
        type="button"
        class="action-button search-toggle w-12 h-12"
        aria-label="Open search"
        aria-expanded="false"
        aria-controls="search-overlay"
      >
  <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true" focusable="false">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
      </button>

      <!-- Theme Toggle -->
      <button
        id="theme-toggle"
        type="button"
        class="action-button theme-toggle w-12 h-12"
        aria-label="Toggle dark mode"
      >
  <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 sun-icon" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="false" focusable="false">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
        </svg>
  <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 moon-icon hidden" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true" focusable="false">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
        </svg>
      </button>

      <!-- Mobile Menu Toggle -->
      <button
        id="nav-toggle"
        type="button"
        class="burger-menu-button w-12 h-12"
        aria-label="Toggle navigation menu"
        aria-expanded="false"
        aria-controls="nav-mobile-links"


      >
        <div class="burger-container">
          <div class="burger-piece top-bun"></div>
          <div class="burger-piece middle"></div>
          <div class="burger-piece bottom-bun"></div>
        </div>
      </button>
    </div>
  </div>

  <!-- Mobile Menu -->
  <div id="nav-mobile-links" class="mobile-menu" role="dialog" aria-modal="true" aria-label="Mobile navigation menu" inert>
    <div class="mobile-menu-backdrop"></div>
    <div class="mobile-menu-content">
      <div class="mobile-menu-header">
        <div id="mobile-menu-title" class="sr-only">Mobile navigation menu</div>
        <button
          id="close-mobile-menu"
          type="button"
          class="mobile-close-button"
          aria-label="Close navigation menu"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

      <nav class="mobile-nav" role="navigation" aria-label="Mobile navigation">
        <ul class="mobile-nav-links" role="menubar">
        {navLinks.map((link) => (
            <li class="mobile-nav-item" role="none">
            <a
              href={link.href}
                class="mobile-nav-link"
              role="menuitem"
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
      </nav>
    </div>
  </div>
</nav>

<script>
  import '../../scripts/entry/init-modern-navbar.ts';
</script>

<script is:inline>
  (function() {
    try {
      // 1) Set aria-current on matching nav links
      var path = window.location && window.location.pathname;
      if (path) {
        var links = document.querySelectorAll('.nav-link, .mobile-nav-link');
        links.forEach(function(a) {
          if (a.getAttribute('href') === path) {
            a.setAttribute('aria-current', 'page');
          } else {
            a.removeAttribute('aria-current');
          }
        });
      }

      // 2) Defensive fallback: ensure basic interactivity even if main module fails or is skipped
      // Only attach if window.modernNavBar is not present shortly after DOM is ready
      var attachFallback = function() {
        try {
          if (window.modernNavBar) return; // enhanced controller present, skip fallback

          var burger = document.getElementById('nav-toggle');
          var menu = document.getElementById('nav-mobile-links');
          var closeBtn = document.getElementById('close-mobile-menu');
          var searchToggle = document.getElementById('search-toggle');
          var overlay = document.getElementById('search-overlay');

          function openMenu(){
            if (!menu) return;
            menu.classList.add('active');
            menu.style.visibility = '';
            try { menu.inert = false; } catch { menu.removeAttribute('inert'); }
            document.body.style.overflow = 'hidden';
            document.body.style.position = 'fixed';
            document.body.style.width = '100%';
          }
          function closeMenu(){
            if (!menu) return;
            menu.classList.remove('active');
            setTimeout(function(){
              if (!menu.classList.contains('active')) {
                menu.style.visibility = 'hidden';
                try { menu.inert = true; } catch { menu.setAttribute('inert',''); }
              }
            }, 300);
            document.body.style.overflow = '';
            document.body.style.position = '';
            document.body.style.width = '';
          }
          function openOverlay(){
            var enhanced = window && window.enhancedSearchOverlay;
            if (enhanced && typeof enhanced.open === 'function') { enhanced.open(); return; }
            if (!overlay) return;
            overlay.classList.add('active');
            overlay.style.visibility = 'visible';
            overlay.style.opacity = '1';
            try { overlay.inert = false; } catch { overlay.removeAttribute('inert'); }
            var input = document.getElementById('search-input');
            if (input) setTimeout(function(){ input.focus(); }, 50);
            document.body.style.overflow = 'hidden';
          }
          function closeOverlay(){
            var enhanced = window && window.enhancedSearchOverlay;
            if (enhanced && typeof enhanced.closeSearchOverlay === 'function') { enhanced.closeSearchOverlay(); return; }
            if (!overlay) return;
            overlay.classList.remove('active');
            overlay.style.visibility = 'hidden';
            overlay.style.opacity = '0';
            try { overlay.inert = true; } catch { overlay.setAttribute('inert',''); }
            document.body.style.overflow = '';
          }

          if (burger && menu) {
            burger.addEventListener('click', function(e){ e.preventDefault(); menu.classList.contains('active') ? closeMenu() : openMenu(); });
          }
          if (closeBtn) closeBtn.addEventListener('click', function(e){ e.preventDefault(); closeMenu(); });
          document.addEventListener('keydown', function(e){ if (e.key === 'Escape') { closeMenu(); closeOverlay(); } }, { passive: true });
          if (searchToggle) searchToggle.addEventListener('click', function(e){ e.preventDefault(); openOverlay(); }, { passive: true });
          if (overlay) overlay.addEventListener('click', function(e){ if (e.target === overlay) closeOverlay(); }, { passive: true });
        } catch (_) { /* no-op */ }
      };

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', function(){ setTimeout(attachFallback, 0); });
      } else {
        setTimeout(attachFallback, 0);
      }
    } catch (_) { /* no-op */ }
  })();
  </script>

