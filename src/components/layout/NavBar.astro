---
// Modern NavBar.astro component inspired by Hiro's clean design
import navLinks from '../../config/navLinks';
---

<nav id="navbar" class="navbar-container" role="navigation" aria-label="Main navigation">
  <div class="navbar-content" style="max-width:1200px;margin:0 auto;padding:0 24px;height:64px;display:flex;align-items:center;justify-content:space-between">
    <!-- Brand Section -->
  <div class="brand-section" style="min-width:160px;flex-shrink:0">
      <a href="/" class="brand-link">
        <div class="brand-avatar-container">
          <img
            src="/assets/images/Blake-O-scaled.jpg"
            alt=""
            aria-hidden="true"
            class="brand-avatar"
            width={32}
            height={32}
            loading="eager"
          />
      </div>
        <span class="brand-text">Blake Oxford</span>
      </a>
    </div>

    <!-- Desktop Navigation -->
  <div class="desktop-nav">
      <ul class="nav-links" role="menubar">
      {navLinks.map((link) => (
          <li class="nav-item" role="none">
          <a
              href={link.href}
            class="nav-link"
            role="menuitem"
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>
    </div>

    <!-- Action Buttons -->
  <div class="action-buttons" style="display:flex;align-items:center;gap:8px;min-width:160px;height:48px;white-space:nowrap">
      <!-- Search Toggle -->
      <button
        id="search-toggle"
        type="button"
        class="action-button search-toggle"
        style="width:48px;height:48px"
        aria-label="Open search"
        aria-expanded="false"
        aria-controls="search-overlay"
      >
  <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true" focusable="false">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
      </button>

      <!-- Theme Toggle -->
      <button
        id="theme-toggle"
        type="button"
        class="action-button theme-toggle"
        style="width:48px;height:48px"
        aria-label="Toggle dark mode"
      >
  <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 sun-icon" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true" focusable="false">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
        </svg>
  <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 moon-icon" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true" focusable="false">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
        </svg>
      </button>

      <!-- Mobile Menu Toggle -->
      <button
        id="nav-toggle"
        type="button"
        class="burger-menu-button"
        style="width:48px;height:48px"
        aria-label="Toggle navigation menu"
        aria-expanded="false"
        aria-controls="nav-mobile-links"


      >
        <div class="burger-container">
          <div class="burger-piece top-bun"></div>
          <div class="burger-piece middle"></div>
          <div class="burger-piece bottom-bun"></div>
        </div>
      </button>
    </div>
  </div>

  <!-- Mobile Menu -->
  <div id="nav-mobile-links" class="mobile-menu" role="dialog" aria-modal="true" aria-label="Mobile navigation menu" inert>
    <div class="mobile-menu-backdrop"></div>
    <div class="mobile-menu-content">
      <div class="mobile-menu-header">
        <div id="mobile-menu-title" class="sr-only">Mobile navigation menu</div>
        <button
          id="close-mobile-menu"
          type="button"
          class="mobile-close-button"
          aria-label="Close navigation menu"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
      
      <nav class="mobile-nav" role="navigation" aria-label="Mobile navigation">
        <ul class="mobile-nav-links" role="menubar">
        {navLinks.map((link) => (
            <li class="mobile-nav-item" role="none">
            <a
              href={link.href}
                class="mobile-nav-link"
              role="menuitem"
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
      </nav>
    </div>
  </div>
</nav>

<script is:inline>
  (function() {
    try {
      var path = window.location && window.location.pathname;
      if (!path) return;
      var links = document.querySelectorAll('.nav-link, .mobile-nav-link');
      links.forEach(function(a) {
        if (a.getAttribute('href') === path) {
          a.setAttribute('aria-current', 'page');
        } else {
          a.removeAttribute('aria-current');
        }
      });
    } catch (_) { /* no-op */ }
  })();
  </script>

<style is:inline>
  /* Modern Navbar Container - Hiro-inspired design */
  .navbar-container {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 1000;
    background: rgba(255, 255, 255, 0.8);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-bottom: 1px solid rgba(0, 0, 0, 0.06);
    transition: all 0.2s ease;
  }
  
  .dark .navbar-container {
    background: rgba(0, 0, 0, 0.8);
    border-bottom-color: rgba(255, 255, 255, 0.06);
  }
  
  /* Navbar Content */
  .navbar-content {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 24px;
    height: 64px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  
  /* Brand Section */
  .brand-section {
  flex-shrink: 0;
  /* Reserve space to avoid brand text reflow on font metric changes */
  min-width: 160px;
  }
  
  .brand-link {
    display: flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    color: #000;
    font-weight: 600;
    font-size: 16px;
    transition: opacity 0.2s ease;
  font-synthesis-weight: none;
  font-synthesis-style: none;
  text-rendering: optimizeLegibility;
  }
  
  .dark .brand-link {
    color: #fff;
  }
  
  .brand-link:hover {
    opacity: 0.7;
  }
  
  .brand-avatar-container {
    width: 32px;
    height: 32px;
    border-radius: 8px;
    overflow: hidden;
    border: 1px solid rgba(0, 0, 0, 0.1);
  }
  
  .dark .brand-avatar-container {
    border-color: rgba(255, 255, 255, 0.1);
  }
  
  .brand-avatar {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  
  .brand-text {
  font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, 'Apple Color Emoji','Segoe UI Emoji','Segoe UI Symbol', sans-serif;
    letter-spacing: -0.01em;
  }
  
  /* Desktop Navigation */
  .desktop-nav {
    display: flex;
    align-items: center;
  }
  
  .nav-links {
    display: flex;
    align-items: center;
    gap: 32px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  
  .nav-item {
    position: relative;
  }
  
  .nav-link {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  /* Ensure adequate tap target size per Lighthouse (48x48) */
  min-height: 48px;
  padding: 0 12px;
    color: #000;
    text-decoration: none;
    font-weight: 500;
    font-size: 14px;
    transition: color 0.2s ease;
    white-space: nowrap;
  }
  
  .dark .nav-link {
    color: #fff;
  }
  
  .nav-link:hover {
    color: #666;
  }
  
  .dark .nav-link:hover {
    color: #ccc;
  }
  
  .nav-link[aria-current="page"] {
  color: #000;
  /* Avoid font-weight changes that can cause layout shift; use underline instead */
  text-decoration: underline;
  text-underline-offset: 6px;
  }
  
  .dark .nav-link[aria-current="page"] {
  color: #fff;
  text-decoration: underline;
  text-underline-offset: 6px;
  }
  
  /* Action Buttons */
  .action-buttons {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-shrink: 0;
  /* Reserve stable width for 3 buttons at 48px each plus 2 gaps of 8px: 3*48 + 2*8 = 160px */
  min-width: 160px;
  height: 48px;
  white-space: nowrap;
  }
  
  .action-button {
    display: flex;
    align-items: center;
    justify-content: center;
  /* Increase to 48px to meet mobile tap target guidance */
  width: 48px;
  height: 48px;
  min-width: 48px;
  min-height: 48px;
    border: none;
    border-radius: 8px;
    background: transparent;
    color: #000;
    cursor: pointer;
    transition: all 0.2s ease;
    outline: none;
    /* Improve touch targets */
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
  /* Stabilize icon area to avoid reflow when icons change */
  line-height: 0;
  }
  
  .dark .action-button {
    color: #fff;
  }
  
  .action-button:hover {
    background: rgba(0, 0, 0, 0.05);
  }
  
  .dark .action-button:hover {
    background: rgba(255, 255, 255, 0.05);
  }
  
  /* Theme Toggle */
  .theme-toggle .moon-icon {
    display: none;
  }
  
  .dark .theme-toggle .sun-icon {
    display: none;
  }
  
  .dark .theme-toggle .moon-icon {
    display: block;
  }
  
  /* Burger Menu */
  .burger-menu-button {
    position: relative;
  /* Increase to 48px to meet mobile tap target guidance */
  width: 48px;
  height: 48px;
  min-width: 48px;
  min-height: 48px;
    border: none;
    background: transparent;
    cursor: pointer;
    outline: none;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s ease;
    /* Improve touch targets */
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
  }
  
  .burger-menu-button:hover {
    background: rgba(0, 0, 0, 0.05);
    border-radius: 8px;
  }
  
  .dark .burger-menu-button:hover {
    background: rgba(255, 255, 255, 0.05);
  }
  
  .burger-container {
  position: relative;
    width: 18px;
    height: 14px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }
  
  .burger-piece {
    width: 100%;
    height: 2px;
    background: #000;
    border-radius: 1px;
    transition: all 0.3s ease;
    transform-origin: center;
  }
  
  .dark .burger-piece {
    background: #fff;
  }
  
  /* Burger Animation */
  .burger-menu-button.active .top-bun {
    transform: rotate(45deg) translate(2px, 2px);
  }
  
  .burger-menu-button.active .middle {
    opacity: 0;
    transform: scaleX(0);
  }
  
  .burger-menu-button.active .bottom-bun {
    transform: rotate(-45deg) translate(2px, -2px);
  }
  
  /* Mobile Menu */
  .mobile-menu {
    position: fixed;
  top: 0;
  right: 0;
  width: min(300px, 85vw);
    height: 100vh;
  /* Keep it out of view with transform so it doesn't affect layout/CLS */
  transform: translateX(100%);
  visibility: hidden;
  will-change: transform;
  transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1), visibility 0s linear 0.3s;
    z-index: 1010;
    overflow: hidden;
  }
  
  .mobile-menu.active {
  transform: translateX(0);
    visibility: visible;
  transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }
  
  .mobile-menu-backdrop {
    position: absolute;
    top: 0;
  left: 0;
  width: 100vw;
    height: 100vh;
    background: rgba(0, 0, 0, 0.5);
    opacity: 0;
    transition: opacity 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    pointer-events: none;
  }
  
  .dark .mobile-menu-backdrop {
    background: rgba(0, 0, 0, 0.7);
  }
  
  .mobile-menu-content {
    position: relative;
    width: 100%;
    height: 100%;
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-left: 1px solid rgba(0, 0, 0, 0.06);
    overflow-y: auto;
  }
  
  .dark .mobile-menu-content {
    background: rgba(0, 0, 0, 0.95);
    border-left-color: rgba(255, 255, 255, 0.06);
  }
  
  
  .mobile-menu.active .mobile-menu-backdrop {
    opacity: 1;
    pointer-events: auto;
  }
  
  .mobile-menu-header {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    padding: 16px 24px;
    border-bottom: 1px solid rgba(0, 0, 0, 0.06);
  }
  
  .dark .mobile-menu-header {
    border-bottom-color: rgba(255, 255, 255, 0.06);
  }
  
  .mobile-close-button {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border: none;
    border-radius: 8px;
    background: transparent;
    color: #000;
    cursor: pointer;
    transition: all 0.2s ease;
    outline: none;
  }
  
  .dark .mobile-close-button {
    color: #fff;
  }
  
  .mobile-close-button:hover {
    background: rgba(0, 0, 0, 0.05);
  }
  
  .dark .mobile-close-button:hover {
    background: rgba(255, 255, 255, 0.05);
  }
  
  .mobile-nav {
    padding: 24px 0;
  }
  
  .mobile-nav-links {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  
  .mobile-nav-item {
    border-bottom: 1px solid rgba(0, 0, 0, 0.06);
  }
  
  .dark .mobile-nav-item {
    border-bottom-color: rgba(255, 255, 255, 0.06);
  }
  
  .mobile-nav-item:last-child {
    border-bottom: none;
  }
  
  .mobile-nav-link {
    display: block;
    padding: 16px 24px;
    color: #000;
    text-decoration: none;
    font-weight: 500;
    font-size: 16px;
    transition: all 0.2s ease;
  }
  
  .dark .mobile-nav-link {
    color: #fff;
  }
  
  .mobile-nav-link:hover {
    background: rgba(0, 0, 0, 0.05);
  }
  
  .dark .mobile-nav-link:hover {
    background: rgba(255, 255, 255, 0.05);
  }
  
  .mobile-nav-link[aria-current="page"] {
    background: rgba(0, 0, 0, 0.05);
    font-weight: 600;
  }
  
  .dark .mobile-nav-link[aria-current="page"] {
    background: rgba(255, 255, 255, 0.05);
  }
  
  /* Mobile-specific improvements */
  @media (max-width: 768px) {
    .desktop-nav {
      display: none;
    }
    
    .navbar-content {
      padding: 0 16px;
    }
    
    .brand-text {
      font-size: 14px;
    }
    
    .brand-avatar-container {
      width: 28px;
      height: 28px;
    }
    
    .mobile-menu {
      width: min(280px, 80vw);
    }
  }
  
  @media (max-width: 480px) {
    .navbar-content {
      padding: 0 12px;
    }
    
    .brand-text {
      font-size: 13px;
    }
    
    .brand-avatar-container {
      width: 26px;
      height: 26px;
    }
    
    .mobile-menu {
      width: min(260px, 85vw);
    }
    
    .action-buttons {
      gap: 4px;
    }
    
    .action-button {
      width: 32px;
      height: 32px;
    }
  }
  
  @media (max-width: 320px) {
    .mobile-menu {
      width: 90vw;
    }
    
    .navbar-content {
      padding: 0 8px;
    }
  }
  
  @media (min-width: 769px) {
    .burger-menu-button {
      display: none !important;
    }
  }
  

  
  /* Reduced motion support */
  @media (prefers-reduced-motion: reduce) {
    .navbar-container,
    .nav-link,
    .action-button,
    .brand-link,
    .mobile-menu,
    .burger-piece {
      transition: none !important;
      animation: none !important;
    }
    
    .burger-menu-button.active .top-bun,
    .burger-menu-button.active .bottom-bun {
      transform: rotate(45deg) !important;
    }
    
    .burger-menu-button.active .middle {
      opacity: 0 !important;
    }
  }
</style>

<script>
  import { initModernNavBar } from '../../scripts/features/ModernNavBar';

  function initializeNavBar() {
    if (!document || !document.body) return;

    try {
      // Prevent conflicting NavBarMenu from interfering
      if (typeof window !== 'undefined' && (window as any).navBarMenu) {
        (window as any).navBarMenu = null;
      }

      // Create the navbar instance using the modular approach
      let modernNavBar: any;
      try {
        modernNavBar = initModernNavBar();
      } catch (error) {
        console.error('❌ Error creating ModernNavBar:', error);
      }

      // Store it globally for debugging
      if (typeof window !== 'undefined' && modernNavBar) {
        (window as any).modernNavBar = modernNavBar;
      }
    } catch (error) {
      console.error('❌ Error initializing navbar:', error);
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => {
      initializeNavBar();
    });
  } else {
    // Wait a bit to ensure DOM is fully ready
    setTimeout(() => {
      initializeNavBar();
    }, 100);
  }
</script>