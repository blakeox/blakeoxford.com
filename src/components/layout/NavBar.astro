---
import NavBarIsland from '../islands/NavBarIsland';
import navLinks from '../../config/navLinks';
---

<NavBarIsland
  client:load
  links={navLinks}
  currentPath={Astro.url.pathname}
  logo={{
    name: 'Blake Oxford',
    avatar: {
      jpg: '/assets/images/Blake-O-scaled.jpg',
      webp: '/assets/images/optimized/webp/Blake-O-scaled@640w.webp',
      avif: '/assets/images/optimized/avif/Blake-O-scaled@640w.avif'
    }
  }}
/>


