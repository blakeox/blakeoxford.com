---
/**
 * NavBar - Main site navigation wrapper
 * 
 * Wraps the NavBarIsland React component with Astro props.
 * Provides site-wide navigation with mobile menu, logo, and theme toggle.
 * 
 * @component
 * @category Layout
 * 
 * @example Default navigation
 * ```astro
 * <NavBar />
 * ```
 * 
 * @accessibility
 * - Semantic nav element (handled by island)
 * - Keyboard navigation support
 * - Mobile menu with proper ARIA attributes
 * - Focus management for menu toggle
 */
import NavBarIsland from '../islands/NavBarIsland';
import navLinks from '../../config/navLinks';
---

<NavBarIsland
  client:load
  links={navLinks}
  currentPath={Astro.url.pathname}
  logo={{
    name: 'Blake Oxford',
    avatar: {
      jpg: '/assets/images/Blake-O-scaled.jpg',
      webp: '/assets/images/optimized/webp/Blake-O-scaled@640w.webp',
      avif: '/assets/images/optimized/avif/Blake-O-scaled@640w.avif'
    }
  }}
/>


