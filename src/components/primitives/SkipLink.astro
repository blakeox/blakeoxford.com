---
/**
 * SkipLink - Skip navigation link for accessibility
 *
 * Provides a "Skip to main content" link that appears on focus
 * for keyboard users. Improves accessibility and navigation efficiency.
 *
 * @component
 * @category Primitives
 * @accessibility
 * - Hidden by default, visible on focus
 * - Allows keyboard users to skip navigation
 * - WCAG 2.4.1 compliant
 *
 * @example
 * ```astro
 * <SkipLink href="#main-content" />
 * ```
 *
 * @prop {string} href - Target anchor ID (e.g., "#main-content")
 * @prop {string} [text='Skip to main content'] - Link text
 */
interface Props {
  href: string;
  text?: string;
}

const { href, text = 'Skip to main content' } = Astro.props as Props;
---

<a
  href={href}
  class="skip-link sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:rounded-lg focus:bg-accent focus:px-4 focus:py-2 focus:text-on-accent focus:shadow-lg focus:ring-2 focus:ring-accent/60 focus:ring-offset-2 focus:outline-none"
>
  {text}
</a>
