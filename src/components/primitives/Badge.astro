---
/**
 * Badge - Reusable badge/tag component
 *
 * Provides consistent styling for tags, labels, and status indicators.
 * Use variant="pill" for uppercase meta tags (replaces BadgePill).
 *
 * @example
 * <Badge variant="primary">TypeScript</Badge>
 * <Badge variant="outline" size="sm">Featured</Badge>
 * <Badge variant="pill" showDot>Case Study</Badge>
 */

import {
  getBadgeClasses,
  badgeRecipe,
  type BadgeSize,
  type BadgeVariant,
} from '@/lib/design-system/recipes';

export interface Props {
  /** Badge visual variant */
  variant?: BadgeVariant;
  /** Badge size */
  size?: BadgeSize;
  /** Decorative accent dot (pill variant) */
  showDot?: boolean;
  /** Additional CSS classes */
  class?: string;
}

const { variant = 'secondary', size = 'sm', showDot = false, class: className = '' } = Astro.props;

const classes = getBadgeClasses({ variant, size, className });
---

<span class={classes}>
  {
    showDot && (
      <span class={`rounded-full bg-accent ${badgeRecipe.dotSizes[size]}`} aria-hidden="true" />
    )
  }
  <slot />
</span>
