---
import type { HTMLAttributes } from 'astro/types';

/**
 * Section - Semantic section component with consistent spacing
 * 
 * Provides standard section patterns with vertical padding.
 * Combines Container for width control with Stack for content spacing.
 * 
 * @example
 * <Section padding="lg" container="lg">
 *   <h2>Section Title</h2>
 *   <p>Section content...</p>
 * </Section>
 */

export interface Props extends HTMLAttributes<'section'> {
  /** Vertical padding size */
  padding?: 'none' | 'sm' | 'md' | 'lg' | 'xl';
  /** Container size (false for full width) */
  container?: 'sm' | 'md' | 'lg' | 'xl' | 'full' | false;
  /** Background color */
  background?: 'default' | 'surface' | 'gradient';
  /** HTML element type */
  as?: 'section' | 'div' | 'article' | 'aside' | 'main';
  /** Additional CSS classes */
  class?: string;
  /** ARIA labelledby */
  'aria-labelledby'?: string;
}

const {
  padding = 'lg',
  container = false,
  background = 'default',
  as: Element = 'section',
  class: className = '',
  'aria-labelledby': ariaLabelledby,
  ...rest
} = Astro.props as Props;

// Padding styles
const paddingStyles = {
  none: '',
  sm: 'py-8 sm:py-12',
  md: 'py-12 sm:py-16',
  lg: 'py-16 sm:py-20',
  xl: 'py-20 sm:py-24 lg:py-28',
};

// Background styles
const backgroundStyles = {
  default: '',
  surface: 'bg-surface/50 dark:bg-surface-dark/50',
  gradient: 'bg-gradient-to-r from-background via-surface to-background dark:from-background-dark dark:via-surface-dark dark:to-background-dark',
};

const classes = [
  paddingStyles[padding],
  backgroundStyles[background],
  !container && 'w-full',
  className,
].filter(Boolean).join(' ');
---

<Element class={classes} aria-labelledby={ariaLabelledby} {...rest}>
  {container ? (
    <div class={`${container !== 'full' ? 'max-w-' + container : 'max-w-none'} w-full mx-auto px-4 sm:px-6 lg:px-8`}>
      <slot />
    </div>
  ) : (
    <slot />
  )}
</Element>
