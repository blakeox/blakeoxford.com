---
import type { HTMLAttributes } from 'astro/types';
import Container from './Container.astro';

/**
 * Section - Semantic section component with consistent spacing
 *
 * Provides standard section patterns with vertical padding.
 * Combines Container for width control with Stack for content spacing.
 *
 * @example
 * <Section padding="lg" container="lg">
 * <h2>Section Title</h2>
 * <p>Section content...</p>
 * </Section>
 */

export interface Props extends HTMLAttributes<'section'> {
  /** Vertical padding size */
  padding?: 'none' | 'sm' | 'md' | 'lg' | 'xl';
  /** Container size (false for full width) */
  container?: 'sm' | 'md' | 'lg' | 'xl' | 'full' | false;
  /** Background color */
  background?: 'default' | 'surface' | 'gradient' | 'glass';
  /** HTML element type */
  as?: 'section' | 'div' | 'article' | 'aside' | 'main';
  /** Additional CSS classes */
  class?: string;
  /** ARIA labelledby */
  'aria-labelledby'?: string;
}

const {
  padding = 'lg',
  container = false,
  background = 'default',
  as: Element = 'section',
  class: className = '',
  'aria-labelledby': ariaLabelledby,
  ...rest
} = Astro.props as Props;

// Padding styles — vertical rhythm from --space-section-* / py-section-*
const paddingStyles = {
  none: '',
  sm: 'py-section-sm sm:py-section-md',
  md: 'py-section-md sm:py-section-lg',
  lg: 'py-section-lg sm:py-section-xl',
  xl: 'py-section-lg sm:py-section-xl lg:py-section-2xl',
} as const;

// Background styles
const backgroundStyles = {
  default: '',
  surface: 'bg-surface/50',
  gradient: 'bg-gradient-to-r from-background via-surface to-background',
  glass:
    'border border-border/40 bg-glass/85 shadow-md backdrop-blur supports-[backdrop-filter]:bg-glass/75',
} as const;

const classes = [
  paddingStyles[padding],
  backgroundStyles[background],
  !container && 'w-full',
  className,
]
  .filter(Boolean)
  .join(' ');
---

<Element class={classes} aria-labelledby={ariaLabelledby} {...rest}>
  {
    container ? (
      <Container size={container}>
        <slot />
      </Container>
    ) : (
      <slot />
    )
  }
</Element>
