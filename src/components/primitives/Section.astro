---
import type { HTMLAttributes } from 'astro/types';
import Container from './Container.astro';
import {
  getSectionClasses,
  type SectionBackground,
  type SectionPadding,
} from '@/lib/design-system/recipes';

/**
 * Section - Semantic section component with consistent spacing
 *
 * Provides standard section patterns with vertical padding.
 * Combines Container for width control with Stack for content spacing.
 *
 * @example
 * <Section padding="lg" container="lg">
 * <h2>Section Title</h2>
 * <p>Section content...</p>
 * </Section>
 */

export interface Props extends HTMLAttributes<'section'> {
  /** Vertical padding size */
  padding?: SectionPadding;
  /** Container size (false for full width) */
  container?: 'sm' | 'md' | 'lg' | 'xl' | 'full' | false;
  /** Background color */
  background?: SectionBackground;
  /** HTML element type */
  as?: 'section' | 'div' | 'article' | 'aside' | 'main';
  /** Additional CSS classes */
  class?: string;
  /** ARIA labelledby */
  'aria-labelledby'?: string;
}

const {
  padding = 'lg',
  container = false,
  background = 'default',
  as: Element = 'section',
  class: className = '',
  'aria-labelledby': ariaLabelledby,
  ...rest
} = Astro.props as Props;

const classes = getSectionClasses({
  padding,
  background,
  fullWidth: !container,
  className,
});
---

<Element class={classes} aria-labelledby={ariaLabelledby} {...rest}>
  {
    container ? (
      <Container size={container}>
        <slot />
      </Container>
    ) : (
      <slot />
    )
  }
</Element>
