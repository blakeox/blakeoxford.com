---
/**
 * BadgePill — thin preset over Badge variant="pill".
 * Prefer `<Badge variant="pill">` in new code.
 */
import Badge from './Badge.astro';

export interface Props {
  size?: 'xs' | 'sm' | 'md';
  showDot?: boolean;
  class?: string;
}

const { size = 'sm', showDot = false, class: className = '' } = Astro.props;
---

<Badge variant="pill" size={size} showDot={showDot} class={className}>
  <slot />
</Badge>
