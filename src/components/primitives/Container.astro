---
/**
 * Container - Responsive container with consistent padding and max-width
 *
 * Provides standard container patterns used throughout the site.
 * Padding uses `.layout-gutter` (tokenized clamps from theme.css).
 *
 * @example
 * <Container size="lg">
 * <h1>Page Content</h1>
 * </Container>
 */

import { getContainerClasses, type ContainerSize } from '@/lib/design-system/recipes';

export interface Props {
  /** Container max-width */
  size?: ContainerSize;
  /** Apply tokenized horizontal padding */
  padding?: boolean;
  /** Center content */
  center?: boolean;
  /** HTML element type */
  as?: 'div' | 'section' | 'article' | 'main' | 'aside';
  /** Additional CSS classes */
  class?: string;
}

const props = Astro.props as Props;

const {
  size = 'lg',
  padding = true,
  center = true,
  as: Element = 'div',
  class: className = '',
} = props;

const sizeKey = size ?? 'lg';
const classes = getContainerClasses({ size: sizeKey, padding, center, className });
---

<Element class={classes}>
  <slot />
</Element>
