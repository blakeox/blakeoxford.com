---
/**
 * FloatingBlur - Decorative floating blur shape element
 * 
 * Creates a blurred circular background decoration commonly used in hero sections
 * and cards for visual interest.
 * 
 * @prop {string} size - Size preset: 'sm' (48/192px), 'md' (64/256px), 'lg' (80/320px), 'xl' (96/384px)
 * @prop {string} color - Color: 'accent' (accent/10-20), 'primary' (primary/10-20), 'sky' (sky-500/25)
 * @prop {string} position - Position preset: 'top-left', 'top-right', 'bottom-left', 'bottom-right', 'center'
 * @prop {string} blur - Blur size: 'sm' (blur-xl), 'md' (blur-2xl), 'lg' (blur-3xl), 'custom' (blur-[120px])
 * @prop {string} translate - Custom translate classes (e.g., '-translate-x-1/2 -translate-y-1/2')
 * @prop {boolean} animated - Whether to animate with pulse
 * @prop {string} class - Optional additional classes
 */
interface Props {
  size?: 'sm' | 'md' | 'lg' | 'xl';
  color?: 'accent' | 'accent-light' | 'primary' | 'sky';
  position?: 'top-left' | 'top-right' | 'bottom-left' | 'bottom-right' | 'center' | 'custom';
  blur?: 'sm' | 'md' | 'lg' | 'custom';
  translate?: string;
  animated?: boolean;
  class?: string;
}

const {
  size = 'lg',
  color = 'accent',
  position = 'custom',
  blur = 'lg',
  translate = '',
  animated = false,
  class: className = '',
} = Astro.props;

const sizeClasses = {
  sm: 'w-48 h-48',
  md: 'w-64 h-64',
  lg: 'w-80 h-80',
  xl: 'w-96 h-96',
};

const colorClasses = {
  'accent': 'bg-accent/10',
  'accent-light': 'bg-accent/20',
  'primary': 'bg-primary/20',
  'sky': 'bg-sky-500/25',
};

const positionClasses = {
  'top-left': 'top-0 left-0',
  'top-right': 'top-0 right-0',
  'bottom-left': 'bottom-0 left-0',
  'bottom-right': 'bottom-0 right-0',
  'center': 'top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2',
  'custom': '',
};

const blurClasses = {
  sm: 'blur-xl',
  md: 'blur-2xl',
  lg: 'blur-3xl',
  custom: 'blur-[120px]',
};

const animatedClass = animated ? 'animate-pulse' : '';
const finalClasses = `absolute rounded-full pointer-events-none ${positionClasses[position]} ${sizeClasses[size]} ${colorClasses[color]} ${blurClasses[blur]} ${translate} ${animatedClass} ${className}`.trim();
---

<div class={finalClasses} aria-hidden="true"></div>
