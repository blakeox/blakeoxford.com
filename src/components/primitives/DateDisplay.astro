---
/**
 * DateDisplay - Consistent date rendering with icon
 * 
 * Displays dates in a consistent format with optional calendar icon.
 * Uses utility functions for date formatting.
 * 
 * @example
 * <DateDisplay date={post.data.pubDate} format="blog" />
 * <DateDisplay date={project.data.date} format="short" showIcon={false} />
 */

import { formatDateISO, formatDateShort, formatDateBlog, formatDateFull } from '../../utils/index.js';

export interface Props {
 /** Date to display */
 date: Date | string;
 /** Format style */
 format?: 'short' | 'blog' | 'full' | 'iso';
 /** Show calendar icon */
 showIcon?: boolean;
 /** Additional CSS classes */
 class?: string;
}

const {
 date,
 format = 'short',
 showIcon = true,
 class: className = '',
} = Astro.props;

// Format date based on style
const formattedDate = format === 'short' ? formatDateShort(date)
 : format === 'blog' ? formatDateBlog(date)
 : format === 'full' ? formatDateFull(date)
 : formatDateISO(date);

const isoDate = formatDateISO(date);

const classes = [
 'inline-flex items-center text-sm text-muted-foreground font-medium',
 className,
].filter(Boolean).join(' ');
---

<time class={classes} datetime={isoDate}>
 {showIcon && (
 <svg class="mr-1.5" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
 <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
 <line x1="16" y1="2" x2="16" y2="6"></line>
 <line x1="8" y1="2" x2="8" y2="6"></line>
 <line x1="3" y1="10" x2="21" y2="10"></line>
 </svg>
 )}
 {formattedDate}
</time>
