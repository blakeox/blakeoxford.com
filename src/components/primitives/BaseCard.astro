---
/**
 * BaseCard - Reusable card primitive component
 *
 * Provides the base card contract for repeated content surfaces.
 * Semantic tokens remap in dark mode — avoid redundant dark: surface/border utilities.
 *
 * @example
 * <BaseCard variant="elevated" hover="lift">
 * <div slot="header">Card Header</div>
 * <div>Card Content</div>
 * <div slot="footer">Card Footer</div>
 * </BaseCard>
 */

import type { HTMLAttributes } from 'astro/types';
import { cn } from '@/utils/cn';
import {
  getBaseCardClasses,
  getBaseCardPadding,
  type BaseCardHover,
  type BaseCardPadding,
  type BaseCardRounded,
  type BaseCardVariant,
} from '@/lib/design-system/recipes';

type AllowedElements = 'article' | 'div' | 'footer' | 'section';

export interface Props extends Omit<HTMLAttributes<'div'>, 'class'> {
  /** Card visual variant */
  variant?: BaseCardVariant;
  /** Hover effect type */
  hover?: BaseCardHover;
  /** Border radius size */
  rounded?: BaseCardRounded;
  /** Padding size */
  padding?: BaseCardPadding;
  /** HTML element type */
  as?: AllowedElements;
  /** Additional CSS classes */
  class?: string;
}

const props = Astro.props as Props;

const {
  variant = 'default',
  hover = 'lift',
  rounded = '2xl',
  padding = 'md',
  as: Element = 'div',
  class: className = '',
  ...rest
} = props;

const variantKey = variant ?? 'default';
const hoverKey = hover ?? 'lift';
const roundedKey = rounded ?? '2xl';
const paddingKey = padding ?? 'md';

const classes = getBaseCardClasses({
  variant: variantKey,
  hover: hoverKey,
  rounded: roundedKey,
  className,
});
---

<Element
  class={classes}
  data-card-variant={variantKey}
  data-card-hover={hoverKey}
  data-card-rounded={roundedKey}
  {...rest}
>
  {
    Astro.slots.has('header') && (
      <header class={getBaseCardPadding(paddingKey)}>
        <slot name="header" />
      </header>
    )
  }

  {
    Astro.slots.has('image') && (
      <div class="overflow-hidden">
        <slot name="image" />
      </div>
    )
  }

  <div
    class={cn(
      'flex flex-1 flex-col',
      getBaseCardPadding(paddingKey),
      Astro.slots.has('header') && 'pt-0'
    )}
  >
    <slot />
  </div>

  {
    Astro.slots.has('footer') && (
      <footer class={cn(getBaseCardPadding(paddingKey), 'border-t border-border/20 pt-4')}>
        <slot name="footer" />
      </footer>
    )
  }
</Element>
