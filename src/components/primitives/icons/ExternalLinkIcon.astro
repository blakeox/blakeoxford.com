---
export interface Props {
  size?: string | number;
  class?: string;
}

const { size = 18, class: className = '' } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  width={size}
  height={size}
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  aria-hidden="true"
  focusable="false"
>
  <path d="M7 17 17 7m0 0h-7m7 0v7"></path>
</svg>
