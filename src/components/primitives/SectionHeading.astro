---
import { headingSizeClass, type HeadingSizeInput } from '@/lib/typeScale';

interface Props {
  level?: 'h1' | 'h2' | 'h3' | 'h4' | 'h5' | 'h6';
  /** Semantic ladder (identity|hero|display|section|title|subtitle) or legacy xl–5xl aliases */
  size?: HeadingSizeInput;
  class?: string;
  id?: string;
}

const { level = 'h2', size = 'display', class: className = '', id } = Astro.props;

const baseClasses = 'font-heading font-semibold leading-tight tracking-tight text-foreground';
const Tag = level;
---

<Tag id={id} class={`${headingSizeClass(size)} ${baseClasses} ${className}`}>
  <slot />
</Tag>
