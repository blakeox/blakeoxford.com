---
/**
 * Prose - Article/MDX typography shell.
 *
 * Encodes the blog article recipe once so pages don't scatter long
 * `prose-*:` class strings. Token remaps live in `@utility prose` (global.css).
 *
 * @example
 * <Prose>
 *   <Content />
 * </Prose>
 */
import { getProseClasses, type ProseSize } from '@/lib/design-system/recipes';

export interface Props {
  /** Typography scale */
  size?: ProseSize;
  /** HTML element */
  as?: 'div' | 'article' | 'section';
  /** Extra classes */
  class?: string;
}

const props = Astro.props as Props;
const { size = 'xl', as: Element = 'div', class: className = '' } = props;
---

<Element class={getProseClasses(size, className)}>
  <slot />
</Element>
