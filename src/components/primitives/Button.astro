---
/**
 * Button - Reusable button/link component
 *
 * Provides consistent button styling with support for different variants,
 * sizes, and states. Can render as button or link.
 *
 * @example
 * <Button variant="primary" href="/projects">View Projects</Button>
 * <Button variant="outline" size="sm">Learn More</Button>
 * <Button type="submit" loading>Saving…</Button>
 */

import { getButtonClasses, type ButtonSize, type ButtonVariant } from '@/lib/design-system/recipes';

export interface Props {
  /** Button visual variant */
  variant?: ButtonVariant;
  /** Button size */
  size?: ButtonSize;
  /** Render as link (when href provided) or button */
  href?: string;
  /** Button type (when rendered as button) */
  type?: 'button' | 'submit' | 'reset';
  /** Disabled state */
  disabled?: boolean;
  /** Busy / submitting state — disables interaction and sets aria-busy */
  loading?: boolean;
  /** Full width button */
  fullWidth?: boolean;
  /** Additional CSS classes */
  class?: string;
  /** Stable test hook for Playwright and unit tests */
  'data-testid'?: string;
  /** Accessible label for icon-only or ambiguous controls */
  'aria-label'?: string;
  /** Additional HTML attributes */
  [key: string]: unknown;
}

const {
  variant = 'primary',
  size = 'md',
  href,
  type = 'button',
  disabled = false,
  loading = false,
  fullWidth = false,
  class: className = '',
  'aria-label': ariaLabel,
  'data-testid': dataTestId,
  ...rest
} = Astro.props;

const isDisabled = disabled || loading;
const classes = getButtonClasses({
  variant,
  size,
  fullWidth,
  disabled: isDisabled,
  loading,
  className,
});

const Element = href && !isDisabled ? 'a' : 'button';
const elementProps =
  href && !isDisabled
    ? { href, 'aria-label': ariaLabel, 'data-testid': dataTestId, ...rest }
    : {
        type,
        disabled: isDisabled,
        'aria-busy': loading ? ('true' as const) : undefined,
        'aria-label': ariaLabel,
        'data-testid': dataTestId,
        ...rest,
      };
---

<Element class={classes} {...elementProps}>
  <slot />
  {
    loading && (
      <svg
        class="size-5 animate-spin"
        viewBox="0 0 24 24"
        aria-hidden="true"
        data-button-spinner
      >
        <circle
          cx="12"
          cy="12"
          r="10"
          stroke="currentColor"
          stroke-width="3"
          fill="none"
          opacity=".3"
        />
        <path
          d="M22 12a10 10 0 0 0-10-10"
          stroke="currentColor"
          stroke-width="3"
          stroke-linecap="round"
        />
      </svg>
    )
  }
</Element>
