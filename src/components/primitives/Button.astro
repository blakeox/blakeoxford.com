---
/**
 * Button - Reusable button/link component
 *
 * Provides consistent button styling with support for different variants,
 * sizes, and states. Can render as button or link.
 *
 * @example
 * <Button variant="primary" href="/projects">View Projects</Button>
 * <Button variant="outline" size="sm">Learn More</Button>
 */

import { getButtonClasses, type ButtonSize, type ButtonVariant } from '@/lib/design-system/recipes';

export interface Props {
  /** Button visual variant */
  variant?: ButtonVariant;
  /** Button size */
  size?: ButtonSize;
  /** Render as link (when href provided) or button */
  href?: string;
  /** Button type (when rendered as button) */
  type?: 'button' | 'submit' | 'reset';
  /** Disabled state */
  disabled?: boolean;
  /** Full width button */
  fullWidth?: boolean;
  /** Additional CSS classes */
  class?: string;
  /** Stable test hook for Playwright and unit tests */
  'data-testid'?: string;
  /** Accessible label for icon-only or ambiguous controls */
  'aria-label'?: string;
  /** Additional HTML attributes */
  [key: string]: unknown;
}

const {
  variant = 'primary',
  size = 'md',
  href,
  type = 'button',
  disabled = false,
  fullWidth = false,
  class: className = '',
  'aria-label': ariaLabel,
  'data-testid': dataTestId,
  ...rest
} = Astro.props;

const classes = getButtonClasses({ variant, size, fullWidth, disabled, className });

const Element = href && !disabled ? 'a' : 'button';
const elementProps =
  href && !disabled
    ? { href, 'aria-label': ariaLabel, 'data-testid': dataTestId, ...rest }
    : { type, disabled, 'aria-label': ariaLabel, 'data-testid': dataTestId, ...rest };
---

<Element class={classes} {...elementProps}>
  <slot />
</Element>
