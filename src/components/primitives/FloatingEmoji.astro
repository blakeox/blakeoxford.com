---
/**
 * FloatingEmoji Component
 * 
 * Reusable floating emoji decoration with animation.
 * Used for non-content visual accents around hero images.
 * 
 * @example
 * <FloatingEmoji emoji="💡" position="top-right" size="md" />
 * <FloatingEmoji emoji="🚀" position="bottom-left" size="sm" color="accent-dark" />
 */

interface Props {
 emoji: string;
 size?: 'sm' | 'md' | 'lg';
 position: 'top-right' | 'bottom-left' | 'top-left' | 'bottom-right' | 'center-right';
 color?: 'accent' | 'accent-dark' | 'primary';
 class?: string;
}

const { 
 emoji, 
 size = 'md',
 position,
 color = 'accent',
 class: className = '' 
} = Astro.props;

// Size classes for the container
const sizeClasses = {
 'sm': 'w-6 h-6 text-base',
 'md': 'w-10 h-10 text-lg',
 'lg': 'w-12 h-12 text-2xl'
};

// Position classes
const positionClasses = {
 'top-right': 'absolute -top-4 -right-4',
 'bottom-left': 'absolute -bottom-2 -left-4',
 'top-left': 'absolute -top-4 -left-4',
 'bottom-right': 'absolute -bottom-2 -right-4',
 'center-right': 'absolute top-1/2 -right-9'
};

// Color classes for background
const colorClasses = {
 'accent': 'bg-accent',
 'accent-dark': 'bg-accent-dark',
 'primary': 'bg-primary'
};

const finalClasses = `${positionClasses[position]} ${sizeClasses[size]} ${colorClasses[color]} rounded-full flex items-center justify-center text-background animate-float ${className}`.trim();
---

<div class={finalClasses} aria-hidden='true'>
 {emoji}
</div>
