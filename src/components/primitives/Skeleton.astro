---
/**
 * Skeleton - Loading placeholder component
 * 
 * Provides animated skeleton placeholders for content that is loading.
 * Supports different variants for cards, text, images, etc.
 * 
 * @component
 * @category Primitives
 * 
 * @example Card skeleton
 * ```astro
 * <Skeleton variant="card" />
 * ```
 * 
 * @example Image skeleton
 * ```astro
 * <Skeleton variant="image" aspectRatio="16/9" />
 * ```
 * 
 * @prop {'card' | 'image' | 'text' | 'avatar' | 'custom'} [variant='card'] - Skeleton variant
 * @prop {string} [aspectRatio] - Aspect ratio for image variant (e.g., "16/9")
 * @prop {number} [lines=3] - Number of text lines for text variant
 * @prop {string} [class] - Additional CSS classes
 */
interface Props {
  variant?: 'card' | 'image' | 'text' | 'avatar' | 'custom';
  aspectRatio?: string;
  lines?: number;
  class?: string;
}

const { 
  variant = 'card',
  aspectRatio,
  lines = 3,
  class: className = '',
} = Astro.props as Props;

const baseClasses = 'animate-pulse bg-surface-subtle rounded-lg';
---

{variant === 'card' && (
  <div class={`${baseClasses} ${className}`}>
    <div class="h-48 bg-surface/50 rounded-t-lg"></div>
    <div class="p-6 space-y-3">
      <div class="h-4 bg-surface/50 rounded w-3/4"></div>
      <div class="h-4 bg-surface/50 rounded w-1/2"></div>
      <div class="h-4 bg-surface/50 rounded w-5/6"></div>
    </div>
  </div>
)}

{variant === 'image' && (
  <div 
    class={`${baseClasses} ${className}`}
    style={aspectRatio ? `aspect-ratio: ${aspectRatio};` : undefined}
  >
    <div class="h-full w-full bg-surface/50 rounded-lg"></div>
  </div>
)}

{variant === 'text' && (
  <div class={`${baseClasses} space-y-2 ${className}`}>
    {Array.from({ length: lines }).map((_, i) => (
      <div 
        class={`h-4 bg-surface/50 rounded ${i === lines - 1 ? 'w-3/4' : 'w-full'}`}
      />
    ))}
  </div>
)}

{variant === 'avatar' && (
  <div class={`${baseClasses} h-12 w-12 rounded-full bg-surface/50 ${className}`}></div>
)}

{variant === 'custom' && (
  <div class={`${baseClasses} ${className}`}></div>
)}

