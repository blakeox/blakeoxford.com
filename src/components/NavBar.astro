---
// Modern NavBar.astro component inspired by Hiro's clean design
import navLinks from '../config/navLinks';
---

<nav id="navbar" class="navbar-container" role="navigation" aria-label="Main navigation">
  <div class="navbar-content">
    <!-- Brand Section -->
    <div class="brand-section">
      <a href="/" class="brand-link" aria-label="Home">
        <div class="brand-avatar-container">
          <img
            src="/assets/images/Blake-O-scaled.jpg"
            alt="Blake Oxford"
            class="brand-avatar"
            width={32}
            height={32}
            loading="eager"
          />
      </div>
        <span class="brand-text">Blake Oxford</span>
      </a>
    </div>

    <!-- Desktop Navigation -->
    <div class="desktop-nav">
      <ul class="nav-links" role="menubar">
      {navLinks.map((link) => (
          <li class="nav-item" role="none">
          <a
              href={link.href}
            class="nav-link"
            role="menuitem"
            aria-current={Astro.url.pathname === link.href ? 'page' : undefined}
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>
    </div>

    <!-- Action Buttons -->
    <div class="action-buttons">
      <!-- Search Toggle -->
      <button
        id="search-toggle"
        type="button"
        class="action-button search-toggle"
        aria-label="Open search"
        aria-expanded="false"
        aria-controls="search-overlay"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
      </button>

      <!-- Theme Toggle -->
      <button
        id="theme-toggle"
        type="button"
        class="action-button theme-toggle"
        aria-label="Toggle dark mode"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 sun-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
        </svg>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 moon-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
        </svg>
      </button>

      <!-- Mobile Menu Toggle -->
      <button
        id="nav-toggle"
        type="button"
        class="burger-menu-button"
        aria-label="Toggle navigation menu"
        aria-expanded="false"
        aria-controls="nav-mobile-links"


      >
        <div class="burger-container">
          <div class="burger-piece top-bun"></div>
          <div class="burger-piece middle"></div>
          <div class="burger-piece bottom-bun"></div>
        </div>
      </button>
    </div>
  </div>

  <!-- Mobile Menu -->
  <div id="nav-mobile-links" class="mobile-menu" role="dialog" aria-modal="true" aria-labelledby="mobile-menu-title">
    <div class="mobile-menu-backdrop"></div>
    <div class="mobile-menu-content">
      <div class="mobile-menu-header">
        <h2 id="mobile-menu-title" class="sr-only">Mobile navigation menu</h2>
        <button
          id="close-mobile-menu"
          type="button"
          class="mobile-close-button"
          aria-label="Close navigation menu"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
      
      <nav class="mobile-nav" role="navigation" aria-label="Mobile navigation">
        <ul class="mobile-nav-links" role="menubar">
        {navLinks.map((link) => (
            <li class="mobile-nav-item" role="none">
            <a
              href={link.href}
                class="mobile-nav-link"
              role="menuitem"
              aria-current={Astro.url.pathname === link.href ? 'page' : undefined}
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
      </nav>
    </div>
  </div>
</nav>

<style>
  /* Modern Navbar Container - Hiro-inspired design */
  .navbar-container {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 1000;
    background: rgba(255, 255, 255, 0.8);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-bottom: 1px solid rgba(0, 0, 0, 0.06);
    transition: all 0.2s ease;
  }
  
  .dark .navbar-container {
    background: rgba(0, 0, 0, 0.8);
    border-bottom-color: rgba(255, 255, 255, 0.06);
  }
  
  /* Navbar Content */
  .navbar-content {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 24px;
    height: 64px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  
  /* Brand Section */
  .brand-section {
    flex-shrink: 0;
  }
  
  .brand-link {
    display: flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    color: #000;
    font-weight: 600;
    font-size: 16px;
    transition: opacity 0.2s ease;
  }
  
  .dark .brand-link {
    color: #fff;
  }
  
  .brand-link:hover {
    opacity: 0.7;
  }
  
  .brand-avatar-container {
    width: 32px;
    height: 32px;
    border-radius: 8px;
    overflow: hidden;
    border: 1px solid rgba(0, 0, 0, 0.1);
  }
  
  .dark .brand-avatar-container {
    border-color: rgba(255, 255, 255, 0.1);
  }
  
  .brand-avatar {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  
  .brand-text {
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    letter-spacing: -0.01em;
  }
  
  /* Desktop Navigation */
  .desktop-nav {
    display: flex;
    align-items: center;
  }
  
  .nav-links {
    display: flex;
    align-items: center;
    gap: 32px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  
  .nav-item {
    position: relative;
  }
  
  .nav-link {
    display: block;
    padding: 8px 0;
    color: #000;
    text-decoration: none;
    font-weight: 500;
    font-size: 14px;
    transition: color 0.2s ease;
    white-space: nowrap;
  }
  
  .dark .nav-link {
    color: #fff;
  }
  
  .nav-link:hover {
    color: #666;
  }
  
  .dark .nav-link:hover {
    color: #ccc;
  }
  
  .nav-link[aria-current="page"] {
    color: #000;
    font-weight: 600;
  }
  
  .dark .nav-link[aria-current="page"] {
    color: #fff;
  }
  
  /* Action Buttons */
  .action-buttons {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-shrink: 0;
  }
  
  .action-button {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    min-width: 36px;
    min-height: 36px;
    border: none;
    border-radius: 8px;
    background: transparent;
    color: #000;
    cursor: pointer;
    transition: all 0.2s ease;
    outline: none;
    /* Improve touch targets */
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
  }
  
  .dark .action-button {
    color: #fff;
  }
  
  .action-button:hover {
    background: rgba(0, 0, 0, 0.05);
  }
  
  .dark .action-button:hover {
    background: rgba(255, 255, 255, 0.05);
  }
  
  /* Theme Toggle */
  .theme-toggle .moon-icon {
    display: none;
  }
  
  .dark .theme-toggle .sun-icon {
    display: none;
  }
  
  .dark .theme-toggle .moon-icon {
    display: block;
  }
  
  /* Burger Menu */
  .burger-menu-button {
    position: relative;
    width: 36px;
    height: 36px;
    min-width: 36px;
    min-height: 36px;
    border: none;
    background: transparent;
    cursor: pointer;
    outline: none;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s ease;
    /* Improve touch targets */
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
  }
  
  .burger-menu-button:hover {
    background: rgba(0, 0, 0, 0.05);
    border-radius: 8px;
  }
  
  .dark .burger-menu-button:hover {
    background: rgba(255, 255, 255, 0.05);
  }
  
  .burger-container {
    position: relative;
    width: 18px;
    height: 14px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }
  
  .burger-piece {
    width: 100%;
    height: 2px;
    background: #000;
    border-radius: 1px;
    transition: all 0.3s ease;
    transform-origin: center;
  }
  
  .dark .burger-piece {
    background: #fff;
  }
  
  /* Burger Animation */
  .burger-menu-button.active .top-bun {
    transform: rotate(45deg) translate(2px, 2px);
  }
  
  .burger-menu-button.active .middle {
    opacity: 0;
    transform: scaleX(0);
  }
  
  .burger-menu-button.active .bottom-bun {
    transform: rotate(-45deg) translate(2px, -2px);
  }
  
  /* Mobile Menu */
  .mobile-menu {
    position: fixed;
    top: 0;
    right: -100vw;
    width: min(300px, 85vw);
    height: 100vh;
    transition: right 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    z-index: 1010;
    overflow: hidden;
  }
  
  .mobile-menu-backdrop {
    position: absolute;
    top: 0;
    left: -100vw;
    width: 100vw;
    height: 100vh;
    background: rgba(0, 0, 0, 0.5);
    opacity: 0;
    transition: opacity 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    pointer-events: none;
  }
  
  .dark .mobile-menu-backdrop {
    background: rgba(0, 0, 0, 0.7);
  }
  
  .mobile-menu-content {
    position: relative;
    width: 100%;
    height: 100%;
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-left: 1px solid rgba(0, 0, 0, 0.06);
    overflow-y: auto;
  }
  
  .dark .mobile-menu-content {
    background: rgba(0, 0, 0, 0.95);
    border-left-color: rgba(255, 255, 255, 0.06);
  }
  
  .mobile-menu.active {
    right: 0;
  }
  
  .mobile-menu.active .mobile-menu-backdrop {
    opacity: 1;
    pointer-events: auto;
  }
  
  .mobile-menu-header {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    padding: 16px 24px;
    border-bottom: 1px solid rgba(0, 0, 0, 0.06);
  }
  
  .dark .mobile-menu-header {
    border-bottom-color: rgba(255, 255, 255, 0.06);
  }
  
  .mobile-close-button {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border: none;
    border-radius: 8px;
    background: transparent;
    color: #000;
    cursor: pointer;
    transition: all 0.2s ease;
    outline: none;
  }
  
  .dark .mobile-close-button {
    color: #fff;
  }
  
  .mobile-close-button:hover {
    background: rgba(0, 0, 0, 0.05);
  }
  
  .dark .mobile-close-button:hover {
    background: rgba(255, 255, 255, 0.05);
  }
  
  .mobile-nav {
    padding: 24px 0;
  }
  
  .mobile-nav-links {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  
  .mobile-nav-item {
    border-bottom: 1px solid rgba(0, 0, 0, 0.06);
  }
  
  .dark .mobile-nav-item {
    border-bottom-color: rgba(255, 255, 255, 0.06);
  }
  
  .mobile-nav-item:last-child {
    border-bottom: none;
  }
  
  .mobile-nav-link {
    display: block;
    padding: 16px 24px;
    color: #000;
    text-decoration: none;
    font-weight: 500;
    font-size: 16px;
    transition: all 0.2s ease;
  }
  
  .dark .mobile-nav-link {
    color: #fff;
  }
  
  .mobile-nav-link:hover {
    background: rgba(0, 0, 0, 0.05);
  }
  
  .dark .mobile-nav-link:hover {
    background: rgba(255, 255, 255, 0.05);
  }
  
  .mobile-nav-link[aria-current="page"] {
    background: rgba(0, 0, 0, 0.05);
    font-weight: 600;
  }
  
  .dark .mobile-nav-link[aria-current="page"] {
    background: rgba(255, 255, 255, 0.05);
  }
  
  /* Mobile-specific improvements */
  @media (max-width: 768px) {
    .desktop-nav {
      display: none;
    }
    
    .navbar-content {
      padding: 0 16px;
    }
    
    .brand-text {
      font-size: 14px;
    }
    
    .brand-avatar-container {
      width: 28px;
      height: 28px;
    }
    
    .mobile-menu {
      width: min(280px, 80vw);
    }
  }
  
  @media (max-width: 480px) {
    .navbar-content {
      padding: 0 12px;
    }
    
    .brand-text {
      font-size: 13px;
    }
    
    .brand-avatar-container {
      width: 26px;
      height: 26px;
    }
    
    .mobile-menu {
      width: min(260px, 85vw);
    }
    
    .action-buttons {
      gap: 4px;
    }
    
    .action-button {
      width: 32px;
      height: 32px;
    }
  }
  
  @media (max-width: 320px) {
    .mobile-menu {
      width: 90vw;
    }
    
    .navbar-content {
      padding: 0 8px;
    }
  }
  
  @media (min-width: 769px) {
    .burger-menu-button {
      display: none !important;
    }
  }
  

  
  /* Reduced motion support */
  @media (prefers-reduced-motion: reduce) {
    .navbar-container,
    .nav-link,
    .action-button,
    .brand-link,
    .mobile-menu,
    .burger-piece {
      transition: none !important;
      animation: none !important;
    }
    
    .burger-menu-button.active .top-bun,
    .burger-menu-button.active .bottom-bun {
      transform: rotate(45deg) !important;
    }
    
    .burger-menu-button.active .middle {
      opacity: 0 !important;
    }
  }
</style>

<script>
  import { initModernNavBar } from '../scripts/ModernNavBar';
  
  console.log('🎯 NavBar script tag loaded!');
  
  // Initialize navbar when DOM is ready
  console.log('🚀 NavBar script starting...');
  
  function initializeNavBar() {
    console.log('📄 Initializing navbar...');
    
    try {
      // Prevent conflicting NavBarMenu from interfering
      if (typeof window !== 'undefined' && (window as any).navBarMenu) {
        console.log('⚠️ Conflicting NavBarMenu detected, disabling it...');
        (window as any).navBarMenu = null;
      }
      
      // Create the navbar instance using the modular approach
      console.log('🔧 Creating ModernNavBar instance...');
      
      let modernNavBar;
      try {
        modernNavBar = initModernNavBar();
        console.log('✅ ModernNavBar instance created:', modernNavBar);
      } catch (error) {
        console.error('❌ Error creating ModernNavBar:', error);
      }
      
      // Store it globally for debugging
      if (typeof window !== 'undefined' && modernNavBar) {
        (window as any).modernNavBar = modernNavBar;
        console.log('🌐 Stored modernNavBar globally');
      }
      
    } catch (error) {
      console.error('❌ Error initializing navbar:', error);
    }
  }
  
  if (document.readyState === 'loading') {
    console.log('📄 Document still loading, waiting for DOMContentLoaded...');
    document.addEventListener('DOMContentLoaded', () => {
      console.log('📄 DOMContentLoaded fired, initializing navbar...');
      initializeNavBar();
    });
  } else {
    console.log('📄 Document already loaded, initializing navbar immediately...');
    // Wait a bit to ensure DOM is fully ready
    setTimeout(() => {
      initializeNavBar();
    }, 100);
  }
</script> 