---
/**
 * CoinFlipImage - Interactive 3D coin flip image component
 *
 * Displays two images with a 3D flip animation effect.
 * Supports click-to-flip, auto-flip, and customizable animation parameters.
 * Optimized for performance with lazy loading.
 *
 * @component
 * @category Composites
 *
 * @example Basic coin flip
 * ```astro
 * <CoinFlipImage
 * frontSrc="/front.jpg"
 * backSrc="/back.jpg"
 * alt="Front image"
 * altBack="Back image"
 * />
 * ```
 *
 * @example Auto-flip with custom duration
 * ```astro
 * <CoinFlipImage
 * frontSrc="/front.jpg"
 * backSrc="/back.jpg"
 * alt="Front"
 * altBack="Back"
 * flipMultipleTimes={true}
 * duration={1000}
 * />
 * ```
 *
 * @prop {string} frontSrc - Front image source URL
 * @prop {string} backSrc - Back image source URL
 * @prop {string} alt - Front image alt text
 * @prop {string} altBack - Back image alt text
 * @prop {number} [size=144] - Image size in pixels
 * @prop {boolean} [flipMultipleTimes=false] - Enable auto-flip animation
 * @prop {string} [class] - Additional CSS classes
 * @prop {number} [duration=700] - Flip animation duration in ms
 * @prop {boolean} [flipOnClick=true] - Enable click-to-flip
 * @prop {'x'|'y'} [flipAxis='y'] - Flip axis (horizontal or vertical)
 * @prop {string} [flipEase='cubic-bezier(0.22,1,0.36,1)'] - Animation easing
 * @prop {number} [multiFlipDuration=2000] - Auto-flip interval in ms
 * @prop {string} [multiFlipEase='ease-in-out'] - Auto-flip easing
 * @prop {'lazy'|'eager'} [loading='lazy'] - Image loading strategy
 * @prop {'low'|'high'|'auto'} [fetchPriority='low'] - Fetch priority hint
 * @prop {'async'|'sync'|'auto'} [decoding='async'] - Image decoding mode
 *
 * @accessibility
 * - Button with descriptive aria-label
 * - Alt text for both images
 * - Keyboard accessible (Enter/Space)
 * - Focus-visible styles
 */
import CoinFlipClient from '../islands/CoinFlipClient';

function simpleId() {
  return 'coin-flip-' + Math.random().toString(36).slice(2, 10);
}
const {
  frontSrc,
  backSrc,
  alt = '', // alias for front alt text
  altBack = '',
  size = 144,
  flipMultipleTimes = false,
  class: customClass = '',
  duration = 700, // ms
  flipOnClick = true,
  flipAxis = 'y', // 'y' (default) or 'x'
  flipEase = 'cubic-bezier(0.22,1,0.36,1)', // ease-out for realism
  multiFlipDuration = 2000, // ms, slower for multi-flip
  multiFlipEase = 'cubic-bezier(.68,-0.55,.27,1.55)', // springy for multi-flip
} = Astro.props;
// Optional performance-related props (with safe defaults)
const loading: 'eager' | 'lazy' = (Astro.props.loading as any) || 'lazy';
const fetchPriority: 'high' | 'low' | 'auto' = (Astro.props.fetchPriority as any) || 'low';
const decoding: 'async' | 'auto' | 'sync' = (Astro.props.decoding as any) || 'async';
// Compute axis and easing values
const axis = flipAxis === 'x' ? 'X' : 'Y';
const ease = flipEase;
const multiEase = multiFlipEase;
const uniqueId = simpleId();

// Derive image key names (relative to /public/assets/images) for optimized manifests
function toImageKey(src: string) {
  return src
    .replace(/^\/?assets\/images\//, '')
    .replace(/^\/?public\/assets\/images\//, '')
    .replace(/\.(jpg|jpeg|png|webp|avif)$/i, '');
}

const frontKey = toImageKey(frontSrc);
const backKey = toImageKey(backSrc);

// Build responsive srcsets using available optimized variants (avoid 404s)
// We can't reliably read from /public at build time here, so we use a conservative
// size map for known assets and a sensible fallback for others.
const SIZE_MAP: Record<string, number[]> = {
  // Known limited-size asset (only 320w available)
  'china-profile-picture': [320],
  // Common assets with full set generated
  'Blake-O-scaled': [320, 640, 768],
};

// Some optimized assets are emitted without @width suffix (single-variant only).
// For these, prefer the unsuffixed file to avoid 404s.
const NO_SUFFIX = new Set(['china-profile-picture']);

const FALLBACK_BREAKPOINTS = [320, 640, 768];

function getAvailableBreakpoints(name: string): number[] {
  // Normalize key by stripping directories
  const key = name.split('/').pop() || name;
  // Try exact match; also try without extension artifacts
  const simple = key.replace(/\.[a-z0-9]+$/i, '');
  return (SIZE_MAP[simple] || FALLBACK_BREAKPOINTS).slice().sort((a, b) => a - b);
}

function buildSrcSet(name: string, format: string) {
  const widths = getAvailableBreakpoints(name);
  const key = (name.split('/').pop() || name).replace(/\.[a-z0-9]+$/i, '');
  if (NO_SUFFIX.has(key)) {
    // Single-variant, unsuffixed file only
    const w = widths[0] || 320;
    return `/assets/images/optimized/${format}/${key}.${format} ${w}w`;
  }
  return widths
    .map((w: number) => `/assets/images/optimized/${format}/${name}@${w}w.${format} ${w}w`)
    .join(', ');
}

const frontAvifSet = buildSrcSet(frontKey, 'avif');
const frontWebpSet = buildSrcSet(frontKey, 'webp');
const backAvifSet = buildSrcSet(backKey, 'avif');
const backWebpSet = buildSrcSet(backKey, 'webp');

// Choose a reasonable default src for the <img> tag to match requested size
function pickDefaultSrc(name: string) {
  const widths = getAvailableBreakpoints(name);
  const key = (name.split('/').pop() || name).replace(/\.[a-z0-9]+$/i, '');
  // Pick the smallest breakpoint that is >= requested size, else largest available
  const candidate = widths.find((w) => w >= size) || widths[widths.length - 1] || 320;
  if (NO_SUFFIX.has(key)) {
    return `/assets/images/optimized/avif/${key}.avif`;
  }
  return `/assets/images/optimized/avif/${name}@${candidate}w.avif`;
}
---

<noscript>
  <img
    src={frontSrc}
    alt={alt}
    style={`width:${size}px;height:${size}px;`}
    class={`coin-flip-front ${customClass}`}
  />
</noscript>
<button
  type="button"
  class={`coin-flip ${customClass}`}
  style={`width:${size}px;height:${size}px;aspect-ratio:1/1;`}
  aria-pressed="false"
  aria-label="Flip image; shows front/back of a coin."
  id={uniqueId + '-root'}
  data-flip-on-click={flipOnClick}
  data-flip-axis={axis}
>
  <div
    class={'coin-flip-inner' + (flipMultipleTimes ? ' coin-flip-multi' : '')}
    id={uniqueId + '-inner'}
    style={flipMultipleTimes
      ? `transition-duration:${multiFlipDuration}ms;transition-timing-function:${multiEase};`
      : `transition-duration:${duration}ms;transition-timing-function:${ease};`}
  >
    <div class="coin-flip-face coin-flip-front-face">
      <picture>
        {frontAvifSet && <source srcset={frontAvifSet} sizes={`${size}px`} type="image/avif" />}
        {frontWebpSet && <source srcset={frontWebpSet} sizes={`${size}px`} type="image/webp" />}
        <img
          src={pickDefaultSrc(frontKey)}
          alt={alt}
          class="coin-flip-front"
          loading={loading}
          draggable="false"
          width={size}
          height={size}
          fetchpriority={fetchPriority}
          decoding={decoding}
        />
      </picture>
      <div class="coin-flip-highlight"></div>
    </div>
    <div class="coin-flip-edge"></div>
    <div class="coin-flip-face coin-flip-back-face">
      <picture>
        {backAvifSet && <source srcset={backAvifSet} sizes={`${size}px`} type="image/avif" />}
        {backWebpSet && <source srcset={backWebpSet} sizes={`${size}px`} type="image/webp" />}
        <img
          src={pickDefaultSrc(backKey)}
          alt={altBack}
          class="coin-flip-back"
          loading={loading}
          draggable="false"
          width={size}
          height={size}
          fetchpriority={fetchPriority}
          decoding={decoding}
        />
      </picture>
      <div class="coin-flip-highlight"></div>
    </div>
  </div>
  <span id={uniqueId + '-live'} class="sr-only" aria-live="polite"></span>
</button>

<CoinFlipClient
  client:only="react"
  rootId={uniqueId + '-root'}
  innerId={uniqueId + '-inner'}
  liveRegionId={uniqueId + '-live'}
  flipOnClick={flipOnClick}
/>

<style>
  .coin-flip {
    perspective: 1000px;
    display: inline-block;
    border-radius: 50%;
    box-shadow: var(--shadow-lg);
    overflow: hidden;
    cursor: pointer;
    outline: none;
  }
  .coin-flip:focus {
    box-shadow:
      0 0 0 2px var(--color-accent),
      var(--shadow-lg);
  }
  .coin-flip-inner {
    position: relative;
    width: 100%;
    height: 100%;
    transition-property: transform;
    transition-timing-function: var(--ease-standard, cubic-bezier(0.4, 0, 0.2, 1));
    transform-style: preserve-3d;
  }
  .coin-flip-inner.coin-flip-multi {
    /* duration and timing function are set inline */
  }
  .coin-flip-face {
    position: absolute;
    width: 100%;
    height: 100%;
    top: 0;
    left: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    backface-visibility: hidden;
    border-radius: 50%;
    overflow: hidden;
  }
  .coin-flip-front-face {
    z-index: 2;
  }
  .coin-flip-back-face {
    transform: rotateY(180deg);
    z-index: 2;
  }
  .coin-flip-front,
  .coin-flip-back {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 50%;
    display: block;
  }
  .coin-flip-highlight {
    pointer-events: none;
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border-radius: 50%;
    background: radial-gradient(
      ellipse 60% 30% at 60% 30%,
      color-mix(in oklch, var(--color-surface) 18%, transparent) 0%,
      color-mix(in oklch, var(--color-surface) 4%, transparent) 80%,
      transparent 100%
    );
    mix-blend-mode: lighten;
    z-index: 3;
  }
  .coin-flip-edge {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border-radius: 50%;
    z-index: 1;
    box-shadow:
      0 0 0 3px color-mix(in oklch, var(--color-foreground) 12%, transparent) inset,
      0 0 8px 2px color-mix(in oklch, var(--color-foreground) 10%, transparent) inset;
    background: repeating-linear-gradient(
      90deg,
      color-mix(in oklch, var(--color-foreground) 12%, transparent) 0 2px,
      transparent 2px 6px
    );
    pointer-events: none;
  }
  /* Flip axis logic */
  .coin-flip-inner {
    /* Default is Y axis, but JS sets transform inline for flipping */
  }
  @media (prefers-reduced-motion: reduce) {
    .coin-flip-inner,
    .coin-flip-inner.coin-flip-multi {
      transition: none !important;
    }
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
  /* --- Hover/Focus Flip for Y axis --- */
  .coin-flip[data-flip-axis='Y']:hover .coin-flip-inner,
  .coin-flip[data-flip-axis='Y']:focus .coin-flip-inner {
    transform: rotateY(180deg);
  }
  .coin-flip[data-flip-axis='Y']:hover .coin-flip-inner.coin-flip-multi,
  .coin-flip[data-flip-axis='Y']:focus .coin-flip-inner.coin-flip-multi {
    transform: rotateY(900deg);
  }
  /* --- Hover/Focus Flip for X axis --- */
  .coin-flip[data-flip-axis='X']:hover .coin-flip-inner,
  .coin-flip[data-flip-axis='X']:focus .coin-flip-inner {
    transform: rotateX(180deg);
  }
  .coin-flip[data-flip-axis='X']:hover .coin-flip-inner.coin-flip-multi,
  .coin-flip[data-flip-axis='X']:focus .coin-flip-inner.coin-flip-multi {
    transform: rotateX(900deg);
  }
</style>
