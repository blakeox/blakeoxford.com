---
/**
 * CoinFlipImage — interactive 3D coin flip portrait.
 *
 * Flip state is driven by `data-flipped` (CSS). Optional multi-spin flourish on
 * hover when not flipped. Click / keyboard toggles faces; back face loads lazily.
 */
import { cn } from '@/utils/cn';
import blakePortraitMeta from '../../../public/assets/images/optimized/Blake-O-scaled.json';
import chinaPortraitMeta from '../../../public/assets/images/optimized/china-profile-picture.json';

interface Props {
  frontSrc: string;
  backSrc: string;
  alt?: string;
  altBack?: string;
  size?: number;
  flipMultipleTimes?: boolean;
  class?: string;
  duration?: number;
  flipOnClick?: boolean;
  flipAxis?: 'x' | 'y';
  flipEase?: string;
  multiFlipDuration?: number;
  multiFlipEase?: string;
  loading?: 'lazy' | 'eager';
  fetchPriority?: 'low' | 'high' | 'auto';
  decoding?: 'async' | 'sync' | 'auto';
  /**
   * When true, `--coin-size` is not inlined so the parent can drive fluid sizing
   * (e.g. home hero). `size` still guides srcset selection.
   */
  fluid?: boolean;
}

const {
  frontSrc,
  backSrc,
  alt = '',
  altBack = '',
  size = 144,
  flipMultipleTimes = false,
  class: customClass = '',
  duration = 700,
  flipOnClick = true,
  flipAxis = 'y',
  flipEase = 'var(--ease-emphasized)',
  multiFlipDuration = 2000,
  multiFlipEase = 'cubic-bezier(0.68, -0.55, 0.27, 1.55)',
  loading = 'lazy',
  fetchPriority = 'low',
  decoding = 'async',
  fluid = false,
} = Astro.props as Props;

const axis = flipAxis === 'x' ? 'X' : 'Y';

type OptimizedMeta = { sizes: number[]; width?: number };

const OPTIMIZED_META: Record<string, OptimizedMeta> = {
  'Blake-O-scaled': blakePortraitMeta,
  'china-profile-picture': chinaPortraitMeta,
};

/** Keys that only ship an unsuffixed optimized file (no @Nw variants). */
const NO_WIDTH_SUFFIX = new Set(
  Object.entries(OPTIMIZED_META)
    .filter(([, meta]) => meta.sizes.length <= 1)
    .map(([key]) => key)
);

const FALLBACK_BREAKPOINTS = [320, 640, 768];

function toImageKey(src: string): string {
  return src
    .replace(/^\/?assets\/images\//, '')
    .replace(/^\/?public\/assets\/images\//, '')
    .replace(/\.(jpg|jpeg|png|webp|avif)$/i, '');
}

function basename(key: string): string {
  return (key.split('/').pop() || key).replace(/\.[a-z0-9]+$/i, '');
}

function getWidths(name: string): number[] {
  const key = basename(name);
  const fromMeta = OPTIMIZED_META[key]?.sizes;
  return (fromMeta?.length ? fromMeta : FALLBACK_BREAKPOINTS).slice().sort((a, b) => a - b);
}

function buildSrcSet(name: string, format: string): string {
  const widths = getWidths(name);
  const key = basename(name);
  if (NO_WIDTH_SUFFIX.has(key)) {
    const w = OPTIMIZED_META[key]?.width || widths[0] || 320;
    return `/assets/images/optimized/${format}/${key}.${format} ${w}w`;
  }
  return widths
    .map((w) => `/assets/images/optimized/${format}/${name}@${w}w.${format} ${w}w`)
    .join(', ');
}

function pickDefaultSrc(name: string): string {
  const widths = getWidths(name);
  const key = basename(name);
  const candidate = widths.find((w) => w >= size) || widths[widths.length - 1] || 320;
  if (NO_WIDTH_SUFFIX.has(key)) {
    return `/assets/images/optimized/avif/${key}.avif`;
  }
  return `/assets/images/optimized/avif/${name}@${candidate}w.avif`;
}

const uniqueId = `coin-flip-${toImageKey(frontSrc)
  .replace(/[^a-z0-9]+/gi, '-')
  .slice(0, 24)}`;
const frontKey = toImageKey(frontSrc);
const backKey = toImageKey(backSrc);
const frontAvifSet = buildSrcSet(frontKey, 'avif');
const frontWebpSet = buildSrcSet(frontKey, 'webp');
const backAvifSet = buildSrcSet(backKey, 'avif');
const backWebpSet = buildSrcSet(backKey, 'webp');

const ariaLabel =
  alt && altBack
    ? `Flip portrait. Front: ${alt}. Back: ${altBack}.`
    : 'Flip portrait to see the other side.';
---

<noscript>
  <img
    src={frontSrc}
    alt={alt}
    width={size}
    height={size}
    class={cn('rounded-full object-cover', customClass)}
  />
</noscript>

<button
  type="button"
  class={cn('coin-flip focus-ring-interactive', fluid && 'coin-flip-fluid', customClass)}
  style={fluid
    ? `--coin-duration:${duration}ms;--coin-ease:${flipEase};--coin-multi-duration:${multiFlipDuration}ms;--coin-multi-ease:${multiFlipEase};`
    : `--coin-size:${size}px;--coin-duration:${duration}ms;--coin-ease:${flipEase};--coin-multi-duration:${multiFlipDuration}ms;--coin-multi-ease:${multiFlipEase};`}
  aria-pressed="false"
  aria-label={ariaLabel}
  id={`${uniqueId}-root`}
  data-bo-coin
  data-flip-on-click={flipOnClick ? 'true' : 'false'}
  data-flip-axis={axis}
  data-flipped="false"
  data-multi={flipMultipleTimes ? 'true' : 'false'}
  data-hint="true"
>
  <div class="coin-flip-inner" id={`${uniqueId}-inner`}>
    <div class="coin-flip-face coin-flip-front-face">
      <picture>
        {frontAvifSet && <source srcset={frontAvifSet} sizes={`${size}px`} type="image/avif" />}
        {frontWebpSet && <source srcset={frontWebpSet} sizes={`${size}px`} type="image/webp" />}
        <img
          src={pickDefaultSrc(frontKey)}
          alt={alt}
          class="coin-flip-photo"
          loading={loading}
          draggable="false"
          width={size}
          height={size}
          fetchpriority={fetchPriority}
          decoding={decoding}
        />
      </picture>
      <div class="coin-flip-highlight" aria-hidden="true"></div>
    </div>
    <div class="coin-flip-face coin-flip-back-face">
      <picture>
        {backAvifSet && <source srcset={backAvifSet} sizes={`${size}px`} type="image/avif" />}
        {backWebpSet && <source srcset={backWebpSet} sizes={`${size}px`} type="image/webp" />}
        <img
          src={pickDefaultSrc(backKey)}
          alt={altBack}
          class="coin-flip-photo"
          loading="lazy"
          draggable="false"
          width={size}
          height={size}
          fetchpriority="low"
          decoding="async"
          data-coin-back
        />
      </picture>
      <div class="coin-flip-highlight" aria-hidden="true"></div>
    </div>
  </div>
  <span class="coin-flip-hint" aria-hidden="true">Flip</span>
  <span id={`${uniqueId}-live`} class="sr-only" aria-live="polite" data-coin-live></span>
</button>

<script>
  function bindCoinFlip(root: HTMLElement) {
    if (root.dataset.boBound === 'true') return;
    root.dataset.boBound = 'true';

    const liveRegion = root.querySelector<HTMLElement>('[data-coin-live]');
    const backImg = root.querySelector<HTMLImageElement>('[data-coin-back]');
    const flipOnClick = root.getAttribute('data-flip-on-click') === 'true';

    const announce = (message: string) => {
      if (!liveRegion) return;
      liveRegion.textContent = message;
      window.setTimeout(() => {
        liveRegion.textContent = '';
      }, 750);
    };

    const warmBack = () => {
      if (!backImg || backImg.dataset.warmed === 'true') return;
      backImg.dataset.warmed = 'true';
      if (backImg.loading === 'lazy') {
        backImg.loading = 'eager';
      }
    };

    root.addEventListener('pointerenter', warmBack, { once: true });
    root.addEventListener('focus', warmBack, { once: true });

    root.addEventListener('click', () => {
      if (!flipOnClick) return;
      warmBack();
      const next = root.getAttribute('data-flipped') !== 'true';
      root.setAttribute('data-flipped', next ? 'true' : 'false');
      root.setAttribute('aria-pressed', next ? 'true' : 'false');
      root.setAttribute('data-hint', 'false');
      announce(next ? 'Showing reverse side.' : 'Showing front side.');
    });

    // Once the user explores via hover, drop the Flip hint
    root.addEventListener(
      'pointerenter',
      () => {
        if (root.getAttribute('data-multi') === 'true') {
          root.setAttribute('data-hint', 'false');
        }
      },
      { once: true }
    );
  }

  function setupCoinFlips() {
    document.querySelectorAll<HTMLElement>('[data-bo-coin]').forEach(bindCoinFlip);
  }

  setupCoinFlips();
  document.addEventListener('astro:page-load', setupCoinFlips);
</script>

<style>
  .coin-flip {
    position: relative;
    display: block;
    width: var(--coin-size, 144px);
    height: var(--coin-size, 144px);
    margin-inline: auto;
    aspect-ratio: 1;
    overflow: visible;
    cursor: pointer;
    border-radius: 50%;
    box-shadow: var(--shadow-lg);
    perspective: 1000px;
  }

  .coin-flip-inner {
    position: relative;
    width: 100%;
    height: 100%;
    border-radius: 50%;
    transform-style: preserve-3d;
    transition: transform var(--coin-duration, 700ms) var(--coin-ease, var(--ease-emphasized));
  }

  .coin-flip-face {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    border-radius: 50%;
    backface-visibility: hidden;
    box-shadow:
      var(--shadow-lg),
      0 0 0 1px color-mix(in oklch, var(--color-foreground) 8%, transparent) inset;
  }

  .coin-flip-front-face {
    z-index: 2;
  }

  .coin-flip-back-face {
    z-index: 2;
    transform: rotateY(180deg);
  }

  .coin-flip[data-flip-axis='X'] .coin-flip-back-face {
    transform: rotateX(180deg);
  }

  .coin-flip-photo {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 18%;
    border-radius: 50%;
  }

  .coin-flip-highlight {
    pointer-events: none;
    position: absolute;
    inset: 0;
    z-index: 3;
    border-radius: 50%;
    background: radial-gradient(
      ellipse 60% 30% at 60% 30%,
      color-mix(in oklch, var(--color-surface) 18%, transparent) 0%,
      color-mix(in oklch, var(--color-surface) 4%, transparent) 80%,
      transparent 100%
    );
    mix-blend-mode: lighten;
  }

  .coin-flip-hint {
    pointer-events: none;
    position: absolute;
    left: 50%;
    bottom: -1.75rem;
    z-index: 4;
    translate: -50% 0;
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: color-mix(in oklch, var(--color-muted-foreground) 88%, transparent);
    opacity: 0;
  }

  /* Click / pressed resting state — no inline transform fights */
  .coin-flip[data-flipped='true'][data-flip-axis='Y'] .coin-flip-inner {
    transform: rotateY(180deg);
  }

  .coin-flip[data-flipped='true'][data-flip-axis='X'] .coin-flip-inner {
    transform: rotateX(180deg);
  }

  @media (prefers-reduced-motion: no-preference) {
    .coin-flip[data-hint='true'] .coin-flip-hint {
      animation: coin-hint-fade 4s ease-in-out 1.2s both;
    }

    /* Hover multi-spin when enabled and still showing the front face */
    .coin-flip[data-multi='true']:hover:not([data-flipped='true']) .coin-flip-inner,
    .coin-flip[data-multi='true']:focus-visible:not([data-flipped='true']) .coin-flip-inner {
      transform: rotateY(900deg);
      transition-duration: var(--coin-multi-duration, 2000ms);
      transition-timing-function: var(--coin-multi-ease);
      animation: none;
    }

    .coin-flip[data-multi='true'][data-flip-axis='X']:hover:not([data-flipped='true'])
      .coin-flip-inner,
    .coin-flip[data-multi='true'][data-flip-axis='X']:focus-visible:not([data-flipped='true'])
      .coin-flip-inner {
      transform: rotateX(900deg);
    }

    /* Soft idle nudge only when multi-spin is off */
    .coin-flip[data-multi='false'][data-hint='true']:not([data-flipped='true']) .coin-flip-inner {
      animation: coin-idle-nudge 5s ease-in-out 0.8s 1;
    }

    .coin-flip[data-hint='false'] .coin-flip-inner,
    .coin-flip[data-flipped='true'] .coin-flip-inner,
    .coin-flip[data-multi='false'][data-hint='true']:hover .coin-flip-inner,
    .coin-flip[data-multi='false'][data-hint='true']:focus-visible .coin-flip-inner {
      animation: none;
    }
  }

  @keyframes coin-idle-nudge {
    0%,
    100% {
      transform: rotateY(0deg);
    }
    35% {
      transform: rotateY(-12deg);
    }
    55% {
      transform: rotateY(8deg);
    }
    70% {
      transform: rotateY(0deg);
    }
  }

  @keyframes coin-hint-fade {
    0%,
    100% {
      opacity: 0;
    }
    15%,
    70% {
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .coin-flip-inner {
      transition: none !important;
      animation: none !important;
    }

    .coin-flip[data-hint='true'] .coin-flip-hint {
      opacity: 1;
      animation: none;
    }
  }
</style>
