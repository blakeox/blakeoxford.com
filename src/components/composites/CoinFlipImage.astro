---
/**
 * CoinFlipImage — interactive 3D coin flip portrait.
 *
 * Flip state is driven by `data-flipped` (CSS). Optional multi-flip flourish on hover.
 * Click / keyboard (native button) toggles faces; no competing inline transforms.
 */
import CoinFlipClient from '../islands/CoinFlipClient';
import { cn } from '../../utils/cn';
import blakePortraitMeta from '../../../public/assets/images/optimized/Blake-O-scaled.json';
import chinaPortraitMeta from '../../../public/assets/images/optimized/china-profile-picture.json';

interface Props {
  frontSrc: string;
  backSrc: string;
  alt?: string;
  altBack?: string;
  size?: number;
  flipMultipleTimes?: boolean;
  class?: string;
  duration?: number;
  flipOnClick?: boolean;
  flipAxis?: 'x' | 'y';
  flipEase?: string;
  multiFlipDuration?: number;
  multiFlipEase?: string;
  loading?: 'lazy' | 'eager';
  fetchPriority?: 'low' | 'high' | 'auto';
  decoding?: 'async' | 'sync' | 'auto';
}

const {
  frontSrc,
  backSrc,
  alt = '',
  altBack = '',
  size = 144,
  flipMultipleTimes = false,
  class: customClass = '',
  duration = 700,
  flipOnClick = true,
  flipAxis = 'y',
  flipEase = 'var(--ease-emphasized)',
  multiFlipDuration = 2000,
  multiFlipEase = 'cubic-bezier(0.68, -0.55, 0.27, 1.55)',
  loading = 'lazy',
  fetchPriority = 'low',
  decoding = 'async',
} = Astro.props as Props;

const axis = flipAxis === 'x' ? 'X' : 'Y';
const uniqueId = `coin-flip-${Math.random().toString(36).slice(2, 10)}`;

type OptimizedMeta = { sizes: number[] };

const OPTIMIZED_META: Record<string, OptimizedMeta> = {
  'Blake-O-scaled': blakePortraitMeta,
  'china-profile-picture': chinaPortraitMeta,
};

/** Keys that only ship an unsuffixed optimized file (no @Nw variants). */
const NO_WIDTH_SUFFIX = new Set(
  Object.entries(OPTIMIZED_META)
    .filter(([, meta]) => meta.sizes.length <= 1)
    .map(([key]) => key)
);

const FALLBACK_BREAKPOINTS = [320, 640, 768];

function toImageKey(src: string): string {
  return src
    .replace(/^\/?assets\/images\//, '')
    .replace(/^\/?public\/assets\/images\//, '')
    .replace(/\.(jpg|jpeg|png|webp|avif)$/i, '');
}

function basename(key: string): string {
  return (key.split('/').pop() || key).replace(/\.[a-z0-9]+$/i, '');
}

function getWidths(name: string): number[] {
  const key = basename(name);
  const fromMeta = OPTIMIZED_META[key]?.sizes;
  return (fromMeta?.length ? fromMeta : FALLBACK_BREAKPOINTS).slice().sort((a, b) => a - b);
}

function buildSrcSet(name: string, format: string): string {
  const widths = getWidths(name);
  const key = basename(name);
  if (NO_WIDTH_SUFFIX.has(key)) {
    const w = widths[0] || 320;
    return `/assets/images/optimized/${format}/${key}.${format} ${w}w`;
  }
  return widths
    .map((w) => `/assets/images/optimized/${format}/${name}@${w}w.${format} ${w}w`)
    .join(', ');
}

function pickDefaultSrc(name: string): string {
  const widths = getWidths(name);
  const key = basename(name);
  const candidate = widths.find((w) => w >= size) || widths[widths.length - 1] || 320;
  if (NO_WIDTH_SUFFIX.has(key)) {
    return `/assets/images/optimized/avif/${key}.avif`;
  }
  return `/assets/images/optimized/avif/${name}@${candidate}w.avif`;
}

const frontKey = toImageKey(frontSrc);
const backKey = toImageKey(backSrc);
const frontAvifSet = buildSrcSet(frontKey, 'avif');
const frontWebpSet = buildSrcSet(frontKey, 'webp');
const backAvifSet = buildSrcSet(backKey, 'avif');
const backWebpSet = buildSrcSet(backKey, 'webp');

const ariaLabel =
  alt && altBack
    ? `Flip portrait. Front: ${alt}. Back: ${altBack}.`
    : 'Flip portrait to see the other side.';
---

<noscript>
  <img
    src={frontSrc}
    alt={alt}
    width={size}
    height={size}
    class={cn('rounded-full object-cover', customClass)}
  />
</noscript>

<button
  type="button"
  class={cn('coin-flip focus-ring-interactive', customClass)}
  style={`--coin-size:${size}px;--coin-duration:${duration}ms;--coin-ease:${flipEase};--coin-multi-duration:${multiFlipDuration}ms;--coin-multi-ease:${multiFlipEase};`}
  aria-pressed="false"
  aria-label={ariaLabel}
  id={`${uniqueId}-root`}
  data-flip-on-click={flipOnClick ? 'true' : 'false'}
  data-flip-axis={axis}
  data-flipped="false"
  data-multi={flipMultipleTimes ? 'true' : 'false'}
>
  <div class="coin-flip-inner" id={`${uniqueId}-inner`}>
    <div class="coin-flip-face coin-flip-front-face">
      <picture>
        {frontAvifSet && <source srcset={frontAvifSet} sizes={`${size}px`} type="image/avif" />}
        {frontWebpSet && <source srcset={frontWebpSet} sizes={`${size}px`} type="image/webp" />}
        <img
          src={pickDefaultSrc(frontKey)}
          alt={alt}
          class="coin-flip-photo"
          loading={loading}
          draggable="false"
          width={size}
          height={size}
          fetchpriority={fetchPriority}
          decoding={decoding}
        />
      </picture>
      <div class="coin-flip-highlight" aria-hidden="true"></div>
    </div>
    <div class="coin-flip-edge" aria-hidden="true"></div>
    <div class="coin-flip-face coin-flip-back-face">
      <picture>
        {backAvifSet && <source srcset={backAvifSet} sizes={`${size}px`} type="image/avif" />}
        {backWebpSet && <source srcset={backWebpSet} sizes={`${size}px`} type="image/webp" />}
        <img
          src={pickDefaultSrc(backKey)}
          alt={altBack}
          class="coin-flip-photo"
          loading={loading}
          draggable="false"
          width={size}
          height={size}
          fetchpriority={fetchPriority}
          decoding={decoding}
        />
      </picture>
      <div class="coin-flip-highlight" aria-hidden="true"></div>
    </div>
  </div>
  <span id={`${uniqueId}-live`} class="sr-only" aria-live="polite"></span>
</button>

<CoinFlipClient
  client:only="react"
  rootId={`${uniqueId}-root`}
  liveRegionId={`${uniqueId}-live`}
  flipOnClick={flipOnClick}
/>

<style>
  .coin-flip {
    position: relative;
    display: inline-block;
    width: var(--coin-size, 144px);
    height: var(--coin-size, 144px);
    aspect-ratio: 1;
    overflow: hidden;
    cursor: pointer;
    border-radius: 50%;
    box-shadow: var(--shadow-lg);
    perspective: 1000px;
  }

  .coin-flip-inner {
    position: relative;
    width: 100%;
    height: 100%;
    transform-style: preserve-3d;
    transition: transform var(--coin-duration, 700ms) var(--coin-ease, var(--ease-emphasized));
  }

  .coin-flip-face {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    border-radius: 50%;
    backface-visibility: hidden;
  }

  .coin-flip-front-face {
    z-index: 2;
  }

  .coin-flip-back-face {
    z-index: 2;
    transform: rotateY(180deg);
  }

  .coin-flip[data-flip-axis='X'] .coin-flip-back-face {
    transform: rotateX(180deg);
  }

  .coin-flip-photo {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 50%;
  }

  .coin-flip-highlight {
    pointer-events: none;
    position: absolute;
    inset: 0;
    z-index: 3;
    border-radius: 50%;
    background: radial-gradient(
      ellipse 60% 30% at 60% 30%,
      color-mix(in oklch, var(--color-surface) 18%, transparent) 0%,
      color-mix(in oklch, var(--color-surface) 4%, transparent) 80%,
      transparent 100%
    );
    mix-blend-mode: lighten;
  }

  .coin-flip-edge {
    pointer-events: none;
    position: absolute;
    inset: 0;
    z-index: 1;
    border-radius: 50%;
    box-shadow:
      0 0 0 3px color-mix(in oklch, var(--color-foreground) 12%, transparent) inset,
      0 0 8px 2px color-mix(in oklch, var(--color-foreground) 10%, transparent) inset;
    background: repeating-linear-gradient(
      90deg,
      color-mix(in oklch, var(--color-foreground) 12%, transparent) 0 2px,
      transparent 2px 6px
    );
  }

  /* Click / pressed resting state — no inline transform fights */
  .coin-flip[data-flipped='true'][data-flip-axis='Y'] .coin-flip-inner {
    transform: rotateY(180deg);
  }

  .coin-flip[data-flipped='true'][data-flip-axis='X'] .coin-flip-inner {
    transform: rotateX(180deg);
  }

  @media (prefers-reduced-motion: no-preference) {
    .coin-flip[data-multi='true']:hover:not([data-flipped='true']) .coin-flip-inner,
    .coin-flip[data-multi='true']:focus-visible:not([data-flipped='true']) .coin-flip-inner {
      transform: rotateY(900deg);
      transition-duration: var(--coin-multi-duration, 2000ms);
      transition-timing-function: var(--coin-multi-ease);
    }

    .coin-flip[data-multi='true'][data-flip-axis='X']:hover:not([data-flipped='true'])
      .coin-flip-inner,
    .coin-flip[data-multi='true'][data-flip-axis='X']:focus-visible:not([data-flipped='true'])
      .coin-flip-inner {
      transform: rotateX(900deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .coin-flip-inner {
      transition: none !important;
    }
  }
</style>
