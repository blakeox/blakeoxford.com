---
/**
 * ButtonGroup - Pre-styled Button Container Component
 *
 * A flexible container for grouping buttons with consistent spacing and responsive behavior.
 * Simplifies common button group patterns like hero CTAs and form actions.
 *
 * @example Hero CTA buttons
 * <ButtonGroup align="center" responsive>
 * <Button href="/projects">View Projects</Button>
 * <Button variant="outline" href="/contact">Get in Touch</Button>
 * </ButtonGroup>
 *
 * @example Form action buttons
 * <ButtonGroup align="end" gap="sm">
 * <Button variant="outline" type="button">Cancel</Button>
 * <Button type="submit">Submit</Button>
 * </ButtonGroup>
 */

import Flex from '../primitives/Flex.astro';
import type { HTMLAttributes } from 'astro/types';

interface Props {
  /** Horizontal alignment of buttons */
  align?: 'start' | 'center' | 'end';
  /** Gap between buttons */
  gap?: 'xs' | 'sm' | 'md' | 'lg' | 'xl';
  /** Make responsive (stack vertically on mobile) */
  responsive?: boolean;
  /** Responsive breakpoint (only if responsive=true) */
  breakpoint?: 'sm' | 'md' | 'lg';
  /** Additional CSS classes */
  class?: string;
  /** ARIA role */
  role?: HTMLAttributes<'div'>['role'];
}

const {
  align = 'center',
  gap = 'md',
  responsive = false,
  breakpoint = 'sm',
  class: className = '',
  role,
  ...rest
} = Astro.props;

// Map alignment to justify prop
const justifyMap = {
  start: 'start',
  center: 'center',
  end: 'end',
} as const;

const justify = justifyMap[align];

// Use responsive prop for Flex if requested
const responsiveBreakpoint = responsive ? breakpoint : undefined;

// Additional styling for button groups
const buttonGroupClasses = 'pt-2';

const combinedClasses = `${buttonGroupClasses} ${className}`.trim();
---

<Flex
  direction="row"
  responsive={responsiveBreakpoint}
  gap={gap}
  justify={justify}
  align="center"
  class={combinedClasses}
  role={role}
  {...rest}
>
  <slot />
</Flex>
