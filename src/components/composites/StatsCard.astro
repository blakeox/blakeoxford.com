---
/**
 * StatsCard - Statistics/Metrics Display Component
 * 
 * Uses container queries for responsive typography inside grid layouts.
 */

interface Props {
 label: string;
 value: string;
 description?: string;
 variant?: 'default' | 'elevated' | 'glass' | 'subtle';
 size?: 'sm' | 'md' | 'lg';
 class?: string;
}

const {
 label,
 value,
 description,
 variant = 'default',
 size = 'md',
 class: className = '',
 ...rest
} = Astro.props;

const variantMap = {
 default: 'bg-background ring-1 ring-border/30 shadow-lg',
 elevated: 'bg-surface shadow-lg ring-1 ring-border/20',
 glass: 'bg-surface/60 backdrop-blur-md ring-1 ring-border/40 shadow-lg',
 subtle: 'bg-surface-subtle/40 ring-1 ring-border/25',
};

const sizeMap = {
 sm: {
 container: 'px-3 py-4',
 label: 'text-xxs @sm:text-xs mb-2',
 value: 'text-lg @md:text-xl',
 description: 'text-xs mt-2',
 },
 md: {
 container: 'px-4 py-5 @sm:px-5 @sm:py-6',
 label: 'text-xs @md:text-sm mb-3 @sm:mb-4',
 value: 'text-xl @md:text-2xl @lg:text-3xl',
 description: 'text-sm mt-2 @sm:mt-3',
 },
 lg: {
 container: 'px-5 py-6 @sm:px-6 @sm:py-8',
 label: 'text-xs @sm:text-sm mb-4 @sm:mb-5',
 value: 'text-2xl @md:text-3xl @lg:text-4xl',
 description: 'text-sm @md:text-base mt-3 @sm:mt-4',
 },
};

const variantClasses = variantMap[variant];
const sizeClasses = sizeMap[size];

const containerClasses = `rounded-2xl ${variantClasses} ${sizeClasses.container} ${className}`.trim();
---

<div class="@container" {...rest}>
 <div class={containerClasses}>
 <p class={`font-semibold uppercase tracking-label text-subtle-foreground ${sizeClasses.label}`}>
 {label}
 </p>
 <p class={`font-semibold text-foreground ${sizeClasses.value}`}>
 {value}
 </p>
 {description && (
 <p class={`text-muted-foreground leading-relaxed ${sizeClasses.description}`}>
 {description}
 </p>
 )}
 <slot />
 </div>
</div>
