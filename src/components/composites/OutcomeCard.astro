---
import BaseCard from '../primitives/BaseCard.astro';

export interface Props {
  title: string;
  achievements: string[];
}

const { title, achievements } = Astro.props;
---

<BaseCard variant="subtle" hover="none" rounded="3xl" padding="lg" as="section">
  <header class="space-y-2 mb-4">
    <p class="text-xs font-semibold uppercase tracking-label text-subtle-foreground">
      Outcome thread
    </p>
    <h3 class="text-xl sm:text-2xl font-semibold text-foreground">
      {title}
    </h3>
  </header>
  <ul class="space-y-3 text-sm leading-relaxed text-muted-foreground">
    {achievements.map((achievement) => (
      <li class="flex items-start gap-3" set:html={'<span class="mt-1 block h-1.5 w-1.5 rounded-full bg-accent"></span>' + achievement}></li>
    ))}
  </ul>
</BaseCard>
