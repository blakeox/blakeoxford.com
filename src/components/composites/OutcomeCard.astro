---
import BaseCard from '../primitives/BaseCard.astro';

export interface Props {
  title: string;
  achievements: string[];
}

const { title, achievements } = Astro.props;
---

<BaseCard variant="subtle" hover="none" rounded="3xl" padding="lg" as="section" class="@container">
  <header class="mb-4 space-y-2">
    <p class="text-xs font-semibold tracking-label text-subtle-foreground uppercase">
      Outcome thread
    </p>
    <h3 class="text-xl font-semibold text-foreground @sm:text-2xl">
      {title}
    </h3>
  </header>
  <ul class="space-y-3 text-sm leading-relaxed text-muted-foreground">
    {
      achievements.map((achievement) => (
        <li
          class="flex items-start gap-3"
          set:html={
            '<span class="mt-1 block h-1.5 w-1.5 rounded-full bg-accent"></span>' + achievement
          }
        />
      ))
    }
  </ul>
</BaseCard>
