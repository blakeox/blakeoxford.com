---
/**
 * Case-study CTA — article-density CtaBand so closers share one lockup.
 */
import CtaBand from '@/components/composites/CtaBand.astro';

interface Props {
  heading: string;
  description: string;
  primaryLabel?: string;
  primaryHref?: string;
  secondaryLabel?: string;
  secondaryHref?: string;
}

const {
  heading,
  description,
  primaryLabel = 'Discuss your bottleneck',
  primaryHref = '/contact/',
  secondaryLabel = 'Back to selected work',
  secondaryHref = '/projects/',
} = Astro.props;
---

<CtaBand
  density="article"
  title={heading}
  description={description}
  primary={{ href: primaryHref, label: primaryLabel }}
  secondary={{ href: secondaryHref, label: secondaryLabel }}
/>
