---
/**
 * Case-study CTA — matches home / projects closing band language.
 */
import Button from '../primitives/Button.astro';
import ButtonGroup from '../composites/ButtonGroup.astro';
import { headingSizeClass } from '../../lib/typeScale';

interface Props {
  heading: string;
  description: string;
  primaryLabel?: string;
  primaryHref?: string;
  secondaryLabel?: string;
  secondaryHref?: string;
}

const {
  heading,
  description,
  primaryLabel = 'Book a 20-minute bottleneck review',
  primaryHref = '/contact/',
  secondaryLabel = 'Back to selected work',
  secondaryHref = '/projects/',
} = Astro.props;
---

<div class="flex max-w-2xl flex-col gap-5">
  <h3
    class:list={[
      'font-heading font-semibold tracking-tight text-foreground',
      headingSizeClass('title'),
    ]}
  >
    {heading}
  </h3>
  <p class="text-base leading-relaxed text-muted-foreground sm:text-lg">
    {description}
  </p>
  <ButtonGroup align="start" responsive class="pt-1">
    <Button variant="primary" href={primaryHref}>
      {primaryLabel}
    </Button>
    <Button variant="outline" href={secondaryHref}>
      {secondaryLabel}
    </Button>
  </ButtonGroup>
</div>
