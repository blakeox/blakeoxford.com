---
/**
 * FeatureItem - Individual Feature in FeatureGrid
 * 
 * A standardized feature item with icon, title, and description.
 * Use within FeatureGrid or standalone.
 * 
 * @example
 * <FeatureItem 
 *   icon="💡" 
 *   title="Smart Automation"
 *   description="AI-powered workflows that adapt to your needs."
 * />
 */

import Stack from '../primitives/Stack.astro';

interface Props {
  /** Icon (emoji, SVG, or image) */
  icon?: string;
  /** Feature title */
  title: string;
  /** Feature description */
  description: string;
  /** Icon size variant */
  iconSize?: 'sm' | 'md' | 'lg';
  /** Text alignment */
  align?: 'left' | 'center' | 'right';
  /** Additional CSS classes */
  class?: string;
}

const {
  icon,
  title,
  description,
  iconSize = 'md',
  align = 'left',
  class: className = '',
  ...rest
} = Astro.props;

const iconSizeMap = {
  sm: 'text-2xl',
  md: 'text-3xl',
  lg: 'text-4xl',
};

const alignMap = {
  left: 'text-left',
  center: 'text-center',
  right: 'text-right',
};

const iconSizeClass = iconSizeMap[iconSize];
const alignClass = alignMap[align];
---

<Stack space="md" class={`${alignClass} ${className}`.trim()} {...rest}>
  {icon && (
    <div class={`${iconSizeClass} ${align === 'center' ? 'mx-auto' : ''}`}>
      {icon}
    </div>
  )}
  <slot name="icon" />
  
  <h3 class="text-xl sm:text-2xl font-semibold text-foreground dark:text-foreground-light">
    {title}
  </h3>
  
  <p class="text-sm sm:text-base leading-relaxed text-foreground/80 dark:text-foreground-light/80">
    {description}
  </p>
  
  <slot />
</Stack>
