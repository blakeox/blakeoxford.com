---
/**
 * SectionHeader — IntroCopy preset with an optional trailing action.
 */
import IntroCopy from '@/components/composites/IntroCopy.astro';
import Button from '@/components/primitives/Button.astro';
import type { HeadingSizeInput } from '@/lib/typeScale';

export interface Props {
  title: string;
  titleId?: string;
  kicker?: string;
  description?: string;
  size?: HeadingSizeInput;
  actionHref?: string;
  actionLabel?: string;
  actionVariant?: 'outline' | 'ghost' | 'primary';
  align?: 'start' | 'center';
  class?: string;
}

const {
  title,
  titleId,
  kicker,
  description,
  size = 'display',
  actionHref,
  actionLabel,
  actionVariant = 'outline',
  align = 'start',
  class: className = '',
} = Astro.props;

const isCentered = align === 'center';
---

<div
  class:list={[
    'mb-8 flex flex-col gap-3',
    isCentered
      ? 'mx-auto max-w-2xl items-center text-center'
      : 'md:flex-row md:items-end md:justify-between',
    className,
  ]}
>
  <IntroCopy
    kicker={kicker}
    title={title}
    titleId={titleId}
    description={description}
    as="h2"
    size={size}
    align={align}
    class={isCentered ? '' : 'max-w-2xl'}
  />
  {actionHref && actionLabel && (
    <Button
      variant={actionVariant}
      href={actionHref}
      class:list={['shrink-0', isCentered ? 'self-center' : 'self-start md:self-auto']}
    >
      {actionLabel}
    </Button>
  )}
</div>
