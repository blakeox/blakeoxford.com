---
/**
 * Hero - Pre-composed Hero Section Component
 *
 * A complete hero section with Section, Container, and Stack primitives pre-composed.
 * Provides consistent hero layouts across all pages with optional backgrounds and CTAs.
 *
 * @example Basic hero
 * <Hero title="Welcome" subtitle="Build amazing things">
 * <Button slot="cta" href="/get-started">Get Started</Button>
 * </Hero>
 *
 * @example Hero with gradient background
 * <Hero
 * title="About Me"
 * subtitle="Designer & Developer"
 * background="gradient"
 * size="lg"
 * />
 */

import Section from '../primitives/Section.astro';
import Stack from '../primitives/Stack.astro';

interface Props {
  /** Hero title (h1) */
  title: string;
  /** Optional subtitle/description */
  subtitle?: string;
  /** Section background variant */
  background?: 'default' | 'gradient' | 'glass';
  /** Container size */
  size?: 'sm' | 'md' | 'lg' | 'xl' | 'full';
  /** Section padding size */
  padding?: 'none' | 'sm' | 'md' | 'lg' | 'xl';
  /** Stack spacing for inner content */
  spacing?: 'xs' | 'sm' | 'md' | 'lg' | 'xl' | '2xl' | '3xl';
  /** Title alignment */
  align?: 'left' | 'center' | 'right';
  /** Additional CSS classes */
  class?: string;
}

const {
  title,
  subtitle,
  background = 'gradient',
  size = 'lg',
  padding = 'xl',
  spacing = 'lg',
  align = 'center',
  class: className = '',
} = Astro.props;

const alignMap = {
  left: 'text-left',
  center: 'text-center',
  right: 'text-right',
};

const alignClasses = alignMap[align];
---

<Section padding={padding} background={background} container={size} class={className}>
  <Stack space={spacing} class={alignClasses}>
    <h1 class="text-4xl leading-tight font-bold text-foreground sm:text-5xl lg:text-6xl">
      {title}
    </h1>

    {
      subtitle && (
        <p class="mx-auto max-w-3xl text-lg leading-relaxed text-muted-foreground sm:text-xl">
          {subtitle}
        </p>
      )
    }

    <slot name="cta" />

    <slot />
  </Stack>
</Section>
