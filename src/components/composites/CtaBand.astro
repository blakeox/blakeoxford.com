---
/**
 * CtaBand — full-bleed closing CTA used on home, work, and about.
 */
import Container from '@/components/primitives/Container.astro';
import IntroCopy from '@/components/composites/IntroCopy.astro';
import Button from '@/components/primitives/Button.astro';
import ButtonGroup from './ButtonGroup.astro';

export interface Props {
  title: string;
  description: string;
  titleId?: string;
  kicker?: string;
  primary: { href: string; label: string };
  secondary?: { href: string; label: string };
  /** Full-bleed page closer vs in-article next steps. */
  density?: 'band' | 'article';
  class?: string;
  'data-layout-section'?: string;
}

const {
  title,
  description,
  titleId = 'cta-band-title',
  kicker,
  primary,
  secondary,
  density = 'band',
  class: className = '',
  'data-layout-section': layoutSection,
} = Astro.props;

const isArticle = density === 'article';
---

{isArticle ? (
  <div
    class:list={['flex max-w-3xl flex-col items-start gap-6 text-left', className]}
    data-layout-shell="cta-lockup"
  >
    <IntroCopy
      kicker={kicker}
      title={title}
      titleId={titleId}
      description={description}
      as="h2"
      size="title"
      descriptionSize="md"
    />
    <ButtonGroup align="start" responsive>
      <Button variant="primary" href={primary.href}>
        {primary.label}
      </Button>
      {secondary && (
        <Button variant="outline" href={secondary.href}>
          {secondary.label}
        </Button>
      )}
    </ButtonGroup>
    <slot />
  </div>
) : (
  <section
    class:list={[
      'home-cta-band w-full border-y border-border/40 py-section-lg sm:py-section-xl lg:py-section-2xl',
      className,
    ]}
    aria-labelledby={titleId}
    data-layout-section={layoutSection}
  >
    <Container size="xl" class="relative z-10">
      <div
        class="home-cta-lockup flex max-w-3xl flex-col items-start gap-6 text-left"
        data-layout-shell="cta-lockup"
      >
        <IntroCopy
          kicker={kicker}
          title={title}
          titleId={titleId}
          description={description}
          as="h2"
          size="display"
          descriptionSize="lg"
        />
        <ButtonGroup align="start" responsive>
          <Button variant="primary" size="lg" href={primary.href}>
            {primary.label}
          </Button>
          {secondary && (
            <Button variant="outline" size="lg" href={secondary.href}>
              {secondary.label}
            </Button>
          )}
        </ButtonGroup>
        <slot />
      </div>
    </Container>
  </section>
)}
