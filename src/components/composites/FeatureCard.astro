---
/**
 * FeatureCard - semantic feature card built on BaseCard
 *
 * Expressive tier card for highlights and feature grids.
 * Prefer text titles over decorative emoji icons.
 */

import BaseCard from '@/components/primitives/BaseCard.astro';
import { headingSizeClass } from '@/lib/typeScale';
import { featureCardRecipe, type FeatureCardVariant } from '@/lib/design-system/recipes';

interface Props {
  variant?: FeatureCardVariant;
  title?: string;
  titleLevel?: 2 | 3;
  description?: string;
  badge?: string | number;
  hover?: boolean;
  class?: string;
}

const {
  variant = 'accent',
  title,
  titleLevel = 3,
  description,
  badge,
  hover = true,
  class: className = '',
} = Astro.props;

const classes = [
  'bg-gradient-to-br backdrop-blur-sm @container @md:p-10',
  featureCardRecipe.variants[variant].surface,
  className,
]
  .filter(Boolean)
  .join(' ');

const TitleTag = titleLevel === 2 ? 'h2' : 'h3';
---

<BaseCard
  variant="subtle"
  hover={hover ? 'lift' : 'none'}
  rounded="2xl"
  padding="md"
  class={classes}
>
  {
    badge && (
      <div
        class={`absolute top-4 right-4 flex h-10 w-10 items-center justify-center rounded-full @sm:h-12 @sm:w-12 ${featureCardRecipe.variants[variant].badge} text-lg font-bold shadow-sm @sm:text-xl`}
      >
        {badge}
      </div>
    )
  }

  {
    title && (
      <TitleTag
        class:list={[
          'mb-2 font-heading font-semibold @sm:mb-3',
          headingSizeClass('title'),
          featureCardRecipe.variants[variant].text,
        ]}
      >
        {title}
      </TitleTag>
    )
  }

  {
    description && (
      <p class="text-base leading-relaxed text-muted-foreground @sm:text-lg">{description}</p>
    )
  }

  <slot />
</BaseCard>
