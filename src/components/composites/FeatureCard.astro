---
/**
 * FeatureCard - semantic feature card built on BaseCard
 *
 * Expressive tier card for highlights and feature grids.
 * Prefer text titles over decorative emoji icons.
 */

import BaseCard from '@/components/primitives/BaseCard.astro';
import { headingSizeClass } from '@/lib/typeScale';

interface Props {
  variant?: 'accent' | 'primary' | 'success' | 'warning' | 'info' | 'error';
  title?: string;
  titleLevel?: 2 | 3;
  description?: string;
  badge?: string | number;
  hover?: boolean;
  class?: string;
}

const {
  variant = 'accent',
  title,
  titleLevel = 3,
  description,
  badge,
  hover = true,
  class: className = '',
} = Astro.props;

const variantClasses = {
  accent: 'from-accent/10 to-accent/5 border-accent/30',
  primary: 'from-primary/10 to-primary/5 border-primary/30',
  success: 'from-success/10 to-success/5 border-success/30',
  warning: 'from-warning/15 to-warning/5 border-warning/40',
  info: 'from-info/10 to-info/5 border-info/30',
  error: 'from-error/10 to-error/5 border-error/30',
};

const variantTextColors = {
  accent: 'text-accent-emphasis',
  primary: 'text-primary-emphasis',
  success: 'text-success-emphasis',
  warning: 'text-warning-emphasis',
  info: 'text-info-emphasis',
  error: 'text-error-emphasis',
};

const badgeColors = {
  accent: 'bg-accent text-on-accent',
  primary: 'bg-primary text-on-primary',
  success: 'bg-success-dark text-on-primary',
  warning: 'bg-warning text-foreground',
  info: 'bg-info-dark text-on-primary',
  error: 'bg-error-dark text-on-primary',
};

const classes = [
  'bg-gradient-to-br backdrop-blur-sm @container @md:p-10',
  variantClasses[variant],
  className,
]
  .filter(Boolean)
  .join(' ');

const TitleTag = titleLevel === 2 ? 'h2' : 'h3';
---

<BaseCard
  variant="subtle"
  hover={hover ? 'lift' : 'none'}
  rounded="2xl"
  padding="md"
  class={classes}
>
  {
    badge && (
      <div
        class={`absolute top-4 right-4 flex h-10 w-10 items-center justify-center rounded-full @sm:h-12 @sm:w-12 ${badgeColors[variant]} text-lg font-bold shadow-sm @sm:text-xl`}
      >
        {badge}
      </div>
    )
  }

  {
    title && (
      <TitleTag
        class:list={[
          'mb-2 font-heading font-semibold @sm:mb-3',
          headingSizeClass('title'),
          variantTextColors[variant],
        ]}
      >
        {title}
      </TitleTag>
    )
  }

  {
    description && (
      <p class="text-base leading-relaxed text-muted-foreground @sm:text-lg">{description}</p>
    )
  }

  <slot />
</BaseCard>
