---
export interface Metric {
  metric: string;
  result: string;
  timeline: string;
}

export interface Props {
  metrics: Metric[];
}

const { metrics } = Astro.props;
---

<div class="overflow-x-auto">
  <table class="my-8 w-full border-collapse border border-border dark:border-border-dark">
    <thead>
      <tr class="bg-surface-subtle/70 dark:bg-surface-dark-subtle/70">
        <th class="border border-border p-3 text-left font-semibold text-foreground dark:border-border-dark dark:text-foreground-light">Metric</th>
        <th class="border border-border p-3 text-left font-semibold text-foreground dark:border-border-dark dark:text-foreground-light">Result</th>
        <th class="border border-border p-3 text-left font-semibold text-foreground dark:border-border-dark dark:text-foreground-light">Timeline</th>
      </tr>
    </thead>
    <tbody>
      {metrics.map((metric, index) => (
        <tr class={index % 2 === 1 ? 'bg-surface/70 dark:bg-surface-dark/70' : ''}>
          <td class="border border-border p-3 font-semibold text-foreground dark:border-border-dark dark:text-foreground-light">{metric.metric}</td>
          <td class="border border-border p-3 text-foreground/85 dark:border-border-dark dark:text-foreground-light/80">{metric.result}</td>
          <td class="border border-border p-3 text-foreground/85 dark:border-border-dark dark:text-foreground-light/80">{metric.timeline}</td>
        </tr>
      ))}
    </tbody>
  </table>
</div> 
