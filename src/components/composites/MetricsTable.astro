---
/**
 * Metrics as editorial rows — same vocabulary as portfolio findings.
 */
export interface Metric {
  metric: string;
  result: string;
  timeline: string;
}

export interface Props {
  metrics: Metric[];
}

const { metrics } = Astro.props;
---

{
  metrics.length > 0 && (
    <ul class="divide-y divide-border/50 border-y border-border/50" role="list">
      {metrics.map((row) => (
        <li class="grid gap-1 py-4 sm:grid-cols-[minmax(0,1.2fr)_minmax(0,1fr)_minmax(0,0.9fr)] sm:items-baseline sm:gap-6 sm:py-5">
          <p class="font-heading text-base font-semibold tracking-tight text-accent-emphasis sm:text-lg">
            {row.result}
          </p>
          <p class="text-sm font-semibold text-foreground sm:text-base">{row.metric}</p>
          <p class="text-sm text-muted-foreground sm:text-right">{row.timeline}</p>
        </li>
      ))}
    </ul>
  )
}
