---
import Container from '@/components/primitives/Container.astro';
import { cn } from '@/utils/cn';

/**
 * PageHero — page-level hero shell.
 * Use align="center" for Selected work / Contact style lockups.
 */
interface Props {
  fullScreen?: boolean;
  includeBlurOrbs?: boolean;
  flush?: boolean;
  /** Content alignment inside the container */
  align?: 'start' | 'center';
  containerSize?: 'sm' | 'md' | 'lg' | 'xl' | 'full';
  containerPadding?: boolean;
  class?: string;
  style?: string;
  id?: string;
  /** Optional layout shell marker for tests / centering wrapper */
  shell?: string;
}

const {
  fullScreen = true,
  includeBlurOrbs = false,
  flush = false,
  align = 'start',
  containerSize = 'xl',
  containerPadding = true,
  class: className = '',
  style,
  id = 'hero',
  shell,
} = Astro.props as Props;

const isCentered = align === 'center';
---

<section
  id={id}
  data-layout-section={id}
  style={style}
  class={cn(
    'page-hero-shell relative flex overflow-hidden',
    fullScreen ? 'min-h-[calc(100svh-var(--nav-height))]' : 'min-h-0',
    flush ? 'items-stretch py-0' : 'items-center py-section-lg sm:py-section-xl lg:py-section-2xl',
    className
  )}
>
  {
    includeBlurOrbs && (
      <>
        <div
          class="pointer-events-none absolute top-0 right-0 size-96 rounded-full bg-accent-subtle blur-3xl"
          aria-hidden="true"
        />
        <div
          class="pointer-events-none absolute bottom-0 left-0 size-64 rounded-full bg-primary-subtle blur-3xl"
          aria-hidden="true"
        />
      </>
    )
  }

  <Container
    size={containerSize}
    padding={containerPadding}
    class={cn('relative z-10', flush && 'flex w-full flex-1 flex-col')}
  >
    {
      isCentered ? (
        <div
          class="mx-auto flex w-full max-w-3xl flex-col items-center text-center"
          data-layout-shell={shell}
        >
          <slot />
        </div>
      ) : (
        <slot />
      )
    }
  </Container>
</section>
