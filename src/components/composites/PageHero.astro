---
import Container from '../primitives/Container.astro';
import { cn } from '../../utils/cn';

/**
 * PageHero - Consistent full-screen hero section pattern
 *
 * Provides unified hero treatment across all main pages with:
 * - Full viewport height option
 * - Floating blur orbs for visual depth
 * - Edge-to-edge gradient background
 * - Responsive max-width container for content
 *
 * @example Homepage hero
 * <PageHero fullScreen={true}>
 * <Grid cols="2" gap="xl" alignItems="center">
 * <div><h1>Blake Oxford</h1></div>
 * <div><CoinFlipImage /></div>
 * </Grid>
 * </PageHero>
 *
 * @example Projects hero
 * <PageHero fullScreen={false}>
 * <h1>Selected Projects</h1>
 * <p>Description</p>
 * </PageHero>
 */

interface Props {
  /** Full screen height (min-h-screen) vs standard (min-h-[60vh]) */
  fullScreen?: boolean;
  /** Include floating blur orbs for visual depth */
  includeBlurOrbs?: boolean;
  /** Strip default vertical padding and stretch children (split / media heroes) */
  flush?: boolean;
  /** Container max-width */
  containerSize?: 'sm' | 'md' | 'lg' | 'xl' | 'full';
  /** Apply horizontal layout gutter on the inner container */
  containerPadding?: boolean;
  /** Additional CSS classes */
  class?: string;
  /** Section ID for anchor links */
  id?: string;
}

const {
  fullScreen = true,
  includeBlurOrbs = true,
  flush = false,
  containerSize = 'xl',
  containerPadding = true,
  class: className = '',
  id = 'hero',
} = Astro.props;
---

<section
  id={id}
  data-layout-section={id}
  class={cn(
    'page-hero-shell relative flex overflow-hidden',
    fullScreen ? 'min-h-screen' : 'min-h-[60vh] md:min-h-[70vh]',
    flush ? 'items-stretch py-0' : 'items-center py-20 sm:py-24 md:py-32',
    className
  )}
>
  {
    includeBlurOrbs && (
      <>
        <div
          class="pointer-events-none absolute top-0 right-0 size-96 rounded-full bg-accent-subtle blur-3xl"
          aria-hidden="true"
        />
        <div
          class="pointer-events-none absolute bottom-0 left-0 size-64 rounded-full bg-primary-subtle blur-3xl"
          aria-hidden="true"
        />
      </>
    )
  }

  <Container
    size={containerSize}
    padding={containerPadding}
    class={cn('relative z-10', flush && 'flex w-full flex-1 flex-col')}
  >
    <slot />
  </Container>
</section>
