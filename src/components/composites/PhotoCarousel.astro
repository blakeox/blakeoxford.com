---
/**
 * PhotoCarousel — decorative scrolling photo collage for the About hero.
 *
 * Mobile: horizontal marquee. Desktop (md+): three vertical columns (up / down / up).
 * Motion pauses on hover/focus-within and when prefers-reduced-motion is set.
 * Not an interactive slideshow (no prev/next controls).
 */
import { Image } from 'astro:assets';
import { cn } from '../../utils/cn';

import Appalatia from '@/assets/images/carousel/Appalatia.webp';
import BlakeOScaled from '@/assets/images/carousel/Blake-O-scaled.webp';
import CES from '@/assets/images/carousel/CES.webp';
import CESFront from '@/assets/images/carousel/CES_Front.webp';
import CESInside from '@/assets/images/carousel/CES_Inside.webp';
import HongKong from '@/assets/images/carousel/Hong_Kong.webp';
import IMG0729 from '@/assets/images/carousel/IMG_0729.webp';
import IMG2579 from '@/assets/images/carousel/IMG_2579.webp';
import IMG2790 from '@/assets/images/carousel/IMG_2790.webp';
import IMG4607 from '@/assets/images/carousel/IMG_4607.webp';
import IMG5981 from '@/assets/images/carousel/IMG_5981.webp';
import IMG9139 from '@/assets/images/carousel/IMG_9139.webp';
import IMG9191 from '@/assets/images/carousel/IMG_9191.webp';
import SaoPaulo from '@/assets/images/carousel/Sao_Paulo.webp';
import ShangHaiOldNew from '@/assets/images/carousel/ShangHai_old_new.webp';
import BlakeDetroit from '@/assets/images/carousel/blake_detroit_skyline_bell_isle.webp';
import BlakeMilan from '@/assets/images/carousel/blake_milan.webp';
import ChinaProfile from '@/assets/images/carousel/china-profile-picture.webp';
import NvidiaPrize from '@/assets/images/carousel/Nvidia-prize-download.webp';
import NvidiaPrizeVertical from '@/assets/images/carousel/nvidia-prize-download-vertical.webp';

interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props as Props;

const allImages = [
  Appalatia,
  BlakeOScaled,
  CES,
  CESFront,
  CESInside,
  HongKong,
  IMG0729,
  IMG2579,
  IMG2790,
  IMG4607,
  IMG5981,
  IMG9139,
  IMG9191,
  SaoPaulo,
  ShangHaiOldNew,
  BlakeDetroit,
  BlakeMilan,
  ChinaProfile,
  NvidiaPrize,
  NvidiaPrizeVertical,
];

/** Deterministic shuffle so SSR / visual baselines stay stable across builds. */
function seededShuffle<T>(items: T[], seed: number): T[] {
  const result = [...items];
  let state = seed % 2147483647;
  if (state <= 0) state += 2147483646;
  for (let i = result.length - 1; i > 0; i--) {
    state = (state * 16807) % 2147483647;
    const j = state % (i + 1);
    [result[i], result[j]] = [result[j], result[i]];
  }
  return result;
}

function loop<T>(items: T[]): T[] {
  return items.length ? [...items, ...items] : items;
}

const CONFIG = {
  mobileCount: 6,
  desktopVisible: 5,
  mobileSize: { width: 800, height: 800 },
  desktopSize: { width: 640, height: 640 },
} as const;

const shuffled = seededShuffle(allImages, 42);
const third = Math.ceil(shuffled.length / 3);
const columnA = shuffled.slice(0, third);
const columnB = shuffled.slice(third, third * 2);
const columnC = shuffled.slice(third * 2);
const mobileImages = shuffled.slice(0, CONFIG.mobileCount);

const mobileLoop = loop(mobileImages);
const columnALoop = loop(columnA);
const columnBLoop = loop(columnB);
const columnCLoop = loop(columnC);
---

<div
  class={cn(
    'photo-carousel @container relative h-full min-h-[280px] w-full overflow-hidden select-none',
    '@md:min-h-[320px] @lg:min-h-[400px]',
    className
  )}
  role="region"
  aria-label="Travel and work photo gallery"
  aria-live="off"
>
  <!-- Mobile / narrow: horizontal marquee -->
  <div class="absolute inset-0 flex items-center pt-16 md:hidden md:pt-0">
    <ul
      class="photo-carousel-track photo-carousel-track--x flex gap-4"
      role="list"
      aria-hidden="true"
    >
      {
        mobileLoop.map((image) => (
          <li class="h-[40vh] w-[80vw] flex-shrink-0">
            <div class="relative h-full w-full overflow-hidden rounded-xl shadow-lg">
              <Image
                src={image}
                alt=""
                class="absolute inset-0 h-full w-full object-cover motion-safe:transition-transform motion-safe:duration-normal motion-safe:hover:scale-105"
                width={CONFIG.mobileSize.width}
                height={CONFIG.mobileSize.height}
                loading="lazy"
                decoding="async"
                fetchpriority="low"
              />
            </div>
          </li>
        ))
      }
    </ul>
  </div>

  <!-- Desktop: three vertical columns -->
  <div class="absolute inset-0 hidden h-full w-full gap-4 overflow-hidden pt-8 md:flex">
    {
      (
        [
          { images: columnALoop, track: 'photo-carousel-track--up' },
          { images: columnBLoop, track: 'photo-carousel-track--down' },
          { images: columnCLoop, track: 'photo-carousel-track--up' },
        ] as const
      ).map(({ images, track }) => (
        <ul
          class={cn('photo-carousel-track flex flex-1 flex-col gap-4 py-4', track)}
          role="list"
          aria-hidden="true"
        >
          {images.map((image) => (
            <li class="mx-auto aspect-square w-full flex-shrink-0">
              <div class="relative h-full w-full overflow-hidden rounded-2xl shadow-lg">
                <Image
                  src={image}
                  alt=""
                  class="absolute inset-0 h-full w-full object-cover motion-safe:transition-transform motion-safe:duration-normal motion-safe:hover:scale-105"
                  width={CONFIG.desktopSize.width}
                  height={CONFIG.desktopSize.height}
                  loading="lazy"
                  decoding="async"
                  fetchpriority="low"
                />
              </div>
            </li>
          ))}
        </ul>
      ))
    }
  </div>

  <span class="sr-only">
    Decorative scrolling photo collage. Animation pauses when reduced motion is preferred.
  </span>
</div>

<style>
  @keyframes photo-carousel-x {
    from {
      transform: translate3d(0, 0, 0);
    }
    to {
      transform: translate3d(-50%, 0, 0);
    }
  }

  @keyframes photo-carousel-up {
    from {
      transform: translate3d(0, 0, 0);
    }
    to {
      transform: translate3d(0, -50%, 0);
    }
  }

  @keyframes photo-carousel-down {
    from {
      transform: translate3d(0, -50%, 0);
    }
    to {
      transform: translate3d(0, 0, 0);
    }
  }

  .photo-carousel-track {
    backface-visibility: hidden;
    will-change: transform;
  }

  @media (prefers-reduced-motion: no-preference) {
    .photo-carousel-track--x {
      animation: photo-carousel-x 70s linear infinite;
    }

    .photo-carousel-track--up {
      animation: photo-carousel-up 90s linear infinite;
    }

    .photo-carousel-track--down {
      animation: photo-carousel-down 90s linear infinite;
    }

    .photo-carousel:hover .photo-carousel-track,
    .photo-carousel:focus-within .photo-carousel-track {
      animation-play-state: paused;
    }
  }
</style>
