---
/**
 * PhotoCarousel — decorative scrolling photo collage for the About hero.
 *
 * Mobile: horizontal marquee. Desktop (md+): three vertical columns (work / travel / life).
 * Motion pauses via explicit control, hover, and prefers-reduced-motion.
 * Not an interactive slideshow (no prev/next / lightbox).
 */
import { Image } from 'astro:assets';
import { cn } from '@/utils/cn';

import Appalatia from '@/assets/images/carousel/Appalatia.webp';
import BlakeOScaled from '@/assets/images/carousel/Blake-O-scaled.webp';
import CES from '@/assets/images/carousel/CES.webp';
import CESFront from '@/assets/images/carousel/CES_Front.webp';
import CESInside from '@/assets/images/carousel/CES_Inside.webp';
import HongKong from '@/assets/images/carousel/Hong_Kong.webp';
import IMG0729 from '@/assets/images/carousel/IMG_0729.webp';
import IMG2579 from '@/assets/images/carousel/IMG_2579.webp';
import IMG2790 from '@/assets/images/carousel/IMG_2790.webp';
import IMG4607 from '@/assets/images/carousel/IMG_4607.webp';
import IMG5981 from '@/assets/images/carousel/IMG_5981.webp';
import IMG9139 from '@/assets/images/carousel/IMG_9139.webp';
import IMG9191 from '@/assets/images/carousel/IMG_9191.webp';
import SaoPaulo from '@/assets/images/carousel/Sao_Paulo.webp';
import ShangHaiOldNew from '@/assets/images/carousel/ShangHai_old_new.webp';
import BlakeDetroit from '@/assets/images/carousel/blake_detroit_skyline_bell_isle.webp';
import BlakeMilan from '@/assets/images/carousel/blake_milan.webp';
import ChinaProfile from '@/assets/images/carousel/china-profile-picture.webp';
import NvidiaPrize from '@/assets/images/carousel/Nvidia-prize-download.webp';
import NvidiaPrizeVertical from '@/assets/images/carousel/nvidia-prize-download-vertical.webp';
import SemcacfeEthicsAiAge from '@/assets/images/carousel/SEMCACFE-Ethics-AI-Age.webp';
import SemcacfeEthicsAiAgePodium from '@/assets/images/carousel/SEMCACFE-Ethics-AI-Age-podium.webp';

import type { ImageMetadata } from 'astro';

interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props as Props;

/** Authored columns: work / travel / life — not a random shuffle. */
const workImages: ImageMetadata[] = [
  SemcacfeEthicsAiAge,
  SemcacfeEthicsAiAgePodium,
  CES,
  CESFront,
  CESInside,
  NvidiaPrize,
  NvidiaPrizeVertical,
  IMG9139,
  IMG9191,
];

const travelImages: ImageMetadata[] = [
  HongKong,
  ShangHaiOldNew,
  SaoPaulo,
  BlakeMilan,
  ChinaProfile,
  IMG4607,
  IMG5981,
];

const lifeImages: ImageMetadata[] = [
  BlakeOScaled,
  BlakeDetroit,
  Appalatia,
  IMG0729,
  IMG2579,
  IMG2790,
];

function loop<T>(items: T[]): T[] {
  return items.length ? [...items, ...items] : items;
}

const CONFIG = {
  mobileCount: 6,
  desktopPerColumn: 5,
  mobileSize: { width: 640, height: 480 },
  desktopSize: { width: 480, height: 480 },
} as const;

const columnA = workImages.slice(0, CONFIG.desktopPerColumn);
const columnB = travelImages.slice(0, CONFIG.desktopPerColumn);
const columnC = lifeImages.slice(0, CONFIG.desktopPerColumn);
const mobileImages = [...workImages, ...travelImages, ...lifeImages].slice(0, CONFIG.mobileCount);

const mobileLoop = loop(mobileImages);
const columnALoop = loop(columnA);
const columnBLoop = loop(columnB);
const columnCLoop = loop(columnC);
---

<div
  class={cn(
    'photo-carousel @container relative h-full min-h-[12rem] w-full overflow-hidden select-none md:min-h-0',
    className
  )}
  role="region"
  aria-label="Travel and work photo gallery"
  data-bo-carousel
  data-paused="false"
>
  <!-- Mobile / narrow: horizontal marquee -->
  <div class="absolute inset-0 flex items-center md:hidden">
    <ul
      class="photo-carousel-track photo-carousel-track--x flex gap-3 px-1"
      role="list"
      aria-hidden="true"
    >
      {
        mobileLoop.map((image) => (
          <li class="photo-carousel-mobile-tile flex-shrink-0">
            <div class="relative h-full w-full overflow-hidden rounded-xl shadow-lg">
              <Image
                src={image}
                alt=" "
                class="absolute inset-0 h-full w-full object-cover"
                width={CONFIG.mobileSize.width}
                height={CONFIG.mobileSize.height}
                loading="lazy"
                decoding="async"
                fetchpriority="low"
              />
            </div>
          </li>
        ))
      }
    </ul>
  </div>

  <!-- Desktop: three vertical columns (work / travel / life) -->
  <div class="absolute inset-0 hidden h-full w-full gap-4 overflow-hidden pt-8 md:flex">
    {
      (
        [
          { images: columnALoop, track: 'photo-carousel-track--up' },
          { images: columnBLoop, track: 'photo-carousel-track--down' },
          { images: columnCLoop, track: 'photo-carousel-track--up' },
        ] as const
      ).map(({ images, track }) => (
        <ul
          class={cn('photo-carousel-track flex flex-1 flex-col gap-4 py-4', track)}
          role="list"
          aria-hidden="true"
        >
          {images.map((image) => (
            <li class="photo-carousel-desktop-tile mx-auto aspect-square w-full flex-shrink-0">
              <div class="relative h-full w-full overflow-hidden rounded-2xl shadow-lg">
                <Image
                  src={image}
                  alt=" "
                  class="absolute inset-0 h-full w-full object-cover"
                  width={CONFIG.desktopSize.width}
                  height={CONFIG.desktopSize.height}
                  loading="lazy"
                  decoding="async"
                  fetchpriority="low"
                />
              </div>
            </li>
          ))}
        </ul>
      ))
    }
  </div>

  <button
    type="button"
    class="photo-carousel-pause focus-ring-interactive"
    data-carousel-pause
    aria-pressed="false"
    aria-label="Pause photo gallery motion"
  >
    <span data-pause-label>Pause</span>
  </button>

  <span class="sr-only">
    Decorative scrolling photo collage. Use the pause control to stop motion. Animation is off when
    reduced motion is preferred.
  </span>
</div>

<script>
  function bindCarousel(root: HTMLElement) {
    if (root.dataset.boBound === 'true') return;
    root.dataset.boBound = 'true';

    const button = root.querySelector<HTMLButtonElement>('[data-carousel-pause]');
    const label = button?.querySelector<HTMLElement>('[data-pause-label]');
    if (!button || !label) return;

    const setPaused = (paused: boolean) => {
      root.dataset.paused = paused ? 'true' : 'false';
      button.setAttribute('aria-pressed', paused ? 'true' : 'false');
      button.setAttribute(
        'aria-label',
        paused ? 'Play photo gallery motion' : 'Pause photo gallery motion'
      );
      label.textContent = paused ? 'Play' : 'Pause';
    };

    button.addEventListener('click', () => {
      setPaused(root.dataset.paused !== 'true');
    });
  }

  function setupCarousels() {
    document.querySelectorAll<HTMLElement>('[data-bo-carousel]').forEach(bindCarousel);
  }

  setupCarousels();
  document.addEventListener('astro:page-load', setupCarousels);
</script>

<style>
  @keyframes photo-carousel-x {
    from {
      transform: translate3d(0, 0, 0);
    }
    to {
      transform: translate3d(-50%, 0, 0);
    }
  }

  @keyframes photo-carousel-up {
    from {
      transform: translate3d(0, 0, 0);
    }
    to {
      transform: translate3d(0, -50%, 0);
    }
  }

  @keyframes photo-carousel-down {
    from {
      transform: translate3d(0, -50%, 0);
    }
    to {
      transform: translate3d(0, 0, 0);
    }
  }

  .photo-carousel-pause {
    position: absolute;
    right: 0.75rem;
    bottom: 0.75rem;
    z-index: 2;
    border-radius: 9999px;
    border: 1px solid color-mix(in oklch, var(--color-border) 80%, transparent);
    background: color-mix(in oklch, var(--color-background) 82%, transparent);
    padding: 0.4rem 0.75rem;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-foreground);
    backdrop-filter: blur(8px);
    opacity: 0.72;
    transition: opacity 160ms ease;
  }

  .photo-carousel-pause:hover,
  .photo-carousel-pause:focus-visible {
    opacity: 1;
  }

  .photo-carousel-mobile-tile {
    width: min(70vw, 18rem);
    height: min(34vh, 16rem);
  }

  .photo-carousel-desktop-tile {
    max-width: 15rem;
  }

  @media (width >= 1280px) {
    .photo-carousel-desktop-tile {
      max-width: 17rem;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .photo-carousel-track {
      backface-visibility: hidden;
      will-change: transform;
    }

    .photo-carousel-track--x {
      animation: photo-carousel-x 45s linear infinite;
    }

    .photo-carousel-track--up {
      animation: photo-carousel-up 60s linear infinite;
    }

    .photo-carousel-track--down {
      animation: photo-carousel-down 60s linear infinite;
    }

    .photo-carousel:hover .photo-carousel-track,
    .photo-carousel[data-paused='true'] .photo-carousel-track {
      animation-play-state: paused;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .photo-carousel-pause {
      display: none;
    }
  }
</style>
