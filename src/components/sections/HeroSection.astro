---
import CoinFlipImage from '../ui/CoinFlipImage.astro';
import ParticleBackground from '../animations/ParticleBackground.astro';
import ParallaxScroll from '../animations/ParallaxScroll.astro';
import TypingAnimation from '../animations/TypingAnimation.astro';
import ScrollAnimation from '../animations/ScrollAnimation.astro';
import { siteConfig } from '../../config/data';
---

<section id="about-me" class="hero-section relative overflow-hidden py-32 min-h-[90vh] flex items-center bg-gradient-to-br from-background via-accent/5 to-background dark:from-background-dark dark:via-accent/10 dark:to-background-dark">
  <!-- Enhanced Particle Background -->
  <ParticleBackground density={30} color="rgba(6, 95, 70, 0.15)" speed={0.8} />
  
  <!-- Animated Grid Pattern Background with Parallax -->
  <ParallaxScroll speed={0.3} direction="up" className="absolute inset-0 opacity-[0.03] dark:opacity-[0.08]">
    <div class="absolute inset-0 bg-grid-pattern animate-grid-float" aria-hidden="true"></div>
  </ParallaxScroll>

  <!-- Floating Geometric Shapes with Parallax -->
  <div class="absolute inset-0 overflow-hidden pointer-events-none" aria-hidden="true">
    <ParallaxScroll speed={0.4} direction="down">
      <div class="absolute top-20 left-10 w-24 h-24 bg-accent/10 rounded-full blur-xl animate-float-slow"></div>
    </ParallaxScroll>
    <ParallaxScroll speed={0.6} direction="up">
      <div class="absolute top-40 right-20 w-16 h-16 bg-purple-500/10 rounded-full blur-xl animate-float-reverse"></div>
    </ParallaxScroll>
    <ParallaxScroll speed={0.5} direction="left">
      <div class="absolute bottom-40 left-1/4 w-20 h-20 bg-blue-500/10 rounded-full blur-xl animate-float-slow" style="animation-delay: 1s;"></div>
    </ParallaxScroll>
  </div>

  <!-- Curved divider at bottom -->
  <div class="absolute bottom-0 left-0 w-full overflow-hidden rotate-180">
    <svg data-name="Layer 1" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 120" preserveAspectRatio="none" class="h-20 w-full fill-background dark:fill-background-dark">
      <path d="M0,0V46.29c47.79,22.2,103.59,32.17,158,28,70.36-5.37,136.33-33.31,206.8-37.5C438.64,32.43,512.34,53.67,583,72.05c69.27,18,138.3,24.88,209.4,13.08,36.15-6,69.85-17.84,104.45-29.34C989.49,25,1113-14.29,1200,52.47V0Z" opacity=".25"></path>
      <path d="M0,0V15.81C13,36.92,27.64,56.86,47.69,72.05,99.41,111.27,165,111,224.58,91.58c31.15-10.15,60.09-26.07,89.67-39.8,40.92-19,84.73-46,130.83-49.67,36.26-2.85,70.9,9.42,98.6,31.56,31.77,25.39,62.32,62,103.63,73,40.44,10.79,81.35-6.69,119.13-24.28s75.16-39,116.92-43.05c59.73-5.85,113.28,22.88,168.9,38.84,30.2,8.66,59,6.17,87.09-7.5,22.43-10.89,48-26.93,60.65-49.24V0Z" opacity=".5"></path>
      <path d="M0,0V5.63C149.93,59,314.09,71.32,475.83,42.57c43-7.64,84.23-20.12,127.61-26.46,59-8.63,112.48,12.24,165.56,35.4C827.93,77.22,886,95.24,951.2,90c86.53-7,172.46-45.71,248.8-84.81V0Z"></path>
    </svg>
  </div>

  <div class="container mx-auto max-w-screen-xl px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="grid md:grid-cols-2 gap-12 items-center">
      <!-- Left: Enhanced Text Content -->
      <ScrollAnimation animation="slideUp" delay={200} className="order-2 md:order-1">
        <div class="prose lg:prose-xl dark:prose-invert">
          <h1 class="hero-title font-heading font-bold text-h1 md:text-6xl text-accent mb-6">
            <span class="block name-highlight">{siteConfig.author}</span>
          </h1>
          
          <div class="hero-subtitle text-lead mt-2 text-foreground dark:text-foreground-light font-medium mb-4">
            <TypingAnimation 
              text={siteConfig.description} 
              speed={30} 
              delay={800}
              element="p"
              className="typing-subtitle"
            />
          </div>
          
          <div class="hero-tagline text-body dark:text-foreground-light pl-4 border-l-4 border-accent dark:border-accent-dark border-solid mb-8">
            <ScrollAnimation animation="fadeIn" delay={1500}>
              <p>{siteConfig.tagline}</p>
            </ScrollAnimation>
          </div>
        </div>

        <ScrollAnimation animation="slideUp" delay={1800}>
          <div class="flex flex-col sm:flex-row gap-4 justify-start items-center">
            <a
              href="/contact/"
              class="btn btn-primary btn-lg mobile-tap-effect hero-cta-primary"
              data-analytics="hero-cta"
              aria-label="Start a conversation with Blake Oxford"
            >
              <span class="flex items-center gap-2">
                🤝 <span>Let's Connect</span>
              </span>
            </a>
            <a
              href="/assets/Resume.pdf"
              class="btn btn-secondary btn-lg mobile-tap-effect hero-cta-secondary"
              aria-label="Download Blake Oxford's resume as PDF"
              download
            >
              <span class="flex items-center gap-2">
                📄 <span>Download Resume</span>
              </span>
            </a>
          </div>
        </ScrollAnimation>
      </ScrollAnimation>

      <!-- Right: Enhanced Animated Profile Image -->
      <ScrollAnimation animation="scaleIn" delay={500} className="flex justify-center md:justify-end order-1 md:order-2">
        <div class="hero-image-container relative">
          <!-- Enhanced Glow Effect -->
          <div class="absolute -inset-8 rounded-full bg-gradient-to-r from-accent/20 via-purple-500/20 to-blue-500/20 blur-2xl opacity-60 animate-pulse-glow"></div>
          
          <!-- Rotating Ring -->
          <div class="absolute -inset-6 rounded-full border-2 border-accent/30 animate-spin-slow"></div>
          
          <!-- Main Image Container -->
          <div class="relative rounded-full p-1 bg-gradient-to-r from-accent via-purple-500 to-blue-500 shadow-2xl">
            <CoinFlipImage
              frontSrc="/assets/images/Blake-O-scaled.jpg"
              backSrc="/assets/images/china-profile-picture.jpg"
              alt="Blake Oxford"
              altBack="Blake Oxford in China"
              size={300}
              flipMultipleTimes
              role="img"
              aria-label="Photo of Blake Oxford"
              class="hero-profile-image"
            />
          </div>

          <!-- Enhanced Floating Elements -->
          <div class="floating-elements">
            <div class="floating-element floating-element-1 w-14 h-14 bg-gradient-to-r from-accent to-accent-dark rounded-full flex items-center justify-center text-background text-2xl shadow-lg" style="animation-delay: 0.2s;">
              💡
            </div>
            <div class="floating-element floating-element-2 w-12 h-12 bg-gradient-to-r from-purple-500 to-purple-600 rounded-full flex items-center justify-center text-background text-xl shadow-lg" style="animation-delay: 0.8s;">
              🚀
            </div>
            <div class="floating-element floating-element-3 w-10 h-10 bg-gradient-to-r from-blue-500 to-blue-600 rounded-full flex items-center justify-center text-background text-lg shadow-lg" style="animation-delay: 1.4s;">
              ☁️
            </div>
            <div class="floating-element floating-element-4 w-8 h-8 bg-gradient-to-r from-green-500 to-green-600 rounded-full flex items-center justify-center text-background text-sm shadow-lg" style="animation-delay: 2s;">
              ⚡
            </div>
          </div>
        </div>
      </ScrollAnimation>
    </div>
  </div>
</section>

<style>
  /* Enhanced Hero Animations */
  .hero-title {
    background: linear-gradient(135deg, var(--color-accent), var(--color-accent-dark), #8b5cf6);
    background-clip: text;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-size: 200% auto;
    animation: gradient-shimmer 3s ease-in-out infinite;
  }

  @keyframes gradient-shimmer {
    0%, 100% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
  }

  .name-highlight {
    position: relative;
  }

  .name-highlight::after {
    content: '';
    position: absolute;
    bottom: -4px;
    left: 0;
    width: 100%;
    height: 4px;
    background: linear-gradient(90deg, var(--color-accent), transparent);
    border-radius: 2px;
    animation: underline-expand 2s ease-out 1s both;
  }

  @keyframes underline-expand {
    0% { width: 0%; }
    100% { width: 100%; }
  }

  /* Enhanced Background Patterns */
  .bg-grid-pattern {
    background-image: 
      linear-gradient(var(--color-accent) 1px, transparent 1px),
      linear-gradient(90deg, var(--color-accent) 1px, transparent 1px);
    background-size: 50px 50px;
    opacity: 0.1;
  }

  @keyframes animate-grid-float {
    0%, 100% { transform: translate(0, 0); }
    33% { transform: translate(10px, -10px); }
    66% { transform: translate(-5px, 5px); }
  }

  .animate-grid-float {
    animation: animate-grid-float 20s ease-in-out infinite;
  }

  /* Enhanced Floating Animations */
  @keyframes float-slow {
    0%, 100% { transform: translateY(0px) rotate(0deg); }
    50% { transform: translateY(-20px) rotate(5deg); }
  }

  @keyframes float-reverse {
    0%, 100% { transform: translateY(0px) rotate(0deg); }
    50% { transform: translateY(15px) rotate(-3deg); }
  }

  .animate-float-slow {
    animation: float-slow 6s ease-in-out infinite;
  }

  .animate-float-reverse {
    animation: float-reverse 8s ease-in-out infinite;
  }

  /* Enhanced Image Container */
  .hero-image-container {
    transition: transform 0.3s ease;
  }

  .hero-image-container:hover {
    transform: scale(1.02);
  }

  /* Enhanced Floating Elements */
  .floating-elements {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .floating-element {
    position: absolute;
    animation: enhanced-float 6s ease-in-out infinite;
    transition: all 0.3s ease;
  }

  .floating-element-1 {
    top: -8px;
    right: -8px;
    animation-duration: 5s;
  }

  .floating-element-2 {
    bottom: -4px;
    left: -8px;
    animation-duration: 7s;
  }

  .floating-element-3 {
    top: 50%;
    right: -16px;
    animation-duration: 6s;
  }

  .floating-element-4 {
    top: 20%;
    left: -12px;
    animation-duration: 8s;
  }

  @keyframes enhanced-float {
    0%, 100% { 
      transform: translateY(0px) rotate(0deg) scale(1);
    }
    25% { 
      transform: translateY(-8px) rotate(2deg) scale(1.1);
    }
    50% { 
      transform: translateY(-12px) rotate(-1deg) scale(1.05);
    }
    75% { 
      transform: translateY(-4px) rotate(1deg) scale(1.1);
    }
  }

  .hero-image-container:hover .floating-element {
    animation-play-state: paused;
    transform: scale(1.2);
  }

  /* Enhanced CTA Buttons */
  .hero-cta-primary {
    background: linear-gradient(135deg, var(--color-accent), var(--color-accent-dark));
    box-shadow: 0 4px 20px rgba(6, 95, 70, 0.25);
    position: relative;
    overflow: hidden;
  }

  .hero-cta-primary::before {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, transparent, rgba(255,255,255,0.2), transparent);
    transition: left 0.5s;
  }

  .hero-cta-primary:hover::before {
    left: 100%;
  }

  .hero-cta-secondary {
    position: relative;
    overflow: hidden;
  }

  .hero-cta-secondary::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 0;
    height: 0;
    background: var(--color-accent);
    border-radius: 50%;
    transform: translate(-50%, -50%);
    transition: width 0.3s ease, height 0.3s ease;
    z-index: -1;
  }

  .hero-cta-secondary:hover::after {
    width: 300px;
    height: 300px;
  }

  /* Responsive Enhancements */
  @media (max-width: 768px) {
    .hero-section {
      min-height: 80vh;
      padding: 2rem 0;
    }

    .hero-image-container {
      margin: 2rem 0;
    }

    .floating-element {
      transform: scale(0.8);
    }

    .hero-title {
      font-size: clamp(2.5rem, 8vw, 3.5rem);
    }
  }

  /* Reduced Motion Support */
  @media (prefers-reduced-motion: reduce) {
    .hero-title,
    .floating-element,
    .animate-grid-float,
    .animate-float-slow,
    .animate-float-reverse {
      animation: none !important;
    }

    .hero-cta-primary::before,
    .hero-cta-secondary::after {
      transition: none !important;
    }
  }
</style>