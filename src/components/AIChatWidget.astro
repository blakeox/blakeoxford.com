---
/**
 * AIChatWidget - Lazy-loaded AI chat assistant
 * 
 * Uses client:idle to defer loading until browser is idle, reducing initial bundle size.
 * The launcher button is always available, but the heavy React component loads on idle.
 * 
 * @component
 * @category Features
 * @performance
 * - Lazy loads AIChatIsland on browser idle (client:idle)
 * - Reduces initial bundle by ~92KB
 * - Launcher button remains interactive immediately
 */
import AIChatIsland from './islands/AIChatIsland';
---

<div data-ai-chat-widget>
  <!-- Load on idle - reduces initial bundle size significantly -->
  <AIChatIsland client:idle="react" />
</div>
