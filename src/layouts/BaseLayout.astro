---
import '@fontsource/source-sans-3/latin-400.css';
import '@fontsource/source-sans-3/latin-600.css';
import '@fontsource/source-sans-3/latin-700.css';
import '@fontsource/space-grotesk/latin-500.css';
import '@fontsource/space-grotesk/latin-600.css';
import '@fontsource/space-grotesk/latin-700.css';
import '../styles/global.css';
import NavBar from '@/components/layout/NavBar.astro';
import AIChatWidget from '@/components/composites/AIChatWidget.astro';
import Footer from '@/components/layout/Footer.astro';
import SkipLink from '@/components/primitives/SkipLink.astro';
import SearchOverlay from '@/components/features/search/SearchOverlay.astro';
import DocumentMeta from '@/components/head/DocumentMeta.astro';
import StructuredData from '@/components/head/StructuredData.astro';
import SiteClientScripts from '@/components/head/SiteClientScripts.astro';
import { getThemeFoucPreventionScript } from '@/lib/theme';
import { runtimeSurfaceFlags } from '@/lib/runtimeSurfaceFlags';
import { SEO_DESCRIPTION_MAX_LENGTH } from '@/config/seo-policy';
import { SEO } from '@/config/constants';
import { normalizeMetaText } from '@/lib/seo/meta.mjs';
import {
  DEFAULT_SOCIAL_IMAGE_DIMENSIONS,
  getLocalImageDimensions,
} from '@/lib/seo/image-metadata.mjs';

const themeFoucScript = getThemeFoucPreventionScript();

const {
  title = 'Blake Oxford Portfolio',
  description = 'Systems architect and workflow strategist. Explore shipped projects, implementation guides, and practical articles across cloud, automation, and analytics—plus ways to get in touch.',
  url,
  wide = false,
  noindex = false,
  keywords = '',
  image,
  imageAlt = 'Blake Oxford Portfolio',
  ogType = 'website',
  seoTitle = title,
  seoDescription = description,
  structuredData = [],
} = Astro.props;

const metaDescription = normalizeMetaText(seoDescription, SEO_DESCRIPTION_MAX_LENGTH);

const siteHref = (Astro.site?.href ?? 'https://blakeoxford.com').replace(/\/$/, '');
const canonicalUrl =
  typeof url === 'string' && url.length > 0
    ? url
    : (Astro.url?.href ?? `${siteHref}${Astro.url.pathname}`);
const ogImage = image
  ? image.startsWith('http')
    ? image
    : `${siteHref}${image.startsWith('/') ? image : `/${image}`}`
  : `${siteHref}${SEO.defaultImage}`;
const socialImageDimensions =
  (await getLocalImageDimensions(image ?? SEO.defaultImage)) ?? DEFAULT_SOCIAL_IMAGE_DIMENSIONS;

// Neutral site shell — apply Prose intentionally on article pages, not globally
const mainClasses = wide
  ? 'w-full'
  : 'mx-auto w-full max-w-3xl layout-gutter pt-24 text-base leading-relaxed text-foreground';

const googleSiteVerification = import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION?.trim() ?? '';
---

<html lang="en" class="scroll-smooth bg-background text-foreground">
  <head>
    <script is:inline set:html={themeFoucScript} />
    <DocumentMeta
      title={seoTitle}
      metaDescription={metaDescription}
      canonicalUrl={canonicalUrl}
      ogImage={ogImage}
      ogImageWidth={socialImageDimensions.width}
      ogImageHeight={socialImageDimensions.height}
      ogImageAlt={imageAlt}
      ogType={ogType}
      keywords={keywords}
      noindex={noindex}
      googleSiteVerification={googleSiteVerification}
    />
    <StructuredData
      siteHref={siteHref}
      description={description}
      ogImage={ogImage}
      structuredData={structuredData}
    />
    <SiteClientScripts />
    <slot name="head" />
  </head>
  <body id="top" class="min-h-screen bg-background text-foreground">
    {
      runtimeSurfaceFlags.siteSearch ? (
        <SearchOverlay />
      ) : (
        <aside
          class="mx-auto max-w-3xl px-4 py-3 text-sm text-muted-foreground"
          data-runtime-fallback="site-search"
          aria-label="Site search status"
        >
          Site search is temporarily unavailable. Browse
          <a class="ml-1 text-accent underline" href="/projects/">
            projects
          </a>
          ,
          <a class="ml-1 text-accent underline" href="/blog/">
            blog
          </a>
          , or
          <a class="ml-1 text-accent underline" href="/contact/">
            contact
          </a>
          .
        </aside>
      )
    }

    <SkipLink href="#main-content" text="Skip to main content" />
    <SkipLink href="#footer" text="Skip to footer" />
    <a
      href="#top"
      class="skip-link sr-only focus:not-sr-only focus:absolute focus:top-16 focus:left-4 focus:z-50 focus:rounded-lg focus:bg-accent focus:px-4 focus:py-2 focus:text-on-accent focus:shadow-lg focus:ring-2 focus:ring-accent/60 focus:ring-offset-2 focus:outline-none"
    >
      Back to top
    </a>

    <header class="sticky top-0 z-nav" transition:persist="nav">
      <NavBar />
    </header>
    <main id="main-content" tabindex="-1" class={mainClasses} transition:animate="slide">
      <slot />
    </main>
    <Footer transition:persist="footer" />
    {
      runtimeSurfaceFlags.aiAssistant ? (
        <AIChatWidget transition:persist="chat" />
      ) : (
        <aside
          class="mx-auto max-w-3xl px-4 py-3 text-sm text-muted-foreground"
          data-runtime-fallback="ai-assistant"
          aria-label="AI assistant status"
        >
          The AI assistant is temporarily unavailable. Search the
          <a class="ml-1 text-accent underline" href="/blog/">
            blog
          </a>{' '}
          or
          <a class="ml-1 text-accent underline" href="/contact/">
            contact Blake
          </a>
          .
        </aside>
      )
    }
  </body>
</html>
