---
import '../styles/global.css';
import { ViewTransitions } from 'astro:transitions';
import NavBar from '../components/layout/NavBar.astro';
import AIChatWidget from '../components/AIChatWidget.astro';
import Footer from '../components/layout/Footer.astro';
import SkipLink from '../components/primitives/SkipLink.astro';
import ThemeInitIsland from '../components/islands/ThemeInitIsland';
import ServiceWorkerIsland from '../components/islands/ServiceWorkerIsland';
import ExperimentsCookieIsland from '../components/islands/ExperimentsCookieIsland';
import AccessibilityEnhancementsIsland from '../components/islands/AccessibilityEnhancementsIsland';

// wide: when true, disable the default max-width wrapper for full-width layouts
const {
  title = 'Blake Oxford Portfolio',
  // Provide a fuller default description to satisfy SEO description length guidance (50–160 chars)
  description = 'Systems architect and workflow strategist. Explore shipped projects, implementation guides, and practical articles across cloud, automation, and analytics—plus ways to get in touch.',
  // "url" may be passed in to override canonical; when omitted, compute from Astro.site + Astro.url
  url,
  wide = false,
  keywords = '',
  image, // Optional OG image override
  // structuredData, // Optional additional structured data schemas (unused)
} = Astro.props;

// Sanitize description: remove extra whitespace, replace Unicode with ASCII for Lighthouse compatibility
const metaDescription = String(description || '')
  .replace(/\s+/g, ' ')
  .replace(/—/g, '-')  // em dash to hyphen
  .replace(/‑/g, '-')  // non-breaking hyphen to hyphen
  .trim();

// Compute base site href from astro.config.mjs or fallback (string only)
const siteHref = (Astro.site?.href ?? 'https://blakeoxford.com').replace(/\/$/, '');
// Compute canonical URL: prefer explicit url prop; else use Astro.url (absolute when site is set)
const canonicalUrl = (typeof url === 'string' && url.length > 0)
  ? url
  : (Astro.url?.href ?? `${siteHref}${Astro.url.pathname}`);
// Build absolute asset URL for social image
const ogImage = image 
  ? (image.startsWith('http') ? image : `${siteHref}${image.startsWith('/') ? image : `/${image}`}`)
  : `${siteHref}/assets/images/og-image.jpg`;

const baseMainClasses = wide
  ? 'w-full px-4 sm:px-6 lg:px-8'
  : 'mx-auto w-full max-w-3xl px-4 sm:px-6 lg:px-8 text-base leading-relaxed text-[--fg] prose dark:prose-invert';

const mainClasses = `${baseMainClasses} pt-24`;

const includeTestHelpers = import.meta.env.DEV || import.meta.env.MODE === 'test' || import.meta.env.PUBLIC_ENABLE_TEST_HELPERS === 'true';
---

<html lang="en" class="scroll-smooth bg-[--bg] text-[--fg]">
  <head>
    { includeTestHelpers && <script src="/js/test-helpers.js"></script> }
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    
    <!-- View Transitions API for smooth page navigation -->
    <ViewTransitions />

  <ThemeInitIsland />
  <script is:inline>
    (function(){
      try {
        var isTestEnv = (typeof location !== 'undefined' && (location.hostname === 'localhost' || location.hostname === '127.0.0.1')) || (typeof navigator !== 'undefined' && navigator.webdriver);
        if (!isTestEnv) return;
        try {
          var current = '';
          try { current = getComputedStyle(document.documentElement).getPropertyValue('--color-background') || ''; } catch { /* noop */ }
          if (!current.trim()) {
            document.documentElement.style.setProperty('--color-background', '#ffffff');
            try { window.__TEST_THEME_PRIMED = true; } catch  { void 0; }
          }
        } catch { /* noop */ }
      } catch { /* noop */ }
    })();
  </script>

    <!-- Avoid unconditional DNS-prefetch; GA/gtm are loaded lazily and only after interaction/idle -->
    <!-- Removed: <link rel="dns-prefetch" href="//www.googletagmanager.com" /> -->

    <!-- Font Preloading for Critical Fonts -->
    <!-- Preload primary fonts for faster rendering -->
    <link rel="preconnect" href="https://fonts.googleapis.com" crossorigin />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    
    <!-- Favicon and touch icons (consolidated) -->
    <link rel="apple-touch-icon" sizes="180x180" href="/assets/images/icon-192x192.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/assets/images/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/assets/images/favicon-16x16.png" />
    <link rel="icon" href="/favicon.ico" type="image/x-icon" />
  <link rel="manifest" href="/manifest.webmanifest" />
  <link rel="alternate" type="application/rss+xml" title="Blake Oxford RSS" href="/rss.xml" />
    <title>{title}</title>
    <meta name="description" content={metaDescription} />
    <meta property="og:description" content={metaDescription} />
    {keywords && <meta name="keywords" content={keywords} />}
    <meta name="author" content="Blake Oxford" />
    <meta name="creator" content="Blake Oxford" />
    <meta name="publisher" content="Blake Oxford" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
  <link rel="canonical" href={canonicalUrl} />

    <!-- Enhanced Open Graph & Twitter -->
  <meta property="og:title" content={title} />
  <meta property="og:description" content={metaDescription} />
  <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Blake Oxford Portfolio Screenshot" />
  <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Blake Oxford Portfolio" />
    <meta property="og:locale" content="en_US" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content="Blake Oxford Portfolio Screenshot" />
    <meta name="twitter:creator" content="@blakeoxford" />
    <meta name="twitter:site" content="@blakeoxford" />

    <!-- Additional SEO Meta Tags -->
    <meta name="format-detection" content="telephone=no" />
    <meta name="msapplication-TileColor" content="rgb(var(--color-primary))" />
    <meta name="application-name" content="Blake Oxford Portfolio" />
    <!-- Apple mobile web app support -->
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="Blake Oxford" />

    <!-- Theme colors -->
    <meta name="theme-color" content="rgb(var(--color-primary))" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="rgb(var(--color-primary))" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="rgb(var(--color-primary-dark))" />

