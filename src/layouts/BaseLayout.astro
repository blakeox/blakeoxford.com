  <script is:inline type="application/ld+json">
      {JSON.stringify({
        '@context': 'https://schema.org',
        '@graph': [
          {
            '@type': 'WebSite',
            'url': siteHref,
            'name': 'Blake Oxford Portfolio',
            'description': description,
            'inLanguage': 'en-US',
            'publisher': {
              '@type': 'Person',
              'name': 'Blake Oxford',
              'url': siteHref
            }
          },
          {
            '@type': 'Person',
            'name': 'Blake Oxford',
            'url': siteHref,
            'image': ogImage,
            'description': description,
            'sameAs': [
              'https://www.linkedin.com/in/blake-oxford',
              'https://github.com/blakeox'
            ]
          },
          ...(Astro.props && Astro.props.structuredData ? Astro.props.structuredData : [])
        ]
      })}
    </script>

  <ExperimentsCookieIsland client:only="react" />
  <AccessibilityEnhancementsIsland client:only="react" />
  <script is:inline src="/js/ai-chat-launcher.js" defer></script>
  <slot name="head" />
  </head>
  <body id="top" class="min-h-screen bg-[--bg] text-[--fg] transition-colors duration-300">
