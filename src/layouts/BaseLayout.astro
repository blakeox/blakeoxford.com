---
import '../styles/global.css'; // Import global styles (includes Tailwind and theme tokens)
import NavBar from '../components/layout/NavBar.astro';
import SearchOverlay from '../components/features/search/SearchOverlay.astro';
import Footer from '../components/layout/Footer.astro';

// wide: when true, disable the default max-width wrapper for full-width layouts
const {
  title = 'Blake Oxford Portfolio',
  description = 'Welcome to my portfolio! I\'m Blake Oxford',
  url = 'https://blakeoxford.com',
  wide = false,
  keywords = '',
} = Astro.props;

// Optional per-page Critical CSS support
// If generated module exists (via scripts/build/critical-css-generator.js), inline page-specific CSS.
let inlineCriticalCSS: string | undefined;
let fallbackCriticalCSS = ':root{--color-primary:#065f46;--color-accent:#059669;--color-accent-light:#10b981;--color-accent-dark:#047857;--glass-surface-bg:rgba(255,255,255,0.85);--glass-surface-bg-dark:rgba(17,24,39,0.85);--glass-border:rgba(255,255,255,0.2);--glass-border-dark:rgba(75,85,99,0.2);--z-50:50;--ease-emphasized:cubic-bezier(0.4,0,0.2,1)}html{scroll-behavior:smooth}body{margin:0;font-family:system-ui,-apple-system,BlinkMacSystemFont,\'Segoe UI\',Roboto,Helvetica,Arial,\'Apple Color Emoji\',\'Segoe UI Emoji\',\'Segoe UI Symbol\',sans-serif;line-height:1.6;transition:background-color 0.3s ease,color 0.3s ease;padding-top:64px}.dark{color-scheme:dark}.skip-link{position:absolute;top:-40px;left:6px;background:var(--color-primary);color:white;padding:8px;text-decoration:none;z-index:1000;border-radius:4px;transition:top 0.3s ease}.skip-link:focus{top:6px}.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}.navbar-container{background:linear-gradient(120deg,var(--glass-surface-bg) 80%,var(--color-accent-light) 100%);backdrop-filter:blur(18px) saturate(1.2);border-bottom:1.5px solid var(--glass-border);box-shadow:0 4px 32px 0 rgba(0,0,0,0.08);position:fixed;top:0;left:0;right:0;z-index:var(--z-50);transition:all 0.3s var(--ease-emphasized)}.dark .navbar-container{background:linear-gradient(120deg,var(--glass-surface-bg-dark) 80%,var(--color-accent-dark) 100%);border-bottom:1.5px solid var(--glass-border-dark)}.max-w-3xl{max-width:48rem}.mx-auto{margin-left:auto;margin-right:auto}.p-4{padding:1rem}.transition-colors{transition-property:color,background-color,border-color;transition-duration:0.3s;transition-timing-function:cubic-bezier(0.4,0,0.2,1)}.bg-white{background-color:rgb(255 255 255)}.text-gray-900{color:rgb(17 24 39)}.dark .dark\\:bg-gray-900{background-color:rgb(17 24 39)}.dark .dark\\:text-gray-100{color:rgb(243 244 246)}.nav-menu{opacity:0;transition:opacity 0.3s ease}.nav-menu.loaded{opacity:1}';

try {
  const mod = await import('../styles/critical/critical-css');
  // Map pathnames to page keys used by the generator
  const pathToName = (pathname: string) => {
    switch (pathname) {
      case '/': return 'home';
      case '/about': return 'about';
      case '/projects': return 'projects';
      case '/blog': return 'blog';
      case '/contact': return 'contact';
      default: return 'home';
    }
  };
  const pageKey = pathToName(Astro.url?.pathname || '/');
  inlineCriticalCSS = (mod as any).getCriticalCSS?.(pageKey);
} catch {
  // No generated critical CSS available; use fallback
}
---

<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <!-- Favicon and touch icons -->
  <link rel="apple-touch-icon" sizes="180x180" href="/assets/images/icon-192x192.png" />
  <link rel="icon" type="image/png" sizes="32x32" href="/assets/images/favicon-32x32.png" />
  <link rel="icon" type="image/png" sizes="16x16" href="/assets/images/favicon-16x16.png" />
  <link rel="manifest" href="/manifest.webmanifest">

  <!-- Critical CSS Inline for immediate rendering (generated per-page if available) -->
  <style is:inline set:html={inlineCriticalCSS ?? fallbackCriticalCSS}></style>

    <!-- Resource Preloading for critical assets -->
  <link rel="preload" href="/assets/js/lazy-loader.min.js" as="script" />
  <link rel="preload" href="/assets/images/Blake-O-scaled.avif" as="image" type="image/avif" imagesrcset="/assets/images/Blake-O-scaled.avif 1x, /assets/images/Blake-O-scaled.webp 1x, /assets/images/Blake-O-scaled.jpg 1x" />

  <!-- DNS Prefetch for external resources -->
    <link rel="dns-prefetch" href="//www.googletagmanager.com" />

    <!-- Prevent flash of unstyled content - Must be as early as possible in head -->
    <script is:inline>
      (function() {
        // Check for dark mode preference at the browser level
        const prefersDarkMode = window.matchMedia('(prefers-color-scheme: dark)').matches;
        // Check for theme stored in local storage
        const storedTheme = localStorage.getItem('theme');

        // Apply theme immediately to avoid flash
        if (storedTheme === 'dark' || (!storedTheme && prefersDarkMode)) {
          document.documentElement.classList.add('dark');
        } else {
          document.documentElement.classList.remove('dark');
        }

        // Also add a data attribute for additional selector options
        document.documentElement.dataset.theme = (storedTheme === 'dark' || (!storedTheme && prefersDarkMode)) ? 'dark' : 'light';

        // Log theme state for debugging
        console.log('Initial theme:', document.documentElement.classList.contains('dark') ? 'dark' : 'light');
      })();
    </script>
  <!-- Favicon and touch icons (consolidated) -->
  <link rel="apple-touch-icon" sizes="180x180" href="/assets/images/icon-192x192.png" />
  <link rel="icon" type="image/png" sizes="32x32" href="/assets/images/favicon-32x32.png" />
  <link rel="icon" type="image/png" sizes="16x16" href="/assets/images/favicon-16x16.png" />
  <link rel="icon" href="/favicon.ico" type="image/x-icon" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <!-- SEO Keywords -->
    {keywords && <meta name="keywords" content={keywords} />}
    <meta name="author" content="Blake Oxford" />
    <meta name="creator" content="Blake Oxford" />
    <meta name="publisher" content="Blake Oxford" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <link rel="canonical" href={url} />

    <!-- Enhanced Open Graph & Twitter -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/assets/images/og-image.jpg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Blake Oxford Portfolio Screenshot" />
    <meta property="og:url" content={url} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Blake Oxford Portfolio" />
    <meta property="og:locale" content="en_US" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="/assets/images/og-image.jpg" />
    <meta name="twitter:image:alt" content="Blake Oxford Portfolio Screenshot" />
    <meta name="twitter:creator" content="@blakeoxford" />
    <meta name="twitter:site" content="@blakeoxford" />

    <!-- Additional SEO Meta Tags -->
    <meta name="format-detection" content="telephone=no" />
    <meta name="msapplication-TileColor" content="#2563eb" />
    <meta name="application-name" content="Blake Oxford Portfolio" />
    <!-- Apple mobile web app support -->
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="Blake Oxford" />

    <!-- Theme colors -->
    <meta name="theme-color" content="#2563eb" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#2563eb" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#1e40af" />

    <!-- Manifest and Icons -->
    <link rel="manifest" href="/manifest.webmanifest" />
  <!-- Removed webfont loads to eliminate font-driven CLS; using system font stack in critical CSS -->
    <!-- Essential JavaScript Bundles (performance-optimized) -->
  <script is:inline src="/assets/js/lazy-loader.min.js" defer></script>
  <script is:inline src="/assets/js/performance-monitor.js" async></script>
  <script is:inline src="/assets/js/resource-preloader.js" async></script>
  <script is:inline src="/assets/js/pwa-enhancer.js" async></script>

    <!-- Register Service Worker for offline functionality -->
    <script is:inline>
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/sw.js')
            .then(registration => {
              console.log('✅ Service Worker registered:', registration.scope);
            })
            .catch(error => {
              console.log('❌ Service Worker registration failed:', error);
            });
        });
      }
    </script>

    <!-- Lightweight client-side A/B test cookie initializer (replaces server middleware) -->
    <script is:inline>
      (function(){
        try {
          var name = 'ab-test-group';
          if (document.cookie.indexOf(name + '=') === -1) {
            var group = Math.random() < 0.5 ? 'A' : 'B';
            var maxAge = 60 * 60 * 24 * 30; // 30 days
            var secure = location.protocol === 'https:' ? '; Secure' : '';
            document.cookie = name + '=' + group + '; Path=/; Max-Age=' + maxAge + '; SameSite=Lax' + secure;
          }
        } catch (_) { /* no-op */ }
      })();
    </script>

    <!-- End Google Tag Manager -->
    <!-- Google Analytics (gtag.js) -->
  <script is:inline>{`
    // Defer GA until after load to avoid impacting LCP/TBT
    window.addEventListener('load', function() {
      var s = document.createElement('script');
      s.async = true;
      s.src = 'https://www.googletagmanager.com/gtag/js?id=G-CS4BH1K3HG';
      s.onload = function() {
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);} 
        gtag('js', new Date());
        gtag('config', 'G-CS4BH1K3HG');
      };
      document.head.appendChild(s);
    });
  `}</script>
  </head>
  <body id="top" class="bg-white text-gray-900 dark:bg-gray-900 dark:text-gray-100 transition-colors duration-300">
    <!-- Skip link for keyboard users -->
    <a href="#main-content" class="skip-link" aria-label="Skip to main content">
      Skip to main content
    </a>

    <!-- Global live region for announcements -->
    <div id="live-region" class="sr-only" aria-live="polite" aria-atomic="true"></div>

    <!-- Google Tag Manager (noscript) -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-MDX5DR6Q"
    height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <!-- End Google Tag Manager (noscript) -->
    <header role="banner" style="display: block;">
      <NavBar />
    </header>
  <SearchOverlay />
    <main id="main-content" tabindex="-1" aria-label="Main Content" class={
      wide
        ? 'max-w-none px-0'
        : 'prose prose-gray dark:prose-invert max-w-3xl mx-auto p-4'
    }>
      <slot />
    </main>
    <Footer />
    <!-- Back to top floating button -->
    <div class="fixed bottom-6 right-6 z-50">
      <a href="#top" class="bg-accent hover:bg-accent-dark text-white p-3 rounded-full shadow-lg hover:shadow-xl transition-all duration-300 flex items-center justify-center focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-accent" aria-label="Back to top">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 10l7-7m0 0l7 7m-7-7v18" />
        </svg>
      </a>
    </div>
    <style>
      .fixed.bottom-6.right-6.z-50 {
        /* Ensures the button is always visible and styled */
      }
    </style>
  </body>
</html>
