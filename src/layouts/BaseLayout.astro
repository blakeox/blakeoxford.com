---
import '../styles/global.css'; // Import global styles (includes Tailwind and theme tokens)
import NavBar from '../components/layout/NavBar.astro';
import SearchOverlay from '../components/features/search/SearchOverlay.astro';
import Footer from '../components/layout/Footer.astro';

// wide: when true, disable the default max-width wrapper for full-width layouts
const {
  title = 'Blake Oxford Portfolio',
  description = 'Welcome to my portfolio! I\'m Blake Oxford',
  url = 'https://blakeoxford.com',
  wide = false,
  keywords = '',
} = Astro.props;

// Optional per-page Critical CSS support
// If generated module exists (via scripts/build/critical-css-generator.js), inline page-specific CSS.
let inlineCriticalCSS: string | undefined;
let fallbackCriticalCSS = ':root{--color-primary:#065f46;--color-accent:#059669;--color-accent-light:#10b981;--color-accent-dark:#047857;--glass-surface-bg:rgba(255,255,255,0.85);--glass-surface-bg-dark:rgba(17,24,39,0.85);--glass-border:rgba(255,255,255,0.2);--glass-border-dark:rgba(75,85,99,0.2);--z-50:50;--ease-emphasized:cubic-bezier(0.4,0,0.2,1);--color-foreground-strong:#111827}html{scroll-behavior:smooth}body{margin:0;font-family:system-ui,-apple-system,BlinkMacSystemFont,\'Segoe UI\',Roboto,Helvetica,Arial,\'Apple Color Emoji\',\'Segoe UI Emoji\',\'Segoe UI Symbol\',sans-serif;line-height:1.6;transition:background-color 0.3s ease,color 0.3s ease;padding-top:64px;color:var(--color-foreground-strong,#111827)}body main p{color:var(--color-foreground-strong,#111827)!important}.dark{color-scheme:dark}.skip-link{position:absolute;top:-40px;left:6px;background:var(--color-primary);color:white;padding:8px;text-decoration:none;z-index:1000;border-radius:4px;transition:top 0.3s ease}.skip-link:focus{top:6px}.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}.navbar-container{background:linear-gradient(120deg,var(--glass-surface-bg) 80%,var(--color-accent-light) 100%);backdrop-filter:blur(18px) saturate(1.2);border-bottom:1.5px solid var(--glass-border);box-shadow:0 4px 32px 0 rgba(0,0,0,0.08);position:fixed;top:0;left:0;right:0;z-index:var(--z-50);transition:all 0.3s var(--ease-emphasized)}.dark .navbar-container{background:linear-gradient(120deg,var(--glass-surface-bg-dark) 80%,var(--color-accent-dark) 100%);border-bottom:1.5px solid var(--glass-border-dark)}.max-w-3xl{max-width:48rem}.mx-auto{margin-left:auto;margin-right:auto}.p-4{padding:1rem}.transition-colors{transition-property:color,background-color,border-color;transition-duration:0.3s;transition-timing-function:cubic-bezier(0.4,0,0.2,1)}.bg-white{background-color:rgb(255 255 255)}.text-foreground{color:var(--color-foreground-strong,#111827)}.nav-menu{opacity:0;transition:opacity 0.3s ease}.nav-menu.loaded{opacity:1}';

try {
  const mod = await import('../styles/critical/critical-css');
  // Map pathnames to page keys used by the generator
  const pathToName = (pathname: string) => {
    switch (pathname) {
      case '/': return 'home';
      case '/about': return 'about';
      case '/projects': return 'projects';
      case '/blog': return 'blog';
      case '/contact': return 'contact';
      default: return 'home';
    }
  };
  const pageKey = pathToName(Astro.url?.pathname || '/');
  inlineCriticalCSS = (mod as any).getCriticalCSS?.(pageKey);
} catch {
  // No generated critical CSS available; use fallback
}
---

<html lang="en" class="scroll-smooth bg-background text-foreground dark:bg-background dark:text-foreground">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Early theme initialization (no flash of incorrect theme) -->
    <script is:inline>
      (function() {
        try {
          var ls = null;
          try { ls = localStorage.getItem('theme'); } catch(_) {}
          var prefersDark = false;
          try { prefersDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches; } catch(_) {}
          var theme = ls || (prefersDark ? 'dark' : 'light');
          var html = document.documentElement;
          if (theme === 'dark') {
            html.classList.add('dark');
            html.setAttribute('data-theme','dark');
          } else {
            html.classList.remove('dark');
            html.setAttribute('data-theme','light');
          }
        } catch(_) { /* no-op */ }
      })();
    </script>

    <!-- Critical CSS Inline for immediate rendering (generated per-page if available) -->
    <style is:inline set:html={inlineCriticalCSS ?? fallbackCriticalCSS}></style>

    <!-- Avoid unconditional DNS-prefetch; GA/gtm are loaded lazily and only after interaction/idle -->
    <!-- Removed: <link rel="dns-prefetch" href="//www.googletagmanager.com" /> -->

    <!-- Favicon and touch icons (consolidated) -->
    <link rel="apple-touch-icon" sizes="180x180" href="/assets/images/icon-192x192.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/assets/images/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/assets/images/favicon-16x16.png" />
    <link rel="icon" href="/favicon.ico" type="image/x-icon" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {keywords && <meta name="keywords" content={keywords} />}
    <meta name="author" content="Blake Oxford" />
    <meta name="creator" content="Blake Oxford" />
    <meta name="publisher" content="Blake Oxford" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <link rel="canonical" href={url} />

    <!-- Enhanced Open Graph & Twitter -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/assets/images/og-image.jpg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Blake Oxford Portfolio Screenshot" />
    <meta property="og:url" content={url} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Blake Oxford Portfolio" />
    <meta property="og:locale" content="en_US" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="/assets/images/og-image.jpg" />
    <meta name="twitter:image:alt" content="Blake Oxford Portfolio Screenshot" />
    <meta name="twitter:creator" content="@blakeoxford" />
    <meta name="twitter:site" content="@blakeoxford" />

    <!-- Additional SEO Meta Tags -->
    <meta name="format-detection" content="telephone=no" />
    <meta name="msapplication-TileColor" content="#2563eb" />
    <meta name="application-name" content="Blake Oxford Portfolio" />
    <!-- Apple mobile web app support -->
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="Blake Oxford" />

    <!-- Theme colors -->
    <meta name="theme-color" content="#2563eb" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#2563eb" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#1e40af" />

  <!-- Manifest included above -->
  <!-- Removed webfont loads to eliminate font-driven CLS; using system font stack in critical CSS -->
    <!-- Essential JavaScript Bundles (performance-optimized) -->
  <script is:inline>
    // Inlined lazy-loader.min.js to avoid an extra network request and reduce file count
    class LazyBundleLoader {constructor() {this.loadedBundles = new Set();this.loadingPromises = new Map();}async loadBundle(bundleName) {if (this.loadedBundles.has(bundleName)) {return Promise.resolve();}if (this.loadingPromises.has(bundleName)) {return this.loadingPromises.get(bundleName);}const promise = new Promise((resolve,reject) => {const script = document.createElement('script');script.src = `/assets/js/${bundleName}.min.js`;script.async = true;script.onload = () => {this.loadedBundles.add(bundleName);this.loadingPromises.delete(bundleName);resolve();};script.onerror = () => {this.loadingPromises.delete(bundleName);reject(new Error(`Failed to load bundle:${bundleName}`));};document.head.appendChild(script);});this.loadingPromises.set(bundleName,promise);return promise;}async loadExternalLibrary(libName,url) {if (this.loadedBundles.has(libName)) {return Promise.resolve();}if (this.loadingPromises.has(libName)) {return this.loadingPromises.get(libName);}const promise = new Promise((resolve,reject) => {const script = document.createElement('script');script.src = url;script.async = true;script.onload = () => {this.loadedBundles.add(libName);this.loadingPromises.delete(libName);resolve();};script.onerror = () => {this.loadingPromises.delete(libName);reject(new Error(`Failed to load library:${libName}`));};document.head.appendChild(script);});this.loadingPromises.set(libName,promise);return promise;}async loadAccessibilityFeatures() {return this.loadBundle('accessibility');}async loadInteractiveFeatures() {await Promise.all([ /* this.loadBundle('interactive'), */ this.loadExternalLibrary('fuse','/assets/js/fuse.min.js') ]);}async loadFormFeatures() {return this.loadBundle('forms');}}window.LazyBundleLoader = new LazyBundleLoader();const loadA11yOnInteraction = () => {const events = ['keydown','click','focus'];const loadOnce = () => {window.LazyBundleLoader.loadAccessibilityFeatures();events.forEach(event => {document.removeEventListener(event,loadOnce,true);});};events.forEach(event => {document.addEventListener(event,loadOnce,true);});if (localStorage.getItem('accessibility-preferences')) {loadOnce();}};if (document.readyState === 'loading') {document.addEventListener('DOMContentLoaded',() => {setTimeout(() => window.LazyBundleLoader.loadInteractiveFeatures(),100);});}else {setTimeout(() => window.LazyBundleLoader.loadInteractiveFeatures(),100);}loadA11yOnInteraction();
  </script>
  <script is:inline src="/assets/js/core-boot.js" async></script>

    <!-- Register Service Worker for offline functionality (skip during audits) -->
    <script is:inline>
      (function(){
        var isAudit = !!(window).__AUDIT__ || /(^|;)\s*audit=1(;$|;|\s|$)/.test(document.cookie||'') || /lighthouse|headlesschrome/i.test(navigator.userAgent||'');
        if (isAudit) return;
        if ('serviceWorker' in navigator) {
          window.addEventListener('load', () => {
            navigator.serviceWorker.register('/sw.js')
              .then(registration => { console.log('✅ Service Worker registered:', registration.scope); })
              .catch(error => { console.log('❌ Service Worker registration failed:', error); });
          });
        }
      })();
    </script>

    <!-- Lightweight client-side A/B test cookie initializer (skip during audits) -->
    <script is:inline>
      (function(){
        try {
          var isAudit = !!(window).__AUDIT__ || /(^|;)\s*audit=1(;$|;|\s|$)/.test(document.cookie||'') || /lighthouse|headlesschrome/i.test(navigator.userAgent||'');
          if (isAudit) return;
          var name = 'ab-test-group';
          if (document.cookie.indexOf(name + '=') === -1) {
            var group = Math.random() < 0.5 ? 'A' : 'B';
            var maxAge = 60 * 60 * 24 * 30; // 30 days
            var secure = location.protocol === 'https:' ? '; Secure' : '';
            document.cookie = name + '=' + group + '; Path=/; Max-Age=' + maxAge + '; SameSite=Lax' + secure;
          }
        } catch (_) { /* no-op */ }
      })();
    </script>

    <!-- Analytics facade: load GA only after user interaction or idle -->
  <script is:inline>
    (function() {
      var isAudit = !!(window).__AUDIT__ || /(^|;)\s*audit=1(;$|;|\s|$)/.test(document.cookie||'') || /lighthouse|headlesschrome/i.test(navigator.userAgent||'');
      if (isAudit) { window.dataLayer = window.dataLayer || []; window.gtag = window.gtag || function(){}; return; }
      var GA_ID = 'G-CS4BH1K3HG';
      var loaded = false;
      var queue = [];
      window.dataLayer = window.dataLayer || [];
      window.gtag = function() { queue.push(arguments); };

      function loadGA() {
        if (loaded) return; loaded = true;
        var s = document.createElement('script');
        s.async = true;
        s.src = 'https://www.googletagmanager.com/gtag/js?id=' + GA_ID;
        s.onload = function() {
          window.gtag = function(){ dataLayer.push(arguments); };
          window.gtag('js', new Date());
          window.gtag('consent', 'default', { ad_storage: 'denied', analytics_storage: 'granted', functionality_storage: 'granted', security_storage: 'granted' });
          window.gtag('config', GA_ID, { send_page_view: true, allow_google_signals: false, allow_ad_personalization_signals: false });
          if (queue.length) { queue.forEach(function(args){ window.gtag.apply(null, args); }); queue = []; }
        };
        document.head.appendChild(s);
      }

      var activated = false;
      function activate() {
        if (activated) return; activated = true;
        ['click','keydown','pointerdown','touchstart','scroll'].forEach(function(type){
          window.removeEventListener(type, activate, { passive: true });
        });
        loadGA();
      }
      ['click','keydown','pointerdown','touchstart','scroll'].forEach(function(type){
        window.addEventListener(type, activate, { passive: true, once: true });
      });

      window.addEventListener('load', function() {
        if ('requestIdleCallback' in window) {
          requestIdleCallback(function(){ loadGA(); }, { timeout: 10000 });
        } else {
          setTimeout(loadGA, 10000);
        }
      });
    })();
  </script>
  </head>
  <body id="top" class="min-h-screen bg-background text-foreground dark:bg-background dark:text-foreground transition-colors duration-300">
    <!-- Skip link for keyboard users -->
    <a href="#main-content" class="skip-link" aria-label="Skip to main content">
      Skip to main content
    </a>

    <!-- Global live region for announcements -->
    <div id="live-region" class="sr-only" aria-live="polite" aria-atomic="true"></div>

  <!-- Google Tag Manager (noscript) removed to avoid third-party request when JS disabled -->
  <header role="banner">
      <NavBar />
    </header>
  <SearchOverlay />
    <main id="main-content" role="main" tabindex="-1" aria-label="Main Content" class={
      wide
        ? 'max-w-none px-0'
  : 'prose dark:prose-invert max-w-3xl mx-auto p-4'
    }>
      <slot />
    </main>
    <Footer />
    <!-- Back to top floating button -->
    <div class="fixed bottom-6 right-6 z-50">
      <a href="#top" class="bg-accent hover:bg-accent-dark text-white p-3 rounded-full shadow-lg hover:shadow-xl transition-all duration-300 flex items-center justify-center focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-accent" aria-label="Back to top">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 10l7-7m0 0l7 7m-7-7v18" />
        </svg>
      </a>
    </div>
    <!-- Improve skip-link behavior: ensure focus lands on main content -->
    <script is:inline>
      (function(){
        try {
          var skip = document.querySelector('a.skip-link[href="#main-content"]');
          var main = document.getElementById('main-content');
          if (skip && main) {
            skip.addEventListener('click', function(){ setTimeout(function(){ main.focus(); }, 0); });
            if (location.hash === '#main-content') { setTimeout(function(){ main.focus(); }, 0); }
          }
        } catch(_) {}
      })();
    </script>
  </body>
</html>
