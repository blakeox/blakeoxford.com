---
/**
 * ProjectDetailLayout - Unified layout for all project detail pages
 *
 * Handles common structure, conditional sections, and data loading.
 * Reduces duplication across 7+ project pages.
 *
 * @prop {string} slug - Project slug to load from content collection
 */
import { getEntry, render } from 'astro:content';
import Layout from './BaseLayout.astro';
import {
  createProjectSchema,
  createBreadcrumbListSchema,
  defaultAuthor,
} from '../utils/structuredData';
import ProjectHero from '../components/features/projects/ProjectHero.astro';
import ProjectDetailContent from '../components/features/projects/ProjectDetailContent.astro';

interface Props {
  slug: string;
}

const { slug } = Astro.props;

const entry = await getEntry('projects', slug);
if (!entry) {
  throw new Error(`Project not found: ${slug}`);
}

const { data } = entry;
const title = data.title;
const description = data.description ?? '';
const date = data.date ? new Date(data.date) : new Date();
const canonicalUrl = `https://blakeoxford.com/projects/${entry.id}/`;
const heroImage = (data as any).heroImage ?? '/assets/images/blake-logo-fallback.png';

// Optional sections with runtime guards
const hasMetrics =
  'metrics' in data && Array.isArray((data as any).metrics) && (data as any).metrics.length > 0;
const metrics = hasMetrics
  ? ((data as any).metrics as Array<{ metric: string; result: string; timeline: string }>)
  : [];
const hasJourney =
  'journey' in data && Array.isArray((data as any).journey) && (data as any).journey.length > 0;
const journey = hasJourney ? ((data as any).journey as string[]) : [];
const hasLessons =
  'lessons' in data && Array.isArray((data as any).lessons) && (data as any).lessons.length > 0;
const lessons = hasLessons
  ? ((data as any).lessons as Array<{ title: string; description: string }>)
  : [];
const hasCategories =
  'categories' in data &&
  Array.isArray((data as any).categories) &&
  (data as any).categories.length > 0;
const categories = hasCategories ? ((data as any).categories as string[]) : [];
const reflection =
  'reflection' in data ? ((data as any).reflection as string | undefined) : undefined;

const primaryOutcome =
  (Array.isArray(data.impact) && data.impact[0]) ||
  (hasMetrics && metrics[0] ? `${metrics[0].result} — ${metrics[0].metric}` : undefined);

const { Content } = await render(entry);

// Generate structured data
const siteOrigin = 'https://blakeoxford.com';
const projectImage = heroImage.startsWith('http')
  ? heroImage
  : `${siteOrigin}${heroImage.startsWith('/') ? heroImage : `/${heroImage}`}`;

const projectSchema = createProjectSchema(title, defaultAuthor, date, {
  description: description || undefined,
  image: projectImage,
  url: canonicalUrl,
  keywords: Array.isArray(data.tags) ? data.tags : undefined,
});

const breadcrumbSchema = createBreadcrumbListSchema([
  { name: 'Home', url: `${siteOrigin}/` },
  { name: 'Selected work', url: `${siteOrigin}/projects/` },
  { name: title, url: canonicalUrl },
]);

const externalLink =
  typeof (data as { link?: string }).link === 'string'
    ? (data as { link: string }).link
    : undefined;

const structuredData = [projectSchema, breadcrumbSchema];
---

<Layout
  title={title}
  description={description}
  url={canonicalUrl}
  image={projectImage}
  structuredData={structuredData}
  wide
>
  <ProjectHero
    title={title}
    description={description}
    date={date}
    image={heroImage}
    link={externalLink}
    categories={categories}
    outcome={primaryOutcome}
  />
  <ProjectDetailContent
    data={data}
    Content={Content}
    metrics={metrics}
    journey={journey}
    lessons={lessons}
    reflection={reflection}
    hasMetrics={hasMetrics}
    hasJourney={hasJourney}
    hasLessons={hasLessons}
  >
    <slot name="cta" slot="cta" />
  </ProjectDetailContent>
</Layout>
