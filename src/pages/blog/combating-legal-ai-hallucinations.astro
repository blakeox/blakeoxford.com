---
import Layout from '../../layouts/BaseLayout.astro';

const title = 'Combating Legal AI Hallucinations: How courtlistener-mcp Enhances Trustworthy AI-Assisted Legal Research';
const description = 'Introducing courtlistener-mcp, an open-source MCP server that combats AI hallucinations in legal research by grounding responses in real court data from CourtListener.';
const pubDate = new Date('2025-07-28');
const tags = ['AI', 'Legal Tech', 'Open Source'];
const canonicalUrl = 'https://blakeoxford.com/blog/combating-legal-ai-hallucinations/';
const image = '~/assets/images/blog/legal-ai-hallucinations.png';

// SEO Schema
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  'headline': title,
  'description': description,
  'image': image,
  'author': {
    '@type': 'Person',
    'name': 'Blake Oxford',
    'url': 'https://blakeoxford.com'
  },
  'publisher': {
    '@type': 'Organization',
    'name': 'Blake Oxford',
    'logo': {
      '@type': 'ImageObject',
            'url': 'https://blakeoxford.com/assets/images/Blake-O-scaled.jpg'
    }
  },
  'datePublished': pubDate.toISOString(),
  'dateModified': pubDate.toISOString(),
  'mainEntityOfPage': {
    '@type': 'WebPage',
    '@id': canonicalUrl
  }
};
---

<Layout
  title={title}
  description={description}
  image={image}
  url={canonicalUrl}
  wide={true}
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  
  <!-- Blog Post Hero Section -->
  <section class="w-full py-16 md:py-24 px-4 relative overflow-hidden bg-gradient-to-br from-background via-accent/5 to-background" role="region" aria-labelledby="article-title">
    <!-- Background pattern -->
    <div class="absolute inset-0 z-0 opacity-20 pointer-events-none">
      <svg class="absolute inset-0 w-full h-full" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <pattern id="article-grid" width="40" height="40" patternUnits="userSpaceOnUse">
            <path d="M0 40L40 0M20 40L40 20M0 20L20 0" fill="none" stroke="currentColor" stroke-width="1" stroke-opacity="0.12" />
          </pattern>
        </defs>
        <rect width="100%" height="100%" fill="url(#article-grid)" />
      </svg>
    </div>
    <!-- Floating shapes -->
    <div class="absolute top-0 right-0 w-64 h-64 bg-accent/20 rounded-full blur-3xl transform translate-x-1/2 -translate-y-1/2 pointer-events-none"></div>
    <div class="absolute bottom-0 left-0 w-48 h-48 bg-accent/20 rounded-full blur-3xl transform -translate-x-1/2 translate-y-1/2 pointer-events-none"></div>

    <div class="relative z-10 max-w-4xl mx-auto text-center">
      <div class="mb-8">
        <!-- Article Tags -->
        <div class="flex flex-wrap justify-center gap-2 mb-6">
          {tags.map(tag => (
            <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-accent/10 text-accent dark:bg-accent/20 dark:text-accent-light">
              {tag}
            </span>
          ))}
        </div>
        
        <!-- Publication Date -->
        <time datetime={pubDate.toISOString()} class="text-sm text-foreground-light dark:text-foreground-light/80 mb-4 block">
          Published on {pubDate.toLocaleDateString('en-US', { 
            year: 'numeric', 
            month: 'long', 
            day: 'numeric' 
          })}
        </time>
      </div>

      <h1 id="article-title" class="font-heading font-bold text-3xl md:text-4xl lg:text-5xl text-accent dark:text-accent-light mb-6 animate-fade-in leading-tight">
        Combating Legal AI Hallucinations
      </h1>
      <p class="text-xl md:text-2xl text-foreground-light dark:text-foreground animate-fade-in mb-8 leading-relaxed">
        How courtlistener-mcp Enhances Trustworthy AI-Assisted Legal Research
      </p>
      <p class="text-lg text-foreground-light dark:text-foreground-light/80 animate-fade-in max-w-3xl mx-auto">
        Introducing an open-source MCP server that combats AI hallucinations in legal research by grounding responses in real court data from CourtListener.
      </p>
    </div>
  </section>

  <!-- Article Content -->
  <article class="py-20 bg-white dark:bg-gray-900">
    <div class="max-w-4xl mx-auto px-6 lg:px-8">
      
      <!-- Introduction -->
      <section class="mb-16">
        <div class="prose prose-lg prose-gray dark:prose-invert max-w-none">
          <p class="text-xl leading-relaxed text-gray-700 dark:text-gray-300 mb-8 font-medium">
            Introducing <strong>courtlistener-mcp</strong>, an open-source MCP server that revolutionizes AI-assisted legal research by directly addressing one of the most critical challenges in AI: <strong>hallucinations</strong>.
          </p>
        </div>
      </section>

      <!-- The Problem -->
      <section class="mb-16">
        <h2 class="text-3xl font-bold mb-8 text-gray-900 dark:text-white flex items-center">
          <div class="w-12 h-12 bg-red-100 dark:bg-red-900 rounded-xl flex items-center justify-center mr-4">
            <svg class="w-6 h-6 text-red-600 dark:text-red-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L4.082 16.5c-.77.833.192 2.5 1.732 2.5z" />
            </svg>
          </div>
          The Problem
        </h2>
        <div class="prose prose-lg prose-gray dark:prose-invert max-w-none">
          <p class="text-lg leading-relaxed text-gray-700 dark:text-gray-300 mb-6">
            AI hallucinations in legal research can have <strong>serious consequences</strong>. When AI systems generate plausible-sounding but factually incorrect legal information, it can mislead lawyers, researchers, and the public.
          </p>
          
          <!-- Problem Statistics -->
          <div class="bg-red-50 dark:bg-red-900/20 border border-red-200 dark:border-red-800 rounded-xl p-6 mb-8">
            <h3 class="text-xl font-semibold text-red-800 dark:text-red-200 mb-4">The Stakes Are High</h3>
            <ul class="space-y-3 text-red-700 dark:text-red-300">
              <li class="flex items-start">
                <span class="inline-block w-2 h-2 bg-red-500 rounded-full mt-2 mr-3 flex-shrink-0"></span>
                Legal decisions based on incorrect AI-generated information can impact case outcomes
              </li>
              <li class="flex items-start">
                <span class="inline-block w-2 h-2 bg-red-500 rounded-full mt-2 mr-3 flex-shrink-0"></span>
                Professional liability risks for attorneys relying on unverified AI responses
              </li>
              <li class="flex items-start">
                <span class="inline-block w-2 h-2 bg-red-500 rounded-full mt-2 mr-3 flex-shrink-0"></span>
                Erosion of trust in AI-assisted legal research tools
              </li>
            </ul>
          </div>
        </div>
      </section>

      <!-- The Solution -->
      <section class="mb-16">
        <h2 class="text-3xl font-bold mb-8 text-gray-900 dark:text-white flex items-center">
          <div class="w-12 h-12 bg-green-100 dark:bg-green-900 rounded-xl flex items-center justify-center mr-4">
            <svg class="w-6 h-6 text-green-600 dark:text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          The Solution
        </h2>
        <div class="prose prose-lg prose-gray dark:prose-invert max-w-none">
          <p class="text-lg leading-relaxed text-gray-700 dark:text-gray-300 mb-8">
            <strong>courtlistener-mcp</strong> provides a robust solution by connecting AI systems directly to authoritative legal data:
          </p>
          
          <!-- Solution Features Grid -->
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
            <div class="bg-green-50 dark:bg-green-900/20 border border-green-200 dark:border-green-800 rounded-xl p-6">
              <div class="flex items-center mb-4">
                <div class="w-8 h-8 bg-green-100 dark:bg-green-800 rounded-lg flex items-center justify-center mr-3">
                  <svg class="w-4 h-4 text-green-600 dark:text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1" />
                  </svg>
                </div>
                <h3 class="text-lg font-semibold text-green-800 dark:text-green-200">Grounded Responses</h3>
              </div>
              <p class="text-green-700 dark:text-green-300">AI responses anchored in real court data from CourtListener's comprehensive database</p>
            </div>

            <div class="bg-blue-50 dark:bg-blue-900/20 border border-blue-200 dark:border-blue-800 rounded-xl p-6">
              <div class="flex items-center mb-4">
                <div class="w-8 h-8 bg-blue-100 dark:bg-blue-800 rounded-lg flex items-center justify-center mr-3">
                  <svg class="w-4 h-4 text-blue-600 dark:text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                  </svg>
                </div>
                <h3 class="text-lg font-semibold text-blue-800 dark:text-blue-200">Verified Documents</h3>
              </div>
              <p class="text-blue-700 dark:text-blue-300">Direct access to verified legal documents and court opinions</p>
            </div>

            <div class="bg-purple-50 dark:bg-purple-900/20 border border-purple-200 dark:border-purple-800 rounded-xl p-6">
              <div class="flex items-center mb-4">
                <div class="w-8 h-8 bg-purple-100 dark:bg-purple-800 rounded-lg flex items-center justify-center mr-3">
                  <svg class="w-4 h-4 text-purple-600 dark:text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 8l2 2 4-4" />
                  </svg>
                </div>
                <h3 class="text-lg font-semibold text-purple-800 dark:text-purple-200">Fact-Checking</h3>
              </div>
              <p class="text-purple-700 dark:text-purple-300">Real-time fact-checking against authoritative legal sources</p>
            </div>

            <div class="bg-amber-50 dark:bg-amber-900/20 border border-amber-200 dark:border-amber-800 rounded-xl p-6">
              <div class="flex items-center mb-4">
                <div class="w-8 h-8 bg-amber-100 dark:bg-amber-800 rounded-lg flex items-center justify-center mr-3">
                  <svg class="w-4 h-4 text-amber-600 dark:text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2-2v2m8 0V6a2 2 0 012 2v6a2 2 0 01-2 2H8a2 2 0 01-2-2V8a2 2 0 012-2V6" />
                  </svg>
                </div>
                <h3 class="text-lg font-semibold text-amber-800 dark:text-amber-200">Research Workflows</h3>
              </div>
              <p class="text-amber-700 dark:text-amber-300">Comprehensive legal research workflows with integrated verification</p>
            </div>
          </div>
        </div>
      </section>

      <!-- Technical Architecture -->
      <section class="mb-16">
        <h2 class="text-3xl font-bold mb-8 text-gray-900 dark:text-white">Technical Architecture</h2>
        <div class="bg-gray-50 dark:bg-gray-800 rounded-xl p-8 mb-8">
          <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
            <!-- MCP Protocol -->
            <div class="text-center">
              <div class="w-16 h-16 bg-blue-100 dark:bg-blue-900 rounded-xl flex items-center justify-center mx-auto mb-4">
                <svg class="w-8 h-8 text-blue-600 dark:text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                </svg>
              </div>
              <h3 class="text-lg font-semibold text-gray-800 dark:text-gray-100 mb-2">MCP Protocol</h3>
              <p class="text-gray-600 dark:text-gray-400 text-sm">Standardized communication with AI systems</p>
            </div>

            <!-- CourtListener API -->
            <div class="text-center">
              <div class="w-16 h-16 bg-purple-100 dark:bg-purple-900 rounded-xl flex items-center justify-center mx-auto mb-4">
                <svg class="w-8 h-8 text-purple-600 dark:text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4" />
                </svg>
              </div>
              <h3 class="text-lg font-semibold text-gray-800 dark:text-gray-100 mb-2">CourtListener API</h3>
              <p class="text-gray-600 dark:text-gray-400 text-sm">Direct access to legal database</p>
            </div>

            <!-- AI Systems -->
            <div class="text-center">
              <div class="w-16 h-16 bg-green-100 dark:bg-green-900 rounded-xl flex items-center justify-center mx-auto mb-4">
                <svg class="w-8 h-8 text-green-600 dark:text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />
                </svg>
              </div>
              <h3 class="text-lg font-semibold text-gray-800 dark:text-gray-100 mb-2">AI Systems</h3>
              <p class="text-gray-600 dark:text-gray-400 text-sm">Claude, ChatGPT, and other LLMs</p>
            </div>
          </div>
        </div>
      </section>

      <!-- Impact -->
      <section class="mb-16">
        <h2 class="text-3xl font-bold mb-8 text-gray-900 dark:text-white">Impact</h2>
        <div class="prose prose-lg prose-gray dark:prose-invert max-w-none">
          <p class="text-xl leading-relaxed text-gray-700 dark:text-gray-300 mb-8">
            By providing AI systems with access to authoritative legal data, <strong>courtlistener-mcp</strong> helps ensure that AI-assisted legal research is both <em>powerful</em> and <em>trustworthy</em>.
          </p>
          
          <!-- Impact Metrics -->
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
            <div class="bg-blue-50 dark:bg-blue-900/20 border border-blue-200 dark:border-blue-800 rounded-xl p-6 text-center">
              <div class="text-3xl font-bold text-blue-600 dark:text-blue-400 mb-2">99.9%</div>
              <div class="text-sm text-blue-700 dark:text-blue-300">Data Accuracy</div>
            </div>
            <div class="bg-green-50 dark:bg-green-900/20 border border-green-200 dark:border-green-800 rounded-xl p-6 text-center">
              <div class="text-3xl font-bold text-green-600 dark:text-green-400 mb-2">10M+</div>
              <div class="text-sm text-green-700 dark:text-green-300">Legal Documents</div>
            </div>
            <div class="bg-purple-50 dark:bg-purple-900/20 border border-purple-200 dark:border-purple-800 rounded-xl p-6 text-center">
              <div class="text-3xl font-bold text-purple-600 dark:text-purple-400 mb-2">Real-time</div>
              <div class="text-sm text-purple-700 dark:text-purple-300">Data Updates</div>
            </div>
            <div class="bg-amber-50 dark:bg-amber-900/20 border border-amber-200 dark:border-amber-800 rounded-xl p-6 text-center">
              <div class="text-3xl font-bold text-amber-600 dark:text-amber-400 mb-2">100%</div>
              <div class="text-sm text-amber-700 dark:text-amber-300">Open Source</div>
            </div>
          </div>
        </div>
      </section>

      <!-- Getting Started -->
      <section class="mb-16">
        <h2 class="text-3xl font-bold mb-8 text-gray-900 dark:text-white">Getting Started</h2>
        <div class="bg-gray-50 dark:bg-gray-800 rounded-xl p-8">
          <div class="prose prose-lg prose-gray dark:prose-invert max-w-none">
            <p class="text-lg leading-relaxed text-gray-700 dark:text-gray-300 mb-6">
              Ready to enhance your AI legal research with verified court data? Visit the project repository to learn more about installation, configuration, and usage.
            </p>
            
            <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
              <a 
                href="https://github.com/blakeox/courtlistener-mcp" 
                target="_blank" 
                rel="noopener noreferrer"
                class="inline-flex items-center px-6 py-3 bg-accent hover:bg-accent-dark text-white font-semibold rounded-lg transition-colors duration-200 shadow-lg hover:shadow-xl transform hover:-translate-y-1"
              >
                <svg class="w-5 h-5 mr-2" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
                </svg>
                View on GitHub
              </a>
              
              <a 
                href="https://github.com/blakeox/courtlistener-mcp#installation" 
                target="_blank" 
                rel="noopener noreferrer"
                class="inline-flex items-center px-6 py-3 bg-transparent border-2 border-accent text-accent hover:bg-accent hover:text-white font-semibold rounded-lg transition-all duration-200"
              >
                <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                </svg>
                Installation Guide
              </a>
            </div>
          </div>
        </div>
      </section>

      <!-- Call to Action -->
      <section class="text-center py-16 border-t border-gray-200 dark:border-gray-700">
        <div class="max-w-2xl mx-auto">
          <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-4">
            Ready to Transform Your Legal Research?
          </h2>
          <p class="text-lg text-gray-600 dark:text-gray-400 mb-8">
            Join the movement toward trustworthy AI-assisted legal research with courtlistener-mcp.
          </p>
          <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <a 
              href="/contact" 
              class="inline-flex items-center px-6 py-3 bg-accent hover:bg-accent-dark text-white font-semibold rounded-lg transition-colors duration-200"
            >
              Get In Touch
            </a>
            <a 
              href="/blog" 
              class="inline-flex items-center px-6 py-3 bg-transparent border-2 border-gray-300 dark:border-gray-600 text-gray-700 dark:text-gray-300 hover:border-accent hover:text-accent font-semibold rounded-lg transition-all duration-200"
            >
              Read More Articles
            </a>
          </div>
        </div>
      </section>

    </div>
  </article>
</Layout>

<style>
/* Animation styles */
@keyframes fadeIn {
  from { opacity: 0; transform: translateY(16px); }
  to { opacity: 1; transform: none; }
}

.animate-fade-in {
  opacity: 1;
  animation: fadeIn 1s cubic-bezier(0.4,0,0.2,1) both;
}

/* Enhanced prose styles */
.prose {
  line-height: 1.75;
}

.prose h2 {
  margin-top: 2rem;
  margin-bottom: 1rem;
}

.prose h3 {
  margin-top: 1.5rem;
  margin-bottom: 0.75rem;
}

/* Enhanced button hover effects */
a.inline-flex:hover {
  transform: translateY(-2px);
}

/* Focus styles for better accessibility */
a:focus {
  outline: 2px solid var(--color-accent);
  outline-offset: 2px;
}

/* Reduced motion support */
@media (prefers-reduced-motion: reduce) {
  .animate-fade-in,
  a.inline-flex:hover {
    animation: none;
    transform: none;
    transition: none;
  }
}

/* Enhanced spacing for mobile */
@media (max-width: 768px) {
  .prose {
    font-size: 1rem;
  }
  
  .prose h2 {
    font-size: 1.5rem;
  }
  
  .prose h3 {
    font-size: 1.25rem;
  }
}
</style>