---
import Layout from '@/layouts/BaseLayout.astro';
import OptimizedImage from '@/components/primitives/OptimizedImage.astro';
import Badge from '@/components/primitives/Badge.astro';
import Container from '@/components/primitives/Container.astro';
import Stack from '@/components/primitives/Stack.astro';
import Flex from '@/components/primitives/Flex.astro';
import Prose from '@/components/primitives/Prose.astro';
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import {
  createArticleSchema,
  createBreadcrumbListSchema,
  defaultAuthor,
} from '@/utils/structuredData';
import { headingSizeClass } from '@/lib/typeScale';
import { isPublished } from '@/lib/content/publication-contract.mjs';
import RelatedContent from '@/components/features/content/RelatedContent.astro';
import { CONTENT_RELATIONSHIPS } from '@/config/content-architecture';
import { formatDateFull } from '@/utils/date';
import { resolvePublicImage } from '@/lib/media/publicAssetExists';

export async function getStaticPaths() {
  const posts = await getCollection('blog', (entry: CollectionEntry<'blog'>) => isPublished(entry));
  return posts.map((entry: CollectionEntry<'blog'>) => ({
    params: { slug: entry.id },
  }));
}

const { slug } = Astro.params;

if (!slug) {
  return Astro.redirect('/blog');
}

const posts = await getCollection('blog', (entry: CollectionEntry<'blog'>) => isPublished(entry));
const post = posts.find((entry: CollectionEntry<'blog'>) => entry.id === slug);

if (!post) {
  return Astro.redirect('/blog');
}
const { Content } = await render(post);
const heroImage = post.data.heroImage;
const photo = resolvePublicImage(heroImage);
const siteOrigin = Astro.site?.origin ?? 'https://blakeoxford.com';
const canonicalUrl = `${siteOrigin.replace(/\/$/, '')}/blog/${post.id}/`;
const formattedDate = formatDateFull(post.data.pubDate);
const hasMaterialUpdate =
  post.data.updatedDate && post.data.updatedDate.getTime() > post.data.pubDate.getTime();

// Generate structured data
const articleImage = heroImage
  ? heroImage.startsWith('http')
    ? heroImage
    : `${siteOrigin}${heroImage.startsWith('/') ? heroImage : `/${heroImage}`}`
  : undefined;

const articleAuthor =
  post.data.author === defaultAuthor.name
    ? defaultAuthor
    : { '@type': 'Person' as const, name: post.data.author };

const articleSchema = createArticleSchema(post.data.title, articleAuthor, post.data.pubDate, {
  description: post.data.description ?? undefined,
  dateModified: post.data.updatedDate,
  image: articleImage,
  url: canonicalUrl,
  publisher: defaultAuthor,
});

const breadcrumbSchema = createBreadcrumbListSchema([
  { name: 'Home', url: `${siteOrigin}/` },
  { name: 'Blog', url: `${siteOrigin}/blog/` },
  { name: post.data.title, url: canonicalUrl },
]);

const structuredData = [articleSchema, breadcrumbSchema];
---

<Layout
  title={post.data.title}
  description={post.data.description ?? post.data.title}
  seoTitle={post.data.seoTitle ?? post.data.title}
  seoDescription={post.data.seoDescription ?? post.data.description}
  url={canonicalUrl}
  image={articleImage}
  imageAlt={`${post.data.title} — Blake Oxford`}
  ogType="article"
  structuredData={structuredData}
  wide={true}
>
  <header class="relative isolate overflow-hidden border-b border-border/40">
    <div
      class:list={[
        'flex flex-col',
        photo && 'lg:grid lg:min-h-[calc(100svh-var(--nav-height))] lg:grid-cols-2',
      ]}
    >
      <div class="layout-gutter flex flex-col justify-center py-section-lg sm:py-section-xl lg:py-section-2xl">
        <Stack space="lg" class="max-w-xl">
          <Flex
            wrap
            gap="xs"
            class="text-xs font-semibold tracking-label text-subtle-foreground uppercase"
          >
            {post.data.tags?.map((tag: string) => (
              <Badge variant="pill" size="xs">
                {tag}
              </Badge>
            ))}
          </Flex>
          <h1
            class:list={[
              'font-heading font-semibold tracking-tight text-foreground',
              headingSizeClass('hero'),
            ]}
          >
            {post.data.title}
          </h1>
          <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-muted-foreground">
            <span>By {post.data.author}</span>
            <span aria-hidden="true">·</span>
            <time datetime={post.data.pubDate.toISOString()}>Published on {formattedDate}</time>
            {hasMaterialUpdate && post.data.updatedDate && (
              <>
                <span aria-hidden="true">·</span>
                <time datetime={post.data.updatedDate.toISOString()}>
                  Updated on {formatDateFull(post.data.updatedDate)}
                </time>
              </>
            )}
          </div>
        </Stack>
      </div>
      {photo && (
        <figure class="relative min-h-72 overflow-hidden lg:h-full">
          <OptimizedImage
            src={photo}
            alt={`Hero image for ${post.data.title}`}
            width={960}
            height={1200}
            class="size-full min-h-72 object-cover lg:absolute lg:inset-0 lg:h-full lg:min-h-full"
            loading="eager"
            priority={true}
          />
          <div
            class="pointer-events-none absolute inset-0 hidden bg-gradient-to-r from-background via-background/20 to-transparent lg:block"
            aria-hidden="true"
          ></div>
        </figure>
      )}
    </div>
  </header>

  <Container size="xl" class="py-section-lg sm:py-section-xl lg:py-section-2xl">
    <Stack space="3xl">
      <Prose>
        <Content />
      </Prose>
      <RelatedContent links={CONTENT_RELATIONSHIPS[canonicalUrl.replace(siteOrigin, '')] ?? []} />
    </Stack>
  </Container>
</Layout>
