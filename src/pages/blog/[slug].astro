---
import Layout from '@/layouts/BaseLayout.astro';
import OptimizedImage from '@/components/primitives/OptimizedImage.astro';
import Container from '@/components/primitives/Container.astro';
import Stack from '@/components/primitives/Stack.astro';
import Flex from '@/components/primitives/Flex.astro';
import Prose from '@/components/primitives/Prose.astro';
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import {
  createArticleSchema,
  createBreadcrumbListSchema,
  defaultAuthor,
} from '@/utils/structuredData';
import { headingSizeClass } from '@/lib/typeScale';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }: CollectionEntry<'blog'>) => !data.draft);
  return posts.map((entry: CollectionEntry<'blog'>) => ({
    params: { slug: entry.id },
  }));
}

const { slug } = Astro.params;

if (!slug) {
  return Astro.redirect('/blog');
}

const posts = await getCollection('blog', ({ data }: CollectionEntry<'blog'>) => !data.draft);
const post = posts.find((entry: CollectionEntry<'blog'>) => entry.id === slug);

if (!post) {
  return Astro.redirect('/blog');
}
const { Content } = await render(post);
const heroImage = post.data.heroImage;
const siteOrigin = Astro.site?.origin ?? 'https://blakeoxford.com';
const canonicalUrl = `${siteOrigin.replace(/\/$/, '')}/blog/${post.id}/`;
const formattedDate = post.data.pubDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

// Generate structured data
const articleImage = heroImage
  ? heroImage.startsWith('http')
    ? heroImage
    : `${siteOrigin}${heroImage.startsWith('/') ? heroImage : `/${heroImage}`}`
  : undefined;

const articleSchema = createArticleSchema(post.data.title, defaultAuthor, post.data.pubDate, {
  description: post.data.description ?? undefined,
  dateModified: post.data.updatedDate,
  image: articleImage,
  url: canonicalUrl,
  publisher: defaultAuthor,
});

const breadcrumbSchema = createBreadcrumbListSchema([
  { name: 'Home', url: `${siteOrigin}/` },
  { name: 'Blog', url: `${siteOrigin}/blog/` },
  { name: post.data.title, url: canonicalUrl },
]);

const structuredData = [articleSchema, breadcrumbSchema];
---

<Layout
  title={post.data.title}
  description={post.data.description ?? post.data.title}
  url={canonicalUrl}
  image={articleImage}
  structuredData={structuredData}
  wide={true}
>
  <Container size="xl" class="py-16 sm:py-20 lg:py-24">
    <Stack space="3xl">
      <Stack space="lg" as="header">
        <Flex
          wrap
          gap="xs"
          class="text-xs font-semibold tracking-label text-subtle-foreground uppercase"
        >
          {
            post.data.tags?.map((tag: string) => (
              <span class="rounded-full bg-surface-subtle px-3 py-1 ring-1 ring-border/40">
                {tag}
              </span>
            ))
          }
        </Flex>
        <h1
          class:list={[
            'font-heading font-semibold tracking-tight text-foreground',
            headingSizeClass('hero'),
          ]}
        >
          {post.data.title}
        </h1>
        <time
          datetime={post.data.pubDate.toISOString()}
          class="block text-sm text-muted-foreground"
        >
          Published on {formattedDate}
        </time>
        {
          heroImage && (
            <div class="mt-10">
              <OptimizedImage
                src={heroImage}
                alt={`Hero image for ${post.data.title}`}
                class="max-h-[500px] w-full rounded-2xl object-cover lg:max-h-[600px]"
                loading="eager"
                priority={true}
              />
            </div>
          )
        }
      </Stack>

      <Prose>
        <Content />
      </Prose>
    </Stack>
  </Container>
</Layout>
