---
import Layout from '../../layouts/BaseLayout.astro';
import OptimizedImage from '../../components/primitives/OptimizedImage.astro';
import Container from '../../components/primitives/Container.astro';
import Stack from '../../components/primitives/Stack.astro';
import Flex from '../../components/primitives/Flex.astro';
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import { createArticleSchema, createBreadcrumbListSchema, defaultAuthor } from '../../utils/structuredData';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }: CollectionEntry<'blog'>) => !data.draft);
  // Exclude slugs that are implemented as a static .astro page to prevent route conflicts
  const STATIC_SLUGS = new Set([
    'combating-legal-ai-hallucinations',
    'hello-world',
  ]);
  return posts
    .filter((entry: CollectionEntry<'blog'>) => !STATIC_SLUGS.has(entry.id))
    .map((entry: CollectionEntry<'blog'>) => ({
      params: { slug: entry.id },
    }));
}

const { slug } = Astro.params;

if (!slug) {
  return Astro.redirect('/blog');
}

const posts = await getCollection('blog', ({ data }: CollectionEntry<'blog'>) => !data.draft);
const post = posts.find((entry: CollectionEntry<'blog'>) => entry.id === slug);

if (!post) {
  return Astro.redirect('/blog');
}
const { Content } = await render(post);
const heroImage = post.data.heroImage;
const siteOrigin = Astro.site?.origin ?? 'https://blakeoxford.com';
const canonicalUrl = `${siteOrigin.replace(/\/$/, '')}/blog/${post.id}/`;
const formattedDate = post.data.pubDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric'
});

// Generate structured data
const articleImage = heroImage 
  ? (heroImage.startsWith('http') ? heroImage : `${siteOrigin}${heroImage.startsWith('/') ? heroImage : `/${heroImage}`}`)
  : undefined;

const articleSchema = createArticleSchema(
  post.data.title,
  defaultAuthor,
  post.data.pubDate,
  {
    description: post.data.description ?? undefined,
    dateModified: post.data.updatedDate,
    image: articleImage,
    url: canonicalUrl,
    publisher: defaultAuthor,
  }
);

const breadcrumbSchema = createBreadcrumbListSchema([
  { name: 'Home', url: `${siteOrigin}/` },
  { name: 'Blog', url: `${siteOrigin}/blog/` },
  { name: post.data.title, url: canonicalUrl },
]);

const structuredData = [articleSchema, breadcrumbSchema];
---

<Layout
  title={post.data.title}
  description={post.data.description ?? post.data.title}
  url={canonicalUrl}
  image={articleImage}
  structuredData={structuredData}
  wide={true}
>
  <Container size="full" class="py-16 sm:py-20 lg:py-24">
    <Stack space="3xl" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <Stack space="lg" as="header">
      <Flex wrap gap="xs" class="text-xs font-semibold uppercase tracking-label text-foreground/60 dark:text-foreground-light/60">
        {post.data.tags?.map((tag: string) => (
          <span class="rounded-full bg-surface-subtle px-3 py-1 ring-1 ring-border/40 dark:bg-surface-dark-subtle">
            {tag}
          </span>
        ))}
      </Flex>
      <h1 class="font-heading text-4xl sm:text-5xl md:text-6xl font-bold leading-tight text-foreground dark:text-foreground-light">
        {post.data.title}
      </h1>
      <time datetime={post.data.pubDate.toISOString()} class="block text-sm text-foreground/70 dark:text-foreground-light/70">
        Published on {formattedDate}
      </time>
      {heroImage && (
        <div class="mt-10">
          <OptimizedImage
            src={heroImage}
            alt={`Hero image for ${post.data.title}`}
            class="w-full max-h-[500px] lg:max-h-[600px] rounded-2xl object-cover"
            loading="eager"
            priority={true}
          />
        </div>
      )}
      </Stack>

      <div class="@container prose prose-lg lg:prose-xl max-w-none text-foreground/90 dark:prose-invert 
        prose-headings:font-heading prose-headings:font-bold prose-headings:tracking-tight
        prose-h1:text-5xl prose-h1:mb-8
        prose-h2:text-4xl prose-h2:mt-16 prose-h2:mb-8
        prose-h3:text-3xl prose-h3:mt-10 prose-h3:mb-5
        prose-p:text-lg prose-p:leading-relaxed prose-p:mb-6
        prose-li:text-lg prose-li:leading-relaxed
        prose-a:text-accent prose-a:no-underline hover:prose-a:underline
        prose-strong:text-foreground prose-strong:font-semibold
        prose-code:text-accent prose-code:bg-surface-subtle prose-code:px-1.5 prose-code:py-0.5 prose-code:rounded
        dark:prose-headings:text-foreground-light
        dark:prose-p:text-foreground-light/90
        dark:prose-li:text-foreground-light/90
        dark:prose-strong:text-foreground-light
        dark:prose-code:bg-surface-dark-subtle">
        <Content />
      </div>
    </Stack>
  </Container>
</Layout>
