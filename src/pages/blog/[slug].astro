---
import Layout from '../../layouts/BaseLayout.astro';
import OptimizedImage from '../../components/ui/OptimizedImage.astro';
import Container from '../../components/primitives/Container.astro';
import Stack from '../../components/primitives/Stack.astro';
import Flex from '../../components/primitives/Flex.astro';
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }: { data: any }) => !data.draft);
  // Exclude slugs that are implemented as a static .astro page to prevent route conflicts
  const STATIC_SLUGS = new Set([
    'combating-legal-ai-hallucinations',
  ]);
  return posts
    .filter(({ slug }: { slug: string }) => !STATIC_SLUGS.has(slug))
    .map(({ slug }: { slug: string }) => ({
      params: { slug },
    }));
}

const { slug } = Astro.params;

if (!slug) {
  return Astro.redirect('/blog');
}

const posts = await getCollection('blog', ({ data }: { data: any }) => !data.draft);
const post = posts.find((entry: CollectionEntry<'blog'>) => entry.slug === slug);

if (!post) {
  return Astro.redirect('/blog');
}
const { Content } = await post.render();
const heroImage = post.data.heroImage ?? '/assets/images/og-image.jpg';
const siteOrigin = Astro.site?.origin ?? 'https://blakeoxford.com';
const canonicalUrl = `${siteOrigin.replace(/\/$/, '')}/blog/${post.slug}/`;
const formattedDate = post.data.pubDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric'
});
---

<Layout
  title={post.data.title}
  description={post.data.description ?? post.data.title}
  url={canonicalUrl}
  wide={true}
>
  <Container size="lg" class="py-16 sm:py-20 lg:py-24">
    <Stack space="3xl">
      <Stack space="lg" as="header">
      <Flex wrap gap="xs" class="text-xs font-semibold uppercase tracking-label text-foreground/60 dark:text-foreground-light/60">
        {post.data.tags?.map((tag: string) => (
          <span class="rounded-full bg-surface-subtle px-3 py-1 ring-1 ring-border/35 dark:bg-surface-dark-subtle">
            {tag}
          </span>
        ))}
      </Flex>
      <h1 class="font-heading text-4xl sm:text-5xl md:text-6xl font-bold leading-tight text-foreground dark:text-foreground-light">
        {post.data.title}
      </h1>
      <time datetime={post.data.pubDate.toISOString()} class="block text-sm text-foreground/70 dark:text-foreground-light/70">
        Published on {formattedDate}
      </time>
      <div class="mt-10">
        <OptimizedImage
          src={heroImage}
          alt={`Hero image for ${post.data.title}`}
          class="w-full max-h-[500px] lg:max-h-[600px] rounded-2xl object-cover"
          loading="eager"
          priority={true}
        />
      </div>
      </Stack>

      <div class="@container prose prose-lg lg:prose-xl max-w-none text-foreground/90 dark:prose-invert [@media(min-width:640px)]:prose-xl [@media(min-width:1024px)]:prose-2xl">
        <Content />
      </div>
    </Stack>
  </Container>
</Layout>
