---
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

import Layout from '../../layouts/BaseLayout.astro';
import BlogIndexHeroSection from '../../components/features/blog/BlogIndexHeroSection.astro';
import BlogIndexContentSection from '../../components/features/blog/BlogIndexContentSection.astro';

const posts = await getCollection('blog', ({ data }: CollectionEntry<'blog'>) => !data.draft);
const sortedPosts = posts
  .slice()
  .sort(
    (a: CollectionEntry<'blog'>, b: CollectionEntry<'blog'>) =>
      b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
  );
---

<Layout
  title="Insights & Updates"
  description="Thoughts on automation, analytics, and leadership-grounded in hands-on work and delivered with practical takeaways."
  wide
>
  <BlogIndexHeroSection />
  <BlogIndexContentSection posts={sortedPosts} />
</Layout>
