---
import { getCollection } from 'astro:content';

import Layout from '@/layouts/BaseLayout.astro';
import BlogIndexHeroSection from '@/components/features/blog/BlogIndexHeroSection.astro';
import BlogIndexContentSection from '@/components/features/blog/BlogIndexContentSection.astro';
import { getBlogListing } from '@/content/blog/getBlogListing';
import { resolvePublicImage } from '@/lib/media/publicAssetExists';

const posts = await getCollection('blog');
const { featuredPost, archivePosts } = getBlogListing(posts);
const featuredImage = resolvePublicImage(featuredPost?.data.heroImage);
---

<Layout
  title="Notes from the field | Blake Oxford"
  description="Practical writing on navigating AI, building trust, and connecting adoption to enterprise systems and everyday work."
  wide
>
  {featuredImage ? (
    <link slot="head" rel="preload" as="image" href={featuredImage} fetchpriority="high" />
  ) : null}
  <BlogIndexHeroSection post={featuredPost} imageSrc={featuredImage} />
  <BlogIndexContentSection posts={archivePosts} hasFeatured={Boolean(featuredPost)} />
</Layout>
