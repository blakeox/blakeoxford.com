---
import Layout from '../../layouts/BaseLayout.astro';
import { BlogPostRow } from '../../components/features/blog';
import Stack from '../../components/primitives/Stack.astro';
import Section from '../../components/primitives/Section.astro';
import Flex from '../../components/primitives/Flex.astro';
import Button from '../../components/primitives/Button.astro';
import Hero from '../../components/composites/Hero.astro';
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

const posts = await getCollection('blog', ({ data }: { data: any }) => !data.draft);
const sortedPosts = posts
  .slice()
  .sort((a: CollectionEntry<'blog'>, b: CollectionEntry<'blog'>) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---
<Layout
  title="Insights & Updates"
  description="Thoughts on automation, analytics, and leadership—grounded in hands-on work and delivered with practical takeaways."
  wide
>
  <Hero 
    title="Fresh thinking, built on shipped work"
    subtitle="Every article explores real-world systems leadership—translating complex automation, data, and change programs into momentum you can measure."
    background="gradient"
    size="lg"
    padding="xl"
    spacing="2xl"
    align="left"
  />

  <!-- Blog Filter/Search Section -->
  {sortedPosts.length > 0 && (
    <Section padding="md" container="lg" class="border-t border-border/20 bg-surface-subtle/40">
        <Flex responsive="sm" gap="md" justify="between" align="center">
          <Flex wrap gap="sm" align="center">
            <span class="inline-flex w-fit items-center gap-2 rounded-full bg-surface-subtle px-3 py-1 text-xxs font-semibold uppercase tracking-label text-foreground/65 ring-1 ring-border/35 dark:bg-surface-dark-subtle">
              {sortedPosts.length} {sortedPosts.length === 1 ? 'Article' : 'Articles'}
            </span>
            <p class="text-sm leading-relaxed text-foreground/80 dark:text-foreground-light/80">
              Latest insights and deep dives
            </p>
          </Flex>
          <Flex gap="sm" align="center">
            <Button
              variant="ghost"
              as="button"
              onclick="document.getElementById('search-overlay')?.setAttribute('data-state', 'open'); document.getElementById('search-overlay')?.removeAttribute('inert'); document.getElementById('search-input')?.focus();"
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-4.8-4.8M10.5 18a7.5 7.5 0 1 1 0-15 7.5 7.5 0 0 1 0 15Z" />
              </svg>
              Search articles
            </Button>
          </Flex>
        </Flex>
    </Section>
  )}

  <!-- Blog Posts Section -->
  <Section padding="lg" container="lg" class="border-t border-border/20 bg-background" role="region" aria-labelledby="blog-posts-heading">
    <Stack space="xl" class="text-pretty">
      {sortedPosts.length > 0 && (
        <Stack space="md" class="max-w-3xl">
          <h2 id="blog-posts-heading" class="font-heading text-2xl sm:text-3xl md:text-4xl font-semibold text-foreground dark:text-foreground-light">
            Latest Insights
          </h2>
          <p class="text-sm sm:text-base leading-relaxed text-foreground/80 dark:text-foreground-light/80">
            Practical takeaways from real-world implementations and strategic initiatives.
          </p>
        </Stack>
      )}
      <Stack space="xl">
        {sortedPosts.length > 0 ? (
          sortedPosts.map((post: CollectionEntry<'blog'>, index: number) => (
            <BlogPostRow post={post} align={index % 2 === 0 ? 'left' : 'right'} />
          ))
        ) : (
          <div class="rounded-3xl bg-surface/95 ring-1 ring-border/30 shadow-lg p-12 text-center">
            <h2 class="font-heading text-2xl sm:text-3xl font-semibold text-foreground dark:text-foreground-light mb-4">Articles are on the way</h2>
            <p class="text-sm leading-relaxed text-foreground/80 dark:text-foreground-light/80">
              Check back soon for breakdowns of recent programs, playbooks, and technical deep dives.
            </p>
          </div>
        )}
      </Stack>
    </Stack>
  </Section>
</Layout>
