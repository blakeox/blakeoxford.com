---
import Layout from '../../layouts/BaseLayout.astro';

const title = 'Hello World';
const description = 'My first blog post using Astro Content Collections and MDX.';
const pubDate = new Date('2025-05-19');
const canonicalUrl = 'https://blakeoxford.com/blog/hello-world/';
---

<Layout title={title} description={description} url={canonicalUrl} wide>
  <!-- Blog Post Hero Banner -->
  <section class="relative overflow-hidden py-16 md:py-24 bg-gradient-to-br from-background via-accent/5 to-background">
    <!-- Animated SVG background pattern -->
    <div class="absolute inset-0 z-0 opacity-20 pointer-events-none">
      <svg class="absolute inset-0 w-full h-full" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <pattern id="blog-hero-grid" width="40" height="40" patternUnits="userSpaceOnUse">
            <path d="M0 40L40 0M20 40L40 20M0 20L20 0" fill="none" stroke="currentColor" stroke-width="1" stroke-opacity="0.12" />
          </pattern>
        </defs>
        <rect width="100%" height="100%" fill="url(#blog-hero-grid)" />
      </svg>
    </div>
    <div class="container mx-auto max-w-screen-xl px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="flex flex-col items-center text-center">
        <h1 class="font-heading font-bold text-4xl sm:text-5xl md:text-6xl text-accent dark:text-accent-light mb-4">{title}</h1>
        <p class="text-lg text-foreground/85 dark:text-gray-300 mb-2 animate-fade-in">{description}</p>
        <time class="text-sm text-foreground/70 dark:text-gray-400 mb-2" datetime={pubDate.toISOString()}>
          {pubDate.toLocaleDateString(undefined, { year: 'numeric', month: 'short', day: 'numeric' })}
        </time>
      </div>
    </div>
    <!-- Decorative SVG divider -->
    <div aria-hidden="true" class="w-full overflow-hidden pointer-events-none mt-8">
      <svg viewBox="0 0 1440 80" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full h-16 md:h-20 lg:h-24">
        <path fill="currentColor" fill-opacity="0.08" d="M0,32 C360,80 1080,0 1440,48 L1440,80 L0,80 Z" />
      </svg>
    </div>
  </section>
  
  <article class="prose c-blog-detail px-4 md:px-12 lg:px-32 py-12">
    <h2 class="font-heading font-bold text-3xl md:text-4xl text-accent dark:text-accent-light mb-4">Blog Post</h2>
    <p class="mb-6 text-foreground/80 dark:text-gray-400">{description}</p>
    
    <div class="prose dark:prose-invert max-w-none">
      <h2>Introduction</h2>
      <p>This is a sample blog post written in MDX. You can use <strong>Markdown</strong> and embed components!</p>
    </div>
  </article>
</Layout> 