---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Section from '@/components/primitives/Section.astro';
import Button from '@/components/primitives/Button.astro';
import { headingSizeClass } from '@/lib/typeScale';

const shortcuts = [
  {
    category: 'Navigation',
    items: [
      { key: 'Tab', description: 'Move forward through interactive elements' },
      { key: 'Shift + Tab', description: 'Move backward through interactive elements' },
      { key: 'Enter', description: 'Activate focused link or button' },
      { key: 'Space', description: 'Activate focused button or checkbox' },
    ],
  },
  {
    category: 'Skip Links',
    items: [
      {
        key: 'Tab',
        description:
          'From the start of the page, reveal links to main content, the footer, and the top.',
      },
      { key: 'Enter', description: 'Activate the focused skip link.' },
    ],
  },
  {
    category: 'Search',
    items: [
      { key: 'Cmd/Ctrl + K', description: 'Open search overlay' },
      { key: 'Escape', description: 'Close search overlay' },
      { key: 'Arrow Up/Down', description: 'Navigate search results' },
      { key: 'Enter', description: 'Go to selected result' },
      { key: 'Tab', description: 'Complete a matching title; otherwise move to the next control.' },
    ],
  },
  {
    category: 'Theme',
    items: [
      {
        key: 'Enter or Space',
        description: 'Activate the theme button in the header to switch between light and dark.',
      },
    ],
  },
  {
    category: 'Ask',
    items: [
      {
        key: 'Enter or Space',
        description: 'Activate the Ask button where the companion is available.',
      },
      { key: 'Escape', description: 'Close Ask' },
      { key: 'Enter (in input)', description: 'Send a question' },
    ],
  },
  {
    category: 'Page landmarks',
    items: [
      { key: 'Header (banner)', description: 'Navigate to site header' },
      { key: 'Main', description: 'Navigate to main content' },
      { key: 'Footer (contentinfo)', description: 'Navigate to footer' },
      { key: 'Navigation', description: 'Navigate to navigation menus' },
    ],
  },
];
---

<BaseLayout
  wide={true}
  title="Keyboard Shortcuts - Blake Oxford"
  description="Keyboard reference for navigation, search, display preferences, and Ask on blakeoxford.com."
  canonicalUrl="https://blakeoxford.com/accessibility/keyboard-shortcuts/"
  noindex={true}
>
  <Section padding="lg" container="xl" aria-labelledby="keyboard-heading">
    <header class="max-w-3xl">
      <p class="section-kicker mb-4">Accessibility</p>
      <h1
        id="keyboard-heading"
        class:list={[
          'font-heading font-semibold tracking-tight text-foreground-strong',
          headingSizeClass('hero'),
        ]}
      >
        Keyboard shortcuts
      </h1>
      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-muted-foreground">
        Move around, find a page, or ask a question. The focus indicator shows which control is
        ready.
      </p>
      <p class="mt-4 max-w-2xl text-sm leading-relaxed text-muted-foreground">
        In Safari on Mac, use <kbd class="font-mono text-xs font-semibold">Option + Tab</kbd> if Tab
        skips links.{' '}
        <a
          href="https://support.apple.com/guide/safari/keyboard-shortcuts-and-gestures-cpsh003/mac"
          class="underline decoration-border underline-offset-4 hover:text-accent"
        >
          Safari keyboard settings
        </a>
      </p>
    </header>

    <div class="mt-12 grid items-start gap-x-16 gap-y-12 md:grid-cols-2">
      {shortcuts.map((section, index) => (
        <section aria-labelledby={`shortcut-group-${index}`}>
          <h2
            id={`shortcut-group-${index}`}
            class:list={[
              'mb-5 font-heading font-semibold text-foreground-strong',
              headingSizeClass('title'),
            ]}
          >
            {section.category}
          </h2>
          {section.category === 'Page landmarks' && (
            <p class="mb-4 text-sm leading-relaxed text-muted-foreground">
              Landmark navigation keys depend on your screen reader.
            </p>
          )}
          <dl>
            {section.items.map((shortcut) => (
              <div
                data-chat-avoid-launcher
                class="grid gap-2 border-t border-border/60 py-4 sm:grid-cols-[9rem_minmax(0,1fr)] sm:gap-5"
              >
                <dt class="text-sm font-semibold text-foreground">
                  {section.category === 'Page landmarks' ? (
                    shortcut.key
                  ) : (
                    <kbd class="inline-flex rounded border border-border bg-surface px-2 py-1 font-mono text-xs leading-relaxed">
                      {shortcut.key}
                    </kbd>
                  )}
                </dt>
                <dd class="text-sm leading-relaxed text-muted-foreground">
                  {shortcut.description}
                </dd>
              </div>
            ))}
          </dl>
        </section>
      ))}
    </div>
  </Section>

  <Section
    padding="md"
    container="xl"
    class="border-t border-border"
    aria-labelledby="display-heading"
  >
    <div class="grid gap-8 md:grid-cols-2 md:gap-16">
      <div>
        <h2
          id="display-heading"
          class:list={[
            'font-heading font-semibold text-foreground-strong',
            headingSizeClass('title'),
          ]}
        >
          Display preferences
        </h2>
        <p class="mt-4 max-w-xl text-sm leading-relaxed text-muted-foreground">
          The theme button remembers your light or dark preference. Motion effects adapt to your
          device’s reduced-motion setting, and keyboard focus uses an outline in forced-colors mode.
        </p>
      </div>
      <div>
        <h2
          class:list={[
            'font-heading font-semibold text-foreground-strong',
            headingSizeClass('title'),
          ]}
        >
          Something getting in your way?
        </h2>
        <p class="mt-4 text-sm leading-relaxed text-muted-foreground">
          Tell me which page and control caused the problem, along with the browser or assistive
          technology you use.
        </p>
        <Button variant="primary" href="/contact/" class="mt-6" data-chat-avoid-launcher>
          Report an accessibility issue
        </Button>
      </div>
    </div>
  </Section>
</BaseLayout>
