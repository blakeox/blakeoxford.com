---
/**
 * Keyboard Shortcuts Documentation
 *
 * Comprehensive guide to keyboard navigation and shortcuts
 * available on the site for improved accessibility.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import Container from '@/components/primitives/Container.astro';
import Section from '@/components/primitives/Section.astro';
import { crossRendererSurfaceRecipe } from '@/lib/design-system/recipes';

const shortcuts = [
  {
    category: 'Navigation',
    items: [
      { key: 'Tab', description: 'Move forward through interactive elements' },
      { key: 'Shift + Tab', description: 'Move backward through interactive elements' },
      { key: 'Enter', description: 'Activate focused link or button' },
      { key: 'Space', description: 'Activate focused button or checkbox' },
      { key: 'Escape', description: 'Close modals, overlays, and dialogs' },
    ],
  },
  {
    category: 'Skip Links',
    items: [
      { key: 'Tab (from top)', description: 'Skip to main content' },
      { key: 'Tab (second)', description: 'Skip to footer' },
      { key: 'Tab (third)', description: 'Back to top link' },
    ],
  },
  {
    category: 'Search',
    items: [
      { key: 'Cmd/Ctrl + K', description: 'Open search overlay' },
      { key: 'Escape', description: 'Close search overlay' },
      { key: 'Arrow Up/Down', description: 'Navigate search results' },
      { key: 'Enter', description: 'Go to selected result' },
    ],
  },
  {
    category: 'Theme',
    items: [{ key: 'Click theme toggle', description: 'Switch between light and dark mode' }],
  },
  {
    category: 'Chat Widget',
    items: [
      { key: 'Click chat icon', description: 'Open AI chat widget' },
      { key: 'Escape', description: 'Close chat widget' },
      { key: 'Enter (in input)', description: 'Send message' },
    ],
  },
  {
    category: 'Landmarks (Screen Reader)',
    items: [
      { key: 'Header (banner)', description: 'Navigate to site header' },
      { key: 'Main', description: 'Navigate to main content' },
      { key: 'Footer (contentinfo)', description: 'Navigate to footer' },
      { key: 'Navigation', description: 'Navigate to navigation menus' },
    ],
  },
];
---

<BaseLayout
  title="Keyboard Shortcuts - Blake Oxford"
  description="Complete guide to keyboard navigation and shortcuts for improved accessibility on blakeoxford.com"
  canonicalUrl="https://blakeoxford.com/accessibility/keyboard-shortcuts/"
  noindex={true}
  keywords="keyboard shortcuts, accessibility, navigation, WCAG, a11y"
>
  <Section padding="xl">
    <Container size="lg">
      <!-- Header -->
      <div class="mb-12">
        <h1 class="mb-4 text-4xl font-bold text-foreground-strong sm:text-5xl">
          Keyboard Shortcuts
        </h1>
        <p class="max-w-2xl text-lg text-foreground">
          Navigate this site efficiently using keyboard shortcuts. Full keyboard support ensures
          accessibility for all users.
        </p>
      </div>

      <!-- Shortcuts by Category -->
      <div class="space-y-12">
        {
          shortcuts.map((section) => (
            <div>
              <h2 class="mb-6 border-b border-border pb-2 text-2xl font-semibold text-foreground-strong">
                {section.category}
              </h2>
              <div class="grid gap-4">
                {section.items.map((shortcut) => (
                  <div class="flex flex-col gap-3 rounded-lg border border-border bg-surface p-4 transition-colors hover:border-accent sm:flex-row sm:items-start">
                    <kbd class="inline-flex min-w-[120px] items-center justify-center rounded border border-border bg-background px-3 py-1.5 font-mono text-sm font-semibold whitespace-nowrap shadow-sm">
                      {shortcut.key}
                    </kbd>
                    <p class="flex-1 text-foreground">{shortcut.description}</p>
                  </div>
                ))}
              </div>
            </div>
          ))
        }
      </div>

      <!-- Additional Information -->
      <div class:list={['mt-16', crossRendererSurfaceRecipe.structural]}>
        <h2 class="mb-4 text-xl font-semibold text-foreground-strong">Accessibility Features</h2>
        <ul class="space-y-3 text-foreground">
          <li class="flex items-start gap-3">
            <span class="mt-1 text-accent">✓</span>
            <span><strong>WCAG AA Compliant:</strong> All colors meet 4.5:1 contrast ratio</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="mt-1 text-accent">✓</span>
            <span
              ><strong>Enhanced Focus Indicators:</strong> 3px outlines with shadow for clear visibility</span
            >
          </li>
          <li class="flex items-start gap-3">
            <span class="mt-1 text-accent">✓</span>
            <span
              ><strong>Screen Reader Support:</strong> Semantic HTML and ARIA labels throughout</span
            >
          </li>
          <li class="flex items-start gap-3">
            <span class="mt-1 text-accent">✓</span>
            <span><strong>Skip Links:</strong> Bypass navigation and jump to key content areas</span
            >
          </li>
          <li class="flex items-start gap-3">
            <span class="mt-1 text-accent">✓</span>
            <span><strong>Reduced Motion:</strong> Respects prefers-reduced-motion settings</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="mt-1 text-accent">✓</span>
            <span><strong>High Contrast Mode:</strong> Windows High Contrast Mode support</span>
          </li>
        </ul>
      </div>

      <!-- Feedback -->
      <div class="mt-12 text-center">
        <p class="mb-4 text-foreground">Have suggestions for improving accessibility?</p>
        <a
          href="/contact/"
          class="inline-flex items-center gap-2 rounded-lg bg-accent px-6 py-3 font-semibold text-on-accent transition-colors hover:bg-accent-dark focus-visible:ring-2 focus-visible:ring-accent/60 focus-visible:outline-none"
        >
          Get in Touch
        </a>
      </div>
    </Container>
  </Section>
</BaseLayout>

<style>
  kbd {
    font-family:
      ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, 'Liberation Mono', 'Courier New',
      monospace;
  }
</style>
