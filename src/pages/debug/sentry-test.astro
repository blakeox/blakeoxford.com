---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/primitives/Container.astro';

const title = 'Sentry Test Trigger';
const description = 'Debug page to manually trigger a test error for Sentry verification.';
---

<BaseLayout title={title} description={description} wide noindex>
  <Container size="sm" class="prose py-12">
    <h1>{title}</h1>
    <p class="!text-foreground">
      This page intentionally throws an error when you click the button below, so you can verify
      that browser events reach your Sentry project. In development, the event is suppressed.
    </p>

    <button
      id="trigger"
      class="inline-flex items-center rounded-md border-2 border-accent/60 px-3 py-2 font-semibold text-accent-emphasis shadow hover:border-accent focus:ring-2 focus:ring-accent focus:ring-offset-2 focus:outline-none"
    >
      Throw test error
    </button>

    <p id="status" class="mt-3 hidden text-success-emphasis">
      Test error thrown. Check Sentry in a few seconds.
    </p>

    <script is:inline>
      const btn = document.getElementById('trigger');
      if (btn) {
        btn.addEventListener('click', () => {
          try {
            throw new Error('Sentry Browser Test: manual trigger from /debug/sentry-test');
          } catch (err) {
            const statusEl = document.getElementById('status');
            if (statusEl) statusEl.classList.remove('hidden');
            // Re-throw for global error handlers (captured by Sentry in production)
            setTimeout(() => {
              throw err;
            }, 0);
          }
        });
      }
    </script>
  </Container>
</BaseLayout>
