                  />
                ) : srcStr ? (
                  <img src={srcStr} alt={tech.alt} width={64} height={64} class="w-full h-full object-contain" loading="lazy" />
                ) : (
                  <span class="text-2xl" aria-label={tech.name}>?</span>
                )}
              </div>
              <span class="group-hover:text-accent transition-colors">{tech.name}</span>
            </li>
          );
        })}
      </ul>
    </section>

    <!-- Featured Projects Section -->
  <section id="featured-projects" class="container mx-auto px-6 sm:px-8 lg:px-12" aria-labelledby="featured-projects-title">
  <h2 id="featured-projects-title" class="text-h2 font-bold mb-8 text-foreground dark:text-foreground-light text-center">Featured Projects</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {featuredProjects.map((project: any) => (
          <ProjectCard project={project} featured={true} />
        ))}
      </div>        <div class="mt-8 text-center">
          <a href="/projects/" class="inline-flex items-center justify-center gap-2 rounded-full border-2 border-accent/60 px-6 sm:px-7 py-3 text-sm font-semibold text-accent transition-all duration-200 hover:text-accent-dark hover:border-accent focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent/60 focus-visible:ring-offset-2">View All Projects</a>
        </div>
    </section>

    <!-- Latest Blog Posts Section -->
  <section class="w-full py-20 text-center bg-gradient-to-r from-background via-surface to-background dark:from-background-dark dark:via-surface-dark dark:to-background-dark" aria-labelledby="latest-blog-posts">
  <div class="container mx-auto px-6 sm:px-8 lg:px-12">
  <h2 id="latest-blog-posts" class="text-h2 font-bold mb-8 text-foreground dark:text-foreground-light">Latest Blog Posts</h2>
        <ul class="grid grid-cols-1 gap-8 md:grid-cols-2 xl:grid-cols-3" role="list">
          {recentBlogPosts.length > 0 ? (
            recentBlogPosts.map((post) => (
              <li class="group flex h-full flex-col rounded-2xl border border-border/40 bg-surface/95 p-6 shadow-xl transition-transform duration-200 hover:-translate-y-1 hover:shadow-2xl dark:bg-surface/80 dark:border-border-dark/40" role="listitem">
                <a href={`/blog/${post.slug}/`} class="flex h-full flex-col gap-4 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent/65 focus-visible:ring-offset-2">
                  <header class="space-y-2">
                    <time class="inline-flex items-center gap-2 text-xs font-semibold uppercase tracking-[0.3em] text-foreground/55 dark:text-foreground-light/60" datetime={post.data.pubDate.toISOString()}>
                      <span class="inline-flex h-1.5 w-1.5 rounded-full bg-accent"></span>
                      {post.data.pubDate.toLocaleDateString('en-US', {
                        year: 'numeric',
                        month: 'long',
                        day: 'numeric'
                      })}
                    </time>
                    <h3 class="text-xl font-semibold leading-snug text-foreground transition-colors duration-200 group-hover:text-accent dark:text-foreground-light">
                      {post.data.title}
                    </h3>
                  </header>

                  {post.data.description && (
                    <p class="text-sm leading-relaxed text-foreground/75 dark:text-foreground-light/75">
                      {post.data.description}
                    </p>
                  )}

                  {post.data.tags && post.data.tags.length > 0 && (
                    <ul class="mt-auto flex flex-wrap gap-2 text-[0.65rem] font-semibold uppercase tracking-[0.25em] text-foreground/55 dark:text-foreground-light/60" aria-label="Post tags" role="list">
                      {post.data.tags.slice(0, 3).map((tag) => (
                        <li class="rounded-full bg-background/90 px-3 py-1 ring-1 ring-border/30 dark:bg-background-dark/70" role="listitem">
                          {tag}
                        </li>
                      ))}
                      {post.data.tags.length > 3 && (
                        <li class="rounded-full bg-background/80 px-3 py-1 ring-1 ring-border/20 text-foreground/50 dark:bg-background-dark/60 dark:text-foreground-light/55" role="listitem">
                          +{post.data.tags.length - 3}
                        </li>
                      )}
                    </ul>
                  )}

                  <span class="mt-4 inline-flex items-center gap-2 text-sm font-semibold text-accent transition-transform duration-200 group-hover:translate-x-1">
                    Read article
                    <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M5 12h14m-6-6 6 6-6 6" />
                    </svg>
                  </span>
                </a>
              </li>
            ))
          ) : (
            <li class="rounded-2xl border border-dashed border-border/40 bg-background/90 p-6 text-center shadow-md dark:bg-background-dark/80">
              <p class="text-sm text-foreground/70 dark:text-foreground-light/70">
                Blog posts are on the way—check back soon for new case studies and playbooks.
              </p>
            </li>
          )}
        </ul>
        <div class="mt-8 text-center">
          <a href="/blog/" class="inline-flex items-center justify-center gap-2 rounded-full bg-accent px-6 sm:px-7 py-3 text-sm font-semibold text-on-accent shadow-lg shadow-accent/30 transition-colors duration-200 hover:bg-accent-dark focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent/65 focus-visible:ring-offset-2">View All Blog Posts</a>
        </div>
      </div>
    </section>

    <!-- Call-to-Action Section -->
  <section class="container mx-auto px-6 sm:px-8 lg:px-12 text-center py-16">
  <h2 class="text-h2 font-bold mb-4 text-foreground dark:text-foreground-light flex items-center justify-center gap-2"><span>🤝</span> Want to Work Together?</h2>
      <p class="text-lg mb-6 text-neutral">I'm always open to exciting new opportunities and collaborations. Let's create something amazing together!</p>
      <a href="/contact/" class="inline-flex items-center justify-center gap-2 rounded-full bg-accent px-6 sm:px-7 py-3 text-sm font-semibold text-on-accent shadow-lg shadow-accent/30 transition-colors duration-200 hover:bg-accent-dark focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent/65 focus-visible:ring-offset-2">Contact Me</a>
    </section>
  </div>
</Layout>
