---
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

import Layout from '../layouts/BaseLayout.astro';
import FloatingBlur from '../components/primitives/FloatingBlur.astro';
import SectionHeading from '../components/primitives/SectionHeading.astro';
import HomeHeroSection from '../components/features/home/HomeHeroSection.astro';
import HomeResumeHighlightsSection from '../components/features/home/HomeResumeHighlightsSection.astro';
import HomeRecentProjectsSection from '../components/features/home/HomeRecentProjectsSection.astro';
import HomeLatestPostsSection from '../components/features/home/HomeLatestPostsSection.astro';
import HomeCTASection from '../components/features/home/HomeCTASection.astro';
import TechnologyItem from '../components/features/home/TechnologyItem.astro';
import { getProjectsSorted } from '../content/projects/getProjects';
import { technologies, siteConfig } from '../config/data';
import { take } from '../utils/index.js';

const allBlogPosts: CollectionEntry<'blog'>[] = await getCollection('blog');
const blogPosts = allBlogPosts
  .filter((entry: CollectionEntry<'blog'>) => !entry.data.draft)
  .slice()
  .sort((a: CollectionEntry<'blog'>, b: CollectionEntry<'blog'>) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const recentProjects = take(await getProjectsSorted(), 3);
const recentBlogPosts: CollectionEntry<'blog'>[] = take(blogPosts, 3);

const heroDescription: string | undefined = siteConfig?.description;
const heroTagline: string | undefined = siteConfig?.tagline;
const normalize = (s?: string) => (s ?? '').replace(/\s+/g, ' ').trim().toLowerCase();
const shouldShowTagline = normalize(heroTagline) !== '' && normalize(heroTagline) !== normalize(heroDescription);
const defaultTagline = 'Systems Architect · Workflow Strategist · Action-Oriented Leader';
const taglineToShow: string | undefined = normalize(heroTagline) === ''
  ? defaultTagline
  : (shouldShowTagline ? heroTagline : undefined);

function deriveImageData(imgPath?: string) {
  if (!imgPath) return null;
  const prefix = '/assets/images/';
  if (!imgPath.startsWith(prefix)) return null;
  const relative = imgPath.slice(prefix.length);
  const lastDot = relative.lastIndexOf('.');
  if (lastDot === -1) return null;
  const name = relative.slice(0, lastDot);
  const ext = relative.slice(lastDot + 1).toLowerCase();
  return { name, ext };
}
---

<Layout title="Blake Oxford - Leadership & Portfolio" description="Systems architect and workflow strategist turning complexity into opportunity-designing scalable systems, streamlining operations, and leading high-stakes transformations that deliver lasting results." wide={true}>
  <link slot="head" rel="preload" as="image" href="/assets/images/optimized/avif/Blake-O-scaled@640w.avif" type="image/avif" fetchpriority="high" />
  <div class="fixed inset-0 -z-10 pointer-events-none">
    <FloatingBlur size="xl" color="accent" position="top-left" translate="-translate-x-1/2 -translate-y-1/2" />
    <FloatingBlur size="lg" color="accent-light" position="bottom-right" translate="translate-x-1/3 translate-y-1/3" />
  </div>

  <div class="space-y-16 sm:space-y-20 lg:space-y-24">
    <HomeHeroSection author={siteConfig.author} tagline={taglineToShow} description={heroDescription} />
    <HomeResumeHighlightsSection />

    <section id="technologies" class="w-full bg-gradient-to-r from-background via-surface to-background py-16 text-center dark:from-background-dark dark:via-background-dark dark:to-background-dark">
      <SectionHeading size="4xl" class="mb-8">Technologies I Excel At</SectionHeading>
      <ul class="flex flex-wrap justify-center gap-8 text-lg font-medium text-foreground/85">
        {technologies.map((tech) => {
          const raw = tech.img;
          const srcStr: string | undefined = typeof raw === 'string' ? raw : (raw && typeof raw === 'object' && 'src' in raw ? String(raw.src) : undefined);
          const canOptimize = typeof srcStr === 'string' && srcStr.startsWith('/assets/images/');
          const data = canOptimize ? deriveImageData(srcStr) : null;
          return <TechnologyItem tech={tech} data={data} srcStr={srcStr} />;
        })}
      </ul>
    </section>

    <HomeRecentProjectsSection projects={recentProjects} />
    <HomeLatestPostsSection posts={recentBlogPosts} />
    <HomeCTASection />
  </div>
</Layout>
