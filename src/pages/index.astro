---
import Layout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import ProjectCard from '../components/features/projects/ProjectCard.astro';
import HeroSection from '../components/sections/HeroSection.astro';
import AchievementsSection from '../components/sections/AchievementsSection.astro';
import TechnologiesSection from '../components/sections/TechnologiesSection.astro';
import ScrollAnimation from '../components/animations/ScrollAnimation.astro';
import { getFeaturedProjects } from '../config/data';

const blogPosts = (await getCollection('blog')) as any[];

// Use centralized data management
const featuredProjects = getFeaturedProjects(3);

// Get the latest blog post if available
const latestBlogPost = blogPosts.length > 0 ? blogPosts[0] : null;
---
<Layout title="Welcome to My Portfolio" description="Explore my projects, blog posts, and get in touch with me." wide={true}>
  <!-- Decorative background shapes -->
  <div class="fixed inset-0 -z-10 pointer-events-none">
    <div class="absolute top-0 left-0 w-96 h-96 bg-accent/10 rounded-full blur-3xl -translate-x-1/2 -translate-y-1/2"></div>
    <div class="absolute bottom-0 right-0 w-80 h-80 bg-accent/20 rounded-full blur-3xl translate-x-1/3 translate-y-1/3"></div>
  </div>
  
  <div class="space-y-20">
    <!-- Enhanced Hero Section -->
    <HeroSection />

    <!-- Core expertise and significant achievements -->
    <AchievementsSection />

    <!-- Technologies I Excel At Section -->
    <TechnologiesSection />

    <!-- Featured Projects Section -->
    <section id="featured-projects" class="c-featured-projects container mx-auto px-4" aria-labelledby="featured-projects-title">
      <ScrollAnimation animation="fadeIn">
        <h2 id="featured-projects-title" class="text-h2 font-bold mb-8 text-accent-dark text-center">Featured Projects</h2>
      </ScrollAnimation>
      
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {featuredProjects.map((project: any, index: number) => (
          <ScrollAnimation animation="slideUp" delay={index * 100}>
            <ProjectCard project={project} featured={true} />
          </ScrollAnimation>
        ))}
      </div>
      
      <ScrollAnimation animation="slideUp" delay={400}>
        <div class="mt-8 text-center">
          <a href="/projects/" class="btn btn-secondary" aria-label="View all projects">View All Projects</a>
        </div>
      </ScrollAnimation>
    </section>

    <!-- Latest Blog Posts Section -->
    <section class="w-full py-20 text-center bg-gradient-to-r from-gray-100 via-gray-200 to-gray-100 dark:from-gray-800 dark:via-gray-900 dark:to-gray-800" aria-labelledby="latest-blog-posts">
      <div class="container mx-auto px-4">
        <ScrollAnimation animation="fadeIn">
          <h2 id="latest-blog-posts" class="text-h2 font-bold mb-8 text-accent-dark">Latest Blog Posts</h2>
        </ScrollAnimation>
        
        <ScrollAnimation animation="slideUp" delay={200}>
          <ul class="grid grid-cols-1 md:grid-cols-2 gap-8">
            {latestBlogPost ? (
              <li style="background: var(--color-surface);" class="dark:bg-gray-800 rounded-2xl shadow-xl p-6 transform transition-all duration-300 hover:shadow-2xl hover:-translate-y-1">
                <a href={`/blog/${latestBlogPost.slug}`} class="block hover:scale-105 transition-transform duration-200" aria-label={`Read blog post: ${latestBlogPost.data.title}`}>
                  <h3 class="text-h3 font-semibold mb-2">{latestBlogPost.data.title}</h3>
                  <time class="text-sm text-neutral" datetime={latestBlogPost.data.pubDate?.toISOString()}>
                    {latestBlogPost.data.pubDate?.toLocaleDateString('en-US', { 
                      year: 'numeric', 
                      month: 'long', 
                      day: 'numeric' 
                    })}
                  </time>
                  <p class="mt-2 text-neutral">{latestBlogPost.data.description || 'Read this blog post to learn more.'}</p>
                </a>
              </li>
            ) : (
              <li style="background: var(--color-surface);" class="dark:bg-gray-800 rounded-2xl shadow-xl p-6 transform transition-all duration-300 hover:shadow-2xl hover:-translate-y-1">
                <div class="block">
                  <h3 class="text-h3 font-semibold mb-2">Blog Post Title May</h3>
                  <time class="text-sm text-neutral" datetime="2025-05-21">May 21, 2025</time>
                  <p class="mt-2 text-neutral">A short excerpt or summary of the blog post goes here to entice the reader to click through and read more.</p>
                </div>
              </li>
            )}
          </ul>
        </ScrollAnimation>
        
        <ScrollAnimation animation="fadeIn" delay={400}>
          <div class="mt-8 text-center">
            <a href="/blog/" class="btn btn-primary" aria-label="View all blog posts">View All Blog Posts</a>
          </div>
        </ScrollAnimation>
      </div>
    </section>

    <!-- Call-to-Action Section -->
    <section class="call-to-action container mx-auto px-4 text-center py-16">
      <ScrollAnimation animation="slideUp">
        <h2 class="text-h2 font-bold mb-4 text-accent-dark flex items-center justify-center gap-2">
          <span>🤝</span> Want to Work Together?
        </h2>
        <p class="text-lg mb-6 text-neutral">I'm always open to exciting new opportunities and collaborations. Let's create something amazing together!</p>
        <a href="/contact/" class="btn btn-primary btn-lg">Contact Me</a>
      </ScrollAnimation>
    </section>
  </div>
</Layout>
