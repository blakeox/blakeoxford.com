---
import Layout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/features/projects/ProjectCard.astro';
import CoinFlipImage from '../components/ui/CoinFlipImage.astro';
import Button from '../components/primitives/Button.astro';
import ButtonGroup from '../components/composites/ButtonGroup.astro';
import ResumeHighlightCard from '../components/features/home/ResumeHighlightCard.astro';
import ResumeHighlightItem from '../components/features/home/ResumeHighlightItem.astro';
import TechnologyItem from '../components/features/home/TechnologyItem.astro';
import BlogPostCard from '../components/features/blog/BlogPostCard.astro';
import SectionHeading from '../components/primitives/SectionHeading.astro';
import FloatingEmoji from '../components/primitives/FloatingEmoji.astro';
import FloatingBlur from '../components/primitives/FloatingBlur.astro';
import Grid from '../components/primitives/Grid.astro';
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import { getProjectsSorted } from '../content/projects/getProjects';
import { technologies, siteConfig } from '../config/data';
import { take } from '../utils/index.js';

const allBlogPosts: CollectionEntry<'blog'>[] = await getCollection('blog');
const blogPosts = allBlogPosts
  .filter((entry: CollectionEntry<'blog'>) => !entry.data.draft)
  .slice()
  .sort((a: CollectionEntry<'blog'>, b: CollectionEntry<'blog'>) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// Get most recent projects instead of featured projects
const recentProjects = take(await getProjectsSorted(), 3);

// Select the most recent posts for homepage feature
const recentBlogPosts: CollectionEntry<'blog'>[] = take(blogPosts, 3);

// Prevent duplicate hero copy: only show tagline if different from description
const heroDescription: string | undefined = siteConfig?.description;
const heroTagline: string | undefined = siteConfig?.tagline;
const normalize = (s?: string) => (s ?? '').replace(/\s+/g, ' ').trim().toLowerCase();
const shouldShowTagline = normalize(heroTagline) !== '' && normalize(heroTagline) !== normalize(heroDescription);
// Preferred default subtitle used previously on the site
const defaultTagline = 'Systems Architect · Workflow Strategist · Action-Oriented Leader';
// Show default when no tagline is set; otherwise show tagline only when not duplicative
const taglineToShow: string | undefined = normalize(heroTagline) === ''
  ? defaultTagline
  : (shouldShowTagline ? heroTagline : undefined);

// Helper to derive optimized image component props from a full /assets/images path
function deriveImageData(imgPath?: string) {
  if (!imgPath) return null;
  // Expect path like /assets/images/proficiencies/python_logo.webp
  const prefix = '/assets/images/';
  if (!imgPath.startsWith(prefix)) return null;
  const relative = imgPath.slice(prefix.length); // proficiencies/python_logo.webp
  const lastDot = relative.lastIndexOf('.');
  if (lastDot === -1) return null;
  const name = relative.slice(0, lastDot); // proficiencies/python_logo
  const ext = relative.slice(lastDot + 1).toLowerCase();
  return { name, ext };
}
---
<Layout title="Blake Oxford - Leadership & Portfolio" description="Systems architect and workflow strategist turning complexity into opportunity—designing scalable systems, streamlining operations, and leading high‑stakes transformations that deliver lasting results." wide={true}>
  <!-- Preload hero LCP image (single optimal size) -->
  <link slot="head" rel="preload" as="image" href="/assets/images/optimized/avif/Blake-O-scaled@640w.avif" type="image/avif" fetchpriority="high" />
  <!-- Decorative background shapes -->
  <div class="fixed inset-0 -z-10 pointer-events-none">
    <FloatingBlur size="xl" color="accent" position="top-left" translate="-translate-x-1/2 -translate-y-1/2" />
    <FloatingBlur size="lg" color="accent-light" position="bottom-right" translate="translate-x-1/3 translate-y-1/3" />
  </div>
  <div class="space-y-16 sm:space-y-20 lg:space-y-24">
    <!-- Hero Section -->
    <section id="about-me" class="relative overflow-hidden py-20 sm:py-24 md:py-32 min-h-[80vh] flex items-center bg-gradient-to-br from-background via-accent/5 to-background dark:from-background-dark dark:via-accent/10 dark:to-background-dark -mt-24">
      <!-- Animated background pattern -->
      <div class="absolute inset-0 z-0 opacity-20" aria-hidden="true">
        <div class="absolute inset-0"></div>
      </div>
      <!-- Curved divider at bottom -->
      <div class="absolute bottom-0 left-0 w-full overflow-hidden rotate-180">
        <svg data-name="Layer 1" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 120" preserveAspectRatio="none" class="h-20 w-full">
        </svg>
      </div>
      <div class="mx-auto w-full max-w-6xl px-4 sm:px-6 lg:px-8 relative z-10">
        <div class="grid md:grid-cols-2 gap-10 sm:gap-12 lg:gap-16 items-center">
          <!-- Left: Text -->
          <div class="order-2 md:order-1">
            <div class="max-w-2xl space-y-6 text-base leading-relaxed text-foreground/80 dark:text-foreground-light/80">
              <div class="space-y-3">
                <!-- Visually hidden pretitle retained for a11y/SEO semantics -->
                <p class="sr-only">Systems Architecture · Automation · Change Enablement</p>
                <h1 class="font-heading text-4xl sm:text-5xl md:text-6xl font-bold text-foreground dark:text-foreground-light">
                  {siteConfig.author}
                </h1>
                {taglineToShow && (
                  <h2 class="text-xl sm:text-2xl md:text-3xl font-medium text-foreground/90 dark:text-foreground-light/90">
                    {taglineToShow}
                  </h2>
                )}
                {heroDescription && (
                  <blockquote class="mt-2 border-l-4 border-accent/70 pl-4 text-base sm:text-lg md:text-xl text-foreground/90 dark:text-foreground-light/90">
                    {heroDescription}
                  </blockquote>
                )}
              </div>
            </div>
            <ButtonGroup align="start" responsive class="mt-6">
              <Button
                variant="primary"
                href="/contact/"
                data-test="home-cta-connect"
                data-analytics="hero-cta"
              >
                🤝 Let's Connect
              </Button>
              <Button
                variant="outline"
                href="/assets/Resume.pdf"
                download
              >
                📄 Download Resume
              </Button>
            </ButtonGroup>
          </div>
          <!-- Right: Animated Profile Image -->
          <div class="flex justify-center md:justify-end order-1 md:order-2">
            <div class="relative">
              <!-- Decorative elements around the image -->
              <div class="absolute -inset-4 rounded-full bg-gradient-to-r from-accent/30 to-primary/30 blur-xl opacity-70 animate-pulse"></div>
              <div class="relative rounded-full p-1 bg-gradient-to-r from-accent to-primary">
                <CoinFlipImage
                  frontSrc="/assets/images/Blake-O-scaled.jpg"
                  backSrc="/assets/images/china-profile-picture.jpg"
                  alt="Blake Oxford"
                  altBack="Blake Oxford in China"
                  size={280}
                  flipMultipleTimes
                  loading="eager"
                  fetchPriority="high"
                  decoding="auto"
                  role="img"
                  aria-label="Photo of Blake Oxford"
                />
              </div>
              <!-- Floating elements -->
              <FloatingEmoji emoji='💡' position='top-right' size='md' />
              <FloatingEmoji emoji='🚀' position='bottom-left' size='sm' color='accent-dark' />
              <FloatingEmoji emoji='☁️' position='center-right' size='sm' color='primary' />
            </div>
          </div>
        </div>
      </div>
    </section>
    
    <!-- Resume Highlights Section -->
    <section id="resume-highlights" class="py-16 sm:py-20 lg:py-24">
      <div class="mx-auto w-full max-w-6xl px-4 sm:px-6 lg:px-8 space-y-12">
        <div class="text-center space-y-4">
          <h2 class="text-3xl sm:text-4xl md:text-5xl font-bold text-foreground dark:text-foreground-light">Resume Highlights</h2>
          <p class="mx-auto max-w-3xl text-lg text-foreground/80 dark:text-foreground-light/80">
            Impact snapshots from enterprise migrations, automation programs, and data strategy initiatives.
          </p>
        </div>
        <Grid cols="3" gap="lg" alignItems="stretch">
          <ResumeHighlightCard title="Cloud &amp; SaaS Transformations" description="Complex platform rollouts delivered end-to-end with strong adoption and governance controls.">
            <svg
              slot="icon"
              xmlns="http://www.w3.org/2000/svg"
              class="h-6 w-6 text-on-primary"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999 5.002 5.002 0 10-9.78 2.096A4.001 4.001 0 003 15z" />
            </svg>
            <ResumeHighlightItem>
              <svg slot="icon" class="w-4.5 h-4.5 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4" />
              </svg>
              Google Workspace → Microsoft 365 migration for 180 users
            </ResumeHighlightItem>
            <ResumeHighlightItem>
              <svg slot="icon" class="w-4.5 h-4.5 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              Sage Intacct financial platform implementation
            </ResumeHighlightItem>
            <ResumeHighlightItem>
              <svg slot="icon" class="w-4.5 h-4.5 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999 5.002 5.002 0 10-9.78 2.096A4.001 4.001 0 003 15z" />
              </svg>
              Azure/Intune endpoint management deployment
            </ResumeHighlightItem>
            <ResumeHighlightItem>
              <svg slot="icon" class="w-4.5 h-4.5 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 8h10M7 12h4m1 8l-4-4H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-3l-4 4z" />
