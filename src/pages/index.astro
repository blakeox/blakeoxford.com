---
import Layout from '../layouts/BaseLayout.astro';
import ProficiencyLogo from '../components/media/ProficiencyLogo.astro';
import ProjectCard from '../components/features/projects/ProjectCard.astro';
import CoinFlipImage from '../components/ui/CoinFlipImage.astro';
import { getCollection } from 'astro:content';
import { getFeaturedProjects, technologies, siteConfig } from '../config/data';

const blogPosts = (await getCollection('blog', ({ data }) => !data.draft))
  .slice()
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// Use centralized data management
const featuredProjects = await getFeaturedProjects(3);

// Select the most recent posts for homepage feature
const recentBlogPosts = blogPosts.slice(0, 3);

// Helper to derive optimized image component props from a full /assets/images path
function deriveImageData(imgPath?: string) {
  if (!imgPath) return null;
  // Expect path like /assets/images/proficiencies/python_logo.webp
  const prefix = '/assets/images/';
  if (!imgPath.startsWith(prefix)) return null;
  const relative = imgPath.slice(prefix.length); // proficiencies/python_logo.webp
  const lastDot = relative.lastIndexOf('.');
  if (lastDot === -1) return null;
  const name = relative.slice(0, lastDot); // proficiencies/python_logo
  const ext = relative.slice(lastDot + 1).toLowerCase();
  return { name, ext };
}
---
