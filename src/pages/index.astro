---
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

import Layout from '@/layouts/BaseLayout.astro';
import HomeHeroSection from '@/components/features/home/HomeHeroSection.astro';
import HomeResumeHighlightsSection from '@/components/features/home/HomeResumeHighlightsSection.astro';
import HomeRecentProjectsSection from '@/components/features/home/HomeRecentProjectsSection.astro';
import HomeLatestPostsSection from '@/components/features/home/HomeLatestPostsSection.astro';
import HomeCTASection from '@/components/features/home/HomeCTASection.astro';
import { getProjectsSorted } from '@/content/projects/getProjects';
import { getHomePage } from '@/content/home/getHomePage';
import { siteConfig } from '@/config/data';
import { take } from '@/utils/index.js';

const page = await getHomePage();

const allBlogPosts: CollectionEntry<'blog'>[] = await getCollection('blog');
const publishedPosts = allBlogPosts
  .filter((entry: CollectionEntry<'blog'>) => !entry.data.draft)
  .slice()
  .sort(
    (a: CollectionEntry<'blog'>, b: CollectionEntry<'blog'>) =>
      b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
  );

const featuredPosts = publishedPosts.filter((entry) => entry.data.featured);
/** Two notes keep Writing a quiet beat after the project grid. */
const recentBlogPosts: CollectionEntry<'blog'>[] = take(
  featuredPosts.length > 0 ? featuredPosts : publishedPosts,
  2
);

const recentProjects = take(await getProjectsSorted(), 3);

const heroDescription =
  (siteConfig?.tagline ?? '').replace(/\s+/g, ' ').trim() || page.hero.defaultTagline;
---

<Layout title={page.meta.title} description={page.meta.description} wide={true}>
  <link
    slot="head"
    rel="preload"
    as="image"
    href="/assets/images/optimized/avif/Blake-O-scaled@768w.avif"
    type="image/avif"
    fetchpriority="high"
  />
  <link slot="head" rel="prefetch" href="/contact/" />

  {
    /*
    Page arc: identity → proof → shipped work → voice → convert.
    Alternating surfaces and widths create rhythm without repeating one section template.
  */
  }
  <div class="flex flex-col">
    <HomeHeroSection author={siteConfig.author} description={heroDescription} content={page.hero} />
    <HomeResumeHighlightsSection content={page.resumeHighlights} />
    <HomeRecentProjectsSection projects={recentProjects} content={page.recentProjects} />
    <HomeLatestPostsSection posts={recentBlogPosts} content={page.latestPosts} />
    <HomeCTASection content={page.cta} />
  </div>
</Layout>
