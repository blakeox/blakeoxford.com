          </ResumeHighlightCard>
        </Grid>
      </div>
    </section>

    <!-- Technologies I Excel At Section -->
  <section id="technologies" class="w-full py-16 text-center bg-gradient-to-r from-background via-surface to-background dark:from-background-dark dark:via-surface-dark dark:to-background-dark">
      <SectionHeading size='4xl' class='mb-8'>Technologies I Excel At</SectionHeading>
      <ul class="flex flex-wrap justify-center gap-8 text-lg font-medium text-neutral">
        {technologies.map((tech) => {
          const raw = tech.img as any;
          const srcStr: string | undefined = typeof raw === 'string' ? raw : raw?.src;
          const canOptimize = typeof srcStr === 'string' && srcStr.startsWith('/assets/images/');
          const data = canOptimize ? deriveImageData(srcStr) : null;
          return (
            <TechnologyItem tech={tech} data={data} srcStr={srcStr} />
          );
        })}
      </ul>
    </section>

    <!-- Recent Projects Section -->
  <section id="recent-projects" class="container mx-auto px-6 sm:px-8 lg:px-12" aria-labelledby="recent-projects-title">
  <SectionHeading id='recent-projects-title' size='4xl' class='mb-8 text-center'>Recent Projects</SectionHeading>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {recentProjects.map((project: any) => (
          <ProjectCard project={project} />
        ))}
      </div>        <div class="mt-8 text-center">
          <Button variant="outline" href="/projects/">View All Projects</Button>
        </div>
    </section>

    <!-- Latest Blog Posts Section -->
  <section class="w-full py-20 text-center bg-gradient-to-r from-background via-surface to-background dark:from-background-dark dark:via-surface-dark dark:to-background-dark" aria-labelledby="latest-blog-posts">
  <div class="container mx-auto px-6 sm:px-8 lg:px-12">
  <SectionHeading id='latest-blog-posts' size='4xl' class='mb-8'>Latest Blog Posts</SectionHeading>
        <ul class="grid grid-cols-1 gap-8 md:grid-cols-2 xl:grid-cols-3" role="list">
          {recentBlogPosts.length > 0 ? (
            recentBlogPosts.map((post) => (
              <li role="listitem">
                <BlogPostCard post={post} />
              </li>
            ))
          ) : (
            <li class="rounded-2xl border border-dashed border-border/40 bg-background/90 p-6 text-center shadow-md dark:bg-background-dark/80">
              <p class="text-sm text-foreground/70 dark:text-foreground-light/70">
                Blog posts are on the way—check back soon for new case studies and playbooks.
              </p>
            </li>
          )}
        </ul>
        <div class="mt-8 text-center">
          <Button variant="outline" href="/blog/">View All Blog Posts</Button>
        </div>
      </div>
    </section>

    <!-- Call-to-Action Section -->
    <section class="container mx-auto px-6 sm:px-8 lg:px-12 text-center py-16">
      <SectionHeading size='3xl' class='mb-4 flex items-center justify-center gap-2'><span>🤝</span> Want to Work Together?</SectionHeading>
      <p class="text-lg mb-6 text-neutral">I'm always open to exciting new opportunities and collaborations. Let's create something amazing together!</p>
      <Button variant="outline" href="/contact/">Contact Me</Button>
    </section>
  </div>
</Layout>
