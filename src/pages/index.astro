---
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

import Layout from '@/layouts/BaseLayout.astro';
import HomeHeroSection from '@/components/features/home/HomeHeroSection.astro';
import HomeResumeHighlightsSection from '@/components/features/home/HomeResumeHighlightsSection.astro';
import HomeLatestPostsSection from '@/components/features/home/HomeLatestPostsSection.astro';
import HomeCTASection from '@/components/features/home/HomeCTASection.astro';
import { getProjectsSorted } from '@/content/projects/getProjects';
import { leadStudies } from '@/content/projects/hirePath';
import { getHomePage } from '@/content/home/getHomePage';
import { siteConfig } from '@/config/data';
import { take } from '@/utils/array';
import { isPublished } from '@/lib/content/publication-contract.mjs';
import { getHomePortrait, homePortraitSizes } from '@/lib/homePortrait';

const page = await getHomePage();
const portrait = await getHomePortrait();

const allBlogPosts: CollectionEntry<'blog'>[] = await getCollection('blog');
const publishedPosts = allBlogPosts
  .filter((entry: CollectionEntry<'blog'>) => isPublished(entry))
  .slice()
  .sort(
    (a: CollectionEntry<'blog'>, b: CollectionEntry<'blog'>) =>
      b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
  );

const featuredPosts = publishedPosts.filter((entry) => entry.data.featured);
const postsById = new Map(publishedPosts.map((entry) => [entry.id, entry]));
const pinnedPosts = (page.latestPosts.postIds ?? [])
  .map((id) => postsById.get(id))
  .filter((entry): entry is CollectionEntry<'blog'> => Boolean(entry));
/** Two hire-path notes after proof; pinned IDs win over featured. */
const recentBlogPosts: CollectionEntry<'blog'>[] = take(
  pinnedPosts.length > 0 ? pinnedPosts : featuredPosts.length > 0 ? featuredPosts : publishedPosts,
  2
);

const publishedProjects = await getProjectsSorted();
const proofStudies = leadStudies(publishedProjects);
---

<Layout
  title={page.meta.title}
  description={page.meta.description}
  image="/assets/images/blake_detroit_og.jpg"
  imageAlt="Blake Oxford on the Detroit riverfront, skyline behind him"
  wide={true}
>
  <link
    slot="head"
    rel="preload"
    as="image"
    href={portrait.src}
    imagesrcset={portrait.srcSet.attribute}
    imagesizes={homePortraitSizes}
    type="image/avif"
    fetchpriority="high"
  />
  {/*
    Page arc: identity → proof → writing → convert.
    The outcome strip is the only study module; Work holds the full index.
  */}
  <div class="flex flex-col">
    <HomeHeroSection author={siteConfig.author} content={page.hero} />
    <HomeResumeHighlightsSection content={page.resumeHighlights} studies={proofStudies} />
    <HomeLatestPostsSection posts={recentBlogPosts} content={page.latestPosts} />
    <HomeCTASection content={page.cta} />
  </div>
</Layout>
