---
/**
 * Dynamic Project Detail Route
 * 
 * Renders individual project pages using MDX content from the projects collection.
 * Replaces 8 duplicate .astro files with a single dynamic route.
 * 
 * CTA sections are optional and configured via frontmatter (ctaHeading, ctaDescription).
 */
import type { GetStaticPaths } from 'astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import ProjectDetailLayout from '../../layouts/ProjectDetailLayout.astro';
import CTASection from '../../components/composites/CTASection.astro';

export const getStaticPaths = (async () => {
  const projects = await getCollection('projects');
  const staticSlugs = new Set([
    'adp-workforcenow',
    'advancedmd-implementation',
    'bank-projections-modeling',
    'fanalyx-deterministic-finance-platform',
    'ferment-app',
    'google-workspace-migration',
    'llm-note-coaching',
    'microsoft-fabric',
  ]);
  return projects
    .filter((project: CollectionEntry<'projects'>) => !project.data.draft)
    .filter((project: CollectionEntry<'projects'>) => !staticSlugs.has(project.id))
    .map((project: CollectionEntry<'projects'>) => ({
      params: { slug: project.id },
      props: { project },
    }));
}) satisfies GetStaticPaths;

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { ctaHeading, ctaDescription } = project.data;
const showCTA = ctaHeading && ctaDescription;
---

<ProjectDetailLayout slug={project.id}>
  {showCTA && (
    <CTASection
      slot="cta"
      heading={ctaHeading}
      description={ctaDescription}
    />
  )}
</ProjectDetailLayout>
