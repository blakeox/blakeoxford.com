---
/**
 * Dynamic Project Detail Route
 *
 * Renders individual project pages using MDX content from the projects collection.
 * Replaces 8 duplicate .astro files with a single dynamic route.
 *
 * CTA sections are optional and configured via frontmatter (ctaHeading, ctaDescription).
 */
import type { GetStaticPaths } from 'astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import ProjectDetailLayout from '@/layouts/ProjectDetailLayout.astro';
import Button from '@/components/primitives/Button.astro';
import { isPublished } from '@/lib/content/publication-contract.mjs';

export const getStaticPaths = (async () => {
  const projects = await getCollection('projects');
  return projects
    .filter((project: CollectionEntry<'projects'>) => isPublished(project))
    .map((project: CollectionEntry<'projects'>) => ({
      params: { slug: project.id },
      props: { project },
    }));
}) satisfies GetStaticPaths;

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { ctaDescription } = project.data;
---

<ProjectDetailLayout slug={project.id}>
  {ctaDescription && (
    <div slot="cta" class="flex flex-col items-start gap-4">
      <p class="max-w-xl text-base leading-relaxed text-muted-foreground">{ctaDescription}</p>
      <Button href="/contact/" variant="primary" data-cta-id="contact_submit">
        Discuss your bottleneck
      </Button>
    </div>
  )}
</ProjectDetailLayout>
