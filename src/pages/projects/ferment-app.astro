---
import { getEntry } from 'astro:content';
import Layout from '../../layouts/BaseLayout.astro';
import ProjectHero from '../../components/features/projects/ProjectHero.astro';
import ProjectDetailSection from '../../components/features/projects/ProjectDetailSection.astro';
import Button from '../../components/primitives/Button.astro';
import ButtonGroup from '../../components/composites/ButtonGroup.astro';
import AchievementCard from '../../components/common/AchievementCard.astro';
import ProjectTags from '../../components/features/projects/ProjectTags.astro';
import Grid from '../../components/primitives/Grid.astro';
import MetricsTable from '../../components/common/MetricsTable.astro';

const entry = await getEntry('projects', 'ferment-app');
if (!entry) {
  throw new Error('Project not found: ferment-app');
}

const { data } = entry;
const title = data.title;
const description = data.description ?? '';
const date = data.date ? new Date(data.date) : new Date();
const canonicalUrl = `https://blakeoxford.com/projects/${entry.slug}/`;
const heroImage = (data as any).heroImage ?? '/assets/images/blake-logo-fallback.png';
// Optional sections with runtime guards
const hasMetrics = 'metrics' in data && Array.isArray((data as any).metrics) && (data as any).metrics.length > 0;
const metrics = hasMetrics ? ((data as any).metrics as Array<{ metric: string; result: string; timeline: string }>) : [];
const hasJourney = 'journey' in data && Array.isArray((data as any).journey) && (data as any).journey.length > 0;
const journey = hasJourney ? ((data as any).journey as string[]) : [];
const hasLessons = 'lessons' in data && Array.isArray((data as any).lessons) && (data as any).lessons.length > 0;
const lessons = hasLessons ? ((data as any).lessons as Array<{ title: string; description: string }>) : [];
const reflection = 'reflection' in data ? ((data as any).reflection as string | undefined) : undefined;
const { Content } = await entry.render();
---

<Layout title={title} description={description} url={canonicalUrl} image={heroImage} wide>
  <ProjectHero title={title} description={description} date={date} image={heroImage} />

  <article class="relative isolate overflow-hidden bg-gradient-to-b from-surface-subtle via-background to-background py-24">
    <div class="pointer-events-none absolute inset-0 bg-grid-overlay/35 [background-size:200px_200px]" aria-hidden="true"></div>
    <div class="relative mx-auto flex w-full max-w-5xl flex-col gap-14 px-4 sm:px-6 lg:px-8">
      <ProjectDetailSection title="Program overview" eyebrow="Context" description={data.description}>
        <div class="max-w-none space-y-6 text-base leading-relaxed text-foreground/80 dark:text-foreground-light/82">
          <Content />
        </div>
      </ProjectDetailSection>

      {data.highlights?.length ? (
        <ProjectDetailSection title="Highlights" eyebrow="What resonated" layout="surface">
          <AchievementCard title="Program outcomes" achievements={data.highlights} />
        </ProjectDetailSection>
      ) : null}

      {(hasMetrics || data.impact?.length) ? (
        <ProjectDetailSection title="Impact signals" eyebrow="Proof of traction" layout="surface">
          <div class="flex flex-col gap-6">
            {hasMetrics ? <MetricsTable metrics={metrics} /> : null}
            {data.impact?.length ? (
              <ul class="flex flex-col gap-3 text-sm leading-relaxed text-foreground/75 dark:text-foreground-light/75" role="list">
                {(data.impact ?? []).map((item: string) => (
                  <li class="flex items-start gap-3">
                    <span class="mt-1 block h-1.5 w-1.5 rounded-full bg-accent" aria-hidden="true"></span>
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            ) : null}
          </div>
        </ProjectDetailSection>
      ) : null}

      {hasJourney ? (
        <ProjectDetailSection title="Journey" eyebrow="How it unfolded">
          <ul class="space-y-3 text-sm leading-relaxed text-foreground/75 dark:text-foreground-light/75" role="list">
            {journey.map((item: string) => (
              <li class="flex items-start gap-3">
                <span class="mt-1 block h-1.5 w-1.5 rounded-full bg-accent" aria-hidden="true"></span>
                <span set:html={item} />
              </li>
            ))}
          </ul>
        </ProjectDetailSection>
      ) : null}

      {hasLessons ? (
        <ProjectDetailSection title="Lessons" eyebrow="What stuck" layout="surface">
          <Grid cols="2" gap="md">
            {lessons.map((lesson: { title: string; description: string }) => (
              <article class="flex flex-col gap-2 rounded-2xl border border-border/25 bg-background/95 p-4 shadow-sm">
                <h3 class="text-lg font-semibold text-foreground dark:text-foreground-light">{lesson.title}</h3>
                <p class="text-sm leading-relaxed text-foreground/75 dark:text-foreground-light/75">{lesson.description}</p>
              </article>
            ))}
          </Grid>
        </ProjectDetailSection>
      ) : null}

      {reflection ? (
        <ProjectDetailSection title="Reflection" eyebrow="Personal note">
          <blockquote class="border-l-4 border-accent/80 bg-surface-subtle/80 p-6 text-base italic leading-relaxed text-foreground/78 dark:bg-surface-dark-subtle dark:text-foreground-light/82">
            {reflection}
          </blockquote>
        </ProjectDetailSection>
      ) : null}

      <ProjectDetailSection title="Next steps" eyebrow="Ready to explore?" layout="surface">
        <div class="grid gap-4 items-start lg:grid-cols-[minmax(0,2fr)_minmax(0,1fr)]">
          <div class="space-y-4">
            <h3 class="text-xl sm:text-2xl font-semibold text-foreground dark:text-foreground-light">
              Want to bring automation to your product flow?
            </h3>
            <p class="text-sm sm:text-base leading-relaxed text-foreground/75 dark:text-foreground-light/75">
              Let’s map the rituals your users love, design automations that feel natural, and ship a pilot that earns retention.
            </p>
          </div>
          <ButtonGroup align="end" responsive>
            <Button variant="outline" href="/contact/">
              Book a working session
            </Button>
            <Button variant="ghost" href="/about/">
              Review how I partner
            </Button>
          </ButtonGroup>
        </div>
      </ProjectDetailSection>
    </div>
  </article>

  <ProjectTags tags={data.tags ?? []} />
</Layout>
