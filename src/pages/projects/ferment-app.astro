---
import Layout from '../../layouts/BaseLayout.astro';
import ProjectHero from '../../components/features/projects/ProjectHero.astro';
import AchievementCard from '../../components/common/AchievementCard.astro';
import MetricsTable from '../../components/common/MetricsTable.astro';
import ProjectDetailSection from '../../components/features/projects/ProjectDetailSection.astro';
import ProjectTags from '../../components/features/projects/ProjectTags.astro';

const title = 'Ferment App – Mobile Recipe Management';
const description = 'A native iOS application for managing fermentation recipes, tracking progress, and automating task reminders — built with SwiftUI and Firebase.';
const date = new Date('2024-01-15T00:00:00.000Z');
const tags = ['Swift', 'SwiftUI', 'Firebase', 'SwiftData', 'Mobile Development', 'Fermentation'];
const image = '/assets/images/default-project.png';
const canonicalUrl = 'https://blakeoxford.com/projects/ferment-app/';

const metrics = [
  {
    metric: 'Recipe Builder',
    result: 'Complete',
    timeline: 'Live in TestFlight'
  },
  {
    metric: 'Task Scheduler',
    result: 'Complete',
    timeline: 'Live in TestFlight'
  },
  {
    metric: 'Timeline Logging',
    result: 'Complete',
    timeline: 'Live in TestFlight'
  },
  {
    metric: 'Cloud Sync',
    result: 'In Development',
    timeline: 'Q2 2025'
  },
  {
    metric: 'Community Sharing',
    result: 'In Development',
    timeline: 'Q3 2025'
  },
  {
    metric: 'App Store Release',
    result: 'Planned',
    timeline: 'Late 2025'
  }
];
---

<Layout
  title={title}
  description={description}
  image={image}
  url={canonicalUrl}
  wide={true}
>
  <ProjectHero
    title={title}
    description={description}
    date={date}
    image={image}
  />

  <article class="relative isolate overflow-hidden bg-gradient-to-b from-surface-subtle via-background to-background py-24">
    <div
      class="pointer-events-none absolute inset-0 bg-grid-overlay/35 [background-size:200px_200px]"
      aria-hidden="true"
    ></div>
    <div class="mx-auto w-full max-w-4xl px-4 sm:px-6 lg:px-8 relative flex flex-col gap-14">
      <ProjectDetailSection title="Project Introduction" eyebrow="🍃 Overview">
        <div class="space-y-6 text-base leading-relaxed text-foreground/78 dark:text-foreground-light/82">
          <p>
            Ferment App is a native iOS experience built with SwiftUI that helps fermentation enthusiasts manage recipes, track progress, and automate critical tasks within a clean, mobile-first interface. It is currently in private TestFlight, shaped by feedback from home brewers and fermentation hobbyists.
          </p>
          <p>
            Designed for kombucha brewers, kimchi makers, and mead experimenters alike, the app offers structured logging, variable monitoring, and recurring schedule management so every batch is consistent and repeatable.
          </p>
        </div>
      </ProjectDetailSection>

      <ProjectDetailSection title="Technical Architecture" eyebrow="🛠️ Systems map" layout="surface">
        <div class="overflow-hidden rounded-[2rem] ring-1 ring-border/25">
          <div class="overflow-x-auto">
            <table class="w-full min-w-[640px] border-collapse text-left">
              <thead class="bg-surface-subtle/80 text-sm font-semibold uppercase tracking-wide text-foreground/70 dark:bg-surface-dark-subtle">
                <tr>
                  <th class="px-6 py-4">Component</th>
                  <th class="px-6 py-4">Technology</th>
                  <th class="px-6 py-4">Purpose</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-border/20 text-sm text-foreground/80 dark:text-foreground-light/78">
                <tr>
                  <td class="px-6 py-4 font-semibold text-foreground dark:text-foreground-light">Language &amp; UI</td>
                  <td class="px-6 py-4">Swift + SwiftUI</td>
                  <td class="px-6 py-4">Modern, fluid native experience</td>
                </tr>
                <tr class="bg-background/70">
                  <td class="px-6 py-4 font-semibold text-foreground dark:text-foreground-light">State Management</td>
                  <td class="px-6 py-4">Combine with ObservableObject</td>
                  <td class="px-6 py-4">Reactive data flow</td>
                </tr>
                <tr>
                  <td class="px-6 py-4 font-semibold text-foreground dark:text-foreground-light">Local Persistence</td>
                  <td class="px-6 py-4">Core Data → SwiftData</td>
                  <td class="px-6 py-4">Offline-first storage</td>
                </tr>
                <tr class="bg-background/70">
                  <td class="px-6 py-4 font-semibold text-foreground dark:text-foreground-light">Cloud Sync &amp; Auth</td>
                  <td class="px-6 py-4">Firebase Firestore, Firebase Auth</td>
                  <td class="px-6 py-4">Cross-device continuity</td>
                </tr>
                <tr>
                  <td class="px-6 py-4 font-semibold text-foreground dark:text-foreground-light">Storage &amp; Media</td>
                  <td class="px-6 py-4">Firebase Storage</td>
                  <td class="px-6 py-4">Recipe imagery and assets</td>
                </tr>
                <tr class="bg-background/70">
                  <td class="px-6 py-4 font-semibold text-foreground dark:text-foreground-light">Charting &amp; Visualization</td>
                  <td class="px-6 py-4">Swift Charts</td>
                  <td class="px-6 py-4">Trend analysis</td>
                </tr>
                <tr>
                  <td class="px-6 py-4 font-semibold text-foreground dark:text-foreground-light">Deployment</td>
                  <td class="px-6 py-4">Xcode + TestFlight</td>
                  <td class="px-6 py-4">Pre-release distribution</td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>
      </ProjectDetailSection>

      <ProjectDetailSection title="Core Features" eyebrow="🚀 Highlights">
        <div class="grid gap-8 md:grid-cols-1">
          <AchievementCard
            title="Recipe management system"
            achievements={[
              'Create and edit fermentation recipes by type (kombucha, kimchi, sauerkraut, vinegar, mead, and more)',
              'Structured ingredient, instruction, and media entry tuned to each fermentation style',
              'Type-driven UI that adapts based on the fermentation category'
            ]}
          />
          <AchievementCard
            title="Intelligent task scheduling"
            achievements={[
              'Auto-generates task lists based on recipe type and fermentation phase',
              'Schedules critical activities like tasting, pH checks, burping, and bottling',
              'Custom reminder cadence per fermentation process'
            ]}
          />
          <AchievementCard
            title="Advanced timeline & tracking"
            achievements={[
              'Log temperature, gravity, pH, notes, and photos in one timeline',
              'Filter by fermentation phase for focused review',
              'Interactive Swift Charts visualizations to spot trends'
            ]}
          />
          <AchievementCard
            title="Cloud integration (in progress)"
            achievements={[
              'Firebase-backed syncing for cross-device access',
              'Foundational work for public recipe sharing and community libraries'
            ]}
          />
        </div>
      </ProjectDetailSection>

      <ProjectDetailSection title="User experience focus" eyebrow="📱 Experience" layout="surface">
        <ul class="space-y-4 text-base leading-relaxed text-foreground/78 dark:text-foreground-light/82">
          <li class="flex gap-4">
            <span class="mt-1 inline-flex h-2 w-2 shrink-0 rounded-full bg-accent"></span>
            <span><strong>SwiftUI foundation</strong> delivers a modern, fluid interface that feels unmistakably native.</span>
          </li>
          <li class="flex gap-4">
            <span class="mt-1 inline-flex h-2 w-2 shrink-0 rounded-full bg-accent"></span>
            <span><strong>Accessibility-first</strong> support for Dark Mode, VoiceOver, and Dynamic Type keeps inclusivity baked in.</span>
          </li>
          <li class="flex gap-4">
            <span class="mt-1 inline-flex h-2 w-2 shrink-0 rounded-full bg-accent"></span>
            <span><strong>Offline-first architecture</strong> balances local persistence with cloud synchronization for reliability.</span>
          </li>
          <li class="flex gap-4">
            <span class="mt-1 inline-flex h-2 w-2 shrink-0 rounded-full bg-accent"></span>
            <span><strong>Modular systems</strong> make it easy to tailor logic per fermentation type and add new categories over time.</span>
          </li>
        </ul>
      </ProjectDetailSection>

      <ProjectDetailSection title="Development deep dive" eyebrow="🔧 Under the hood">
        <div class="space-y-8 text-base leading-relaxed text-foreground/78 dark:text-foreground-light/82">
          <div class="space-y-3">
            <h3 class="text-xl font-semibold text-foreground dark:text-foreground-light">Core Data → SwiftData migration</h3>
            <ul class="space-y-2 pl-5">
              <li class="marker:text-foreground/45"><strong>SwiftData adoption</strong> reduces boilerplate and aligns beautifully with SwiftUI.</li>
              <li class="marker:text-foreground/45"><strong>Version-safe persistence</strong> strategy simplifies future upgrades and migrations.</li>
              <li class="marker:text-foreground/45"><strong>Modern concurrency</strong> patterns improve responsiveness while heavy operations run.</li>
            </ul>
          </div>
          <div class="space-y-3">
            <h3 class="text-xl font-semibold text-foreground dark:text-foreground-light">Dynamic configuration engine</h3>
            <ul class="space-y-2 pl-5">
              <li class="marker:text-foreground/45"><strong>Type-driven UI</strong> uses enums and protocols to adjust flows for kombucha, kimchi, sauerkraut, and more.</li>
              <li class="marker:text-foreground/45"><strong>Auto-generated defaults</strong> populate templates for ingredients and tasks by recipe type.</li>
              <li class="marker:text-foreground/45"><strong>Extensible architecture</strong> keeps new fermentation types a single configuration away.</li>
            </ul>
          </div>
          <div class="space-y-3">
            <h3 class="text-xl font-semibold text-foreground dark:text-foreground-light">Timeline &amp; visualization</h3>
            <ul class="space-y-2 pl-5">
              <li class="marker:text-foreground/45"><strong>Custom timeline view</strong> captures events, measurements, and notes in chronological context.</li>
              <li class="marker:text-foreground/45"><strong>Swift Charts</strong> surfaces pH, temperature, and gravity trends at a glance.</li>
              <li class="marker:text-foreground/45"><strong>Interactive filters</strong> narrow the lens by fermentation phase or datapoint category.</li>
            </ul>
          </div>
        </div>
      </ProjectDetailSection>

      <ProjectDetailSection title="Development status" eyebrow="🧪 Progress tracker" layout="surface">
        <MetricsTable metrics={metrics} />
      </ProjectDetailSection>

      <ProjectDetailSection title="Impact &amp; vision" eyebrow="🎉 Why it matters">
        <div class="space-y-4 text-base leading-relaxed text-foreground/78 dark:text-foreground-light/82">
          <p>
            Ferment App bridges the gap between paper logs and overcomplicated brewing software, providing structure without sacrificing creativity. Enthusiasts gain a repeatable process, richer insights, and a living history of their experiments.
          </p>
          <p>
            <strong>The vision:</strong> make fermentation accessible, enjoyable, and scientific for everyone—turning humble home experiments into guided experiences that merge ancient tradition with modern tooling.
          </p>
        </div>
      </ProjectDetailSection>

      <ProjectDetailSection title="The story behind it" eyebrow="📚 Origin story" layout="surface">
        <div class="space-y-6 text-base leading-relaxed text-foreground/78 dark:text-foreground-light/82">
          <p>
            Ferment App started as a side project that fused my love for healthy living, gardening, and fermentation with a deeper dive into modern iOS development.
          </p>
          <div class="space-y-4">
            <div class="space-y-2">
              <h3 class="text-xl font-semibold text-foreground dark:text-foreground-light">Why fermentation?</h3>
              <p>
                Fermentation is ancient, hands-on, and deeply scientific. Lowering the barrier—and even gamifying the experience—helps more people enjoy its rewards. In the U.S. especially, there is room to normalize fermented foods by making the process approachable and fun.
              </p>
            </div>
            <div class="space-y-2">
              <h3 class="text-xl font-semibold text-foreground dark:text-foreground-light">Technical growth</h3>
              <p>Building the app has been a learning lab across:</p>
              <ul class="space-y-2 pl-5">
                <li class="marker:text-foreground/45"><strong>SwiftUI</strong> for delightful interfaces</li>
                <li class="marker:text-foreground/45"><strong>Firebase</strong> for real-time sync</li>
                <li class="marker:text-foreground/45"><strong>Core Data &amp; SwiftData</strong> for persistence strategies</li>
                <li class="marker:text-foreground/45"><strong>IoT exploration</strong> with temperature sensors</li>
                <li class="marker:text-foreground/45"><strong>Swift Charts</strong> for immersive visualizations</li>
              </ul>
              <p>
                It connects technology with tradition, growing me as both a developer and a lifelong experimenter.
              </p>
            </div>
          </div>
        </div>
      </ProjectDetailSection>

      <ProjectDetailSection title="Reflection" eyebrow="Leave a note">
        <p class="text-base italic leading-relaxed text-foreground/78 dark:text-foreground-light/82">
          The project is still evolving. If you are interested in collaborating, testing, or advising, I would love to connect.
        </p>
      </ProjectDetailSection>
    </div>
  </article>

  <ProjectTags tags={tags} />
</Layout>
