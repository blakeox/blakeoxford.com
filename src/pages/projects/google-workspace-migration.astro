---
import Layout from '../../layouts/BaseLayout.astro';
import ProjectHero from '../../components/features/projects/ProjectHero.astro';
import AchievementCard from '../../components/common/AchievementCard.astro';
import MetricsTable from '../../components/common/MetricsTable.astro';
import ProjectDetailSection from '../../components/features/projects/ProjectDetailSection.astro';
import ProjectTags from '../../components/features/projects/ProjectTags.astro';

const title = 'Google Workspace → Microsoft 365 Migration & Endpoint Management';
const description = 'Led the transition from Google Workspace to Microsoft 365 and deployed modern device management via Intune/Endpoint Manager during early 2020, ensuring business continuity through COVID-19 disruptions.';
const date = new Date('2020-01-15T00:00:00.000Z');
const tags = ['Microsoft 365', 'Google Workspace', 'Endpoint Manager', 'Intune', 'MDM', 'COVID-19 Response'];
const image = '/assets/images/default-project.png';
const canonicalUrl = 'https://blakeoxford.com/projects/google-workspace-migration/';

const metrics = [
  {
    metric: 'Downtime Minimization',
    result: '<1% net user impact',
    timeline: 'Completed outside business hours'
  },
  {
    metric: 'Support Efficiency',
    result: '45% reduction in cross-platform tickets',
    timeline: 'Within 3 months'
  },
  {
    metric: 'Enhanced Security',
    result: '60% reduction in compliance incidents',
    timeline: 'Uniform Intune policies'
  },
  {
    metric: 'Collaboration Growth',
    result: '100% active Teams usage',
    timeline: 'Replaced fragmented workflows'
  },
  {
    metric: 'COVID-19 Resilience',
    result: 'Continuous patient care enabled',
    timeline: 'Safe remote/on-site work'
  }
];
---

<Layout
  title={title}
  description={description}
  image={image}
  url={canonicalUrl}
  wide={true}
>
  <ProjectHero
    title={title}
    description={description}
    date={date}
    image={image}
  />

  <article class="relative isolate overflow-hidden bg-gradient-to-b from-surface-subtle via-background to-background py-24">
    <div
      class="pointer-events-none absolute inset-0 bg-grid-overlay/30 [background-size:200px_200px]"
      aria-hidden="true"
    ></div>
    <div class="layout-shell-wide relative flex flex-col gap-14">
      <ProjectDetailSection title="Project introduction" eyebrow="🏥 Overview">
        <div class="space-y-6 text-base leading-relaxed text-foreground/78 dark:text-foreground-light/82">
          <p>
            In late 2019 our healthcare organization was juggling Google Workspace and Microsoft tooling, creating an exhausting support load and fragmented EHR workflows that depended on Excel and Word.
          </p>
          <p>
            We officially kicked off a migration in January 2020—only to have COVID-19 accelerate the timeline. The mandate became clear: unify collaboration, identity, and device management while protecting patient care for both in-clinic and remote teams.
          </p>
        </div>
      </ProjectDetailSection>

      <ProjectDetailSection title="Key achievements" eyebrow="🎯 Highlights" layout="surface">
        <div class="grid gap-8 md:grid-cols-1">
          <AchievementCard
            title="Platform consolidation"
            achievements={[
              '<strong>Migrated 100+ mailboxes</strong> from Gmail to Exchange Online with folder structures and shared drives intact',
              '<strong>Turnover-driven onboarding</strong> used early-pandemic hires to normalize Microsoft 365 workflows across teams'
            ]}
          />
          <AchievementCard
            title="Endpoint management deployment"
            achievements={[
              '<strong>Pre-COVID device enrollment</strong> brought every Windows and Mac into Intune for policy enforcement and remote provisioning',
              '<strong>Teams collaboration framework</strong> standardized channels, SharePoint sites, and EHR integrations so care teams shared the same playbook'
            ]}
          />
          <AchievementCard
            title="Business continuity & interoperability"
            achievements={[
              '<strong>EHR-ready Office workflows</strong> kept Excel and Word templates functioning natively, reducing errors during critical care moments',
              '<strong>Remote readiness</strong> leveraged Intune to deploy VPN clients and guard remote access when clinics had to pivot overnight',
              '<strong>Mobile data collection alignment</strong> partnered with an MDM-backed ABA app rollout to keep field devices compliant'
            ]}
          />
        </div>
      </ProjectDetailSection>

      <ProjectDetailSection title="Execution journey" eyebrow="🚀 Journey & growth">
        <div class="space-y-10 text-base leading-relaxed text-foreground/78 dark:text-foreground-light/82">
          <div class="space-y-3">
            <h3 class="text-xl font-semibold text-foreground dark:text-foreground-light">Strategic onboarding amid turnover</h3>
            <p>
              Sudden staff departures turned into an adoption advantage. New hires were onboarded exclusively on Microsoft 365, establishing champions who influenced the rest of the organization.
            </p>
          </div>
          <div class="space-y-3">
            <h3 class="text-xl font-semibold text-foreground dark:text-foreground-light">Immersive training blitz</h3>
            <p>
              With day-to-day operations slowed, we hosted rapid-fire virtual sessions covering Teams, Intune, SharePoint, and conditional access basics. The live labs built confidence fast.
            </p>
          </div>
          <div class="space-y-3">
            <h3 class="text-xl font-semibold text-foreground dark:text-foreground-light">Phased migration playbook</h3>
            <p>
              A four-phase plan—Discovery, Pilot, Bulk Migration, Optimization—balanced urgency with risk mitigation, keeping high-value clinics insulated from disruption.
            </p>
          </div>
          <div class="space-y-3">
            <h3 class="text-xl font-semibold text-foreground dark:text-foreground-light">Communication & governance</h3>
            <p>
              Weekly stakeholder updates, ticket triage office hours, and post-launch governance meetings kept adoption high and surfaced new automation opportunities like MFA and conditional access.
            </p>
          </div>
        </div>
      </ProjectDetailSection>

      <ProjectDetailSection title="Impact & results" eyebrow="📊 Metrics" layout="surface">
        <MetricsTable metrics={metrics} />
      </ProjectDetailSection>

      <ProjectDetailSection title="Lessons & takeaways" eyebrow="💡 What stuck">
        <ul class="space-y-4 text-base leading-relaxed text-foreground/78 dark:text-foreground-light/82">
          <li class="flex gap-4">
            <span class="mt-1 inline-flex h-2 w-2 shrink-0 rounded-full bg-accent"></span>
            <span><strong>Plan for uncertainty:</strong> early investment in Endpoint Manager delivered resiliency when the pandemic hit.</span>
          </li>
          <li class="flex gap-4">
            <span class="mt-1 inline-flex h-2 w-2 shrink-0 rounded-full bg-accent"></span>
            <span><strong>Stakeholder alignment matters:</strong> recurring workshops and transparent change management reduce resistance and boost confidence.</span>
          </li>
          <li class="flex gap-4">
            <span class="mt-1 inline-flex h-2 w-2 shrink-0 rounded-full bg-accent"></span>
            <span><strong>Iterate after go-live:</strong> feedback loops and monthly policy reviews kept the environment secure and evolving.</span>
          </li>
        </ul>
      </ProjectDetailSection>

      <ProjectDetailSection title="Reflection" eyebrow="🗒️ Closing note" layout="surface">
        <blockquote class="border-l-4 border-accent/80 bg-surface-subtle/80 p-8 text-base italic leading-relaxed text-foreground/78 dark:bg-surface-dark-subtle dark:text-foreground-light/82">
          This migration didn&apos;t just consolidate platforms—it built a secure, scalable foundation for collaboration and device management that continues to power digital health initiatives.
        </blockquote>
      </ProjectDetailSection>
    </div>
  </article>

  <ProjectTags tags={tags} />
</Layout>
