---
import Layout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/features/projects/ProjectCard.astro';
import Stack from '../../components/primitives/Stack.astro';
import Section from '../../components/primitives/Section.astro';
import PageHero from '../../components/composites/PageHero.astro';
import Grid from '../../components/primitives/Grid.astro';
import Flex from '../../components/primitives/Flex.astro';
import Button from '../../components/primitives/Button.astro';
import ButtonGroup from '../../components/composites/ButtonGroup.astro';
import StatsCard from '../../components/composites/StatsCard.astro';
import BadgePill from '../../components/primitives/BadgePill.astro';
import { getProjectsSorted } from '../../content/projects/getProjects';

const meta = (await import('../../content/projects/_meta.json')).default;
const hero = meta.hero;

const projects = await getProjectsSorted();

const title = 'Blake Oxford\'s Projects';
const description = 'Explore my portfolio of systems architecture, digital transformation, and development projects.';
const canonicalUrl = 'https://blakeoxford.com/projects/';

---

<Layout title={title} description={description} url={canonicalUrl} wide>
 <!-- Hero Section -->
 <PageHero fullScreen={true} includeBlurOrbs={true} id="projects-hero">
 <div class="section-intro max-w-4xl space-y-8">
 <span class="section-kicker">{hero.kicker}</span>
 <h1 id="projects-title" class="font-heading text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-bold leading-tight text-foreground">
 Selected Projects
 </h1>
 <p class="text-lg sm:text-xl md:text-2xl leading-relaxed text-muted-foreground">
 Systems architecture, automation, and digital transformation work that delivered measurable results. Each engagement combines technical depth with the change programming needed to keep adoption high.
 </p>
 
 <Flex wrap gap="sm" justify="center" class="text-xs font-semibold uppercase tracking-label text-subtle-foreground" role="list" aria-label="Focus areas">
 {hero.focusAreas.map((area) => (
 <span role="listitem">
 <BadgePill size="sm">
 {area}
 </BadgePill>
 </span>
 ))}
 </Flex>

 <div class="flex flex-wrap justify-center gap-4 pt-2">
 <Button variant="primary" href={hero.primaryCta.href}>{hero.primaryCta.label}</Button>
 <Button variant="outline" href={hero.secondaryCta.href}>{hero.secondaryCta.label}</Button>
 </div>
 </div>
 </PageHero>

 <!-- Projects Grid -->
 <Section
 padding="lg"
 container="xl"
 class="border-t border-border/20 bg-background relative overflow-hidden"
 role="region"
 aria-labelledby="projects-grid-heading"
 data-layout-section="projects-grid"
 >
 <!-- Subtle blur orb for visual interest -->
 <div class="absolute top-1/2 right-0 w-64 h-64 bg-primary/5 rounded-full blur-3xl pointer-events-none"></div>
 
 <Stack space="xl" class="text-pretty relative z-10" data-layout-shell="projects-grid-inner">
 <Stack space="md" class="max-w-3xl">
 <span class="section-kicker w-fit">{meta.grid.kicker}</span>
 <h2 id="projects-grid-heading" class="font-heading text-2xl sm:text-3xl md:text-4xl font-semibold text-foreground">
 {meta.grid.title}
 </h2>
 <p class="text-sm sm:text-base leading-relaxed text-muted-foreground">
 {meta.grid.description}
 </p>
 </Stack>

 <Grid cols="3" gap="lg">
 {projects.map((project) => (
 <ProjectCard project={project} />
 ))}
 </Grid>
 </Stack>
 </Section>

 <!-- Impact Section -->
 <Section
 padding="lg"
 container="xl"
 class="border-t border-border/20 bg-surface-subtle/40 relative overflow-hidden"
 role="region"
 aria-labelledby="results-heading"
 data-layout-section="projects-impact"
 >
 <!-- Accent blur orb for visual depth -->
 <div class="absolute bottom-0 left-0 w-80 h-80 bg-accent/5 rounded-full blur-3xl pointer-events-none"></div>
 
 <Stack space="xl" class="text-pretty relative z-10" data-layout-shell="projects-impact-inner">
 <Stack space="md" class="max-w-3xl">
 <span class="section-kicker w-fit">Portfolio signals</span>
 <h2 id="results-heading" class="font-heading text-2xl sm:text-3xl md:text-4xl font-semibold text-foreground">
 Results that stick
 </h2>
 <p class="text-sm sm:text-base leading-relaxed text-muted-foreground">
 Measurable outcomes from programs where automation and change enablement launched together.
 </p>
 </Stack>

 <Grid cols="3" gap="md">
 {hero.stats.map((stat) => (
 <StatsCard label={stat.label} value={stat.value} variant="default" size="md" />
 ))}
 </Grid>
 </Stack>
 </Section>

 <!-- CTA Section -->
 <Section
 padding="lg"
 container="md"
 class="border-t border-border/20 bg-background"
 role="region"
 aria-labelledby="cta-heading"
 data-layout-section="projects-cta"
 >
 <Stack space="lg" class="text-center" data-layout-shell="projects-cta-inner">
 <h2 id="cta-heading" class="font-heading text-2xl sm:text-3xl md:text-4xl font-semibold leading-tight text-foreground">
 Ready to line up the next leap?
 </h2>
 <p class="text-base sm:text-lg leading-relaxed text-muted-foreground">
 Bring the problem space and we'll map the operating backbone—automation, analytics, and change enablement—without losing clarity for stakeholders.
 </p>
 <ButtonGroup align="center" responsive>
 <Button
 variant="outline"
 href="/contact/"
 >
 Start a project conversation
 </Button>
 <Button
 variant="ghost"
 href="/about/"
 >
 See how I work
 </Button>
 </ButtonGroup>
 </Stack>
 </Section>
</Layout>
