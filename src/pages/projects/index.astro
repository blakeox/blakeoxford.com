---
import Layout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/features/projects/ProjectCard.astro';
import ProjectRow from '../../components/features/projects/ProjectRow.astro';
import ProjectDetailSection from '../../components/features/projects/ProjectDetailSection.astro';
import { featuredProjectsData } from '../../config/data';

const projects = featuredProjectsData;

const title = 'Blake Oxford\'s Projects';
const description = 'Explore my portfolio of systems architecture, digital transformation, and development projects.';
const canonicalUrl = 'https://blakeoxford.com/projects/';

const focusAreas: string[] = ['Automation & AI', 'Financial intelligence', 'Change enablement'];

const heroStats: { value: string; label: string }[] = [
  { value: '120+ hrs/mo', label: 'Capacity returned through automation' },
  { value: '200 teammates', label: 'Enabled with new playbooks' },
  { value: '10 departments', label: 'Working from one operating model' }
];

const journeyStages: { title: string; summary: string }[] = [
  {
    title: 'Discover the real friction',
    summary: 'Shadow workflows, baseline key metrics, and agree on the measurable shifts that matter to sponsors and frontline teams alike.'
  },
  {
    title: 'Design the operating rhythm',
    summary: 'Co-create new flows, dashboards, and change stories that show what good looks like before automation enters the picture.'
  },
  {
    title: 'Pilot with instrumentation',
    summary: 'Run controlled pilots with analytics, coaching, and feedback loops that surface adoption signals in real time.'
  },
  {
    title: 'Automate with guardrails',
    summary: 'Launch automation, insights, and governance together so every team inherits clear roles, alerts, and recovery plans.'
  },
  {
    title: 'Sustain and evolve',
    summary: 'Stand up enablement, champion networks, and improvement backlogs so the program keeps compounding value after launch.'
  }
];

const valuePillars: { title: string; detail: string }[] = [
  {
    title: 'Evidence-first decisions',
    detail: 'Dashboards, retros, and briefings keep executives aligned with the work happening on the ground—no translation gap.'
  },
  {
    title: 'Change that stays adopted',
    detail: 'Enablement kits, playbooks, and internal champions anchor new behaviors so rollout day is the starting line—not the finish.'
  },
  {
    title: 'Automation you can trust',
    detail: 'Workflows launch with guardrails, access models, and recovery scripts so teams adopt without fearing hidden risk.'
  }
];

const deliverySignals: string[] = [
  'Week-over-week storytelling that ties ROI, adoption, and delivery health together.',
  'Enablement tracks, office hours, and feedback loops that convert new processes into habits.',
  'Executive scorecards plus champion networks that keep momentum visible long after launch.'
];

const featuredHighlights: string[] = [
  'Automation joined finance and operations data so leaders could spot friction before it slowed delivery.',
  'Weekly CXO readouts blended adoption, ROI, and risk signals on a single dashboard.',
  'Change champion playbooks equipped 200+ teammates to run the new cadence with confidence.'
];

const sortedProjects = projects
  .filter((project) => !project.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const [featuredProject, ...otherProjects] = sortedProjects;
const limitedProjects = otherProjects.slice(0, 5);

---

<Layout title={title} description={description} url={canonicalUrl} wide>
  <section class="bg-background py-20 sm:py-24 md:py-28" role="region" aria-labelledby="projects-title">
    <div class="mx-auto w-full max-w-6xl px-4 sm:px-6 lg:px-8 flex flex-col gap-10 sm:gap-12 lg:gap-14 text-pretty">
      <div class="max-w-3xl space-y-6 sm:space-y-7">
        <span class="inline-flex w-fit items-center gap-2 rounded-full bg-surface-subtle px-4 py-1.5 text-xs font-semibold uppercase tracking-[0.28em] text-foreground/65 ring-1 ring-border/40 dark:bg-surface-dark-subtle">
          Signature programs
        </span>
        <header class="space-y-4 sm:space-y-5">
          <h1 id="projects-title" class="font-heading text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-semibold leading-tight text-foreground dark:text-foreground-light">
            Operational intelligence work that stays adopted
          </h1>
          <p class="text-lg sm:text-xl font-semibold text-foreground dark:text-foreground-light">
            Systems built to keep decisions, delivery, and change leadership moving in lockstep.
          </p>
          <p class="text-base sm:text-lg leading-relaxed text-foreground/75 dark:text-foreground-light/80">
            Explore the programs where automation, financial intelligence, and enablement launched together—turning strategy slides into reliable operating rhythms.
          </p>
        </header>
      </div>

      <div class="flex flex-wrap gap-2 text-xs font-semibold uppercase tracking-[0.28em] text-foreground/60 dark:text-foreground-light/60" role="list" aria-label="Focus areas">
        {focusAreas.map((area) => (
          <span class="inline-flex items-center gap-2 rounded-full bg-surface-subtle px-3 py-1 ring-1 ring-border/35 dark:bg-surface-dark-subtle" role="listitem">
            <span class="h-1.5 w-1.5 rounded-full bg-accent/70" aria-hidden="true"></span>
            {area}
          </span>
        ))}
      </div>

      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {heroStats.map((stat) => (
          <div class="rounded-2xl bg-background px-4 py-5 sm:px-5 sm:py-6 ring-1 ring-border/30 shadow-lg">
            <p class="mb-3 sm:mb-4 text-xs font-semibold uppercase tracking-[0.28em] text-foreground/55 dark:text-foreground-light/60">{stat.label}</p>
            <p class="text-xl sm:text-2xl font-semibold text-foreground dark:text-foreground-light">{stat.value}</p>
          </div>
        ))}
      </div>

      <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:gap-4">
        <a
          href="/contact/"
          class="inline-flex min-h-[48px] items-center justify-center gap-2 rounded-full bg-accent px-6 sm:px-7 py-3 text-sm font-semibold text-on-accent shadow-accent-glow transition-colors hover:bg-accent-dark focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent/65 focus-visible:ring-offset-2"
        >
          Start a project conversation
        </a>
        <a
          href="/about/"
          class="inline-flex min-h-[48px] items-center justify-center gap-2 rounded-full px-6 sm:px-7 py-3 text-sm font-semibold text-accent ring-1 ring-accent/40 transition-all hover:text-accent-dark hover:ring-accent focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent/60 focus-visible:ring-offset-2"
        >
          See how I work
        </a>
      </div>
    </div>
  </section>

  {featuredProject && (
    <section class="bg-surface-subtle/40 py-16 sm:py-20" role="region" aria-labelledby="featured-project-heading">
      <div class="mx-auto w-full max-w-6xl px-4 sm:px-6 lg:px-8 flex flex-col gap-8 sm:gap-10 text-pretty">
        <header class="max-w-2xl space-y-3 sm:space-y-4">
          <span class="inline-flex w-fit items-center gap-2 rounded-full bg-background/90 px-3 py-1 text-[0.7rem] font-semibold uppercase tracking-[0.28em] text-foreground/65 ring-1 ring-border/35">
            Featured program
          </span>
          <h2 id="featured-project-heading" class="font-heading text-2xl sm:text-3xl md:text-4xl font-semibold text-foreground dark:text-foreground-light">
            {featuredProject.data.title}
          </h2>
          <p class="text-sm sm:text-base leading-relaxed text-foreground/75 dark:text-foreground-light/75">
            {featuredProject.data.description}
          </p>
        </header>

        <div class="max-w-5xl space-y-6 sm:space-y-8">
          <ProjectCard project={featuredProject} featured />
          <ProjectDetailSection title="Why it resonated" eyebrow="Program outcomes" layout="surface">
            <ul class="flex flex-col gap-3 sm:gap-4 text-sm leading-relaxed text-foreground/75 dark:text-foreground-light/75" role="list">
              {featuredHighlights.map((highlight) => (
                <li class="flex items-start gap-3 rounded-xl bg-background/95 px-3 py-3 sm:px-4 sm:py-4 ring-1 ring-border/25 dark:bg-surface-dark-subtle" role="listitem">
                  <span class="mt-1 h-1.5 w-1.5 rounded-full bg-accent flex-shrink-0" aria-hidden="true"></span>
                  <span>{highlight}</span>
                </li>
              ))}
            </ul>

            {Array.isArray(featuredProject.data.tags) && featuredProject.data.tags.length > 0 && (
              <div class="mt-6 flex flex-wrap gap-2 text-[0.7rem] font-semibold uppercase tracking-[0.28em] text-foreground/60 dark:text-foreground-light/65" role="list" aria-label="Project technologies">
                {featuredProject.data.tags.map((tag: string) => (
                  <span class="rounded-full bg-surface-subtle px-3 py-1 ring-1 ring-border/25 dark:bg-surface-dark-subtle" role="listitem">{tag}</span>
                ))}
              </div>
            )}

            <a
              href={`/projects/${featuredProject.slug}/`}
              aria-label={`View project: ${featuredProject.data.title}`}
              class="mt-6 inline-flex min-h-[44px] items-center justify-center gap-2 rounded-full bg-accent px-5 py-2 text-sm font-semibold text-on-accent transition-colors hover:bg-accent-dark focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent/60 focus-visible:ring-offset-2"
            >
              View the full case study
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M5 12h14m-6-6 6 6-6 6" />
              </svg>
            </a>
          </ProjectDetailSection>
        </div>
      </div>
    </section>
  )}

  <section class="border-t border-border/20 bg-background py-16 sm:py-20" role="region" aria-labelledby="value-pillar-heading">
    <div class="mx-auto w-full max-w-6xl px-4 sm:px-6 lg:px-8 flex flex-col gap-8 sm:gap-10 text-pretty">
      <header class="max-w-3xl space-y-3 sm:space-y-4">
        <span class="inline-flex w-fit items-center gap-2 rounded-full bg-surface-subtle px-3 py-1 text-[0.7rem] font-semibold uppercase tracking-[0.28em] text-foreground/65 ring-1 ring-border/35 dark:bg-surface-dark-subtle">
          What leaders count on
        </span>
        <h2 id="value-pillar-heading" class="font-heading text-2xl sm:text-3xl md:text-4xl font-semibold text-foreground dark:text-foreground-light">
          Make the operating system visible and defensible.
        </h2>
        <p class="text-sm sm:text-base leading-relaxed text-foreground/75 dark:text-foreground-light/75">
          Every engagement connects insight, enablement, and automation so teams lead with clarity instead of chasing updates.
        </p>
      </header>

      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {valuePillars.map((pillar) => (
          <div class="rounded-2xl bg-surface-subtle px-4 py-5 sm:px-6 sm:py-6 ring-1 ring-border/30 shadow-lg dark:bg-surface-dark-subtle">
            <p class="text-sm font-semibold text-foreground dark:text-foreground-light">{pillar.title}</p>
            <p class="mt-2 text-sm leading-relaxed text-foreground/70 dark:text-foreground-light/70">{pillar.detail}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="border-t border-border/20 bg-surface-subtle/40 py-16 sm:py-20" role="region" aria-labelledby="journey-heading">
    <div class="mx-auto w-full max-w-6xl px-4 sm:px-6 lg:px-8 flex flex-col gap-8 sm:gap-10 text-pretty">
      <header class="max-w-3xl space-y-3 sm:space-y-4">
        <span class="inline-flex w-fit items-center gap-2 rounded-full bg-background/90 px-3 py-1 text-[0.7rem] font-semibold uppercase tracking-[0.28em] text-foreground/65 ring-1 ring-border/35">
          Journey
        </span>
        <h2 id="journey-heading" class="font-heading text-2xl sm:text-3xl md:text-4xl font-semibold text-foreground dark:text-foreground-light">
          A single-column journey from insight to lasting change.
        </h2>
        <p class="text-sm sm:text-base leading-relaxed text-foreground/75 dark:text-foreground-light/75">
          The pace is deliberate: measure what matters, design with the people who use it, then automate with the right guardrails.
        </p>
      </header>

      <ol class="space-y-4" role="list">
        {journeyStages.map((stage, index) => (
          <li class="rounded-2xl bg-background px-4 py-5 sm:px-6 sm:py-6 ring-1 ring-border/25 shadow-lg" role="listitem">
            <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:gap-5">
              <span class="inline-flex h-9 w-9 items-center justify-center rounded-xl bg-accent/15 text-xs font-semibold uppercase tracking-[0.28em] text-accent">
                {String(index + 1).padStart(2, '0')}
              </span>
              <div class="space-y-2">
                <p class="text-sm font-semibold text-foreground dark:text-foreground-light">{stage.title}</p>
                <p class="text-sm leading-relaxed text-foreground/70 dark:text-foreground-light/75">{stage.summary}</p>
              </div>
            </div>
          </li>
        ))}
      </ol>

      <div class="rounded-2xl bg-background/85 px-4 py-5 sm:px-6 sm:py-6 ring-1 ring-border/25 shadow-lg">
        <p class="text-xs font-semibold uppercase tracking-[0.3em] text-foreground/60 dark:text-foreground-light/60">Delivery signals we protect</p>
        <ul class="mt-3 space-y-2 text-sm leading-relaxed text-foreground/70 dark:text-foreground-light/70" role="list">
          {deliverySignals.map((signal) => (
            <li class="flex items-start gap-3" role="listitem">
              <span class="mt-1.5 h-1.5 w-1.5 rounded-full bg-accent flex-shrink-0" aria-hidden="true"></span>
              <span>{signal}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section class="border-t border-border/20 bg-background py-16 sm:py-20" role="region" aria-labelledby="selected-projects-heading">
    <div class="mx-auto w-full max-w-6xl px-4 sm:px-6 lg:px-8 flex flex-col gap-8 sm:gap-10 text-pretty">
      <header class="max-w-3xl space-y-3 sm:space-y-4">
        <span class="inline-flex w-fit items-center gap-2 rounded-full bg-surface-subtle px-3 py-1 text-[0.7rem] font-semibold uppercase tracking-[0.28em] text-foreground/65 ring-1 ring-border/35 dark:bg-surface-dark-subtle">
          Selected engagements
        </span>
        <h2 id="selected-projects-heading" class="font-heading text-2xl sm:text-3xl md:text-4xl font-semibold text-foreground dark:text-foreground-light">
          Snapshots from the broader library.
        </h2>
        <p class="text-sm sm:text-base leading-relaxed text-foreground/75 dark:text-foreground-light/75">
          Each project combines operational clarity with the change programming needed for teams to run the new model with confidence.
        </p>
      </header>

      <div class="grid gap-6 md:grid-cols-2 xl:grid-cols-3">
        {limitedProjects.map((project) => (
          <ProjectRow project={project} />
        ))}
      </div>

      <div class="flex flex-wrap gap-3">
        <a
          href="/contact/"
          class="inline-flex min-h-[40px] items-center justify-center gap-2 rounded-full px-4 py-2 text-xs font-semibold uppercase tracking-[0.28em] text-accent ring-1 ring-accent/30 transition-all hover:text-accent-dark hover:ring-accent focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent/60 focus-visible:ring-offset-2"
        >
          Request full portfolio
        </a>
      </div>
    </div>
  </section>

  <section class="border-t border-border/20 bg-surface-subtle/50 py-16 sm:py-20" role="region" aria-labelledby="projects-cta-heading">
    <div class="mx-auto w-full max-w-6xl px-4 sm:px-6 lg:px-8 flex flex-col gap-6 sm:gap-7 text-pretty">
      <h2 id="projects-cta-heading" class="font-heading text-2xl sm:text-3xl md:text-[2.2rem] font-semibold text-foreground dark:text-foreground-light">
        Ready to line up the next leap?
      </h2>
      <p class="max-w-3xl text-sm sm:text-base leading-relaxed text-foreground/75 dark:text-foreground-light/75">
        Bring the problem space and we’ll map the operating backbone—automation, analytics, and change enablement—without losing clarity for stakeholders.
      </p>
      <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:gap-4">
        <a
          href="/contact/"
          class="inline-flex min-h-[48px] items-center justify-center gap-2 rounded-full bg-accent px-6 sm:px-7 py-3 text-sm font-semibold text-on-accent shadow-accent-glow transition-colors hover:bg-accent-dark focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent/65 focus-visible:ring-offset-2"
        >
          Start a project conversation
        </a>
        <a
          href="/about/"
          class="inline-flex min-h-[48px] items-center justify-center gap-2 rounded-full px-6 sm:px-7 py-3 text-sm font-semibold text-accent ring-1 ring-accent/40 transition-all hover:text-accent-dark hover:ring-accent focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent/60 focus-visible:ring-offset-2"
        >
          See how I work
        </a>
      </div>
      <div class="flex flex-wrap gap-2 text-xs font-semibold uppercase tracking-[0.28em] text-foreground/60 dark:text-foreground-light/60">
        {focusAreas.map((area) => (
          <span class="inline-flex items-center gap-2 rounded-full bg-background/92 px-3 py-1 ring-1 ring-border/30">
            <span class="h-1.5 w-1.5 rounded-full bg-accent/70"></span>
            {area}
          </span>
        ))}
      </div>
    </div>
  </section>
</Layout>
