---
import Layout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/composites/PageHero.astro';
import IntroCopy from '../../components/composites/IntroCopy.astro';
import DotMetaList from '../../components/composites/DotMetaList.astro';
import Button from '../../components/primitives/Button.astro';
import ButtonGroup from '../../components/composites/ButtonGroup.astro';
import ProjectsCapabilitiesSection from '../../components/features/projects/ProjectsCapabilitiesSection.astro';
import ProjectsFeaturedSection from '../../components/features/projects/ProjectsFeaturedSection.astro';
import ProjectsLibrarySection from '../../components/features/projects/ProjectsLibrarySection.astro';
import ProjectsFindingsSection from '../../components/features/projects/ProjectsFindingsSection.astro';
import ProjectsCTASection from '../../components/features/projects/ProjectsCTASection.astro';
import { getProjectInsights } from '../../content/projects/getProjectInsights';

const meta = (await import('../../content/projects/_meta.json')).default;
const { findings, projects, deepCut } = await getProjectInsights();

const featuredProject = deepCut
  ? projects.find((project) => project.id === deepCut.projectSlug)
  : undefined;

const title = 'Selected work — Blake Oxford';
const description =
  'Portfolio of migrations, automation, analytics, and AI-enabled workflows Blake Oxford has shipped under real operating pressure.';
const canonicalUrl = 'https://blakeoxford.com/projects/';
---

{/*
  Portfolio showcase arc:
  capability claim → what I deliver → featured proof → full range → cross-case results → convert.
*/}
<Layout title={title} description={description} url={canonicalUrl} wide>
  <PageHero
    fullScreen={false}
    includeBlurOrbs={false}
    align="center"
    id="projects-hero"
    shell="projects-hero-inner"
  >
    <div class="flex w-full flex-col items-center gap-7">
      <IntroCopy
        kicker={meta.hero.kicker}
        title={meta.hero.title}
        titleId="projects-title"
        description={meta.hero.subtitle}
        align="center"
        size="hero"
      >
        <DotMetaList
          items={meta.hero.capabilities}
          label="Capability focus"
          align="center"
          class="pt-1"
        />
      </IntroCopy>
      <ButtonGroup align="center" responsive>
        <Button variant="primary" href={meta.hero.primaryCta.href}>
          {meta.hero.primaryCta.label}
        </Button>
        <Button variant="outline" href={meta.hero.secondaryCta.href}>
          {meta.hero.secondaryCta.label}
        </Button>
      </ButtonGroup>
    </div>
  </PageHero>

  <ProjectsCapabilitiesSection
    kicker={meta.capabilities.kicker}
    title={meta.capabilities.title}
    description={meta.capabilities.description}
    items={meta.capabilities.items}
  />

  {
    featuredProject && deepCut && (
      <ProjectsFeaturedSection
        project={featuredProject}
        deepCut={deepCut}
        kicker={meta.featured.kicker}
        ctaLabel={meta.featured.ctaLabel}
      />
    )
  }

  <ProjectsLibrarySection
    projects={projects}
    excludeSlug={deepCut?.projectSlug}
    kicker={meta.library.kicker}
    title={meta.library.title}
    description={meta.library.description}
  />

  <ProjectsFindingsSection
    findings={findings}
    kicker={meta.results.kicker}
    title={meta.results.title}
    description={meta.results.description}
  />

  <ProjectsCTASection
    title={meta.cta.title}
    description={meta.cta.description}
    button={meta.cta.button}
  />
</Layout>
