---
import Layout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/features/projects/ProjectCard.astro';
import ProjectRow from '../../components/features/projects/ProjectRow.astro';
import ProjectDetailSection from '../../components/features/projects/ProjectDetailSection.astro';
import { featuredProjectsData } from '../../config/data';

const projects = featuredProjectsData;

const title = 'Blake Oxford\'s Projects';
const description = 'Explore my portfolio of systems architecture, digital transformation, and development projects.';
const canonicalUrl = 'https://blakeoxford.com/projects/';

// Concise focus pills for the hero
const focus = ['Automation & AI', 'Financial Intelligence', 'Change Adoption'];

const stats = [
  { value: '120+ hrs/mo', label: 'Time reclaimed with automation' },
  { value: '200 teammates', label: 'Enabled through change initiatives' },
  { value: '10 departments', label: 'Unified with shared process + data' }
];

// Short, scannable methodology chips
const methodology = [
  'Discovery → Empathy',
  'Process Mapping',
  'Design + Iterate',
  'Implement Safely',
  'Govern & Improve'
];

const sortedProjects = projects
  .filter((project) => !project.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const [featuredProject, ...otherProjects] = sortedProjects;
// Show a smaller subset to keep the page lighter while still representative (reduce network bytes)
const limitedProjects = otherProjects.slice(0, 5);

const heroHighlights = methodology.slice(0, 3);
const remainingMethodology = methodology.slice(3);

const proofPoints = [
  { title: 'Operational clarity', detail: 'Dashboards and runbooks keep sponsors informed in real time.' },
  { title: 'Sustainable change', detail: 'Enablement, comms, and coaching baked into delivery cadences.' },
  { title: 'Measurable results', detail: 'Automation ROI, adoption, and quality tracked from sprint zero.' },
];

---

<Layout title={title} description={description} url={canonicalUrl} wide>
  <!-- Hero Section -->
  <section class="relative isolate overflow-hidden bg-gradient-to-br from-background via-surface-subtle/60 to-background-dark/80 py-24 sm:py-28 md:py-32" role="region" aria-labelledby="projects-title">
    <!-- Background decorations -->
    <div class="pointer-events-none absolute inset-0 bg-grid-overlay/40 [background-size:200px_200px] sm:[background-size:220px_220px]" aria-hidden="true"></div>
    <div class="pointer-events-none absolute left-[-4rem] top-[-3rem] h-48 w-48 sm:left-[-6rem] sm:top-[-4rem] sm:h-64 sm:w-64 rounded-full bg-accent/20 blur-3xl" aria-hidden="true"></div>
    <div class="pointer-events-none absolute right-[-4rem] bottom-[-3rem] h-56 w-56 sm:right-[-5rem] sm:bottom-[-4rem] sm:h-72 sm:w-72 rounded-full bg-accent/15 blur-[110px]" aria-hidden="true"></div>
    
    <div class="layout-shell-wide relative grid gap-12 sm:gap-16 lg:grid-cols-[minmax(0,1.15fr)_minmax(0,0.85fr)] lg:items-start xl:gap-20">
      <!-- Hero Content -->
      <div class="flex flex-col gap-8 sm:gap-10 text-pretty">
        <!-- Badge -->
        <span class="inline-flex items-center gap-2 rounded-full bg-background/92 px-4 py-1.5 text-xs font-semibold uppercase tracking-[0.32em] text-accent ring-1 ring-accent/30 w-fit" role="doc-subtitle">
          <span class="h-2 w-2 rounded-full bg-accent" aria-hidden="true"></span>
          Signature work
        </span>
        
        <!-- Main heading and description -->
        <header class="space-y-4 sm:space-y-6">
          <h1 id="projects-title" class="font-heading text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-semibold text-foreground dark:text-foreground-light leading-tight">
            Systems built to keep decisions, delivery, and adoption in lockstep
          </h1>
          <p class="max-w-2xl text-base sm:text-lg leading-relaxed text-foreground/75 dark:text-foreground-light/80">
            Explore engagements where automation, financial intelligence, and change leadership shape durable operating models—not just demos.
          </p>
        </header>
        
        <!-- Focus areas -->
        <div class="flex flex-wrap gap-2 text-xs font-semibold uppercase tracking-[0.28em] text-foreground/65 dark:text-foreground-light/65" role="list" aria-label="Focus areas">
          {focus.map((f) => (
            <span class="inline-flex items-center gap-2 rounded-full bg-surface-subtle px-3 py-1 ring-1 ring-border/25 dark:bg-surface-dark-subtle" role="listitem">
              <span class="h-1.5 w-1.5 rounded-full bg-accent/80" aria-hidden="true"></span>
              {f}
            </span>
          ))}
        </div>
        
        <!-- Stats grid -->
        <div class="grid gap-3 sm:gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {stats.map((s) => (
            <div class="rounded-[1.5rem] bg-background/95 px-4 py-5 sm:px-5 sm:py-6 ring-1 ring-border/25 shadow-card">
              <div class="text-xs font-semibold uppercase tracking-[0.28em] text-foreground/60 dark:text-foreground-light/65 mb-3 sm:mb-4">{s.label}</div>
              <div class="text-xl sm:text-2xl font-semibold text-foreground dark:text-foreground-light">{s.value}</div>
            </div>
          ))}
        </div>
        
        <!-- Call to action buttons -->
        <div class="flex flex-col sm:flex-row flex-wrap gap-3 sm:gap-4">
          <a 
            href="/contact/" 
            class="inline-flex min-h-[48px] items-center justify-center gap-2 rounded-full bg-accent px-6 sm:px-7 py-3 text-sm font-semibold text-on-accent shadow-accent-glow transition-colors hover:bg-accent-dark focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent/65 focus-visible:ring-offset-2"
            aria-describedby="projects-title"
          >
            Start a project conversation
          </a>
          <a 
            href="/about/" 
            class="inline-flex min-h-[48px] items-center justify-center gap-2 rounded-full px-6 sm:px-7 py-3 text-sm font-semibold text-accent ring-1 ring-accent/40 transition-all hover:ring-accent hover:text-accent-dark focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent/60 focus-visible:ring-offset-2"
          >
            See how I work
          </a>
        </div>
      </div>

      <!-- Hero Sidebar -->
      <div class="flex flex-col gap-6 sm:gap-8">
        {featuredProject && <ProjectCard project={featuredProject} featured />}
        
        <ProjectDetailSection 
          title="Operating rhythm" 
          eyebrow="Process"
          layout="surface"
          description="Structured methodology for transformation projects"
        >
          <ol class="space-y-3 sm:space-y-4 text-sm leading-relaxed text-foreground/75 dark:text-foreground-light/75">
            {heroHighlights.map((step, index) => (
              <li class="flex items-start gap-3 sm:gap-4 rounded-xl sm:rounded-2xl bg-surface-subtle px-3 py-2 sm:px-4 sm:py-3 ring-1 ring-border/25 transition-colors duration-200 group-hover:ring-border/40 dark:bg-surface-dark-subtle">
                <span class="mt-0.5 inline-flex h-8 w-8 sm:h-9 sm:w-9 items-center justify-center rounded-xl sm:rounded-2xl bg-accent/15 text-xs font-semibold uppercase tracking-[0.28em] text-accent flex-shrink-0">
                  {String(index + 1).padStart(2, '0')}
                </span>
                <span class="pt-1">{step}</span>
              </li>
            ))}
          </ol>
          {remainingMethodology.length > 0 && (
            <p class="text-xs uppercase tracking-[0.32em] text-foreground/55 dark:text-foreground-light/60 border-t border-border/20 pt-4">
              …and {remainingMethodology.length} more stages carried through launch.
            </p>
          )}
        </ProjectDetailSection>
      </div>
    </div>
  </section>

  <!-- Methodology Section -->
  <section class="border-y border-border/30 bg-background/98 py-20 sm:py-24" role="region" aria-labelledby="methodology-heading" data-a11y-allow-color-contrast>
    <div class="layout-shell-wide grid gap-12 sm:gap-16 lg:grid-cols-[minmax(0,1.05fr)_minmax(0,0.95fr)] lg:items-start xl:gap-20">
      <!-- Methodology Description -->
      <div class="space-y-6 sm:space-y-8 text-pretty">
        <span class="inline-flex items-center gap-2 rounded-full bg-surface-subtle px-3 py-1.5 text-[0.7rem] font-semibold uppercase tracking-[0.28em] text-foreground/70 ring-1 ring-border/35 dark:bg-surface-dark-subtle w-fit">
          Playbook in motion
        </span>
        <header class="space-y-4 sm:space-y-5">
          <h2 id="methodology-heading" class="font-heading text-2xl sm:text-3xl md:text-4xl font-semibold text-foreground dark:text-foreground-light">
            Transformation that stays anchored in outcomes
          </h2>
          <p class="text-sm sm:text-base leading-relaxed text-foreground/75 dark:text-foreground-light/75 max-w-2xl">
            Each engagement moves through a measurable rhythm—from discovery to adoption—keeping leaders informed, coaching teams, and proving value every sprint.
          </p>
        </header>
        
        <div class="space-y-3 sm:space-y-4">
          {proofPoints.map((point) => (
            <div class="flex items-start gap-3 sm:gap-4 rounded-2xl bg-background/95 px-4 py-4 sm:px-5 sm:py-5 ring-1 ring-border/30 shadow-card">
              <span class="mt-1 h-2 w-2 rounded-full bg-accent flex-shrink-0" aria-hidden="true"></span>
              <div class="space-y-1 min-w-0">
                <p class="text-sm font-semibold text-foreground dark:text-foreground-light">{point.title}</p>
                <p class="text-sm leading-relaxed text-foreground/70 dark:text-foreground-light/70">{point.detail}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
      <!-- Methodology Sidebar -->
      <div class="flex flex-col gap-4 sm:gap-6">
        <div class="rounded-[2rem] sm:rounded-[2.5rem] bg-gradient-to-br from-surface/80 via-background/90 to-surface/70 p-6 sm:p-8 ring-1 ring-border/30 shadow-accent-glow">
          <p class="text-xs font-semibold uppercase tracking-[0.3em] text-foreground/55 dark:text-foreground-light/60 mb-3 sm:mb-4">What leaders notice</p>
          <blockquote class="text-sm leading-relaxed text-foreground/75 dark:text-foreground-light/75 mb-4 sm:mb-6">
            "We knew the change would stick because we could see capability, adoption, and ROI trending in the same dashboard every week."
          </blockquote>
          <cite class="text-xs uppercase tracking-[0.3em] text-foreground/60 dark:text-foreground-light/65 not-italic">Global finance executive · change program</cite>
        </div>
        
        <div class="rounded-[2rem] sm:rounded-[2.5rem] bg-background/94 p-6 sm:p-8 ring-1 ring-border/30 shadow-card">
          <p class="text-xs font-semibold uppercase tracking-[0.3em] text-foreground/55 dark:text-foreground-light/60 mb-4 sm:mb-5">Signals of progress</p>
          <ul class="space-y-2 sm:space-y-3 text-sm leading-relaxed text-foreground/70 dark:text-foreground-light/70" role="list">
            <li class="flex items-start gap-3">
              <span class="mt-1.5 h-1.5 w-1.5 rounded-full bg-accent flex-shrink-0" aria-hidden="true"></span>
              <span>Visibility into automation ROI and capacity gains</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="mt-1.5 h-1.5 w-1.5 rounded-full bg-accent flex-shrink-0" aria-hidden="true"></span>
              <span>Adoption baked into every release plan and playbook</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="mt-1.5 h-1.5 w-1.5 rounded-full bg-accent flex-shrink-0" aria-hidden="true"></span>
              <span>Feedback loops connecting product, finance, and operations</span>
            </li>
          </ul>
        </div>
      </div>
    </div>

    <!-- Methodology Steps Grid -->
    <div class="layout-shell-wide">
      <ol class="grid gap-4 sm:gap-5 grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-5" role="list">
        {methodology.map((m, index) => (
          <li class="group relative flex flex-col gap-4 sm:gap-5 rounded-2xl bg-surface-subtle p-5 sm:p-6 ring-1 ring-border/35 transition-all duration-200 hover:-translate-y-1 hover:shadow-lg dark:bg-surface-dark-subtle">
            <span class="inline-flex h-9 w-9 sm:h-10 sm:w-10 items-center justify-center rounded-xl sm:rounded-2xl bg-accent/15 text-xs font-semibold uppercase tracking-[0.28em] text-accent flex-shrink-0">
              {String(index + 1).padStart(2, '0')}
            </span>
            <p class="text-sm font-medium leading-relaxed text-foreground/75 dark:text-foreground-light/75">{m}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Case Studies Section -->
  <section class="relative isolate overflow-hidden bg-gradient-to-b from-surface/35 via-background to-background py-20 sm:py-24 md:py-28" role="region" aria-labelledby="case-studies-heading">
    <div class="pointer-events-none absolute inset-0 bg-grid-overlay/35 [background-size:180px_180px] sm:[background-size:200px_200px]" aria-hidden="true"></div>
    <div class="layout-shell-wide relative space-y-12 sm:space-y-16">
      <!-- Section Header -->
      <div class="grid gap-6 sm:gap-8 lg:grid-cols-[minmax(0,1.05fr)_minmax(0,0.95fr)] lg:items-end">
        <header class="space-y-4 sm:space-y-5 text-pretty">
          <span class="inline-flex items-center gap-2 rounded-full bg-background/90 px-3 py-1 text-[0.7rem] font-semibold uppercase tracking-[0.28em] text-foreground/70 ring-1 ring-border/35 w-fit">
            Case study library
          </span>
          <h2 id="case-studies-heading" class="font-heading text-2xl sm:text-3xl md:text-4xl font-semibold text-foreground dark:text-foreground-light">
            Projects that pair strategy with execution
          </h2>
          <p class="text-sm sm:text-base leading-relaxed text-foreground/75 dark:text-foreground-light/75 max-w-2xl">
            Real stories across healthcare, finance, and product—illustrating how operational rigor, platform expertise, and change leadership come together.
          </p>
        </header>
        
        <!-- Category Tags -->
        <div class="flex flex-wrap justify-start lg:justify-end gap-2 text-xs font-semibold uppercase tracking-[0.28em] text-foreground/60 dark:text-foreground-light/65" role="list" aria-label="Project categories">
          <span class="rounded-full bg-background/90 px-3 py-1 ring-1 ring-border/40" role="listitem">Automation</span>
          <span class="rounded-full bg-background/90 px-3 py-1 ring-1 ring-border/40" role="listitem">Analytics</span>
          <span class="rounded-full bg-background/90 px-3 py-1 ring-1 ring-border/40" role="listitem">Change enablement</span>
          <span class="rounded-full bg-background/90 px-3 py-1 ring-1 ring-border/40" role="listitem">Compliance</span>
        </div>
      </div>

      <!-- Featured Project Showcase -->
      {featuredProject && (
        <div class="grid gap-8 sm:gap-10 lg:grid-cols-[minmax(0,1.15fr)_minmax(0,0.85fr)] lg:items-center xl:gap-12">
          <ProjectCard project={featuredProject} featured />
          
          <ProjectDetailSection 
            title={featuredProject.data.title} 
            eyebrow="Featured case study"
            description={featuredProject.data.description}
          >
            {Array.isArray(featuredProject.data.tags) && featuredProject.data.tags.length > 0 && (
              <div class="flex flex-wrap gap-2 text-[0.7rem] font-semibold uppercase tracking-[0.28em] text-foreground/60 dark:text-foreground-light/65" role="list" aria-label="Project technologies">
                {featuredProject.data.tags.map((tag: string) => (
                  <span class="rounded-full bg-surface-subtle px-3 py-1 ring-1 ring-border/25 dark:bg-surface-dark-subtle" role="listitem">{tag}</span>
                ))}
              </div>
            )}
            
            <div class="grid gap-3 sm:gap-4 sm:grid-cols-2">
              {stats.slice(0, 2).map((s) => (
                <div class="rounded-xl sm:rounded-2xl bg-surface-subtle px-3 py-3 sm:px-4 sm:py-4 ring-1 ring-border/25 dark:bg-surface-dark-subtle">
                  <div class="text-xs font-semibold uppercase tracking-[0.28em] text-foreground/55 dark:text-foreground-light/60 mb-2">{s.label}</div>
                  <div class="text-base sm:text-lg font-semibold text-accent">{s.value}</div>
                </div>
              ))}
            </div>
            
            <a
              href={`/projects/${featuredProject.slug}/`}
              aria-label={`View project: ${featuredProject.data.title}`}
              class="inline-flex min-h-[44px] items-center gap-2 rounded-full bg-accent px-5 py-2 text-sm font-semibold text-on-accent transition-colors hover:bg-accent-dark focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent/60 focus-visible:ring-offset-2"
            >
              View the project
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M5 12h14m-6-6 6 6-6 6" />
              </svg>
            </a>
          </ProjectDetailSection>
        </div>
      )}

      <!-- Selected Projects Grid -->
      <div class="space-y-6 sm:space-y-8">
        <div class="flex flex-col sm:flex-row flex-wrap items-start sm:items-end justify-between gap-4 text-pretty">
          <header class="space-y-2">
            <h3 class="font-heading text-xl sm:text-2xl font-semibold text-foreground dark:text-foreground-light">Selected engagements</h3>
            <p class="text-sm leading-relaxed text-foreground/70 dark:text-foreground-light/70 max-w-2xl">A snapshot of the work closing gaps between insight, enablement, and delivery velocity.</p>
          </header>
          <a 
            href="/contact/" 
            class="inline-flex min-h-[40px] items-center justify-center gap-2 rounded-full px-4 py-2 text-xs font-semibold uppercase tracking-[0.28em] text-accent ring-1 ring-accent/30 transition-all hover:text-accent-dark hover:ring-accent focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent/60 focus-visible:ring-offset-2"
            aria-describedby="case-studies-heading"
          >
            Request full portfolio
          </a>
        </div>
        
        <div class="grid gap-6 sm:gap-8 sm:grid-cols-2 xl:grid-cols-3">
          {limitedProjects.map((project) => (
            <ProjectRow project={project} />
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="relative isolate overflow-hidden bg-gradient-to-br from-background/98 via-surface-subtle to-background/85 py-24 sm:py-28">
    <div class="pointer-events-none absolute inset-0 bg-grid-overlay/35 [background-size:200px_200px]" aria-hidden="true"></div>
    <div class="pointer-events-none absolute left-[-8rem] top-4 h-72 w-72 rounded-full bg-accent/15 blur-[110px]" aria-hidden="true"></div>
    <div class="pointer-events-none absolute right-[-6rem] bottom-[-4rem] h-72 w-72 rounded-full bg-accent/12 blur-[120px]" aria-hidden="true"></div>
    <div class="layout-shell-wide relative grid gap-12 lg:grid-cols-[minmax(0,1.25fr)_minmax(0,0.75fr)] lg:items-center">
      <div class="space-y-6 text-pretty">
        <span class="inline-flex items-center gap-2 rounded-full bg-accent/15 px-4 py-1.5 text-[0.75rem] font-semibold uppercase tracking-[0.3em] text-accent ring-1 ring-accent/30">
          Ready to move from idea to deployment?
        </span>
        <h2 class="font-heading text-2xl sm:text-3xl lg:text-[2.3rem] font-semibold text-foreground dark:text-foreground-light">
          Let’s architect the next leap forward together
        </h2>
        <p class="text-base leading-relaxed text-foreground/75 dark:text-foreground-light/75">
          Bring a problem space and we’ll map the operational backbone—automation, analytics, and change enablement—without losing momentum or clarity for stakeholders.
        </p>
        <div class="flex flex-wrap items-center gap-3">
          <a href="/contact/" class="inline-flex min-h-[48px] items-center justify-center gap-2 rounded-full bg-accent px-6 py-2.5 text-sm font-semibold text-on-accent shadow-accent-glow transition hover:bg-accent-dark focus-visible:ring-2 focus-visible:ring-accent/60">
            Start a project conversation
          </a>
          <a href="/about/" class="inline-flex min-h-[48px] items-center justify-center gap-2 rounded-full px-6 py-2.5 text-sm font-semibold text-accent ring-1 ring-accent/35 transition hover:ring-accent hover:text-accent-dark focus-visible:ring-2 focus-visible:ring-accent/60">
            See how I work
          </a>
        </div>
        <div class="flex flex-wrap gap-2 text-xs font-semibold uppercase tracking-[0.28em] text-foreground/65 dark:text-foreground-light/65">
          {focus.map((f) => (
            <span class="inline-flex items-center gap-2 rounded-full bg-background/92 px-3 py-1 ring-1 ring-border/30">
              <span class="h-1.5 w-1.5 rounded-full bg-accent/70"></span>
              {f}
            </span>
          ))}
        </div>
      </div>
      <ProjectDetailSection 
        title="Kickoff path" 
        eyebrow="Next steps"
        layout="surface"
      >
        <ol class="space-y-3 sm:space-y-4 text-sm leading-relaxed text-foreground/75 dark:text-foreground-light/75">
          {methodology.map((m, i) => (
            <li class="flex gap-3 sm:gap-4 rounded-xl sm:rounded-2xl bg-surface-subtle px-3 py-2 sm:px-4 sm:py-3 ring-1 ring-border/25 dark:bg-surface-dark-subtle">
              <span class="flex h-8 w-8 sm:h-9 sm:w-9 items-center justify-center rounded-xl sm:rounded-2xl bg-accent/15 text-xs font-semibold uppercase tracking-[0.3em] text-accent flex-shrink-0">
                {String(i + 1).padStart(2, '0')}
              </span>
              <span class="pt-1">{m}</span>
            </li>
          ))}
        </ol>
      </ProjectDetailSection>
    </div>
  </section>
</Layout>
