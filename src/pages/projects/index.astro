---
import Layout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/features/projects/ProjectCard.astro';
import ProjectDetailSection from '../../components/features/projects/ProjectDetailSection.astro';
import { getProjectsSorted } from '../../content/projects/getProjects';

const meta = (await import('../../content/projects/_meta.json')).default;
const hero = meta.hero;
const approach = meta.approach;
const grid = meta.grid;

const projects = await getProjectsSorted();

const title = 'Blake Oxford\'s Projects';
const description = 'Explore my portfolio of systems architecture, digital transformation, and development projects.';
const canonicalUrl = 'https://blakeoxford.com/projects/';

---

<Layout title={title} description={description} url={canonicalUrl} wide>
  <section class="bg-gradient-to-b from-background via-accent/5 to-background py-20 sm:py-24 md:py-28" role="region" aria-labelledby="projects-title">
    <div class="@container mx-auto w-full max-w-6xl px-4 sm:px-6 lg:px-8 flex flex-col gap-10 sm:gap-12 lg:gap-14 text-pretty">
      <div class="max-w-3xl space-y-6 sm:space-y-7">
        <span class="inline-flex w-fit items-center gap-2 rounded-full bg-surface-subtle px-4 py-1.5 text-xs font-semibold uppercase tracking-[0.28em] text-foreground/65 ring-1 ring-border/40 dark:bg-surface-dark-subtle backdrop-blur-sm">
          {hero.kicker}
        </span>
        <header class="space-y-4 sm:space-y-5">
          <h1 id="projects-title" class="font-heading text-4xl sm:text-5xl md:text-6xl font-bold leading-tight text-foreground dark:text-foreground-light">
            {hero.title}
          </h1>
          <p class="text-xl sm:text-2xl font-semibold text-foreground dark:text-foreground-light">
            {hero.subtitle}
          </p>
          <p class="text-base sm:text-lg leading-relaxed text-foreground/80 dark:text-foreground-light/80">
            {hero.description}
          </p>
        </header>
      </div>

      <div class="flex flex-wrap gap-2 text-xs font-semibold uppercase tracking-[0.28em] text-foreground/60 dark:text-foreground-light/60" role="list" aria-label="Focus areas">
        {hero.focusAreas.map((area) => (
          <span class="inline-flex items-center gap-2 rounded-full bg-surface-subtle px-3 py-1 ring-1 ring-border/35 dark:bg-surface-dark-subtle" role="listitem">
            <span class="h-1.5 w-1.5 rounded-full bg-accent/70" aria-hidden="true"></span>
            {area}
          </span>
        ))}
      </div>

      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {hero.stats.map((stat) => (
          <div class="rounded-2xl bg-background px-4 py-5 sm:px-5 sm:py-6 ring-1 ring-border/30 shadow-lg">
            <p class="mb-3 sm:mb-4 text-xs font-semibold uppercase tracking-[0.28em] text-foreground/55 dark:text-foreground-light/60">{stat.label}</p>
            <p class="text-xl sm:text-2xl font-semibold text-foreground dark:text-foreground-light">{stat.value}</p>
          </div>
        ))}
      </div>

      <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:gap-4">
        {hero.primaryCta && (
          <a
            href={hero.primaryCta.href}
            class="inline-flex min-h-[48px] items-center justify-center gap-2 rounded-full bg-accent px-6 sm:px-7 py-3 text-sm font-semibold text-on-accent shadow-accent-glow transition-colors hover:bg-accent-dark focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent/65 focus-visible:ring-offset-2"
          >
            {hero.primaryCta.label}
          </a>
        )}
        {hero.secondaryCta && (
          <a
            href={hero.secondaryCta.href}
            class="inline-flex min-h-[48px] items-center justify-center gap-2 rounded-full px-6 sm:px-7 py-3 text-sm font-semibold text-accent ring-1 ring-accent/40 transition-all hover:text-accent-dark hover:ring-accent focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent/60 focus-visible:ring-offset-2"
          >
            {hero.secondaryCta.label}
          </a>
        )}
      </div>
    </div>
  </section>

  {approach && (
    <section class="border-t border-border/20 bg-surface-subtle/40 py-16 sm:py-20" role="region" aria-labelledby="journey-heading">
      <div class="mx-auto w-full max-w-6xl px-4 sm:px-6 lg:px-8 flex flex-col gap-10 sm:gap-12 text-pretty">
        <ProjectDetailSection
          id="journey-heading"
          eyebrow={approach.kicker}
          title={approach.title}
          description={approach.description}
          subtitle={approach.subtitle}
          layout="surface"
        >
          <div class="grid gap-4 sm:gap-6 lg:grid-cols-5">
            {approach.stages.map((stage) => (
              <article class="flex h-full flex-col gap-4 rounded-3xl border border-border/25 bg-background/95 p-4 sm:p-5 shadow-sm">
                <header class="space-y-1.5">
                  <p class="text-[0.65rem] font-semibold uppercase tracking-[0.35em] text-foreground/55 dark:text-foreground-light/55">
                    Stage
                  </p>
                  <h3 class="text-base font-semibold text-foreground dark:text-foreground-light">{stage.title}</h3>
                </header>
                <p class="text-sm leading-relaxed text-foreground/75 dark:text-foreground-light/75">{stage.summary}</p>
                {Array.isArray(stage.proof) && stage.proof.length > 0 && (
                  <ul class="mt-auto flex flex-col gap-2 text-xs leading-relaxed text-foreground/65 dark:text-foreground-light/70" role="list">
                    {stage.proof.map((item) => (
                      <li class="flex items-start gap-2">
                        <span class="mt-1 block h-1.5 w-1.5 rounded-full bg-accent" aria-hidden="true"></span>
                        <span>{item}</span>
                      </li>
                    ))}
                  </ul>
                )}
              </article>
            ))}
          </div>

          <div class="grid gap-4 sm:gap-5 lg:grid-cols-3">
            {approach.signals.map((signal) => (
              <div class="flex flex-col gap-3 rounded-3xl border border-dashed border-border/45 bg-surface-subtle/65 p-4 sm:p-6">
                <h3 class="text-xs font-semibold uppercase tracking-[0.4em] text-foreground/60 dark:text-foreground-light/60">
                  Signal of success
                </h3>
                <p class="text-sm leading-relaxed text-foreground/75 dark:text-foreground-light/75">{signal}</p>
              </div>
            ))}
          </div>

          {approach.cta && (
            <div class="grid gap-4 rounded-3xl border border-border/25 bg-background/95 p-6 sm:p-8 lg:p-10 lg:grid-cols-[2fr_minmax(0,1fr)] lg:items-center">
              <div class="space-y-4">
                <h3 class="text-2xl font-semibold text-foreground dark:text-foreground-light">{approach.cta.title}</h3>
                <p class="text-sm sm:text-base leading-relaxed text-foreground/75 dark:text-foreground-light/75">{approach.cta.description}</p>
              </div>
              <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-end sm:gap-4">
                {approach.cta.primaryCta && (
                  <a
                    href={approach.cta.primaryCta.href}
                    class="inline-flex min-h-[48px] items-center justify-center gap-2 rounded-full bg-accent px-6 sm:px-7 py-3 text-sm font-semibold text-on-accent shadow-accent-glow transition-colors hover:bg-accent-dark focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent/65 focus-visible:ring-offset-2"
                  >
                    {approach.cta.primaryCta.label}
                  </a>
                )}
                {approach.cta.secondaryCta && (
                  <a
                    href={approach.cta.secondaryCta.href}
                    class="inline-flex min-h-[48px] items-center justify-center gap-2 rounded-full px-6 sm:px-7 py-3 text-sm font-semibold text-accent ring-1 ring-accent/40 transition-all hover:text-accent-dark hover:ring-accent focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent/60 focus-visible:ring-offset-2"
                  >
                    {approach.cta.secondaryCta.label}
                  </a>
                )}
              </div>
            </div>
          )}
        </ProjectDetailSection>
      </div>
    </section>
  )}

  <section class="border-t border-border/20 bg-background py-16 sm:py-20" role="region" aria-labelledby="projects-grid-heading">
    <div class="mx-auto w-full max-w-6xl px-4 sm:px-6 lg:px-8 flex flex-col gap-8 sm:gap-10 text-pretty">
      <header class="max-w-3xl space-y-3 sm:space-y-4">
        <span class="inline-flex w-fit items-center gap-2 rounded-full bg-surface-subtle px-3 py-1 text-[0.7rem] font-semibold uppercase tracking-[0.28em] text-foreground/65 ring-1 ring-border/35 dark:bg-surface-dark-subtle">
          {grid.kicker}
        </span>
        <h2 id="projects-grid-heading" class="font-heading text-2xl sm:text-3xl md:text-4xl font-semibold text-foreground dark:text-foreground-light">
          {grid.title}
        </h2>
        <p class="text-sm sm:text-base leading-relaxed text-foreground/75 dark:text-foreground-light/75">
          {grid.description}
        </p>
      </header>

      <div class="grid gap-6 md:grid-cols-2 xl:grid-cols-3">
        {projects.map((project) => (
          <ProjectCard project={project} />
        ))}
      </div>
    </div>
  </section>
</Layout>
