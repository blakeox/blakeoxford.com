---
import Layout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/features/projects/ProjectCard.astro';
import Stack from '../../components/primitives/Stack.astro';
import Section from '../../components/primitives/Section.astro';
import Grid from '../../components/primitives/Grid.astro';
import Flex from '../../components/primitives/Flex.astro';
import Button from '../../components/primitives/Button.astro';
import ButtonGroup from '../../components/composites/ButtonGroup.astro';
import StatsCard from '../../components/composites/StatsCard.astro';
import BadgePill from '../../components/primitives/BadgePill.astro';
import { getProjectsSorted } from '../../content/projects/getProjects';

const meta = (await import('../../content/projects/_meta.json')).default;
const hero = meta.hero;

const projects = await getProjectsSorted();

const title = 'Blake Oxford\'s Projects';
const description = 'Explore my portfolio of systems architecture, digital transformation, and development projects.';
const canonicalUrl = 'https://blakeoxford.com/projects/';

---

<Layout title={title} description={description} url={canonicalUrl} wide>
  <Section
    id="projects-hero"
    padding="xl"
    container="lg"
    background="gradient"
    role="region"
    aria-labelledby="projects-title"
    data-layout-section="projects-hero"
  >
    <Stack space="2xl" class="@container text-pretty" data-layout-shell="projects-hero-inner">
      <Stack space="lg" class="max-w-3xl" as="header">
          <h1 id="projects-title" class="font-heading text-4xl sm:text-5xl md:text-6xl font-bold leading-tight text-foreground dark:text-foreground-light">
            Selected Projects
          </h1>
          <p class="text-base sm:text-lg leading-relaxed text-foreground/80 dark:text-foreground-light/80">
            Systems architecture, automation, and digital transformation work that delivered measurable results. Each engagement combines technical depth with the change programming needed to keep adoption high.
          </p>
      </Stack>

      <Flex wrap gap="sm" class="text-xs font-semibold uppercase tracking-label text-foreground/60 dark:text-foreground-light/60" role="list" aria-label="Focus areas">
        {hero.focusAreas.map((area) => (
          <span role="listitem">
            <BadgePill size="sm">
              {area}
            </BadgePill>
          </span>
        ))}
      </Flex>
    </Stack>
  </Section>

  <!-- Projects Grid -->
  <Section
    padding="lg"
    container="lg"
    class="border-t border-border/20 bg-background"
    role="region"
    aria-labelledby="projects-grid-heading"
    data-layout-section="projects-grid"
  >
    <Stack space="xl" class="text-pretty" data-layout-shell="projects-grid-inner">
      <Stack space="md" class="max-w-3xl">
        <BadgePill size="xs" class="w-fit">
          Case Studies
        </BadgePill>
        <h2 id="projects-grid-heading" class="font-heading text-2xl sm:text-3xl md:text-4xl font-semibold text-foreground dark:text-foreground-light">
          Recent Engagements
        </h2>
        <p class="text-sm sm:text-base leading-relaxed text-foreground/80 dark:text-foreground-light/80">
          Explore programs where automation, analytics, and enablement launched together—strategy turned into operating rhythms that teams keep running.
        </p>
      </Stack>

      <Grid cols="3" gap="lg">
        {projects.map((project) => (
          <ProjectCard project={project} />
        ))}
      </Grid>
    </Stack>
  </Section>

  <!-- Impact Section -->
  <Section
    padding="lg"
    container="lg"
    class="border-t border-border/20 bg-surface-subtle/40"
    role="region"
    aria-labelledby="results-heading"
    data-layout-section="projects-impact"
  >
    <Stack space="xl" class="text-pretty" data-layout-shell="projects-impact-inner">
      <Stack space="md" class="max-w-3xl">
        <BadgePill size="xs" class="w-fit">
          Impact Metrics
        </BadgePill>
        <h2 id="results-heading" class="font-heading text-2xl sm:text-3xl md:text-4xl font-semibold text-foreground dark:text-foreground-light">
          Results that stick
        </h2>
        <p class="text-sm sm:text-base leading-relaxed text-foreground/80 dark:text-foreground-light/80">
          Measurable outcomes from programs where automation and change enablement launched together.
        </p>
      </Stack>

      <Grid cols="3" gap="md">
        {hero.stats.map((stat) => (
          <StatsCard label={stat.label} value={stat.value} variant="default" size="md" />
        ))}
      </Grid>
    </Stack>
  </Section>

  <!-- CTA Section -->
  <Section
    padding="lg"
    container="md"
    class="border-t border-border/20 bg-background"
    role="region"
    aria-labelledby="cta-heading"
    data-layout-section="projects-cta"
  >
    <Stack space="lg" class="text-center" data-layout-shell="projects-cta-inner">
        <h2 id="cta-heading" class="font-heading text-2xl sm:text-3xl md:text-4xl font-semibold leading-tight text-foreground dark:text-foreground-light">
          Ready to line up the next leap?
        </h2>
        <p class="text-base sm:text-lg leading-relaxed text-foreground/80 dark:text-foreground-light/80">
          Bring the problem space and we'll map the operating backbone—automation, analytics, and change enablement—without losing clarity for stakeholders.
        </p>
        <ButtonGroup align="center" responsive>
          <Button
            variant="outline"
            href="/contact/"
          >
            Start a project conversation
          </Button>
          <Button
            variant="ghost"
            href="/about/"
          >
            See how I work
          </Button>
        </ButtonGroup>
    </Stack>
  </Section>
</Layout>
