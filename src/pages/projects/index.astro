---
import Layout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/features/projects/ProjectCard.astro';
import { getProjectsSorted } from '../../content/projects/getProjects';

const meta = (await import('../../content/projects/_meta.json')).default;
const hero = meta.hero;

const projects = await getProjectsSorted();

const title = 'Blake Oxford\'s Projects';
const description = 'Explore my portfolio of systems architecture, digital transformation, and development projects.';
const canonicalUrl = 'https://blakeoxford.com/projects/';

---

<Layout title={title} description={description} url={canonicalUrl} wide>
  <section class="bg-gradient-to-b from-background via-accent/3 to-background/95 pb-24 sm:pb-32 md:pb-40" role="region" aria-labelledby="projects-title">
    <div class="@container mx-auto w-full max-w-7xl px-4 sm:px-6 lg:px-8 flex flex-col gap-12 sm:gap-16 lg:gap-20 text-pretty">
      <div class="max-w-5xl space-y-8 sm:space-y-10">
        <header class="space-y-6 sm:space-y-8 text-center">
          <div class="space-y-4">
            <span class="inline-flex w-fit items-center gap-2 rounded-full bg-accent/10 px-4 py-2 text-xs font-semibold uppercase tracking-wider text-accent border border-accent/20">
              Portfolio Showcase
            </span>
            <h1 id="projects-title" class="font-heading text-5xl sm:text-6xl md:text-7xl font-bold leading-[0.9] tracking-tight text-foreground dark:text-foreground-light">
              Selected Projects
            </h1>
          </div>
          <p class="text-xl sm:text-2xl font-medium leading-relaxed text-foreground/80 dark:text-foreground-light/80 max-w-4xl mx-auto">
            Systems architecture, automation, and digital transformation work that delivered measurable results
          </p>
        </header>

        <!-- Quick Navigation -->
        <div class="flex flex-wrap justify-center gap-3 pt-4" role="list" aria-label="Project categories">
          {hero.focusAreas.map((area) => (
            <button class="group inline-flex items-center gap-2 rounded-full bg-surface-subtle/80 hover:bg-accent/10 px-4 py-2.5 text-sm font-medium text-foreground/70 hover:text-accent ring-1 ring-border/30 hover:ring-accent/30 transition-all duration-200" role="listitem">
              <span class="h-2 w-2 rounded-full bg-current opacity-60 group-hover:opacity-100" aria-hidden="true"></span>
              {area}
            </button>
          ))}
          <button class="inline-flex items-center gap-2 rounded-full bg-background px-4 py-2.5 text-sm font-medium text-foreground ring-1 ring-border/40 hover:ring-accent/30 transition-all duration-200">
            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
            View All
          </button>
        </div>
      </div>


    </div>
  </section>

  <!-- Projects Grid - Priority Content -->
  <section class="bg-background py-16 sm:py-20" role="region" aria-labelledby="projects-grid-heading">
    <div class="mx-auto w-full max-w-7xl px-4 sm:px-6 lg:px-8 flex flex-col gap-10 sm:gap-12 text-pretty">
      <div class="grid gap-8 sm:gap-10 md:grid-cols-2 xl:grid-cols-3">
        {projects.map((project) => (
          <ProjectCard project={project} />
        ))}
      </div>
    </div>
  </section>

  <!-- Results & Testimonials Section -->
  <section class="border-t border-border/10 bg-surface-subtle/30 py-16 sm:py-20" role="region" aria-labelledby="results-heading">
    <div class="mx-auto w-full max-w-6xl px-4 sm:px-6 lg:px-8 flex flex-col gap-10 sm:gap-12 text-pretty">
      <header class="max-w-3xl space-y-4 text-center mx-auto">
        <span class="inline-flex w-fit items-center gap-2 rounded-full bg-accent/10 px-4 py-2 text-xs font-semibold uppercase tracking-wider text-accent border border-accent/20">
          Impact
        </span>
        <h2 id="results-heading" class="font-heading text-3xl sm:text-4xl font-bold leading-tight text-foreground dark:text-foreground-light">
          Results that matter
        </h2>
        <p class="text-base sm:text-lg leading-relaxed text-foreground/70 dark:text-foreground-light/70">
          Measurable outcomes from real implementations
        </p>
      </header>

      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {hero.stats.map((stat) => (
          <div class="group rounded-2xl bg-background/80 backdrop-blur-sm px-6 py-6 sm:px-7 sm:py-7 ring-1 ring-border/20 shadow-sm hover:shadow-md hover:ring-border/30 transition-all duration-300 text-center">
            <p class="text-3xl sm:text-4xl font-bold text-accent dark:text-accent-light group-hover:scale-105 transition-transform duration-300 mb-3">{stat.value}</p>
            <p class="text-sm font-medium text-foreground/70 dark:text-foreground-light/70">{stat.label}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="border-t border-border/10 bg-background py-16 sm:py-20" role="region" aria-labelledby="cta-heading">
    <div class="mx-auto w-full max-w-4xl px-4 sm:px-6 lg:px-8 text-center">
      <div class="space-y-6 sm:space-y-8">
        <h2 id="cta-heading" class="font-heading text-3xl sm:text-4xl font-bold leading-tight text-foreground dark:text-foreground-light">
          Ready to discuss your next project?
        </h2>
        <p class="text-lg leading-relaxed text-foreground/75 dark:text-foreground-light/75 max-w-2xl mx-auto">
          Let's explore how systems thinking and automation can accelerate your business objectives.
        </p>
        <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-center sm:gap-6 pt-4">
          <a
            href="/contact/"
            class="inline-flex min-h-[52px] items-center justify-center gap-2 rounded-full border-2 border-accent/60 px-8 py-4 text-base font-semibold text-accent shadow-accent-glow transition-colors hover:border-accent hover:text-accent-dark dark:hover:text-accent-light focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent/65 focus-visible:ring-offset-2"
          >
            Start a conversation
          </a>
          <a
            href="/about/"
            class="inline-flex min-h-[52px] items-center justify-center gap-2 rounded-full px-8 py-4 text-base font-medium text-foreground/80 ring-1 ring-border/40 hover:ring-accent/30 hover:text-foreground transition-all focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent/60 focus-visible:ring-offset-2"
          >
            Learn about my approach
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>
