---
import Layout from '../../layouts/BaseLayout.astro';
import ProjectRow from '../../components/features/projects/ProjectRow.astro';
import { featuredProjectsData } from '../../config/data';

// Use centralized projects data
const projects = featuredProjectsData;

const title = 'Blake Oxford\'s Projects';
const description = 'Explore my portfolio of systems architecture, digital transformation, and development projects.';
const canonicalUrl = 'https://blakeoxford.com/projects/';
---

<Layout title={title} description={description} url={canonicalUrl} wide>
  <!-- Projects Header Section -->
  <section class="w-full py-16 md:py-24 px-4 relative overflow-hidden bg-gradient-to-br from-background via-accent/5 to-background" role="region" aria-labelledby="projects-title">
    <!-- Background pattern -->
    <div class="absolute inset-0 z-0 opacity-20 pointer-events-none">
      <svg class="absolute inset-0 w-full h-full" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <pattern id="projects-grid" width="40" height="40" patternUnits="userSpaceOnUse">
            <path d="M0 40L40 0M20 40L40 20M0 20L20 0" fill="none" stroke="currentColor" stroke-width="1" stroke-opacity="0.12" />
          </pattern>
        </defs>
        <rect width="100%" height="100%" fill="url(#projects-grid)" />
      </svg>
    </div>
    <!-- Floating shapes -->
    <div class="absolute top-0 right-0 w-64 h-64 bg-accent/20 rounded-full blur-3xl transform translate-x-1/2 -translate-y-1/2 pointer-events-none"></div>
    <div class="absolute bottom-0 left-0 w-48 h-48 bg-accent/20 rounded-full blur-3xl transform -translate-x-1/2 translate-y-1/2 pointer-events-none"></div>

    <div class="relative z-10 max-w-4xl mx-auto text-center">
      <h1 id="projects-title" class="font-heading font-bold text-4xl md:text-5xl lg:text-6xl text-accent dark:text-accent-light mb-6 animate-fade-in">Projects</h1>
      <p class="text-lead text-foreground dark:text-foreground-light animate-fade-in mb-8">
        Explore a curated collection of projects showcasing key skills in process automation, finance, and more.
      </p>
      <p class="text-lg text-foreground dark:text-foreground-light animate-fade-in">
        Below you'll find my methodology and approach, followed by detailed case studies of my work.
      </p>
    </div>
  </section>

  <!-- Transition Section -->
  <section class="w-full py-8 md:py-12 px-4 relative" role="region">
    <!-- Curved transition -->
    <div class="absolute inset-0 bg-gradient-to-b from-background via-accent/5 to-background"></div>
    <div class="relative z-10 max-w-6xl mx-auto">
      <div class="text-center">
        <div class="inline-block w-24 h-1 bg-gradient-to-r from-transparent via-accent to-transparent rounded-full mb-8"></div>
        <h2 class="text-2xl md:text-3xl font-semibold text-accent dark:text-accent-light mb-4">My Approach</h2>
        <p class="text-lg text-foreground dark:text-foreground-light max-w-3xl mx-auto">
          I tackle projects through a holistic lens: process, people, and technology. Here's the structured methodology I follow to ensure success.
        </p>
      </div>
    </div>
  </section>

  <!-- Transition Divider & Contextual Text -->
  <div class="w-full flex flex-col items-center my-12">
    <svg viewBox="0 0 1440 80" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full h-16 md:h-20 lg:h-24">
      <path fill="currentColor" fill-opacity="0.10" d="M0,32 C360,80 1080,0 1440,48 L1440,80 L0,80 Z" />
    </svg>
    <div class="relative z-10 -mt-8 mb-4 text-center animate-fade-in">
      <span class="inline-block px-6 py-3 rounded-full bg-background dark:bg-background-dark text-black dark:text-foreground-light font-semibold shadow-md border border-accent/30">
        See how this methodology drives real results in the projects below
      </span>
      <div class="flex justify-center mt-2">
        <svg class="w-6 h-6 text-accent animate-bounce" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
        </svg>
      </div>
    </div>
  </div>

  <!-- Methodology Section -->
  <section class="c-methodology w-full py-16 md:py-24 px-4 max-w-6xl mx-auto" role="region" aria-labelledby="methodology-title" data-a11y-allow-color-contrast>
    <div class="relative flex flex-col items-center">
      <!-- Accent timeline line -->
      <div class="absolute left-1/2 top-0 bottom-0 w-1 bg-gradient-to-b from-accent/40 via-accent/20 to-accent/0 rounded-full pointer-events-none" style="transform: translateX(-50%);"></div>
      <!-- Timeline steps -->
      <div class="w-full max-w-3xl mx-auto flex flex-col gap-12">
        <!-- Step 1 -->
        <div class="relative flex items-center group animate-fade-in">
          <div class="flex flex-col items-center mr-6">
            <div class="w-12 h-12 bg-accent/20 border-2 border-accent rounded-full flex items-center justify-center shadow-lg mb-2">
              <svg class="w-6 h-6 text-accent dark:text-accent-light" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" /></svg>
            </div>
            <span class="text-xs text-black dark:text-foreground-light font-bold">Step 1</span>
          </div>
          <div class="flex-1 bg-background dark:bg-background-dark border border-accent/10 rounded-2xl p-6 md:p-8 shadow-lg hover:border-accent/30 transition-all duration-300 text-black dark:text-foreground-light">
            <h3 class="text-xl md:text-2xl font-semibold text-foreground dark:text-foreground-light mb-2">Discovery & Empathy</h3>
            <div class="font-bold text-foreground mb-2">Uncover true pain points and human factors.</div>
            <p class="text-foreground dark:text-foreground-light leading-relaxed">Conduct stakeholder interviews and shadow frontline staff to uncover true pain points and human factors that drive successful implementations.</p>
          </div>
        </div>
        <!-- Step 2 -->
        <div class="relative flex items-center group animate-fade-in">
          <div class="flex flex-col items-center mr-6">
            <div class="w-12 h-12 bg-accent/20 border-2 border-accent rounded-full flex items-center justify-center shadow-lg mb-2">
              <svg class="w-6 h-6 text-accent dark:text-accent-light" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-1.447-.894L15 4m0 13V4m-6 3l6-3" /></svg>
            </div>
            <span class="text-xs text-black dark:text-foreground-light font-bold">Step 2</span>
          </div>
          <div class="flex-1 bg-background dark:bg-background-dark border border-accent/10 rounded-2xl p-6 md:p-8 shadow-lg hover:border-accent/30 transition-all duration-300 text-black dark:text-foreground-light">
            <h3 class="text-xl md:text-2xl font-semibold text-foreground dark:text-foreground-light mb-2">Process Mapping</h3>
            <div class="font-bold text-foreground mb-2">Document workflows before selecting tools.</div>
            <p class="text-foreground dark:text-foreground-light leading-relaxed">Use BPMN and workshops to document workflows, handoffs, and responsibilities before selecting tools. This ensures technology serves the process, not the other way around.</p>
          </div>
        </div>
        <!-- Step 3 -->
        <div class="relative flex items-center group animate-fade-in">
          <div class="flex flex-col items-center mr-6">
            <div class="w-12 h-12 bg-accent/20 border-2 border-accent rounded-full flex items-center justify-center shadow-lg mb-2">
              <svg class="w-6 h-6 text-accent dark:text-accent-light" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" /></svg>
            </div>
            <span class="text-xs text-black dark:text-foreground-light font-bold">Step 3</span>
          </div>
          <div class="flex-1 bg-background dark:bg-background-dark border border-accent/10 rounded-2xl p-6 md:p-8 shadow-lg hover:border-accent/30 transition-all duration-300 text-black dark:text-foreground-light">
            <h3 class="text-xl md:text-2xl font-semibold text-foreground dark:text-foreground-light mb-2">Pre-Sales Preparation</h3>
            <div class="font-bold text-foreground mb-2">Align vendor evaluations with needs.</div>
            <p class="text-foreground dark:text-foreground-light leading-relaxed">Prepare detailed SOPs, workflows, and risk assessments to align vendor evaluations with organizational needs and ensure successful procurement decisions.</p>
          </div>
        </div>
        <!-- Step 4 -->
        <div class="relative flex items-center group animate-fade-in">
          <div class="flex flex-col items-center mr-6">
            <div class="w-12 h-12 bg-accent/20 border-2 border-accent rounded-full flex items-center justify-center shadow-lg mb-2">
              <svg class="w-6 h-6 text-accent dark:text-accent-light" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" /></svg>
            </div>
            <span class="text-xs text-black dark:text-foreground-light font-bold">Step 4</span>
          </div>
          <div class="flex-1 bg-background dark:bg-background-dark border border-accent/10 rounded-2xl p-6 md:p-8 shadow-lg hover:border-accent/30 transition-all duration-300 text-black dark:text-foreground-light">
            <h3 class="text-xl md:text-2xl font-semibold text-foreground dark:text-foreground-light mb-2">Design Thinking & Iteration</h3>
            <div class="font-bold text-foreground mb-2">Prototype, gather feedback, refine.</div>
            <p class="text-foreground dark:text-foreground-light leading-relaxed">Prototype solutions rapidly, gather user feedback, and refine in agile sprints to balance critique with encouragement and drive continuous improvement.</p>
          </div>
        </div>
        <!-- Step 5 -->
        <div class="relative flex items-center group animate-fade-in">
          <div class="flex flex-col items-center mr-6">
            <div class="w-12 h-12 bg-accent/20 border-2 border-accent rounded-full flex items-center justify-center shadow-lg mb-2">
              <svg class="w-6 h-6 text-accent dark:text-accent-light" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" /></svg>
            </div>
            <span class="text-xs text-black dark:text-foreground-light font-bold">Step 5</span>
          </div>
          <div class="flex-1 bg-background dark:bg-background-dark border border-accent/10 rounded-2xl p-6 md:p-8 shadow-lg hover:border-accent/30 transition-all duration-300 text-black dark:text-foreground-light">
            <h3 class="text-xl md:text-2xl font-semibold text-foreground dark:text-foreground-light mb-2">Technical Implementation</h3>
            <div class="font-bold text-foreground mb-2">Build scalable, compliant systems.</div>
            <p class="text-foreground dark:text-foreground-light leading-relaxed">Integrate best-in-class platforms and custom scripts—leveraging SQL, Python, or LLMs—to build scalable, compliant systems that grow with your organization.</p>
          </div>
        </div>
        <!-- Step 6 -->
        <div class="relative flex items-center group animate-fade-in">
          <div class="flex flex-col items-center mr-6">
            <div class="w-12 h-12 bg-accent/20 border-2 border-accent rounded-full flex items-center justify-center shadow-lg mb-2">
              <svg class="w-6 h-6 text-accent dark:text-accent-light" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>
            </div>
            <span class="text-xs text-black dark:text-foreground-light font-bold">Step 6</span>
          </div>
          <div class="flex-1 bg-background dark:bg-background-dark border border-accent/10 rounded-2xl p-6 md:p-8 shadow-lg hover:border-accent/30 transition-all duration-300 text-black dark:text-foreground-light">
            <h3 class="text-xl md:text-2xl font-semibold text-foreground dark:text-foreground-light mb-2">Governance & Continuous Improvement</h3>
            <div class="font-bold text-foreground mb-2">Evolve solutions, empower teams.</div>
            <p class="text-foreground dark:text-foreground-light leading-relaxed">Establish reviews, training, and documentation to evolve solutions over years and empower teams to maintain and enhance systems independently.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Projects List Section -->
  <section class="c-projects-list w-full py-20 md:py-32 relative overflow-hidden bg-gradient-to-br from-background via-accent/5 to-background" role="region" aria-labelledby="projects-list-title">
    <!-- Background pattern -->
    <div class="absolute inset-0 z-0 opacity-20 pointer-events-none">
      <svg class="absolute inset-0 w-full h-full" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <pattern id="projects-grid" width="40" height="40" patternUnits="userSpaceOnUse">
            <path d="M0 40L40 0M20 40L40 20M0 20L20 0" fill="none" stroke="currentColor" stroke-width="1" stroke-opacity="0.12" />
          </pattern>
        </defs>
        <rect width="100%" height="100%" fill="url(#projects-grid)" />
      </svg>
    </div>
    <!-- Floating shapes -->
    <div class="absolute top-0 right-0 w-64 h-64 bg-accent/20 rounded-full blur-3xl transform translate-x-1/2 -translate-y-1/2 pointer-events-none"></div>
    <div class="absolute bottom-0 left-0 w-48 h-48 bg-accent/20 rounded-full blur-3xl transform -translate-x-1/2 translate-y-1/2 pointer-events-none"></div>

    <div class="relative z-10 px-4">
      <div class="max-w-4xl mx-auto mb-12 text-center">
        <h2 id="projects-list-title" class="font-heading font-bold text-3xl md:text-4xl lg:text-5xl text-accent dark:text-accent-light mb-6 animate-fade-in">Case Studies</h2>
        <p class="text-lead text-foreground dark:text-foreground-light animate-fade-in">
          Explore detailed case studies of my work, showcasing the methodology in action across various industries and challenges.
        </p>
      </div>

      <!-- Decorative SVG divider -->
      <div aria-hidden="true" class="w-full overflow-hidden pointer-events-none mb-12">
        <svg viewBox="0 0 1440 80" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full h-16 md:h-20 lg:h-24">
          <path fill="currentColor" fill-opacity="0.08" d="M0,32 C360,80 1080,0 1440,48 L1440,80 L0,80 Z" />
        </svg>
      </div>

      <div class="flex flex-col gap-8 md:gap-6 w-full">
        {projects
          .filter((p) => !p.data.draft)
          .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
          .map((project, idx) => (
            <ProjectRow
              project={project}
              featured={['advancedmd-implementation','bank-projections-modeling','Microsoft-Fabric'].includes(project.slug)}
              align={idx % 2 === 0 ? 'left' : 'right'}
            />
          ))}
      </div>
    </div>
  </section>
</Layout>

<style>
.projects-masonry {
  /* Masonry layout for modern browsers */
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
  gap: 2rem;
}
@keyframes fadeIn {
  from { opacity: 0; transform: translateY(16px); }
  to { opacity: 1; transform: none; }
}
.animate-fade-in {
  opacity: 1;
  animation: fadeIn 1s cubic-bezier(0.4,0,0.2,1) both;
}
@media (min-width: 640px) {
  .projects-masonry {
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
  }
}
@media (min-width: 1024px) {
  .projects-masonry {
    grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
  }
}
@supports (grid-template-rows: masonry) {
  .projects-masonry {
    grid-template-rows: masonry;
  }
}

/* Focus styles for better accessibility */
.group:focus-within {
  outline: 2px solid var(--color-accent);
  outline-offset: 2px;
}

/* Reduced motion support */
@media (prefers-reduced-motion: reduce) {
  .group {
    transition: none;
  }
}

/* Smooth transitions between sections */
.c-methodology,
.c-projects-list {
  position: relative;
}

/* Enhanced visual flow */
.c-methodology::before {
  content: '';
  position: absolute;
  top: -2px;
  left: 0;
  right: 0;
  height: 2px;
  background: linear-gradient(90deg, transparent, var(--color-accent), transparent);
  opacity: 0.3;
}
</style>
