---
import Layout from '../../layouts/BaseLayout.astro';
import ProjectHero from '../../components/ProjectHero.astro';
import AchievementCard from '../../components/AchievementCard.astro';
import MetricsTable from '../../components/MetricsTable.astro';
import ProjectTags from '../../components/ProjectTags.astro';

const title = "AdvancedMD Implementation & Evolution";
const description = "Led the selection, implementation, and continuous enhancement of AdvancedMD, transforming paper workflows into a robust, data-driven EHR ecosystem with custom SQL tools.";
const date = new Date('2017-12-01T00:00:00.000Z');
const tags = ["EHR", "Digital Transformation", "Automation", "Healthcare IT", "SQL"];
const image = "/assets/images/advancedmd-implementation.png";
const canonicalUrl = "https://blakeoxford.com/projects/advancedmd-implementation/";

const metrics = [
  {
    metric: "Backlog Resolution",
    result: "~$100K in outstanding claims cleared",
    timeline: "Within 6 months"
  },
  {
    metric: "Operational Efficiency",
    result: "60% reduction in manual reconciliation",
    timeline: "Consolidated workflows"
  },
  {
    metric: "Reporting Efficiency",
    result: "75% reduction in monthly reporting tasks",
    timeline: "SQL toolkit automation"
  },
  {
    metric: "Onboarding Time",
    result: "Reduced from 4 weeks to 1 week",
    timeline: "Knowledge sharing system"
  }
];
---

<Layout
  title={title}
  description={description}
  image={image}
  url={canonicalUrl}
  wide={true}
>
  <ProjectHero 
    title={title}
    description={description}
    date={date}
    image={image}
  />

  <!-- Full-Width Content Section -->
  <article class="py-20 bg-white dark:bg-gray-900">
    <div class="w-full px-6 lg:px-12 xl:px-16">
      <div class="max-w-none mx-auto">
        
        <!-- Background & Challenge -->
        <section class="mb-16">
          <h2 class="text-3xl font-bold mb-8 text-gray-900 dark:text-white">Background & Challenge</h2>
          <div class="prose prose-lg prose-gray dark:prose-invert max-w-none">
            <p class="text-lg leading-relaxed text-gray-700 dark:text-gray-300 mb-6">
              In late 2017, fresh out of college at a 12-person startup, I was thrust into a billing meltdown: our revenue cycle partner collapsed, leaving us with paper records, unprocessed claims approaching $100K, and no internal billing expertise. We urgently needed to select and configure an EHR/Practice Management (PM) platform that could serve three critical services—medical, Physical Therapy (PT), and Applied Behavior Analysis (ABA)—without disrupting daily operations.
            </p>
            <p class="text-lg leading-relaxed text-gray-700 dark:text-gray-300">
              It was a true dumpster fire. Our initial rush to go-live, without comprehensive process mapping or stakeholder alignment, led to misconfigured workflows, a mounting backlog, and frustrated providers. Payroll hung in the balance, and I had no formal training in healthcare IT.
            </p>
          </div>
        </section>

        <!-- Key Achievements -->
        <section class="mb-16">
          <h2 class="text-3xl font-bold mb-8 text-gray-900 dark:text-white">Key Achievements</h2>
          
          <div class="grid md:grid-cols-1 gap-8">
            <AchievementCard 
              title="Strategic Vendor Selection"
              achievements={[
                "Orchestrated multi-day workshops with clinicians, PT therapists, and ABA staff to define critical requirements, ultimately selecting AdvancedMD for its modularity and payer integrations."
              ]}
            />

            <AchievementCard 
              title="Emergency Billing Continuity"
              achievements={[
                "Designed and deployed interim billing workflows in under 72 hours, training a contract biller on-the-fly to handle live claims."
              ]}
            />

            <AchievementCard 
              title="Deep Process Analysis"
              achievements={[
                "Self-taught BPMN to map end-to-end flows for medical, PT, and ABA services, uncovering 15+ handoff failures that were silently sabotaging operations."
              ]}
            />

            <AchievementCard 
              title="EDI & Payer Integration"
              achievements={[
                "Proactively engaged Blue Cross Blue Shield EDI specialists to diagnose and fix legacy PIN and taxonomy mapping issues blocking claim submissions."
              ]}
            />

            <AchievementCard 
              title="Custom SQL Toolkit & Automation"
              achievements={[
                "Developed SQL stored procedures and automation scripts to extract, transform, and load AdvancedMD data into a reporting database. Automated exception alerts and drove real-time KPIs in Power BI dashboards."
              ]}
            />

            <AchievementCard 
              title="Continuous Governance & Evolution"
              achievements={[
                "Established quarterly governance reviews to align platform updates, schema migrations, and user-role refinements with evolving clinical and regulatory needs."
              ]}
            />
          </div>
        </section>

        <!-- Journey & Growth -->
        <section class="mb-16">
          <h2 class="text-3xl font-bold mb-8 text-gray-900 dark:text-white">Journey & Growth</h2>
          <div class="prose prose-lg prose-gray dark:prose-invert max-w-none">
            <p class="text-lg leading-relaxed text-gray-700 dark:text-gray-300 mb-6">
              <em>Note: the core implementation was completed within the first six months, and I then led continuous enhancements and optimizations for eight years, making AdvancedMD a true business-critical platform.</em>
            </p>
            <ol class="space-y-4 mb-6 list-decimal list-inside">
              <li class="text-lg text-gray-700 dark:text-gray-300">
                <strong>Immersive Learning:</strong> With the project spiraling, I dove into healthcare IT texts—BPMN guides, FHIR specifications, revenue cycle management books—and spent nights on message boards and in cold-emailing veteran implementers for best practices.
              </li>
              <li class="text-lg text-gray-700 dark:text-gray-300">
                <strong>Owning Mistakes:</strong> Our initial go-live missed essential scenarios for PT multi-code billing and ABA session documentation, forcing daily firefighting. I captured each failure in a "Lessons Learned" log and used it to drive our next sprint.
              </li>
              <li class="text-lg text-gray-700 dark:text-gray-300">
                <strong>Agile Iteration:</strong> Adopted bi-weekly configuration sprints—deploying process tweaks, updating workflows, and refining SQL tools based on direct user feedback—turning frustration into forward momentum.
              </li>
              <li class="text-lg text-gray-700 dark:text-gray-300">
                <strong>SME Development:</strong> Over eight years, I became the go-to expert for AdvancedMD—leading integrations, managing schema upgrades, and creating bespoke extensions that became core to our operations.
              </li>
              <li class="text-lg text-gray-700 dark:text-gray-300">
                <strong>Knowledge Sharing:</strong> Curated a library of over 50 internal knowledge articles, conducted regular training workshops, and maintained a living wiki of best practices—reducing AdvancedMD onboarding time from 4 weeks to 1.
              </li>
            </ol>
          </div>
        </section>

        <!-- Impact & Results -->
        <section class="mb-16">
          <h2 class="text-3xl font-bold mb-8 text-gray-900 dark:text-white">Impact & Results</h2>
          <MetricsTable metrics={metrics} />
          <div class="mt-6">
            <ul class="space-y-4">
              <li class="flex items-start gap-3">
                <span class="text-accent dark:text-accent-light font-bold">•</span>
                <span class="text-lg text-gray-700 dark:text-gray-300">
                  <strong>Scalable Framework:</strong> The process-first governance model and custom tooling now underpin all digital transformations across the organization.
                </span>
              </li>
            </ul>
          </div>
        </section>

        <!-- Lessons & Takeaways -->
        <section class="mb-16">
          <h2 class="text-3xl font-bold mb-8 text-gray-900 dark:text-white">Lessons & Takeaways</h2>
          
          <div class="space-y-8">
            <div>
              <h3 class="text-2xl font-semibold mb-4 text-gray-800 dark:text-gray-100">Deep Curiosity Wins</h3>
              <p class="text-lg leading-relaxed text-gray-700 dark:text-gray-300">
                When you lack expertise, immerse yourself—books, forums, mentors—to build domain knowledge rapidly.
              </p>
            </div>

            <div>
              <h3 class="text-2xl font-semibold mb-4 text-gray-800 dark:text-gray-100">Process Comes First</h3>
              <p class="text-lg leading-relaxed text-gray-700 dark:text-gray-300">
                Skipping detailed workflow mapping leads to costly rework; invest time upfront to clarify handoffs.
              </p>
            </div>

            <div>
              <h3 class="text-2xl font-semibold mb-4 text-gray-800 dark:text-gray-100">Iterate Fearlessly</h3>
              <p class="text-lg leading-relaxed text-gray-700 dark:text-gray-300">
                Treat failures as data; rapid sprints maintain momentum and build trust.
              </p>
            </div>

            <div>
              <h3 class="text-2xl font-semibold mb-4 text-gray-800 dark:text-gray-100">Share Your Knowledge</h3>
              <p class="text-lg leading-relaxed text-gray-700 dark:text-gray-300">
                Document and teach relentlessly to build organizational resilience.
              </p>
            </div>

            <div>
              <h3 class="text-2xl font-semibold mb-4 text-gray-800 dark:text-gray-100">Pre-Sales Preparation</h3>
              <p class="text-lg leading-relaxed text-gray-700 dark:text-gray-300">
                Before any new implementation or sales meeting, I create foundational documentation—process maps, stakeholder interviews, and workflow analyses—to accurately scope projects, align expectations, and identify potential risks or requirements.
              </p>
            </div>
          </div>
        </section>

        <!-- Quote -->
        <blockquote class="border-l-4 border-accent pl-6 py-4 bg-gray-50 dark:bg-gray-800 rounded-r-lg my-12">
          <p class="text-lg italic text-gray-700 dark:text-gray-300">
            This project was my crucible—transforming chaos into a structured, evolving system and shaping my philosophy: never accept limits as given, and always strive for continual improvement.
          </p>
        </blockquote>

      </div>
    </div>
  </article>

  <ProjectTags tags={tags} />
</Layout> 