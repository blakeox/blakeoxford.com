---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/primitives/Container.astro';
import Section from '../../components/primitives/Section.astro';
import Badge from '../../components/primitives/Badge.astro';
import { componentDocs, getCategories, getAllTags, type ComponentDoc } from '../../data/componentDocs';
import { componentVisualBaselines } from '../../data/componentVisualBaselines';

const title = 'Component Documentation';
const description = 'Comprehensive documentation for all Blake Oxford Portfolio components';
const canonicalUrl = 'https://blakeoxford.com/docs/components/';

// Group components by category
const categories = getCategories();
const componentsByCategory = categories.map((category) => ({
 category,
 components: componentDocs.filter((doc) => doc.category === category),
}));

const allTags = getAllTags();
---

<BaseLayout title={title} description={description} canonicalUrl={canonicalUrl}>
 <Container>
 <Section class="py-16">
 <!-- Header -->
 <header class="mb-12 text-center">
 <h1 class="text-4xl font-bold text-foreground sm:text-5xl lg:text-6xl">
 Component Documentation
 </h1>
 <p class="mt-4 text-lg text-muted-foreground max-w-3xl mx-auto">
 Comprehensive API documentation for all components in the Blake Oxford Portfolio.
 Built with accessibility, performance, and developer experience in mind.
 </p>
 </header>

 <!-- Search Input -->
 <div class="mb-12">
 <label for="component-search" class="sr-only">Search components</label>
 <input
 type="search"
 id="component-search"
 placeholder="Search components by name, description, or tag..."
 class="w-full rounded-xl border border-border px-6 py-4 text-lg transition focus:outline-none focus:ring-2 focus:ring-accent dark:border-border-dark dark:bg-surface-dark"
 />
 </div>

 <!-- Tag Filter -->
 <div class="mb-12">
 <h2 class="mb-4 text-sm font-semibold uppercase tracking-wide text-subtle-foreground">
 Filter by Tag
 </h2>
 <div class="flex flex-wrap gap-2">
 <button
 class="tag-filter rounded-full border border-border px-4 py-2 text-sm transition hover:border-accent hover:bg-accent/10 dark:border-border-dark"
 data-tag="all"
 >
 All
 </button>
 {allTags.map((tag) => (
 <button
 class="tag-filter rounded-full border border-border px-4 py-2 text-sm transition hover:border-accent hover:bg-accent/10 dark:border-border-dark"
 data-tag={tag}
 >
 {tag}
 </button>
 ))}
 </div>
 </div>

 <!-- Component Documentation -->
 {componentsByCategory.map(({ category, components }) => (
 <section class="mb-16">
 <h2 class="mb-8 text-3xl font-bold text-foreground">
 {category} Components
 <span class="ml-2 text-base font-normal text-subtle-foreground">({components.length})</span>
 </h2>
 
 <div class="space-y-8">
 {components.map((component: ComponentDoc) => (
 <article
 class="component-card min-w-0 overflow-hidden rounded-2xl border border-border/40 bg-surface/70 p-5 shadow-sm transition-colors hover:border-accent/40 dark:border-border-dark/40 dark:bg-surface-dark/60 sm:p-8"
 data-component-name={component.name.toLowerCase()}
 data-component-tags={component.tags?.join(',') || ''}
 >
 {/* Component Header */}
 <header class="mb-6">
 <div class="flex items-start justify-between gap-4">
 <div>
 <h3 class="text-2xl font-bold text-foreground">
 {component.name}
 </h3>
 {component.subcategory && (
 <p class="mt-1 text-sm text-subtle-foreground">
 {component.category} › {component.subcategory}
 </p>
 )}
 </div>
 <a
 href={`https://github.com/blakeox/blakeoxford.com/blob/main/${component.filePath}`}
 target="_blank"
 rel="noopener noreferrer"
 class="shrink-0 rounded-lg border border-border px-4 py-2 text-sm transition hover:border-accent hover:bg-accent/10 dark:border-border-dark"
 >
 View Source
 </a>
 </div>
 
 <p class="mt-4 text-muted-foreground">
 {component.description}
 </p>

 {component.visualTier && (
 <p class="mt-3 text-sm">
 <span class="font-semibold text-foreground">Visual tier:</span>{' '}
 <Badge class="bg-surface-subtle text-foreground text-xs dark:bg-surface-dark-subtle">{component.visualTier}</Badge>
 </p>
 )}

 {component.tokenDependencies && component.tokenDependencies.length > 0 && (
 <div class="mt-3">
 <p class="text-sm font-semibold text-foreground">Token dependencies</p>
 <div class="mt-2 flex flex-wrap gap-2">
 {component.tokenDependencies.map((token) => (
 <code class="rounded bg-accent/10 px-2 py-1 text-xs text-accent">{token}</code>
 ))}
 </div>
 </div>
 )}

 {component.visualBaseline && (
 <p class="mt-3 text-sm text-muted-foreground">
 <span class="font-semibold text-foreground">Visual baseline:</span>{' '}
 Playwright snapshot <code class="text-accent">{componentVisualBaselines[component.visualBaseline].snapshotFile}</code>
 on <code>{componentVisualBaselines[component.visualBaseline].route}</code>
 </p>
 )}

 {/* Tags */}
 {component.tags && component.tags.length > 0 && (
 <div class="mt-4 flex flex-wrap gap-2">
 {component.tags.map((tag) => (
 <Badge class="bg-accent/10 text-accent text-xs">{tag}</Badge>
 ))}
 </div>
 )}
 </header>

 {/* Props */}
 {component.props && component.props.length > 0 && (
 <div class="mb-6">
 <h4 class="mb-3 text-lg font-semibold text-foreground">
 Props
 </h4>
 <div class="max-w-full overflow-x-auto" tabindex="0">
 <table class="w-full text-sm">
 <thead class="border-b border-border dark:border-border-dark">
 <tr class="text-left">
 <th class="pb-2 pr-4 font-semibold">Name</th>
 <th class="pb-2 pr-4 font-semibold">Type</th>
 <th class="pb-2 pr-4 font-semibold">Default</th>
 <th class="pb-2 font-semibold">Description</th>
 </tr>
 </thead>
 <tbody class="divide-y divide-border dark:divide-border-dark">
 {component.props.map((prop) => (
 <tr>
 <td class="py-3 pr-4">
 <code class="rounded bg-accent/10 px-2 py-1 text-accent">
 {prop.name}
 {prop.required && <span class="text-error">*</span>}
 </code>
 </td>
 <td class="py-3 pr-4">
 <code class="text-muted-foreground">
 {prop.type}
 </code>
 </td>
 <td class="py-3 pr-4">
 {prop.default ? (
 <code class="text-muted-foreground">
 {prop.default}
 </code>
 ) : (
 <span class="text-subtle-foreground/80">—</span>
 )}
 </td>
 <td class="py-3 text-muted-foreground">
 {prop.description}
 </td>
 </tr>
 ))}
 </tbody>
 </table>
 </div>
 </div>
 )}

 {/* Examples */}
 {component.examples && component.examples.length > 0 && (
 <div class="mb-6">
 <h4 class="mb-3 text-lg font-semibold text-foreground">
 Examples
 </h4>
 <div class="space-y-4">
 {component.examples.map((example) => (
 <div>
 {example.title && (
 <p class="mb-2 text-sm font-medium text-muted-foreground">
 {example.title}
 </p>
 )}
 {example.description && (
 <p class="mb-2 text-sm text-subtle-foreground">
 {example.description}
 </p>
 )}
 <pre class="max-w-full overflow-x-auto rounded-xl bg-surface-dark p-4 text-sm text-foreground-light dark:bg-background-dark" tabindex="0"><code>{example.code}</code></pre>
 </div>
 ))}
 </div>
 </div>
 )}

 {/* Accessibility */}
 {component.accessibility && component.accessibility.length > 0 && (
 <div class="mb-6">
 <h4 class="mb-3 text-lg font-semibold text-foreground">
 Accessibility
 </h4>
 <ul class="space-y-2">
 {component.accessibility.map((feature) => (
 <li class="flex items-start gap-2 text-sm text-muted-foreground">
 <span class="mt-1 text-success">✓</span>
 <span>{feature}</span>
 </li>
 ))}
 </ul>
 </div>
 )}

 {/* Performance */}
 {component.performance && component.performance.length > 0 && (
 <div>
 <h4 class="mb-3 text-lg font-semibold text-foreground">
 Performance
 </h4>
 <ul class="space-y-2">
 {component.performance.map((feature) => (
 <li class="flex items-start gap-2 text-sm text-muted-foreground">
 <span class="mt-1 text-info">⚡</span>
 <span>{feature}</span>
 </li>
 ))}
 </ul>
 </div>
 )}
 </article>
 ))}
 </div>
 </section>
 ))}

 <!-- Stats Footer -->
 <footer class="mt-16 rounded-2xl border border-border/40 bg-surface/70 p-5 text-center shadow-sm dark:border-border-dark/40 dark:bg-surface-dark/60 sm:p-8">
 <h2 class="mb-4 text-2xl font-bold text-foreground">
 Documentation Statistics
 </h2>
 <div class="grid gap-6 sm:grid-cols-3">
 <div>
 <p class="text-4xl font-bold text-accent">{componentDocs.length}</p>
 <p class="mt-1 text-sm text-subtle-foreground">
 Components Documented
 </p>
 </div>
 <div>
 <p class="text-4xl font-bold text-accent">{categories.length}</p>
 <p class="mt-1 text-sm text-subtle-foreground">
 Categories
 </p>
 </div>
 <div>
 <p class="text-4xl font-bold text-accent">{allTags.length}</p>
 <p class="mt-1 text-sm text-subtle-foreground">
 Unique Tags
 </p>
 </div>
 </div>
 </footer>
 </Section>
 </Container>
</BaseLayout>

<script>
 // Search functionality
 const searchInput = document.getElementById('component-search') as HTMLInputElement;
 const componentCards = document.querySelectorAll('.component-card');
 const tagFilters = document.querySelectorAll('.tag-filter');
 
 let currentTag = 'all';

 function filterComponents() {
 const searchTerm = searchInput?.value.toLowerCase() || '';
 
 componentCards.forEach((card) => {
 const tags = card.getAttribute('data-component-tags') || '';
 const text = card.textContent?.toLowerCase() || '';
 
 const matchesSearch = text.includes(searchTerm);
 const matchesTag = currentTag === 'all' || tags.includes(currentTag);
 
 if (matchesSearch && matchesTag) {
 (card as HTMLElement).style.display = 'block';
 } else {
 (card as HTMLElement).style.display = 'none';
 }
 });
 }

 searchInput?.addEventListener('input', filterComponents);

 tagFilters.forEach((button) => {
 button.addEventListener('click', () => {
 tagFilters.forEach((btn) => btn.classList.remove('bg-accent', 'text-on-accent', 'border-accent'));
 button.classList.add('bg-accent', 'text-on-accent', 'border-accent');
 
 currentTag = button.getAttribute('data-tag') || 'all';
 filterComponents();
 });
 });

 // Set initial "All" button as active
 const allButton = document.querySelector('[data-tag="all"]');
 allButton?.classList.add('bg-accent', 'text-on-accent', 'border-accent');
</script>

<style>
 /* Syntax highlighting for code blocks */
 pre code {
 font-family: 'Monaco', 'Courier New', monospace;
 line-height: 1.6;
 }
 
 /* Search filtering */
 .component-card {
 transition: opacity 0.2s ease, border-color 0.2s ease;
 }
 
 /* Table responsiveness */
 @media (max-width: 768px) {
 table {
 font-size: 0.875rem;
 }
 }
</style>
