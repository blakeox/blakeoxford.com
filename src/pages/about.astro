---
import Layout from '../layouts/BaseLayout.astro';
import AboutHeroSection from '../components/features/about/AboutHeroSection.astro';
import AboutTimelineSection from '../components/features/about/AboutTimelineSection.astro';
import AboutEducationSkillsSection from '../components/features/about/AboutEducationSkillsSection.astro';
import AchievementCard from '../components/features/about/AchievementCard.astro';
import AboutSocial from '../components/features/about/AboutSocial.astro';
import Section from '../components/primitives/Section.astro';
import Grid from '../components/primitives/Grid.astro';
import { getAboutPage } from '../content/about/getAboutPage';
import { CANONICAL_URLS } from '../config/constants';

const page = await getAboutPage();
const canonicalUrl = CANONICAL_URLS.about;

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Blake Oxford',
  url: 'https://blakeoxford.com',
  jobTitle: 'Systems Architect',
  sameAs: page.social.links.map((link) => link.url),
  description: page.meta.description,
  image: '/assets/images/Blake-O-scaled.jpg',
};
---

<Layout
  title={page.meta.title}
  description={page.meta.description}
  image="/assets/images/Blake-O-scaled.jpg"
  url={canonicalUrl}
  wide={true}
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(personSchema)} />

  <AboutHeroSection content={page.hero} />

  <Section padding="lg" container="lg" class="relative overflow-hidden bg-surface">
    <div class="absolute inset-0 z-0 opacity-5">
      <div
        class="absolute inset-0"
        style="background-image: url('data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%239C92AC' fill-opacity='0.4'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E');"
      >
      </div>
    </div>
    <div class="relative z-10">
      <div class="grid grid-cols-1 gap-8 lg:gap-12">
        <div>
          <div class="section-intro mb-12">
            <span class="section-kicker">{page.achievements.kicker}</span>
            <h2
              class="mb-4 text-center font-heading text-2xl font-semibold text-foreground sm:text-3xl md:text-4xl"
            >
              {page.achievements.title}
            </h2>
            <p class="text-muted-foreground">
              {page.achievements.description}
            </p>
          </div>

          <Grid cols="3" gap="lg">
            {
              page.achievements.cards.map((card) => (
                <AchievementCard
                  icon={card.icon}
                  title={card.title}
                  description={card.description}
                  achievements={card.achievements}
                  achievementIcons={card.achievementIcons}
                />
              ))
            }
          </Grid>
        </div>
      </div>
    </div>
  </Section>

  <AboutSocial
    social={{
      title: page.social.title,
      description: page.social.description,
      links: page.social.links.map((link) => ({
        href: link.url,
        label: link.name,
        icon: link.icon,
      })),
    }}
  />

  <AboutEducationSkillsSection content={page.education} />
  <AboutTimelineSection content={page.timeline} />

  <Section padding="lg" container="lg" class="bg-gradient-to-b from-surface to-background">
    <div class="section-intro mx-auto max-w-3xl">
      <span class="section-kicker">{page.closing.kicker}</span>
      <h2 class="mb-4 font-heading text-2xl font-semibold text-foreground sm:text-3xl md:text-4xl">
        {page.closing.title}
      </h2>
      <p class="mb-8 text-muted-foreground">{page.closing.description}</p>
      <ul class="flex flex-wrap items-center justify-center gap-4" role="list">
        {
          page.social.links.map((link) => (
            <li>
              <a
                href={link.url}
                class="inline-flex items-center gap-2 rounded-lg border border-border px-4 py-2 font-medium text-foreground transition-colors hover:border-accent hover:bg-surface-subtle"
                target="_blank"
                rel="noopener noreferrer"
              >
                {link.name}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </Section>
</Layout>
