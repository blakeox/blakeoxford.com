---
import Layout from '../layouts/BaseLayout.astro';
import AboutHeroSection from '../components/features/about/AboutHeroSection.astro';
import AboutProofSection from '../components/features/about/AboutProofSection.astro';
import AboutTimelineSection from '../components/features/about/AboutTimelineSection.astro';
import AboutEducationSkillsSection from '../components/features/about/AboutEducationSkillsSection.astro';
import CtaBand from '../components/composites/CtaBand.astro';
import { getAboutPage } from '../content/about/getAboutPage';
import { CANONICAL_URLS } from '../config/constants';

const page = await getAboutPage();
const canonicalUrl = CANONICAL_URLS.about;

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Blake Oxford',
  url: 'https://blakeoxford.com',
  jobTitle: 'Systems Architect',
  sameAs: page.social.links.map((link) => link.url),
  description: page.meta.description,
  image: '/assets/images/Blake-O-scaled.jpg',
};
---

{/*
  Hire-path arc: who / how I show up → judgment proof → track record → background → convert.
*/}
<Layout
  title={page.meta.title}
  description={page.meta.description}
  image="/assets/images/Blake-O-scaled.jpg"
  url={canonicalUrl}
  wide={true}
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(personSchema)} />

  <AboutHeroSection content={page.hero} />

  <AboutProofSection
    kicker={page.achievements.kicker}
    title={page.achievements.title}
    description={page.achievements.description}
    cards={page.achievements.cards}
  />

  <AboutTimelineSection
    kicker={page.timeline.kicker}
    title={page.timeline.title}
    description={page.timeline.description}
    items={page.timeline.items}
  />

  <AboutEducationSkillsSection content={page.education} />

  <CtaBand
    titleId="about-closing-title"
    kicker={page.closing.kicker}
    title={page.closing.title}
    description={page.closing.description}
    primary={{ href: '/contact/', label: 'Book a 20-minute bottleneck review' }}
    secondary={{ href: '/projects/', label: 'See the work' }}
  >
    <ul
      class="flex flex-wrap items-center justify-center gap-x-5 gap-y-2 text-sm text-muted-foreground"
      role="list"
      aria-label={page.social.title}
    >
      {
        page.social.links.map((link) => (
          <li>
            <a
              href={link.url}
              class="font-semibold text-accent-emphasis transition-colors hover:text-accent"
              target="_blank"
              rel="noopener noreferrer"
            >
              {link.name}
            </a>
          </li>
        ))
      }
    </ul>
  </CtaBand>
</Layout>
