---
import Layout from '../layouts/BaseLayout.astro';
import PhotoCarousel from '../components/ui/PhotoCarousel.astro';

interface SocialLink {
  name: string;
  url: string;
  icon: 'linkedin' | 'github' | 'microsoft-learn';
}


interface TimelineItem {
  year: string;
  icon: string;
  title: string;
  achievements: string[];
  color: string;
}

const title = 'About Blake Oxford';
const description = 'Learn about Blake Oxford, Systems Architect and Workflow Strategist. Explore key skills, career highlights, and collaboration opportunities.';
const canonicalUrl = 'https://blakeoxford.com/about/';

// Social Media Links
const socialLinks: SocialLink[] = [
  { name: 'LinkedIn', url: 'https://www.linkedin.com/in/blakeoxford/', icon: 'linkedin' },
  { name: 'GitHub', url: 'https://github.com/blakeoxford', icon: 'github' },
  { name: 'Microsoft Learn', url: 'https://learn.microsoft.com/users/BlakeOxford-1002', icon: 'microsoft-learn' }
];

// Structured data for Person
const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  'name': 'Blake Oxford',
  'url': 'https://blakeoxford.com',
  'jobTitle': 'Systems Architect',
  'sameAs': socialLinks.map(link => link.url),
  'description': description,
  'image': '/assets/images/Blake-O-scaled.jpg'
};


// Timeline Data
const timelineItems: TimelineItem[] = [
  {
    year: '2019',
    icon: '🔄',
    title: 'System Integration & Optimization',
    achievements: [
      'Streamlined cross-departmental workflows through integration of Sage Intacct and ADP',
      'Reduced manual data entry by 80% through custom API integrations',
      'Implemented automated reconciliation processes, reducing month-end close by 3 days'
    ],
    color: 'from-emerald-500 to-purple-500'
  },
  {
    year: '2020',
    icon: '☁️',
    title: 'Cloud Migration & Digital Transformation',
    achievements: [
      'Led Google Workspace to Microsoft 365 migration for 180 staff with zero downtime',
      'Implemented Sage Intacct and ADP Workforce Now, consolidating 5 legacy systems',
      'Designed disaster recovery protocols reducing potential data loss window by 90%'
    ],
    color: 'from-emerald-500 to-purple-500'
  },
  {
    year: '2023',
    icon: '💡',
    title: 'Analytics & Process Innovation',
    achievements: [
      'Developed Power BI dashboards for real-time financial forecasting',
      'Authored SOPs and trained team on AdvancedMD RCM',
      '$1.2M in unbilled services surfaced via SQL-based reporting suite'
    ],
    color: 'from-emerald-500 to-purple-500'
  },
  {
    year: '2024',
    icon: '🤖',
    title: 'AI-Powered Compliance & Workflow Enhancement',
    achievements: [
      'Developed and launched a real-time Azure OpenAI auditing system for clinical notes, ensuring insurance compliance before submission',
      'Enabled automated coaching for providers and technicians, improving documentation quality and reducing claim denials',
      'Integrated AI into daily workflows for tasks like insurance appeals and internal process optimization, saving hours across departments'
    ],
    color: 'from-emerald-500 to-purple-500'
  }
];
---

<Layout
  title={title}
  description={description}
  image="/assets/images/Blake-O-scaled.jpg"
  url={canonicalUrl}
  wide={true}
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(personSchema)} />
  <!-- Decorative background shapes -->
  <div class="fixed inset-0 -z-10 pointer-events-none">
    <div class="absolute top-0 left-0 w-96 h-96 bg-accent/10 rounded-full blur-3xl -translate-x-1/2 -translate-y-1/2"></div>
    <div class="absolute bottom-0 right-0 w-80 h-80 bg-accent/20 rounded-full blur-3xl translate-x-1/3 translate-y-1/3"></div>
  </div>
  <!-- About Hero Section -->
  <section id="about-me" class="relative overflow-hidden pt-24 pb-16 sm:pb-20 lg:pb-24 min-h-screen flex items-center bg-gradient-to-br from-background via-accent/5 to-background dark:from-background-dark dark:via-accent/10 dark:to-background-dark">
      <!-- Animated background pattern -->
      <div class="absolute inset-0 z-0 opacity-20" aria-hidden="true">
        <div class="absolute inset-0"></div>
      </div>
      <div class="mx-auto w-full max-w-7xl px-4 sm:px-6 lg:px-8 relative z-10">
        <div class="grid md:grid-cols-2 gap-10 sm:gap-12 lg:gap-16 items-center">
          <div class="space-y-6">
            <h1 id="about-me-title" class="font-heading font-bold text-4xl sm:text-5xl md:text-6xl tracking-tight text-foreground dark:text-foreground-light leading-tight">
              Systems Architect & Workflow Strategist
            </h1>
            <p class="text-base sm:text-lg md:text-xl leading-relaxed text-foreground/80 dark:text-foreground-light/80">
              Based in Michigan, I help organizations transform complex processes into streamlined, data-driven systems. From healthcare to finance, my approach combines technical expertise with strategic thinking to deliver solutions that scale.
            </p>
            <div class="rounded-2xl border border-border/35 bg-background/95 p-6 dark:bg-background-dark/75">
              <ul class="space-y-3 text-sm font-semibold uppercase tracking-[0.28em] text-foreground/55 dark:text-foreground-light/60">
                <li class="flex items-center gap-3">
                  <span class="inline-flex size-2 rounded-full bg-accent"></span>
                  Automation with adoption guardrails
                </li>
                <li class="flex items-center gap-3">
                  <span class="inline-flex size-2 rounded-full bg-accent"></span>
                  Financial intelligence that informs every sprint
                </li>
                <li class="flex items-center gap-3">
                  <span class="inline-flex size-2 rounded-full bg-accent"></span>
                  Governance and enablement built-in from day one
                </li>
              </ul>
            </div>
          </div>
          <div class="w-full h-full min-h-[50vh] md:min-h-[60vh] lg:min-h-[70vh]" role="complementary" aria-label="Photo gallery">
            <div class="relative w-full h-full">
              <PhotoCarousel class="w-full h-full" />
              <div class="absolute inset-0 bg-gradient-to-r from-background/20 via-transparent to-transparent dark:from-background-dark/20 pointer-events-none"></div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Achievements -->
    <section id="achievements" class="py-16 sm:py-20 lg:py-24 relative overflow-hidden bg-surface dark:bg-surface-dark">
            <!-- Background pattern -->
            <div class="absolute inset-0 z-0 opacity-5">
              <div class="absolute inset-0" style="background-image: url('data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%239C92AC' fill-opacity='0.4'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E');"></div>
            </div>
            <div class="mx-auto w-full max-w-5xl px-4 sm:px-6 lg:px-8 relative z-10">
              <div class="grid grid-cols-1 gap-8 lg:gap-12">
                <div>
                  <h2 class="text-h2 font-bold text-foreground dark:text-foreground-light text-center mb-12">Key Achievements</h2>

                  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                    <!-- Achievement 1 -->
                    <div class="bg-surface/80 dark:bg-surface-dark/80 p-8 rounded-xl shadow-lg border border-border dark:border-border-dark hover:shadow-2xl hover-lift-sm transition-all duration-300">
                      <div class="flex items-center justify-center w-16 h-16 rounded-lg bg-gradient-to-br from-accent to-tertiary text-foreground-light text-2xl mb-6">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
                        </svg>
                      </div>
                      <h3 class="text-xl font-bold mb-3 text-foreground dark:text-foreground-light">Enterprise Transformation</h3>
                      <p class="mb-4 text-neutral dark:text-neutral-light">Successfully led Google Workspace to Microsoft 365 migration for 180+ staff with zero downtime, integrating 5 legacy systems.</p>
                      <ul class="space-y-2">
                        <li class="flex items-center gap-2">
                          <span class="inline-flex items-center justify-center w-6 h-6 rounded-full bg-green-50 dark:bg-green-900 aspect-square">
                            <svg class="w-4 h-4 text-green-600 dark:text-green-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 3v2m6-2v2M9 19v2m6-2v2M5 9H3m2 6H3m18-6h-2m2 6h-2M7 19h10a2 2 0 002-2V7a2 2 0 00-2-2H7a2 2 0 00-2 2v10a2 2 0 002 2zM9 9h6v6H9V9z" />
                            </svg>
                          </span>
                          <span class="text-sm">Zero downtime during migration</span>
                        </li>
                        <li class="flex items-center gap-2">
                          <span class="inline-flex items-center justify-center w-6 h-6 rounded-full bg-blue-50 dark:bg-blue-900 aspect-square">
                            <svg class="w-4 h-4 text-blue-600 dark:text-blue-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                              <circle cx="12" cy="12" r="10" stroke-width="2" />
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6l4 2" />
                            </svg>
                          </span>
                          <span class="text-sm">5 legacy systems consolidated</span>
                        </li>
                        <li class="flex items-center gap-2">
                          <span class="inline-flex items-center justify-center w-6 h-6 rounded-full bg-purple-50 dark:bg-purple-900 aspect-square">
                            <svg class="w-4 h-4 text-purple-600 dark:text-purple-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a4 4 0 00-3-3.87M9 20H4v-2a4 4 0 013-3.87m9-4a4 4 0 11-8 0 4 4 0 018 0z" />
                            </svg>
                          </span>
                          <span class="text-sm">100% employee adoption</span>
                        </li>
                      </ul>
                    </div>
                    <!-- Achievement 2 -->
                    <div class="bg-surface/80 dark:bg-surface-dark/80 p-8 rounded-xl shadow-lg border border-border dark:border-border-dark hover:shadow-2xl hover-lift-sm transition-all duration-300">
                      <div class="flex items-center justify-center w-16 h-16 rounded-lg bg-gradient-to-br from-accent to-tertiary text-foreground-light text-2xl mb-6">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
                        </svg>
                      </div>
                      <h3 class="text-xl font-bold mb-3 text-foreground dark:text-foreground-light">Financial Analytics</h3>
                      <p class="mb-4 text-neutral dark:text-neutral-light">Built sophisticated Power BI dashboards for real-time financial forecasting that revealed $1.2M in unbilled services.</p>
                      <ul class="space-y-2">
                        <li class="flex items-center gap-2">
                          <span class="inline-flex items-center justify-center w-6 h-6 rounded-full bg-green-50 dark:bg-green-900 aspect-square">
                            <svg class="w-4 h-4 text-green-600 dark:text-green-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                            </svg>
                          </span>
                          <span class="text-sm">$1.2M in unbilled services identified</span>
                        </li>
                        <li class="flex items-center gap-2">
                          <span class="inline-flex items-center justify-center w-6 h-6 rounded-full bg-blue-50 dark:bg-blue-900 aspect-square">
                            <svg class="w-4 h-4 text-blue-600 dark:text-blue-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                              <circle cx="12" cy="12" r="10" stroke-width="2" />
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6l4 2" />
                            </svg>
                          </span>
                          <span class="text-sm">Real-time forecast dashboards</span>
                        </li>
                        <li class="flex items-center gap-2">
                          <span class="inline-flex items-center justify-center w-6 h-6 rounded-full bg-purple-50 dark:bg-purple-900 aspect-square">
                            <svg class="w-4 h-4 text-purple-600 dark:text-purple-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" />
                            </svg>
                          </span>
                          <span class="text-sm">25% improved financial accuracy</span>
                        </li>
                      </ul>
                    </div>
                    <!-- Achievement 3 -->
                    <div class="bg-surface/80 dark:bg-surface-dark/80 p-8 rounded-xl shadow-lg border border-border dark:border-border-dark hover:shadow-2xl hover-lift-sm transition-all duration-300">
                      <div class="flex items-center justify-center w-16 h-16 rounded-lg bg-gradient-to-br from-accent to-tertiary text-foreground-light text-2xl mb-6">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />
                        </svg>
                      </div>
                      <h3 class="text-xl font-bold mb-3 text-foreground dark:text-foreground-light">AI-Powered Analytics Overhaul</h3>
                      <p class="mb-4 text-neutral dark:text-neutral-light">Led the modernization of enterprise analytics by integrating AI-driven insights, centralizing KPIs, and building real-time dashboards that transformed operational decision-making.</p>
                      <ul class="space-y-2">
                        <li class="flex items-center gap-2">
                          <span class="inline-flex items-center justify-center w-6 h-6 rounded-full bg-green-50 dark:bg-green-900 aspect-square">
                            <svg class="w-4 h-4 text-green-600 dark:text-green-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 3v2m6-2v2M9 19v2m6-2v2M5 9H3m2 6H3m18-6h-2m2 6h-2M7 19h10a2 2 0 002-2V7a2 2 0 00-2-2H7a2 2 0 00-2 2v10a2 2 0 002 2zM9 9h6v6H9V9z" />
                            </svg>
                          </span>
                          <span class="text-sm">Deployed 30+ AI-enhanced dashboards across 6 departments</span>
                        </li>
                        <li class="flex items-center gap-2">
                          <span class="inline-flex items-center justify-center w-6 h-6 rounded-full bg-blue-50 dark:bg-blue-900 aspect-square">
                            <svg class="w-4 h-4 text-blue-600 dark:text-blue-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                              <circle cx="12" cy="12" r="10" stroke-width="2" />
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6l4 2" />
                            </svg>
                          </span>
                          <span class="text-sm">Cut reporting delays by 50% with predictive data models</span>
                        </li>
                        <li class="flex items-center gap-2">
                          <span class="inline-flex items-center justify-center w-6 h-6 rounded-full bg-purple-50 dark:bg-purple-900 aspect-square">
                            <svg class="w-4 h-4 text-purple-600 dark:text-purple-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" />
                            </svg>
                          </span>
                          <span class="text-sm">Unified metrics and insights for real-time decision-making</span>
                        </li>
                      </ul>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </section>

          <!-- Education & Skills -->
          <section id="education-skills" class="py-16 bg-gradient-to-b from-background to-surface dark:from-background-dark dark:to-surface-dark relative overflow-hidden">
            <!-- Background geometric shapes -->
            <div class="absolute inset-0 z-0 opacity-20 overflow-hidden">
              <div class="absolute top-1/4 left-1/4 w-64 h-64 bg-accent/30 rounded-full blur-3xl"></div>
              <div class="absolute bottom-1/4 right-1/4 w-80 h-80 bg-purple-500/20 rounded-full blur-3xl"></div>
            </div>
            <div class="mx-auto w-full max-w-5xl px-4 sm:px-6 lg:px-8 relative z-10">
              <div class="max-w-3xl mx-auto text-center mb-12">
                <p class="text-lg text-neutral">
                </p>
              </div>
              <!-- Two column layout -->
              <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-12">
                <!-- Education Column -->
                <div>
                  <h2 class="text-2xl font-bold border-l-4 border-accent pl-4 mb-6">Education</h2>
                  <div class="bg-surface dark:bg-surface p-6 rounded-xl shadow-lg border border-border dark:border-border-dark hover:shadow-xl transition-all duration-300 group">
                    <div class="flex items-start">
                      <div class="flex-shrink-0 bg-accent/10 p-3 rounded-lg group-hover:scale-110 transition-transform duration-300">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                          <path d="M12 14l9-5-9-5-9 5 9 5z" />
                          <path d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z" />
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5zm0 0l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14zm-4 6v-7.5l4-2.222" />
                        </svg>
                      </div>
                      <div class="ml-4">
                        <h3 class="font-bold text-xl text-foreground dark:text-foreground-light group-hover:text-accent transition-colors duration-300">Calvin College</h3>
                        <div class="text-sm text-foreground/80 dark:text-gray-400 mb-2">Bachelor of Arts in Finance</div>
                        <p class="text-foreground/85">
                          Focused on Finance with complementary studies in Mandarin Chinese and development economics. Gained experience applying financial modeling and international business concepts through coursework and projects.
                        </p>
                      </div>
                    </div>
                  </div>
                </div>

                <!-- Skills Column -->
                <div>
                  <h2 class="text-2xl font-bold border-l-4 border-accent pl-4 mb-6">Skills</h2>
                  <div class="bg-surface dark:bg-surface p-6 rounded-xl shadow-lg border border-border dark:border-border-dark">
                    <p class="text-foreground/85 mb-4">A blend of systems thinking, finance, and hands-on engineering. I focus on shipping reliable, human-centered automation that delivers measurable outcomes.</p>
                    <ul class="flex flex-wrap gap-3" role="list">
                      <li class="px-3 py-2 rounded-lg bg-accent/10 text-foreground/90 dark:text-foreground-light/90">Systems Architecture</li>
                      <li class="px-3 py-2 rounded-lg bg-accent/10 text-foreground/90 dark:text-foreground-light/90">Process Automation</li>
                      <li class="px-3 py-2 rounded-lg bg-accent/10 text-foreground/90 dark:text-foreground-light/90">Cloud: Azure / M365</li>
                      <li class="px-3 py-2 rounded-lg bg-accent/10 text-foreground/90 dark:text-foreground-light/90">Data Analytics (Power BI)</li>
                      <li class="px-3 py-2 rounded-lg bg-accent/10 text-foreground/90 dark:text-foreground-light/90">APIs & Integrations</li>
                      <li class="px-3 py-2 rounded-lg bg-accent/10 text-foreground/90 dark:text-foreground-light/90">AI-Assisted Workflows</li>
                      <li class="px-3 py-2 rounded-lg bg-accent/10 text-foreground/90 dark:text-foreground-light/90">Financial Operations</li>
                      <li class="px-3 py-2 rounded-lg bg-accent/10 text-foreground/90 dark:text-foreground-light/90">Security & Compliance</li>
                    </ul>
                  </div>
                </div>
              </div>
            </div>
          </section>

          <!-- Career Timeline -->
          <section id="about-timeline" class="py-16 relative overflow-hidden bg-surface dark:bg-surface-dark">
            <!-- Overlay dots pattern -->
            <div class="absolute inset-0 z-0 opacity-10">
              <div class="absolute inset-0" aria-hidden="true">
                <svg xmlns="http://www.w3.org/2000/svg" width="100%" height="100%">
                </svg>
              </div>
            </div>
            <div class="mx-auto w-full max-w-5xl px-4 sm:px-6 lg:px-8 relative z-10">
              <div class="max-w-3xl mx-auto text-center mb-16">
                <h2 class="text-h2 font-bold mb-6 text-foreground dark:text-foreground-light">Professional Journey</h2>
                <p class="text-lg text-neutral-light">
                </p>
              </div>
              <!-- Desktop Timeline (vertical) -->
              <div class="hidden md:block relative timeline-desktop">
                <!-- Timeline center line with gradient animation -->
                <div class="absolute left-1/2 transform -translate-x-1/2 h-full w-1 bg-gradient-to-b from-emerald-500 via-purple-500 to-emerald-500 animate-gradient-shift"></div>
                <div class="space-y-0">
                  {timelineItems.map((item, index) => (
                    <div class={`relative z-10 flex items-center justify-${index % 2 === 0 ? 'start' : 'end'} group`}>
                      <div class={`w-full flex ${index % 2 === 0 ? '' : 'justify-end'} mb-16`}>
                        <div class={`${index % 2 === 0 ? 'ml-0 mr-8 text-right' : 'ml-8 mr-0'} w-5/12`}>
                          <div data-testid="timeline-card" class={'bg-surface/90 backdrop-blur-sm border border-gray-700 p-6 rounded-xl hover:shadow-lg hover-lift-sm transition-all duration-300 hover:shadow-emerald-500/10 group-hover:bg-surface/95 relative overflow-hidden'}>
                            {/* Background gradient effect */}
                            <div class="absolute inset-0 bg-gradient-to-r from-emerald-500/5 to-purple-500/5 opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>

                            <div class="flex items-center mb-6 gap-4 relative">
                              <div class={`inline-flex items-center justify-center w-16 h-16 rounded-full bg-gradient-to-br ${item.color} text-2xl group-hover:scale-110 transition-transform duration-300 relative`}>
                                {/* Multiple gradient layers for depth */}
                                <div class="absolute inset-0 rounded-full bg-gradient-to-br from-emerald-500/20 to-purple-500/20 blur-md opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
                                <div class="absolute inset-0 rounded-full bg-gradient-to-br from-emerald-500/30 to-purple-500/30 opacity-20 group-hover:opacity-30 transition-opacity duration-300"></div>
                                {/* Enhanced icon container */}
                                <div class="relative z-10 w-8 h-8">
                                  {item.icon === '🔄' && (
                                    <svg class="w-full h-full" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
                                    </svg>
                                  )}
                                  {item.icon === '☁️' && (
                                    <svg class="w-full h-full" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999 5.002 5.002 0 10-9.78 2.096A4.001 4.001 0 003 15z" />
                                    </svg>
                                  )}
                                  {item.icon === '💡' && (
                                    <svg class="w-full h-full" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />
                                    </svg>
                                  )}
                                  {item.icon === '🤖' && (
                                    <svg class="w-full h-full" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 3v2m6-2v2M9 19v2m6-2v2M5 9H3m2 6H3m18-6h-2m2 6h-2M7 19h10a2 2 0 002-2V7a2 2 0 00-2-2H7a2 2 0 00-2 2v10a2 2 0 002 2zM9 9h6v6H9V9z" />
                                    </svg>
                                  )}
                                </div>
                              </div>
                              <div class="flex-1">
                                <h3 class="text-2xl font-bold text-white group-hover:text-emerald-500 transition-colors duration-300">{item.year}</h3>
                                <p class="text-emerald-500 group-hover:text-emerald-500/80 transition-colors duration-300">{item.title}</p>
                              </div>
                            </div>
                            <div class="space-y-3 pl-4 border-l-2 border-gray-700 group-hover:border-emerald-500/50 transition-colors duration-300 relative">
                              {item.achievements.map((achievement, idx) => (
                                <p class="text-gray-300 group-hover:text-gray-200 flex items-start transform hover:translate-x-1 transition-all duration-300 hover:bg-gray-700/30 rounded-lg p-2" style={`transition-delay: ${idx * 50}ms`}>
                                  <svg class="w-4 h-4 text-emerald-500 mt-1 mr-2 flex-shrink-0 opacity-0 group-hover:opacity-100 transition-opacity duration-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                                  </svg>
                                  {achievement}
                                </p>
                              ))}
                            </div>
                            {/* Bottom gradient line */}
                            <div class="absolute bottom-0 left-0 w-full h-1 bg-gradient-to-r from-emerald-500/0 via-emerald-500/50 to-emerald-500/0 transform scale-x-0 group-hover:scale-x-100 transition-transform duration-500 origin-center"></div>
                          </div>
                        </div>
                      </div>
                      {/* Timeline dot with pulse animation */}
                      <div class="absolute left-1/2 top-1/2 transform -translate-x-1/2 -translate-y-1/2 w-5 h-5 rounded-full border-4 border-gray-900 bg-emerald-500 group-hover:scale-125 transition-transform duration-300">
                        <div class="absolute inset-0 rounded-full bg-emerald-500 animate-ping opacity-75"></div>
                      </div>
                    </div>
                  ))}
                </div>
              </div>

              <!-- Mobile Timeline (horizontal scroll) -->
              <div class="md:hidden overflow-x-auto pb-8 timeline-scroll-container timeline-mobile focus:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500 focus-visible:ring-offset-2 focus-visible:ring-offset-surface dark:focus-visible:ring-offset-surface-dark" role="region" aria-label="Timeline events" tabindex="0">
                <div class="inline-flex space-x-6 min-w-max px-4 pb-6">
                  {timelineItems.map((item) => (
                    <div data-testid="timeline-card" class="flex-none w-80 bg-surface/50 backdrop-blur-sm border border-gray-700 rounded-xl p-6 hover:shadow-lg hover:shadow-emerald-500/10 transition-all group relative overflow-hidden">
                      {/* Background gradient effect */}
                      <div class="absolute inset-0 bg-gradient-to-r from-emerald-500/5 to-purple-500/5 opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>

                      <div class="flex items-center mb-6 relative">
                        <div class={`w-14 h-14 flex items-center justify-center rounded-full text-xl bg-gradient-to-br ${item.color} group-hover:scale-110 transition-transform duration-300 relative`}>
                          {/* Multiple gradient layers for depth */}
                          <div class="absolute inset-0 rounded-full bg-gradient-to-br from-emerald-500/20 to-purple-500/20 blur-md opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
                          <div class="absolute inset-0 rounded-full bg-gradient-to-br from-emerald-500/30 to-purple-500/30 opacity-20 group-hover:opacity-30 transition-opacity duration-300"></div>
                          {/* Enhanced icon container */}
                          <div class="relative z-10 w-7 h-7">
                            {item.icon === '🔄' && (
                              <svg class="w-full h-full" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
                              </svg>
                            )}
                            {item.icon === '☁️' && (
                              <svg class="w-full h-full" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999 5.002 5.002 0 10-9.78 2.096A4.001 4.001 0 003 15z" />
                              </svg>
                            )}
                            {item.icon === '💡' && (
                              <svg class="w-full h-full" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />
                              </svg>
                            )}
                            {item.icon === '🤖' && (
                              <svg class="w-full h-full" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 3v2m6-2v2M9 19v2m6-2v2M5 9H3m2 6H3m18-6h-2m2 6h-2M7 19h10a2 2 0 002-2V7a2 2 0 00-2-2H7a2 2 0 00-2 2v10a2 2 0 002 2zM9 9h6v6H9V9z" />
                              </svg>
                            )}
                          </div>
                        </div>
                        <div class="ml-4 flex-1">
                          <h3 class="font-bold text-xl group-hover:text-emerald-500 transition-colors duration-300">{item.year}</h3>
                          <p class="text-emerald-500 group-hover:text-emerald-500/80 transition-colors duration-300">{item.title}</p>
                        </div>
                      </div>
                      <div class="pl-2 border-l-2 border-gray-700 group-hover:border-emerald-500/50 transition-colors duration-300 space-y-2 relative">
                        {item.achievements.map((achievement, idx) => (
                          <p class="text-sm text-gray-300 group-hover:text-gray-200 flex items-start transform hover:translate-x-1 transition-all duration-300 hover:bg-gray-700/30 rounded-lg p-2" style={`transition-delay: ${idx * 50}ms`}>
                            <svg class="w-3 h-3 text-emerald-500 mt-1 mr-2 flex-shrink-0 opacity-0 group-hover:opacity-100 transition-opacity duration-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                            </svg>
                            {achievement}
                          </p>
                        ))}
                      </div>
                      {/* Bottom gradient line */}
                      <div class="absolute bottom-0 left-0 w-full h-1 bg-gradient-to-r from-emerald-500/0 via-emerald-500/50 to-emerald-500/0 transform scale-x-0 group-hover:scale-x-100 transition-transform duration-500 origin-center"></div>
                    </div>
                  ))}
                </div>
              </div>

              <style>
                @keyframes gradient-shift {
                  0% { background-position: 0% 0%; }
                  50% { background-position: 0% 100%; }
                  100% { background-position: 0% 0%; }
                }
                .animate-gradient-shift {
                  background-size: 100% 200%;
                  animation: gradient-shift 8s ease infinite;
                }
                /* Fallback display rules to ensure correct variant renders regardless of Tailwind purge/variant issues */
                @media (min-width: 768px) {
                  #about-timeline .timeline-desktop { display: block !important; }
                  #about-timeline .timeline-mobile { display: none !important; }
                }
                @media (max-width: 767.98px) {
                  #about-timeline .timeline-desktop { display: none !important; }
                  #about-timeline .timeline-mobile { display: block !important; }
                }
                .timeline-scroll-container::-webkit-scrollbar {
                  height: 8px;
                }
                .timeline-scroll-container::-webkit-scrollbar-track {
                  background: rgb(var(--color-neutral-dark) / 30%);
                  border-radius: 4px;
                }
                .timeline-scroll-container::-webkit-scrollbar-thumb {
                  background: rgb(var(--color-accent) / 50%);
                  border-radius: 4px;
                }
                .timeline-scroll-container::-webkit-scrollbar-thumb:hover {
                  background: rgb(var(--color-accent) / 70%);
                }
              </style>
            </div>
          </section>

          <!-- Connect / Social Links -->
          <section id="about-social" class="py-16 bg-gradient-to-b from-surface to-background dark:from-surface-dark dark:to-background-dark">
            <div class="mx-auto w-full max-w-5xl px-4 sm:px-6 lg:px-8">
              <div class="max-w-3xl mx-auto text-center">
                <h2 class="text-h2 font-bold mb-4">Let’s Connect</h2>
                <p class="text-neutral mb-8">Open to collaborating on systems architecture, data platforms, and automation initiatives.</p>
                <ul class="flex flex-wrap items-center justify-center gap-4" role="list">
                  {socialLinks.map((link) => (
                    <li>
                      <a
                        class="inline-flex items-center gap-2 px-4 py-2 rounded-lg border border-border dark:border-border-dark hover:bg-accent/10 hover:border-accent transition-colors"
                        href={link.url}
                        target="_blank"
                        rel="noopener noreferrer"
                        aria-label={`Open ${link.name} profile in a new tab`}
                      >
                        {link.icon === 'linkedin' && (
                          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="20" height="20" fill="currentColor" class="text-foreground/80">
                            <path d="M4.98 3.5C4.98 4.88 3.86 6 2.5 6S0 4.88 0 3.5 1.12 1 2.5 1s2.48 1.12 2.48 2.5zM.5 8.5h4V23h-4V8.5zM8.5 8.5h3.83v1.98h.05c.53-1 1.83-2.06 3.77-2.06 4.03 0 4.77 2.65 4.77 6.1V23h-4v-6.5c0-1.55-.03-3.54-2.16-3.54-2.16 0-2.49 1.68-2.49 3.43V23h-4V8.5z" />
                          </svg>
                        )}
                        {link.icon === 'github' && (
                          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="20" height="20" fill="currentColor" class="text-foreground/80">
                            <path fill-rule="evenodd" d="M12 2C6.48 2 2 6.58 2 12.25c0 4.53 2.87 8.37 6.84 9.73.5.1.68-.22.68-.49 0-.24-.01-.87-.01-1.7-2.78.62-3.37-1.37-3.37-1.37-.45-1.18-1.11-1.5-1.11-1.5-.91-.64.07-.63.07-.63 1.01.07 1.54 1.06 1.54 1.06.89 1.57 2.34 1.12 2.91.86.09-.66.35-1.12.63-1.38-2.22-.26-4.56-1.15-4.56-5.12 0-1.13.39-2.06 1.03-2.79-.1-.26-.45-1.31.1-2.73 0 0 .85-.28 2.79 1.06A9.41 9.41 0 0 1 12 7.06c.86 0 1.73.12 2.54.34 1.94-1.34 2.78-1.06 2.78-1.06.56 1.42.21 2.47.1 2.73.64.73 1.03 1.66 1.03 2.79 0 3.98-2.34 4.86-4.57 5.12.36.33.69.97.69 1.96 0 1.41-.01 2.55-.01 2.9 0 .27.18.6.69.49A10.06 10.06 0 0 0 22 12.25C22 6.58 17.52 2 12 2Z" clip-rule="evenodd" />
                          </svg>
                        )}
                        {link.icon === 'microsoft-learn' && (
                          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="20" height="20" fill="currentColor" class="text-foreground/80">
                            <path d="M12 2l7 4v6c0 5-3.5 9-7 10-3.5-1-7-5-7-10V6l7-4zm-1 6H7v2h4V8zm2 0h4v2h-4V8z" />
                          </svg>
                        )}
                        <span class="font-medium">{link.name}</span>
                        <span class="sr-only">(opens in a new tab)</span>
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            </div>
    </section>
</Layout>
