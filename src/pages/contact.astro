---
import Layout from '../layouts/BaseLayout.astro';
import CoinFlipImage from '../components/ui/CoinFlipImage.astro';
import ContactFormClient from '../components/islands/ContactFormClient';
const title = 'Contact Blake';
const description = 'Get in touch with Blake Oxford for collaboration, inquiries, or just to say hello!';
const canonicalUrl = 'https://blakeoxford.com/contact/';
---

<Layout title={title} description={description} url={canonicalUrl} wide={true}>
  <!-- Hero section -->
  <section id="hero" class="pb-20 sm:pb-24 md:pb-32 bg-gradient-to-br from-background via-accent/5 to-background relative overflow-hidden">
    <div class="relative z-10 mx-auto w-full max-w-6xl px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 gap-12 items-center md:grid-cols-2">
          <div class="@container space-y-6">
            <h1 class="font-heading font-bold text-4xl sm:text-5xl md:text-6xl tracking-tight text-foreground dark:text-foreground-light">Let's Connect</h1>
            <p class="text-base sm:text-lg leading-relaxed text-foreground/80 dark:text-foreground-light/80 max-w-2xl">Have a project in mind or just want to say hello? I'm all ears—whether it's a collaboration idea, a question, or just a quick chat. I usually reply within 24 hours and can't wait to build something great together!</p>
          </div>
          <div class="flex justify-center md:justify-end">
            <div class="relative">
              <CoinFlipImage frontSrc="/assets/images/Blake-O-scaled.jpg" backSrc="/assets/images/china-profile-picture.jpg" alt="Blake Oxford" altBack="Blake Oxford in China" size={280} flipMultipleTimes loading="eager" fetchPriority="high" decoding="auto" />
            <div class="absolute -top-4 -right-4 flex h-12 w-12 items-center justify-center rounded-full bg-accent text-background animate-float">💡</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Main contact section -->
  <section id="contact-info" class="w-full py-16 sm:py-20 lg:py-24 relative overflow-hidden bg-gradient-to-br from-background via-accent/5 to-background" aria-labelledby="message-form">
    <!-- Animated SVG background pattern -->
    <div class="absolute inset-0 z-0 opacity-20 pointer-events-none">
      <svg class="absolute inset-0 w-full h-full" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <pattern id="contact-grid" width="40" height="40" patternUnits="userSpaceOnUse">
            <path d="M0 40L40 0M20 40L40 20M0 20L20 0" fill="none" stroke="currentColor" stroke-width="1" stroke-opacity="0.12" />
          </pattern>
        </defs>
        <rect width="100%" height="100%" fill="url(#contact-grid)" />
      </svg>
    </div>
    <!-- Blurred/floating shapes -->
    <div class="absolute top-0 right-0 w-64 h-64 bg-accent/20 rounded-full blur-3xl translate-x-1/2 -translate-y-1/2 pointer-events-none"></div>
    <div class="absolute bottom-0 left-0 w-48 h-48 bg-accent/20 rounded-full blur-3xl -translate-x-1/2 translate-y-1/2 pointer-events-none"></div>

    <div class="relative z-10 mx-auto w-full max-w-6xl px-4 sm:px-6 lg:px-8">
      <!-- Contact Information -->
      <div class="scroll-animate flex flex-col md:flex-row items-center justify-center gap-8 mb-12 sm:mb-14 lg:mb-16">
        <a href="mailto:blakepoxford@outlook.com" class="flex flex-col items-center gap-3 group focus:outline-none focus-visible:ring-2 focus-visible:ring-accent p-4 rounded-xl hover:bg-accent/5 transition-colors" aria-label="Email Blake Oxford" title="Email">
          <span class="text-accent text-3xl group-hover:scale-110 transition">✉️</span>
          <span class="font-medium text-primary group-hover:text-accent transition-colors">blakepoxford@outlook.com</span>
        </a>
        <a href="tel:2482024479" class="flex flex-col items-center gap-3 group focus:outline-none focus-visible:ring-2 focus-visible:ring-accent p-4 rounded-xl hover:bg-accent/5 transition-colors" aria-label="Call Blake Oxford" title="Phone">
          <span class="text-accent text-3xl group-hover:scale-110 transition">📞</span>
          <span class="font-medium text-primary group-hover:text-accent transition-colors">248-202-4479</span>
        </a>
        <a href="https://linkedin.com/in/blake-oxford" target="_blank" rel="noopener" class="flex flex-col items-center gap-3 group focus:outline-none focus-visible:ring-2 focus-visible:ring-accent p-4 rounded-xl hover:bg-accent/5 transition-colors" aria-label="LinkedIn" title="LinkedIn">
          <span class="text-accent text-3xl group-hover:scale-110 transition">💼</span>
          <span class="font-medium text-primary group-hover:text-accent transition-colors">linkedin.com/in/blake-oxford</span>
        </a>
      </div>

      <!-- Contact Form -->
      <div class="mx-auto w-full max-w-3xl">
  <h2 id="message-form" class="font-heading font-bold text-2xl sm:text-3xl md:text-4xl text-foreground dark:text-foreground-light text-center mb-8">Or Send Me a Message</h2>

        <!-- Form status banner -->
  <div id="form-status" aria-live="polite" class="hidden text-center font-semibold mb-4 min-h-[56px]"></div>

        <div class="scroll-animate bg-surface dark:bg-surface-dark rounded-2xl shadow-xl p-8 mt-4 max-w-xl mx-auto border-2 border-accent/30 hover:border-accent/50 transition-colors">
          <form id="contact-form" method="POST" action="/send-email" class="space-y-6" aria-describedby="contact-form-help">
            <input type="hidden" name="form-name" value="contact" aria-hidden="true" />
            <p class="sr-only" aria-hidden="true">
              <label>
                Don&#39;t fill this out:
                <input name="bot-field" type="hidden" aria-hidden="true" tabindex="-1" />
              </label>
            </p>
            <p id="contact-form-help" class="sr-only">All fields marked with an asterisk are required.</p>

            <div class="flex flex-col gap-2">
              <label for="name" class="font-semibold text-lg">Name <span class="text-accent dark:text-accent-light">*</span></label>
              <input
                id="name"
                name="name"
                autocomplete="name"
                required
                aria-required="true"
                aria-describedby="name-error"
                minlength="2"
                maxlength="100"
                class="w-full p-3 rounded-lg border-2 border-accent/30 focus:border-accent focus:ring-2 focus:ring-accent/20 dark:border-accent-dark dark:bg-surface-dark bg-surface transition-colors"
                placeholder="Your Name"
              />
              <div id="name-error" class="text-red-600 text-sm hidden" role="alert" aria-live="polite"></div>
            </div>
            <div class="flex flex-col gap-2">
              <label for="email" class="font-semibold text-lg">Email <span class="text-accent dark:text-accent-light">*</span></label>
              <input
                id="email"
                name="email"
                type="email"
                autocomplete="email"
                required
                aria-required="true"
                aria-describedby="email-help email-error"
                maxlength="254"
                class="w-full p-3 rounded-lg border-2 border-accent/30 focus:border-accent focus:ring-2 focus:ring-accent/20 dark:border-accent-dark dark:bg-surface-dark bg-surface transition-colors"
                placeholder="you@email.com"
              />
              <small id="email-help" class="text-sm text-neutral">I'll never share your email.</small>
              <div id="email-error" class="text-red-600 text-sm hidden" role="alert" aria-live="polite" aria-atomic="true"></div>
            </div>
            <div class="flex flex-col gap-2">
              <label for="message" class="font-semibold text-lg">Message <span class="text-accent dark:text-accent-light">*</span></label>
              <textarea
                id="message"
                name="message"
                rows="5"
                required
                aria-required="true"
                aria-describedby="message-error message-help"
                minlength="10"
                maxlength="2000"
                class="w-full p-3 rounded-lg border-2 border-accent/30 focus:border-accent focus:ring-2 focus:ring-accent/20 dark:border-accent-dark dark:bg-surface-dark bg-surface transition-colors"
                placeholder="How can I help you?"
              ></textarea>
              <small id="message-help" class="text-sm text-neutral">Please provide at least 10 characters (maximum 2000).</small>
              <div id="message-error" class="text-red-600 text-sm hidden" role="alert" aria-live="polite" aria-atomic="true"></div>
            </div>

            <!-- Cloudflare Turnstile placeholder (reserve space to avoid CLS) -->
            <div class="w-full min-h-[72px] flex items-center justify-center">
              <div id="turnstile-container" class="w-full" role="group" aria-label="Human verification challenge">
                <!-- Facade placeholder; real widget injected on-demand -->
                <div class="text-center text-sm text-neutral">Human verification will appear when needed.</div>
              </div>
            </div>

            <button type="submit" class="mx-auto flex w-full md:w-auto items-center justify-center gap-2 rounded-full bg-accent px-6 sm:px-7 py-3 text-sm font-semibold text-on-accent shadow-lg shadow-accent/25 transition-colors duration-200 hover:bg-accent-light dark:hover:bg-accent-dark focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent/65 focus-visible:ring-offset-2">
              🚀 <span id="btn-label">Send Message</span>
              <svg id="spinner" class="hidden animate-spin h-5 w-5" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" fill="none"/></svg>
            </button>
          </form>
        </div>
      </div>
    </div>
  </section>

  <ContactFormClient client:load />
</Layout>
