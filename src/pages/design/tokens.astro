---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/primitives/Container.astro';
import Section from '../../components/primitives/Section.astro';
import Badge from '../../components/primitives/Badge.astro';

const semanticColors = [
 { name: 'background', utility: 'bg-background', usage: 'Page canvas' },
 { name: 'surface', utility: 'bg-surface', usage: 'Cards, panels, controls' },
 { name: 'foreground', utility: 'text-foreground', usage: 'Primary readable text' },
 { name: 'muted-foreground', utility: 'text-muted-foreground', usage: 'Secondary body copy (WCAG AA on background)' },
 { name: 'subtle-foreground', utility: 'text-subtle-foreground', usage: 'Labels, meta, uppercase captions' },
 { name: 'border', utility: 'border-border', usage: 'Dividers, rings, component outlines' },
 { name: 'primary', utility: 'bg-primary text-on-primary', usage: 'Primary brand actions' },
 { name: 'accent', utility: 'bg-accent text-on-accent', usage: 'Focused calls to action and highlights' },
 { name: 'success', utility: 'bg-success', usage: 'Successful or available state' },
 { name: 'warning', utility: 'bg-warning', usage: 'Caution and pending state' },
 { name: 'error', utility: 'bg-error', usage: 'Failure and destructive state' },
 { name: 'info', utility: 'bg-info', usage: 'Informational state (aliases secondary)' },
];

const semanticAliases = [
 { token: '--bg', mapsTo: '--color-background', usage: 'Arbitrary values: bg-background' },
 { token: '--fg', mapsTo: '--color-foreground', usage: 'Arbitrary values: text-foreground' },
 { token: '--fg-muted', mapsTo: '--color-muted-foreground', usage: 'Nav links, secondary chrome' },
 { token: '--fg-subtle', mapsTo: '--color-subtle-foreground', usage: 'Labels and meta text' },
 { token: '--surface', mapsTo: '--color-surface', usage: 'Glass panels and cards' },
 { token: '--border', mapsTo: '--border-color', usage: 'Component outlines' },
 { token: '--accent', mapsTo: '--color-accent', usage: 'Focus rings and highlights' },
];

const motionTokens = [
 { token: '--duration-fast', value: '100ms', usage: 'Micro-interactions, toggles' },
 { token: '--duration', value: '250ms', usage: 'Default transitions (Tailwind duration DEFAULT)' },
 { token: '--duration-slow', value: '500ms', usage: 'Panel open/close, hero motion' },
 { token: '--ease-standard', value: 'Material curve', usage: 'Most UI transitions' },
 { token: '--ease-emphasized', value: 'Dramatic curve', usage: 'Entrance animations (slideUp)' },
];

const elevationScale = [
 { token: 'shadow-sm', usage: 'Static cards and subtle containers' },
 { token: 'shadow-md', usage: 'Glass panels and light overlays' },
 { token: 'shadow-lg', usage: 'Interactive cards, dialogs, and major panels' },
];

const radiusScale = [
 { token: 'rounded-lg', usage: 'Buttons, inputs, compact controls' },
 { token: 'rounded-xl', usage: 'Small cards and grouped controls' },
 { token: 'rounded-2xl', usage: 'Standard cards and component panels' },
 { token: 'rounded-3xl', usage: 'Route-level hero media or modal shells only' },
];

const stylesheetRoles = [
 {
 file: 'src/styles/theme.css',
 role: 'Design tokens, base resets, focus styles, and opt-in :has() pattern utilities.',
 },
 {
 file: 'src/styles/components.css',
 role: 'Reusable component classes (cards, blur orbs, hero gradient, search overlay guards).',
 },
 {
 file: 'src/styles/global.css',
 role: 'Tailwind entry point only — imports theme + components; no test overrides.',
 },
 {
 file: 'tests/playwright/fixtures/test-overrides.css',
 role: 'Playwright-only CSS injected via hooks.ts (mobile menu + search harness).',
 },
];
---

<BaseLayout
 title="Design Tokens"
 description="Operational reference for the Blake Oxford design-system token contract."
 canonicalUrl="https://blakeoxford.com/design/tokens/"
>
 <Section padding="xl">
 <Container size="xl">
 <header class="max-w-3xl">
 <Badge variant="subtle">Design system</Badge>
 <h1 class="mt-5 text-4xl font-bold text-foreground sm:text-5xl">
 Token Contract
 </h1>
 <p class="mt-4 text-lg leading-relaxed text-muted-foreground">
 Tokens live in <code class="rounded bg-surface-subtle px-1.5 py-0.5 text-sm dark:bg-surface-dark-subtle">src/styles/theme.css</code>,
 component classes in <code class="rounded bg-surface-subtle px-1.5 py-0.5 text-sm dark:bg-surface-dark-subtle">components.css</code>,
 and Tailwind maps them in <code class="rounded bg-surface-subtle px-1.5 py-0.5 text-sm dark:bg-surface-dark-subtle">tailwind.config.ts</code>.
 Components consume semantic utilities — not raw palette names or orphaned token variables.
 </p>
 </header>

 <div class="mt-12 grid gap-4 md:grid-cols-3">
 <div class="rounded-2xl border border-border/40 bg-surface p-6 shadow-sm dark:border-border-dark/40 dark:bg-surface-dark">
 <p class="text-sm font-semibold uppercase tracking-label text-subtle-foreground">Source</p>
 <p class="mt-3 text-xl font-semibold">theme.css</p>
 <p class="mt-2 text-sm text-muted-foreground">OKLCH palette, motion scale, glass surfaces, and dark-mode swaps on <code>:root</code>.</p>
 </div>
 <div class="rounded-2xl border border-border/40 bg-surface p-6 shadow-sm dark:border-border-dark/40 dark:bg-surface-dark">
 <p class="text-sm font-semibold uppercase tracking-label text-subtle-foreground">Mapping</p>
 <p class="mt-3 text-xl font-semibold">tailwind.config.ts</p>
 <p class="mt-2 text-sm text-muted-foreground">Exposes semantic utilities. Unused token aliases are pruned rather than kept “just in case.”</p>
 </div>
 <div class="rounded-2xl border border-border/40 bg-surface p-6 shadow-sm dark:border-border-dark/40 dark:bg-surface-dark">
 <p class="text-sm font-semibold uppercase tracking-label text-subtle-foreground">Gate</p>
 <p class="mt-3 text-xl font-semibold">design-lint</p>
 <p class="mt-2 text-sm text-muted-foreground">Blocks duplicate artifacts, undefined tokens, raw reusable palettes, and unsupported opacity steps.</p>
 </div>
 </div>

 <section class="mt-16" aria-labelledby="stylesheet-roles">
 <h2 id="stylesheet-roles" class="text-2xl font-bold text-foreground">Stylesheet Roles</h2>
 <div class="mt-5 grid gap-3">
 {stylesheetRoles.map((item) => (
 <div class="rounded-xl border border-border/40 bg-surface p-4 shadow-sm dark:border-border-dark/40 dark:bg-surface-dark">
 <code class="text-sm font-semibold text-accent">{item.file}</code>
 <p class="mt-1 text-sm text-muted-foreground">{item.role}</p>
 </div>
 ))}
 </div>
 </section>

 <section class="mt-16" aria-labelledby="color-tokens">
 <h2 id="color-tokens" class="text-2xl font-bold text-foreground">Semantic Colors</h2>
 <p class="mt-3 max-w-3xl text-muted-foreground">
 Reusable components must use these semantic names. Raw colors belong only in token definition files or content-specific editorial art.
 </p>
 <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-5">
 {semanticColors.map((color) => (
 <article class="overflow-hidden rounded-2xl border border-border/40 bg-surface shadow-sm dark:border-border-dark/40 dark:bg-surface-dark">
 <div class={`h-20 ${color.utility}`} aria-hidden="true"></div>
 <div class="p-4">
 <h3 class="font-semibold text-foreground">{color.name}</h3>
 <p class="mt-1 text-xs text-subtle-foreground">{color.usage}</p>
 </div>
 </article>
 ))}
 </div>
 </section>

 <section class="mt-16 grid gap-8 lg:grid-cols-2" aria-labelledby="aliases-motion">
 <div>
 <h2 id="aliases-motion" class="text-2xl font-bold text-foreground">Semantic Aliases</h2>
 <p class="mt-3 text-sm text-muted-foreground">
 Short names for arbitrary Tailwind values. Dark mode re-maps these inside <code>:root[data-theme="dark"]</code>.
 </p>
 <div class="mt-5 space-y-3">
 {semanticAliases.map((item) => (
 <div class="rounded-xl border border-border/40 bg-surface p-4 shadow-sm dark:border-border-dark/40 dark:bg-surface-dark">
 <code class="text-sm font-semibold text-accent">{item.token}</code>
 <span class="mx-2 text-subtle-foreground/80">→</span>
 <code class="text-sm text-muted-foreground">{item.mapsTo}</code>
 <p class="mt-1 text-sm text-muted-foreground">{item.usage}</p>
 </div>
 ))}
 </div>
 </div>
 <div>
 <h2 class="text-2xl font-bold text-foreground">Motion</h2>
 <p class="mt-3 text-sm text-muted-foreground">
 Prefer Tailwind <code>duration-*</code> and <code>ease-*</code> utilities. Reduced motion sets <code>--animation-duration</code> and <code>--transition-duration</code> to near-zero.
 </p>
 <div class="mt-5 space-y-3">
 {motionTokens.map((item) => (
 <div class="rounded-xl border border-border/40 bg-surface p-4 shadow-sm dark:border-border-dark/40 dark:bg-surface-dark">
 <code class="text-sm font-semibold text-accent">{item.token}</code>
 <span class="ml-2 text-xs text-subtle-foreground">{item.value}</span>
 <p class="mt-1 text-sm text-muted-foreground">{item.usage}</p>
 </div>
 ))}
 </div>
 </div>
 </section>

 <section class="mt-16 grid gap-8 lg:grid-cols-2" aria-labelledby="shape-elevation">
 <div>
 <h2 id="shape-elevation" class="text-2xl font-bold text-foreground">Elevation</h2>
 <div class="mt-5 space-y-3">
 {elevationScale.map((item) => (
 <div class="rounded-xl border border-border/40 bg-surface p-4 shadow-sm dark:border-border-dark/40 dark:bg-surface-dark">
 <code class="text-sm font-semibold text-accent">{item.token}</code>
 <p class="mt-1 text-sm text-muted-foreground">{item.usage}</p>
 </div>
 ))}
 </div>
 </div>
 <div>
 <h2 class="text-2xl font-bold text-foreground">Radius & Layout</h2>
 <div class="mt-5 space-y-3">
 {radiusScale.map((item) => (
 <div class="rounded-xl border border-border/40 bg-surface p-4 shadow-sm dark:border-border-dark/40 dark:bg-surface-dark">
 <code class="text-sm font-semibold text-accent">{item.token}</code>
 <p class="mt-1 text-sm text-muted-foreground">{item.usage}</p>
 </div>
 ))}
 <div class="rounded-xl border border-border/40 bg-surface p-4 shadow-sm dark:border-border-dark/40 dark:bg-surface-dark">
 <code class="text-sm font-semibold text-accent">max-w-container-2xl</code>
 <p class="mt-1 text-sm text-muted-foreground">Site-wide max content width (<code>--container-2xl</code>, 110rem). Used by the navbar and wide layouts.</p>
 </div>
 </div>
 </div>
 </section>

 <section class="mt-16 rounded-2xl border border-border/40 bg-surface p-6 shadow-sm dark:border-border-dark/40 dark:bg-surface-dark" aria-labelledby="token-rules">
 <h2 id="token-rules" class="text-2xl font-bold text-foreground">Rules</h2>
 <ul class="mt-5 grid gap-3 text-sm text-muted-foreground md:grid-cols-2">
 <li>Use semantic tokens for reusable UI: primary, accent, success, warning, error, info.</li>
 <li>Use opacity steps supported by the system: 5, 10, 15, 20, 25, 30, 40, 50, 60, 70, 75, 80, 85, 90, 95, 100.</li>
 <li>Keep card elevation to shadow-sm, shadow-md, or shadow-lg unless the surface is a route-level modal shell.</li>
 <li>Do not add tokens without a mapped Tailwind utility or a direct component consumer — prune orphans during audits.</li>
 <li>Prefer <code class="text-subtle-foreground">text-muted-foreground</code> and <code class="text-subtle-foreground">text-subtle-foreground</code> over <code class="text-subtle-foreground">text-foreground/55–/65</code> for readable secondary copy in light mode.</li>
 <li>Playwright-only CSS belongs in <code>tests/playwright/fixtures/</code>, not <code>global.css</code>.</li>
 <li>Keep token examples aligned with component props and data from <code>src/data/componentDocs.ts</code>.</li>
 </ul>
 </section>

 <nav class="mt-12 flex flex-wrap gap-3" aria-label="Design documentation">
 <a class="rounded-lg bg-accent px-4 py-2 font-semibold text-on-accent transition hover:bg-accent-dark" href="/design/components/">Component contracts</a>
 <a class="rounded-lg border border-border px-4 py-2 font-semibold text-foreground transition hover:border-accent dark:border-border-dark" href="/docs/components/">Component catalog</a>
 </nav>
 </Container>
 </Section>
</BaseLayout>
