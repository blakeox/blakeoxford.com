---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/primitives/Container.astro';
import Section from '../../components/primitives/Section.astro';
import Badge from '../../components/primitives/Badge.astro';

const semanticColors = [
  { name: 'background', utility: 'bg-background', usage: 'Page canvas (theme-aware)' },
  { name: 'surface', utility: 'bg-surface', usage: 'Cards, panels, controls' },
  { name: 'surface-subtle', utility: 'bg-surface-subtle', usage: 'Quiet secondary panels' },
  { name: 'surface-elevated', utility: 'bg-surface-elevated', usage: 'Elevated overlays' },
  { name: 'glass', utility: 'bg-glass', usage: 'Nav and chat translucent chrome' },
  { name: 'overlay-scrim', utility: 'bg-overlay-scrim', usage: 'Modal backdrops (always dark)' },
  { name: 'code-surface', utility: 'bg-code-surface text-code-foreground', usage: 'Always-dark code samples' },
  { name: 'foreground', utility: 'text-foreground', usage: 'Primary readable text' },
  { name: 'muted-foreground', utility: 'text-muted-foreground', usage: 'Secondary body copy (dark floor oklch 0.82)' },
  { name: 'subtle-foreground', utility: 'text-subtle-foreground', usage: 'Labels and meta (dark floor oklch 0.80)' },
  { name: 'border', utility: 'border-border', usage: 'Dividers and outlines' },
  { name: 'accent', utility: 'bg-accent text-on-accent', usage: 'Primary actions — on-accent is near-white in light, dark ink in dark' },
  { name: 'on-accent', utility: 'text-on-accent', usage: 'Foreground paired with bg-accent / button-primary (theme-aware)' },
  { name: 'accent-subtle', utility: 'bg-accent-subtle', usage: 'Soft accent washes (theme-aware)' },
  { name: 'primary-subtle', utility: 'bg-primary-subtle', usage: 'Soft primary washes (blur orbs)' },
  { name: '*-emphasis', utility: 'text-accent-emphasis', usage: 'Theme-aware accent/state text — prefer over dark: pairs' },
];

const rules = [
  'Edit tokens only in src/styles/theme.css. @theme inline exposes them as utilities.',
  'Prefer theme-aware utilities (bg-surface, text-accent-emphasis, bg-accent-subtle). Never use bg-background-dark / text-foreground-light.',
  'Pair bg-accent with text-on-accent (or button-primary-*). Light mode uses near-white on-accent; dark mode remaps to dark ink because the accent lightens.',
  'Dark muted/subtle foregrounds stay ≥ oklch 0.80 so small-caps labels clear WCAG AA 4.5:1.',
  'Use bg-overlay-scrim for modal backdrops and bg-code-surface for always-dark code blocks. Scrim dismiss layers are decorative — mark with data-a11y-allow-color-contrast.',
  'Motion: duration-fast | duration-normal | duration-moderate | duration-slow (not duration-200).',
  'Do not use bg-[color:var(--…)] for tokens that already have utilities.',
  'Shared chrome (nav, overlays, hero motion) lives in components.css; page layout stays in Tailwind.',
  'tailwind.config.ts keeps plugins + container padding only.',
];
---

<BaseLayout
  title="Design Tokens"
  description="Operational reference for the Blake Oxford design token contract."
>
  <Section padding="xl">
    <Container size="xl">
      <header class="max-w-3xl">
        <Badge variant="subtle">Design system</Badge>
        <h1 class="mt-5 font-heading text-4xl font-bold text-foreground sm:text-5xl">
          Token contract
        </h1>
        <p class="mt-4 text-lg leading-relaxed text-muted-foreground">
          Tokens live in <code class="rounded bg-surface-subtle px-1.5 py-0.5 text-sm">src/styles/theme.css</code>.
          Shared classes live in <code class="rounded bg-surface-subtle px-1.5 py-0.5 text-sm">components.css</code>.
          Dark mode remaps semantic tokens on <code class="rounded bg-surface-subtle px-1.5 py-0.5 text-sm">:root</code> — components should not restate dark variants.
        </p>
      </header>

      <div class="mt-12 grid gap-4 md:grid-cols-3">
        <div class="rounded-2xl border border-border/40 bg-surface p-6 shadow-sm">
          <p class="text-sm font-semibold uppercase tracking-label text-subtle-foreground">Source</p>
          <p class="mt-3 text-xl font-semibold text-foreground">theme.css</p>
          <p class="mt-2 text-sm text-muted-foreground">OKLCH palette, motion, glass, and dark swaps.</p>
        </div>
        <div class="rounded-2xl border border-border/40 bg-surface p-6 shadow-sm">
          <p class="text-sm font-semibold uppercase tracking-label text-subtle-foreground">Bridge</p>
          <p class="mt-3 text-xl font-semibold text-foreground">@theme inline</p>
          <p class="mt-2 text-sm text-muted-foreground">Generates semantic Tailwind utilities from tokens.</p>
        </div>
        <div class="rounded-2xl border border-border/40 bg-surface p-6 shadow-sm">
          <p class="text-sm font-semibold uppercase tracking-label text-subtle-foreground">Config</p>
          <p class="mt-3 text-xl font-semibold text-foreground">tailwind.config.ts</p>
          <p class="mt-2 text-sm text-muted-foreground">Plugins and container padding only.</p>
        </div>
      </div>

      <section class="mt-16" aria-labelledby="brand-palette">
        <h2 id="brand-palette" class="font-heading text-2xl font-bold text-foreground">Brand palette</h2>
        <p class="mt-3 max-w-3xl text-muted-foreground">
          Primary ink at OKLCH hue <strong>55°</strong>; accent brass at <strong>75°</strong>.
        </p>
        <div class="mt-6 grid gap-4 md:grid-cols-3">
          <article class="rounded-2xl border border-border/40 bg-surface p-5 shadow-sm">
            <div class="mb-4 h-16 rounded-xl bg-primary"></div>
            <h3 class="font-semibold text-foreground">primary</h3>
            <p class="mt-1 text-sm text-subtle-foreground">55° · <code>--color-primary</code></p>
            <p class="mt-2 text-sm text-muted-foreground">Warm ink — secondary brand surfaces and emphasis</p>
          </article>
          <article class="rounded-2xl border border-border/40 bg-surface p-5 shadow-sm">
            <div class="mb-4 flex h-16 items-center justify-center rounded-xl bg-accent px-4 font-semibold text-on-accent">
              text-on-accent
            </div>
            <h3 class="font-semibold text-foreground">accent</h3>
            <p class="mt-1 text-sm text-subtle-foreground">75° · <code>--color-accent</code> + <code>--color-on-accent</code></p>
            <p class="mt-2 text-sm text-muted-foreground">Brass signal — CTAs, focus rings, interactive chrome (AA with on-accent)</p>
          </article>
          <article class="rounded-2xl border border-border/40 bg-surface p-5 shadow-sm">
            <div class="mb-4 h-16 rounded-xl bg-accent-subtle"></div>
            <h3 class="font-semibold text-foreground">accent-subtle</h3>
            <p class="mt-1 text-sm text-subtle-foreground">75° mix · <code>--color-accent-subtle</code></p>
            <p class="mt-2 text-sm text-muted-foreground">Soft accent washes for panels and chips</p>
          </article>
        </div>
      </section>

      <section class="mt-16" aria-labelledby="semantic-colors">
        <h2 id="semantic-colors" class="font-heading text-2xl font-bold text-foreground">Semantic utilities</h2>
        <div class="mt-6 overflow-x-auto rounded-2xl border border-border/40 bg-surface shadow-sm">
          <table class="min-w-full text-left text-sm">
            <thead class="border-b border-border/40 bg-surface-subtle/60 text-subtle-foreground">
              <tr>
                <th class="px-4 py-3 font-semibold">Name</th>
                <th class="px-4 py-3 font-semibold">Utility</th>
                <th class="px-4 py-3 font-semibold">Usage</th>
              </tr>
            </thead>
            <tbody>
              {semanticColors.map((row) => (
                <tr class="border-b border-border/20 last:border-0">
                  <td class="px-4 py-3 font-medium text-foreground">{row.name}</td>
                  <td class="px-4 py-3"><code class="text-accent-emphasis">{row.utility}</code></td>
                  <td class="px-4 py-3 text-muted-foreground">{row.usage}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>

      <section class="mt-16 rounded-2xl border border-border/40 bg-surface p-6 shadow-sm" aria-labelledby="token-rules">
        <h2 id="token-rules" class="font-heading text-2xl font-bold text-foreground">Rules</h2>
        <ul class="mt-4 space-y-2 text-muted-foreground">
          {rules.map((rule) => (
            <li class="flex gap-3">
              <span class="mt-2 size-1.5 shrink-0 rounded-full bg-accent" aria-hidden="true"></span>
              <span>{rule}</span>
            </li>
          ))}
        </ul>
      </section>
    </Container>
  </Section>
</BaseLayout>
