---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/primitives/Container.astro';
import Section from '../../components/primitives/Section.astro';
import Badge from '../../components/primitives/Badge.astro';

const motionRules = [
  {
    name: 'State transition',
    purpose: 'Use for theme changes, hover color, and active state changes.',
    contract: 'transition-colors duration-200',
    example: 'Color changes should clarify state without moving layout.',
  },
  {
    name: 'Surface reveal',
    purpose: 'Use for dialogs, overlays, and panels that enter the viewport.',
    contract: 'transition-transform duration-200 ease-out',
    example: 'Search and chat panels can translate in; content cards should stay stable.',
  },
  {
    name: 'Affordance lift',
    purpose: 'Use only on clickable repeated items where hover confirms interactivity.',
    contract: 'motion-safe:hover:-translate-y-0.5',
    example: 'Keep the movement small and pair it with focus-visible styles.',
  },
  {
    name: 'Reduced motion',
    purpose: 'Every non-essential transform must respect user motion preferences.',
    contract: '@media (prefers-reduced-motion: reduce)',
    example: 'Disable continuous and ornamental motion first.',
  },
];
---

<BaseLayout
  title="Design Motion"
  description="Operational motion rules for the Blake Oxford design system."
  canonicalUrl="https://blakeoxford.com/design/animations/"
  wide={true}
>
  <Section padding="xl">
    <Container size="xl">
      <header class="max-w-3xl">
        <Badge variant="subtle">Design system</Badge>
        <h1 class="mt-5 text-4xl font-bold text-foreground dark:text-foreground-light sm:text-5xl">
          Motion Rules
        </h1>
        <p class="mt-4 text-lg leading-relaxed text-foreground/75 dark:text-foreground-light/75">
          Motion exists to clarify state, focus, and hierarchy. Continuous decorative animation is not part of the core component contract.
        </p>
      </header>

      <section class="mt-12 grid gap-4 lg:grid-cols-2" aria-label="Motion contracts">
        {motionRules.map((rule) => (
          <article class="min-w-0 rounded-2xl border border-border/40 bg-surface/70 p-5 shadow-sm dark:border-border-dark/40 dark:bg-surface-dark/60">
            <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
              <div>
                <h2 class="text-xl font-semibold text-foreground dark:text-foreground-light">{rule.name}</h2>
                <p class="mt-2 text-sm leading-relaxed text-foreground/70 dark:text-foreground-light/70">{rule.purpose}</p>
              </div>
              <Badge variant="outline" size="xs">Motion</Badge>
            </div>
            <code class="mt-5 block max-w-full overflow-x-auto rounded-lg bg-surface-subtle p-3 text-xs text-foreground/75 dark:bg-surface-dark-subtle dark:text-foreground-light/75">{rule.contract}</code>
            <p class="mt-4 text-sm text-foreground/70 dark:text-foreground-light/70">{rule.example}</p>
          </article>
        ))}
      </section>

      <section class="mt-16 rounded-2xl border border-border/40 bg-surface/70 p-5 shadow-sm dark:border-border-dark/40 dark:bg-surface-dark/60 sm:p-6" aria-labelledby="motion-boundary">
        <h2 id="motion-boundary" class="text-2xl font-bold text-foreground dark:text-foreground-light">Boundary</h2>
        <ul class="mt-5 grid gap-3 text-sm text-foreground/75 dark:text-foreground-light/75 md:grid-cols-2">
          <li>Do not add looping decorative motion to routine documentation or app surfaces.</li>
          <li>Do not use motion to compensate for unclear layout, labels, or hierarchy.</li>
          <li>Do not animate size, spacing, or text in ways that cause layout shift.</li>
          <li>Do keep focus, hover, and open/closed states predictable across keyboard and pointer input.</li>
        </ul>
      </section>

      <nav class="mt-12 flex flex-wrap gap-3" aria-label="Design documentation">
        <a class="rounded-lg bg-accent px-4 py-2 font-semibold text-on-accent transition hover:bg-accent-dark" href="/design/components/">Component contracts</a>
        <a class="rounded-lg border border-border px-4 py-2 font-semibold text-foreground transition hover:border-accent dark:border-border-dark dark:text-foreground-light" href="/design/tokens/">Tokens</a>
      </nav>
    </Container>
  </Section>
</BaseLayout>
