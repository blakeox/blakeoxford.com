---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Container from '@/components/primitives/Container.astro';
import Section from '@/components/primitives/Section.astro';
import Button from '@/components/primitives/Button.astro';
import Badge from '@/components/primitives/Badge.astro';
import BaseCard from '@/components/primitives/BaseCard.astro';
import FeatureCard from '@/components/composites/FeatureCard.astro';
import { PRIMITIVE_PROP_CONTRACT, COMPONENT_AUTHORING_CHECKLIST } from '@/data/componentDocs';
import ComponentCatalog from '@/components/features/design/ComponentCatalog.astro';
import {
  componentVariantMatrix,
  getComponentVariantCases,
} from '@/data/design-system/variantMatrix';
import type {
  BaseCardHover,
  BaseCardVariant,
  BadgeVariant,
  ButtonVariant,
  FeatureCardVariant,
  SectionBackground,
} from '@/lib/design-system/recipes';

const canonicalExamples = [
  {
    name: 'Button',
    contract: 'Use for explicit commands. Prefer semantic variants and stable sizes.',
    path: 'src/components/primitives/Button.astro',
  },
  {
    name: 'Badge',
    contract: 'Use for labels and status. Status variants must be semantic.',
    path: 'src/components/primitives/Badge.astro',
  },
  {
    name: 'BaseCard',
    contract: 'Use as the shared card primitive. Keep card styling centralized.',
    path: 'src/components/primitives/BaseCard.astro',
  },
  {
    name: 'FeatureCard',
    contract: 'Use for reusable feature surfaces. Avoid page-specific color props.',
    path: 'src/components/composites/FeatureCard.astro',
  },
];

const baseCardVariants = getComponentVariantCases('BaseCard').filter(
  (entry) => entry.recipe === 'baseCardRecipe'
);
const baseCardHoverVariants = getComponentVariantCases('BaseCard').filter(
  (entry) => entry.recipe === 'baseCardRecipe.hover'
);
const badgeVariants = getComponentVariantCases('Badge').filter(
  (entry) => entry.recipe === 'badgeRecipe.variant'
);
const buttonVariants = getComponentVariantCases('Button').filter(
  (entry) => entry.recipe === 'buttonRecipe.variant'
);
const featureCardVariants = getComponentVariantCases('FeatureCard').filter(
  (entry) => entry.recipe === 'featureCardRecipe.variant'
);
const sectionBackgrounds = getComponentVariantCases('Section').filter(
  (entry) => entry.recipe === 'sectionRecipe.background'
);
---

<BaseLayout
  title="Design Components"
  description="Operational component contracts and searchable catalog for the Blake Oxford design system."
  canonicalUrl="https://blakeoxford.com/design/components/"
  noindex={true}
  wide={true}
>
  <Section padding="xl">
    <Container size="xl">
      <header class="max-w-3xl">
        <Badge variant="subtle">Design system</Badge>
        <h1 class="mt-5 text-4xl font-bold text-foreground sm:text-5xl">Component Contracts</h1>
        <p class="mt-4 text-lg leading-relaxed text-muted-foreground">
          This page documents canonical component paths, live examples, and the full searchable
          catalog generated from
          <code class="rounded bg-surface-subtle px-1.5 py-0.5 text-sm break-all"
            >src/data/component-docs/manifest.ts</code
          >.
        </p>
      </header>

      <section
        class="mt-12 grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-4"
        aria-label="Canonical examples"
      >
        {
          canonicalExamples.map((item) => (
            <BaseCard as="article" variant="subtle" hover="none" padding="md" class="min-w-0">
              <h2 class="text-lg font-semibold text-foreground">{item.name}</h2>
              <p class="mt-2 text-sm text-muted-foreground">{item.contract}</p>
              <code class="mt-4 block rounded-lg bg-surface-subtle p-3 text-xs break-all text-muted-foreground">
                {item.path}
              </code>
            </BaseCard>
          ))
        }
      </section>

      <section class="mt-16" aria-labelledby="live-examples">
        <h2 id="live-examples" class="text-2xl font-bold text-foreground">Live Examples</h2>
        <div class="mt-6 grid grid-cols-1 gap-6 lg:grid-cols-2">
          <BaseCard variant="elevated" hover="none">
            <h3 class="text-xl font-semibold text-foreground">Buttons</h3>
            <div class="mt-5 flex flex-wrap gap-3">
              <Button variant="primary">Primary</Button>
              <Button variant="secondary">Secondary</Button>
              <Button variant="outline">Outline</Button>
              <Button variant="ghost">Ghost</Button>
            </div>
          </BaseCard>

          <BaseCard variant="elevated" hover="none">
            <h3 class="text-xl font-semibold text-foreground">Badges</h3>
            <div class="mt-5 flex flex-wrap gap-2">
              <Badge variant="secondary">Default</Badge>
              <Badge variant="primary">Primary</Badge>
              <Badge variant="success">Success</Badge>
              <Badge variant="warning">Warning</Badge>
              <Badge variant="error">Error</Badge>
            </div>
          </BaseCard>

          <FeatureCard
            title="Accent Feature"
            description="Expressive treatments use only accent and primary variants."
            variant="accent"
            hover={false}
          />
          <FeatureCard
            title="Primary Feature"
            description="Use Badge or a stateful component when the meaning is status."
            variant="primary"
            hover={false}
          />
        </div>
      </section>

      <section
        class="mt-16"
        aria-labelledby="canonical-variant-matrix"
        data-variant-case-count={componentVariantMatrix.length}
      >
        <h2 id="canonical-variant-matrix" class="text-2xl font-bold text-foreground">
          Canonical Variant Matrix
        </h2>
        <p class="mt-3 max-w-3xl text-muted-foreground">
          Every public visual recipe key is rendered here for bounded light/dark, desktop/mobile,
          focus, and reduced-motion checks. Structural keys remain contract-tested without adding
          screenshot volume.
        </p>

        <div class="mt-6 grid gap-6 lg:grid-cols-2">
          <BaseCard
            as="section"
            variant="subtle"
            hover="none"
            padding="md"
            aria-label="BaseCard variants"
          >
            <h3 class="text-lg font-semibold text-foreground">BaseCard variants</h3>
            <div class="mt-4 grid gap-3 sm:grid-cols-2">
              {
                baseCardVariants.map((entry) => (
                  <div
                    data-variant-component="BaseCard"
                    data-variant-recipe={entry.recipe}
                    data-variant-key={entry.variant}
                  >
                    <BaseCard variant={entry.variant as BaseCardVariant} hover="none" padding="sm">
                      <span class="text-sm text-foreground">{entry.variant}</span>
                    </BaseCard>
                  </div>
                ))
              }
              {
                baseCardHoverVariants.map((entry) => (
                  <div
                    data-variant-component="BaseCard"
                    data-variant-recipe={entry.recipe}
                    data-variant-key={entry.variant}
                  >
                    <BaseCard variant="subtle" hover={entry.variant as BaseCardHover} padding="sm">
                      <span class="text-sm text-foreground">hover: {entry.variant}</span>
                    </BaseCard>
                  </div>
                ))
              }
            </div>
          </BaseCard>

          <BaseCard
            as="section"
            variant="subtle"
            hover="none"
            padding="md"
            aria-label="Button variants"
          >
            <h3 class="text-lg font-semibold text-foreground">Button variants</h3>
            <div class="mt-4 flex flex-wrap gap-3">
              {
                buttonVariants.map((entry) => (
                  <div
                    data-variant-component="Button"
                    data-variant-recipe={entry.recipe}
                    data-variant-key={entry.variant}
                  >
                    <Button variant={entry.variant as ButtonVariant}>{entry.variant}</Button>
                  </div>
                ))
              }
            </div>
          </BaseCard>

          <BaseCard
            as="section"
            variant="subtle"
            hover="none"
            padding="md"
            aria-label="Badge variants"
          >
            <h3 class="text-lg font-semibold text-foreground">Badge variants</h3>
            <div class="mt-4 flex flex-wrap gap-2">
              {
                badgeVariants.map((entry) => (
                  <div
                    data-variant-component="Badge"
                    data-variant-recipe={entry.recipe}
                    data-variant-key={entry.variant}
                  >
                    <Badge variant={entry.variant as BadgeVariant}>{entry.variant}</Badge>
                  </div>
                ))
              }
            </div>
          </BaseCard>

          <BaseCard
            as="section"
            variant="subtle"
            hover="none"
            padding="md"
            aria-label="FeatureCard variants"
          >
            <h3 class="text-lg font-semibold text-foreground">FeatureCard variants</h3>
            <div class="mt-4 grid gap-3 sm:grid-cols-2">
              {
                featureCardVariants.map((entry) => (
                  <div
                    data-variant-component="FeatureCard"
                    data-variant-recipe={entry.recipe}
                    data-variant-key={entry.variant}
                  >
                    <FeatureCard
                      title={entry.variant}
                      description="Canonical expressive recipe coverage."
                      variant={entry.variant as FeatureCardVariant}
                      hover={false}
                    />
                  </div>
                ))
              }
            </div>
          </BaseCard>
        </div>

        <div class="mt-6 grid gap-3 sm:grid-cols-2">
          {
            sectionBackgrounds.map((entry) => (
              <Section
                padding="sm"
                background={entry.variant as SectionBackground}
                data-variant-component="Section"
                data-variant-recipe={entry.recipe}
                data-variant-key={entry.variant}
              >
                <p class="text-sm font-semibold text-foreground">section: {entry.variant}</p>
              </Section>
            ))
          }
        </div>
      </section>

      <ComponentCatalog />

      <BaseCard
        as="section"
        variant="subtle"
        hover="none"
        padding="lg"
        class="mt-16"
        aria-labelledby="authoring-checklist"
      >
        <h2 id="authoring-checklist" class="text-2xl font-bold text-foreground">
          New Component Checklist
        </h2>
        <p class="mt-3 text-sm text-muted-foreground">
          Follow this list before merging a new component. The catalog at <code
            >src/data/component-docs/manifest.ts</code
          > is the searchable source of truth.
        </p>
        <ul class="mt-5 grid gap-3 text-sm text-muted-foreground md:grid-cols-2">
          {
            COMPONENT_AUTHORING_CHECKLIST.map((item) => (
              <li class="flex items-start gap-2">
                <span class="mt-0.5 text-success">✓</span>
                <span>{item}</span>
              </li>
            ))
          }
        </ul>
        <div class="mt-8">
          <h3 class="text-lg font-semibold text-foreground">Standard primitive props</h3>
          <div class="mt-4 overflow-x-auto">
            <table class="w-full text-sm">
              <thead class="border-b border-border">
                <tr class="text-left">
                  <th class="pr-4 pb-2 font-semibold">Prop</th>
                  <th class="pr-4 pb-2 font-semibold">When</th>
                  <th class="pb-2 font-semibold">Notes</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-border">
                {
                  PRIMITIVE_PROP_CONTRACT.map((entry) => (
                    <tr>
                      <td class="py-3 pr-4">
                        <code class="text-accent-emphasis">{entry.prop}</code>
                      </td>
                      <td class="py-3 pr-4 text-muted-foreground">{entry.when}</td>
                      <td class="py-3 text-muted-foreground">{entry.notes ?? '—'}</td>
                    </tr>
                  ))
                }
              </tbody>
            </table>
          </div>
        </div>
      </BaseCard>

      <BaseCard
        as="section"
        variant="subtle"
        hover="none"
        padding="lg"
        class="mt-16"
        aria-labelledby="anti-patterns"
      >
        <h2 id="anti-patterns" class="text-2xl font-bold text-foreground">Anti-Patterns</h2>
        <ul class="mt-5 grid gap-3 text-sm text-muted-foreground md:grid-cols-2">
          <li>Do not add new component folders for one-off wrappers.</li>
          <li>
            Do not place component files directly under <code>src/components</code>; use the
            canonical layer folders.
          </li>
          <li>
            Do not document components unless the catalog path exists and the category matches the
            folder.
          </li>
          <li>Do not advertise variants that are not supported by the component prop types.</li>
          <li>
            Do not use raw green, red, blue, gray, white, or black utilities in reusable components.
          </li>
          <li>
            Do not create duplicate files with a <code>* 2.*</code> suffix; the lint gate blocks them.
          </li>
        </ul>
      </BaseCard>
    </Container>
  </Section>
</BaseLayout>
