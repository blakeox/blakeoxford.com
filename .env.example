# Environment variables for blakeoxford.com
# Copy this file to .env and fill in secrets for local development

# Contact email delivery uses the CONTACT_EMAIL binding in wrangler.toml.
# It does not require an application-level API key.

# Example: Cloudflare Turnstile site key (if used)
CF_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Analytics — GA4 via Cloudflare Zaraz (see scripts/setup/deploy-zaraz.mjs)
GA4_MEASUREMENT_ID=
PUBLIC_GOOGLE_SITE_VERIFICATION=

# Microsoft Clarity — client-side snippet (src/lib/clarity.ts)
PUBLIC_CLARITY_PROJECT_ID=tqngpokfgs

# Optional Cloudflare Web Analytics beacon token (Analytics → Web Analytics)
PUBLIC_CF_WEB_ANALYTICS_TOKEN=

# Optional interactive-surface kill switches. Omit or set true to enable;
# false, 0, off, and disabled render the documented fallback links instead.
PUBLIC_ENABLE_SITE_SEARCH=true
PUBLIC_ENABLE_AI_ASSISTANT=true


# AutoRAG AI search configuration (proxied via /api/ai-search)
AI_SEARCH_API_ENDPOINT=
AI_SEARCH_API_TOKEN=

# Add any other secrets or config here

# --------------------------------------------------
# Performance & Testing Configuration
# --------------------------------------------------
# BASE_URL: Set to an already running deploy/preview to reuse instead of starting dev server in perf scripts
BASE_URL=

# OUTPUT_DIR: Destination for Lighthouse / performance reports (default: ./lighthouse-reports)
OUTPUT_DIR=

# BROWSER_INSTALL_FAILED: If set to 'true', Playwright config skips launching tests that need browsers (used in CI fallback)
BROWSER_INSTALL_FAILED=

# --------------------------------------------------
# Tooling / Automation (optional)
# --------------------------------------------------
# GH_TOKEN: Personal access token for GitHub CLI automation (only needed if not using interactive login)
GH_TOKEN=

# NODE_ENV can be overridden locally if needed (defaults to development when running dev server)
NODE_ENV=

# --------------------------------------------------
# Sentry - Error Tracking & Performance Monitoring
# --------------------------------------------------
# Project: accelerise-consulting / blakeoxford-com
# Keep the existing conservative sampling and review usage in Sentry.

# CLIENT-SIDE (Browser) DSN - This is PUBLIC and will be exposed in client code
# Get from the project's Client Keys settings. Leave blank to disable browser reporting.
PUBLIC_SENTRY_DSN=
# Optional override for isolated verification; Workers Builds derives production/preview from its branch.
PUBLIC_SENTRY_ENVIRONMENT=
SENTRY_ORG=accelerise-consulting
SENTRY_PROJECT=blakeoxford-com
# SENTRY_AUTH_TOKEN belongs in secure BUILD storage for source-map uploads, never PUBLIC_* or Worker bindings.

# Git commit SHA for release tracking (automatically set in production builds)
PUBLIC_GIT_COMMIT=dev

# Carousel master images (outside git; see src/assets/images/carousel/ORIGINAL_MASTERS.md)
# CAROUSEL_ORIGINALS_DIR=/Users/you/Documents/blakeoxford-local/carousel-originals

# CLOUDFLARE WORKERS SECRETS (set via wrangler CLI, not in .env):
# wrangler secret put SENTRY_DSN_EDGE       # Same app project; environment separates preview/production
# wrangler secret put GIT_COMMIT            # Set in CI/CD: $(git rev-parse HEAD)
# wrangler secret put ENVIRONMENT           # Set to: production
